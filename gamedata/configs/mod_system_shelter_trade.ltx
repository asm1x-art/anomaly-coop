goods           = medkit_scientic, medkit_army, antirad, drug_radioprotector, drug_psy_blockade, drug_antidot, drug_anabiotic, drug_coagulant, glucose, batteries_dead, mutant_part_cat_thyroid
goods_medic     = stimpack_scientic, drug_booster, morphine, rebirth   ; only once the base has a medic

[shelter_supplier_petrenko]

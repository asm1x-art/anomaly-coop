; The shelter's trade (shelter_trade.script, shelter_orders.script, ui_shelter_trade.script; docs/coop/shelter.md, "Economy").

; the trade: visitors come every sell_hours game hours; the markup: general, set on the laptop from markup_min to
; markup_max by markup_step. Visitors in a game day: from traffic_low to traffic_high by weight_rep * the trade's name +
; weight_range * the range on sale (each category full from range_full positions) + weight_prices * the prices (1 at no
; markup, 0 from dear_at times the category's fair one), times a crisis' traffic; then traffic_spread either way, drawn
; each day: so 3-5 at the worst, 12-14 at the best. barman_cost: hiring one on the laptop; without one trade stops.
[shelter_trade]
sell_hours      = 1
markup          = 1.1
markup_min      = 0.8
markup_max      = 2.5
markup_step     = 0.05
traffic_low     = 4
traffic_high    = 13
traffic_spread  = 1
weight_rep      = 0.4
weight_range    = 0.3
weight_prices   = 0.3
range_full      = 5
dear_at         = 1.5
barman_cost     = 30000
rep_start       = 50
low_stock       = 10
categories      = food, drink, medical, ammo, weapon, armour, artefact, gear
ranks           = experienced, veteran, master
not_goods       = shelter_, prop_, wpn_m4_tac_brigadier, wpn_krissvektor_chemist
not_boxes       = shelter_stash, shelter_generator_box, shelter_till, coop_shadow_box

; who comes: no rookies, they don't get to the Radar
[shelter_trade_rank_experienced]
weight          = 5
wallet_min      = 15000
wallet_max      = 40000

[shelter_trade_rank_veteran]
weight          = 3
wallet_min      = 30000
wallet_max      = 80000

[shelter_trade_rank_master]
weight          = 1
wallet_min      = 60000
wallet_max      = 150000

; a category: the items' kinds; need: the chance a visitor wants it; min, max: how many (rounds for ammo); fair: the
; markup taken without a thought; above it the chance falls by elastic for each 1.0 of markup; worn: the price follows
; the condition; rounds: counted by the round; default_off: not sold till put on sale on the laptop
[shelter_trade_cat_food]
kinds           = i_food
need            = 0.5
min             = 1
max             = 2
fair            = 1.4
elastic         = 1.2

[shelter_trade_cat_drink]
kinds           = i_drink
need            = 0.5
min             = 1
max             = 2
fair            = 1.4
elastic         = 1.2

[shelter_trade_cat_medical]
kinds           = i_medical
need            = 0.4
min             = 1
max             = 2
fair            = 1.6
elastic         = 0.25

[shelter_trade_cat_ammo]
kinds           = w_ammo
need            = 0.5
min             = 30
max             = 90
fair            = 1.4
elastic         = 0.9
rounds          = true

[shelter_trade_cat_weapon]
kinds           = w_pistol, w_rifle, w_sniper, w_smg, w_shotgun
need            = 0.03
min             = 1
max             = 1
fair            = 1.3
elastic         = 0.6
worn            = true

[shelter_trade_cat_armour]
kinds           = o_light, o_medium, o_heavy, o_sci, o_helmet
need            = 0.02
min             = 1
max             = 1
fair            = 1.3
elastic         = 0.6
worn            = true

[shelter_trade_cat_artefact]
kinds           = i_arty
need            = 0.02
min             = 1
max             = 1
fair            = 1.2
elastic         = 0.8
worn            = true
default_off     = true

[shelter_trade_cat_gear]
kinds           = i_tool, i_repair, i_kit, i_attach, i_device, i_arty_junk, i_mutant_part, i_mutant_raw, i_mutant_cooked, i_mutant_belt, w_explosive, w_misc
need            = 0.1
min             = 1
max             = 1
fair            = 1.3
elastic         = 1

; crises: one every gap_min..gap_max world hours, each for its hours. traffic: visitors times this (traffic_fixed_at: not
; if the general markup is this or lower); demand_<cat>: the need times this; fair_<cat>: the fair markup times this;
; stops: a supplier taking no orders; spoil, spoil_cat: a share of a category gone at the start
[shelter_crises]
list            = dry, psi, dump, rats, audit, double, snipers
gap_min         = 72
gap_max         = 120

[shelter_crisis_dry]
hours           = 72
stops           = skryaga
demand_drink    = 1.5
fair_drink      = 2.5
fair_ammo       = 1.5

[shelter_crisis_psi]
hours           = 48
demand_medical  = 2.5
fair_medical    = 2

[shelter_crisis_dump]
hours           = 48
traffic         = 0.6
traffic_fixed_at = 1.1

[shelter_crisis_rats]
hours           = 24
spoil           = 0.15
spoil_cat       = food
off_state       = bayun_grown

[shelter_crisis_audit]
hours           = 96
stops           = sakharov
demand_medical  = 1.5
fair_medical    = 1.5

; economic only: no emission is started by it
[shelter_crisis_double]
hours           = 12
traffic         = 1.5
demand_medical  = 2
demand_food     = 1.5
demand_ammo     = 1.5
fair_medical    = 2
fair_food       = 2
fair_ammo       = 2

; stops: all suppliers; squads: "smart:section"; until_dead: over once they are dead
[shelter_crisis_snipers]
hours           = 96
stops           = all
squads          = rad_after_valley:raid_monolith_sniper, rad_valley:raid_monolith_sniper
until_dead      = true

; the supply. lots: pieces of the three lot sizes, lots_ammo: rounds, bulk: the price against that trader's retail for
; each size. A trader's price: retail * bulk * goodwill's factor (below rep_low: rep_k_low, from rep_high: rep_k_high)
; * (1 - the discount won by contracts, at most discount_max): with these numbers never above 0.945 of retail. A trader
; dead or below rep_hostile takes no orders. sos_hours: how long an intercepted case lies; squads: who is on it.
[shelter_orders]
suppliers       = barman, sakharov, petrenko, skryaga
lots            = 20, 50, 100
lots_ammo       = 300, 1000, 3000
bulk            = 0.9, 0.8, 0.7
rep_low         = 500
rep_high        = 1500
rep_k_low       = 1.05
rep_k_high      = 0.9
rep_hostile     = -500
discount_max    = 0.15
sos_hours       = 6
squads          = merc_sim_squad_advanced, merc_sim_squad_veteran, monolith_sim_squad_advanced, monolith_sim_squad_veteran
board_size      = 5
offer_every     = 12
offer_hours     = 48

; retail: as the trader's sell factor (configs/items/trade/presets/trade_discounts.ltx); the risk is the way's: the time
; and the chance of interception, the same for all, none with the perimeter fortified. points: smart terrains outside the Radar's lethal zone
[shelter_supplier_barman]
name            = st_shelter_tr_sup_name_barman
story           = bar_visitors_barman_stalker_trader
faction         = stalker
retail          = 1

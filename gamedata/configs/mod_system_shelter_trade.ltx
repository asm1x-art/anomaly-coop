; an intercepted lot's case: taken, the lot goes to the ledger
[shelter_cargo]:tch_quest
visual          = dynamics\equipments\quest\safe_container.ogf
inv_name        = st_shelter_tr_cargo_name
inv_name_short  = st_shelter_tr_cargo_name
description     = st_shelter_tr_cargo_descr
inv_grid_x      = 4
inv_grid_y      = 11
inv_grid_width  = 2
inv_grid_height = 2
inv_weight      = 1
quest_item      = true

; the contracts. variants: what is wanted, "/" between the variants (one is drawn; one naming an unknown section is
; skipped); hours: the time once taken; pay: the reward against the things' base cost; min_cond: for worn things; rep:

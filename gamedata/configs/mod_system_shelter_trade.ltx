goods           = vodka, vodka_quality, beer, cigarettes, cigarettes_lucky, tushonka, conserva, bread, kolbasa, energy_drink, mineral_water, ammo_9x18_fmj, ammo_9x19_fmj, ammo_5.45x39_fmj, ammo_7.62x39_fmj, bandage, medkit

[shelter_supplier_sakharov]

; Co-op: doors, breakable boxes, where things lie and glass are the world's, not each game's (coop_physics.script,
; src/xrGame/coop/coop_props.cpp).
[coop_physics]
plain_box_loot_chance = 0.5 ; chance a plain wooden or metal box (no drop_box in its spawn) has loot when broken,
                            ; rolled from the box's name and the world's loot seed; Anomaly's own is 0.5
break_hit_power = 100       ; power of the hit (fire wound) that breaks our copy of a box another player broke
; where things lie (a physic object, a door swinging free, an item on the ground): told when it comes to rest
rest_min_move   = 0.10      ; m any of its physics elements moved from where the world has it
rest_min_turn   = 5         ; degrees any of them turned (a thing put where the world has it settles without
                            ; being sent back, so low numbers don't make things go back and forth)
rest_check_ms   = 500       ; real ms between two looks at the things online here
rest_min_gap_ms = 1000      ; real ms at least between two rests of one thing sent
; doors whose logic asks about the player (how near, in a zone, what he carries or knows): the level's authority runs
; it for all the level's players (the nearest, any in the zone, none out of it, an info any/none has), the others take
; the door
key_reach_m     = 5         ; m: a key (actor_has_item) counts for its holder within this of the door; without the key
                            ; a player gets no use out of a door asking for it
peer_stale_s    = 10        ; real s: a player not heard from for this long doesn't count for a door's logic
carry_items     = decoder, pri_b35_lab_x8_key ; items each game tells it carries (fact carry:<player>), for door logic
                            ; asking actor_has_item; ones the logic of a door online here asks about are added (and
                            ; the infos it asks about or changes: fact knows:<player>)
carry_check_ms  = 1000      ; real ms between two looks at what our player carries and knows of them
replay_effects  = play_sound, play_sound_looped, stop_sound_looped, play_particle_on_path, hit_npc
                            ; effects of a door's switch the authority made that the other games play too (only seen
                            ; and heard: an effect that changes the world stays the authority's)

; Fixes to the Grim Raid Addon weapon pack (tools\gra\build_pack.py brings it in; this file is the repo's own)

; Boomsticks' Archangel has "_v.ogf" after its world model's path (with spaces between, which the engine drops), a
; model that doesn't exist: the game crashed on the first Monolith stalker carrying it
![wpn_remington700_bas_archangel]
visual = dynamics\weapons\wpn_remington700_bas\wpn_remington700_bas_archangel_world.ogf

; World models in a stalker's or a player's hands (third person; CWeapon::UpdateXForm, the co-op puppet): these
; sections kept the offsets of vanilla's models, whose origin is far under the grip, while their own models have it at
; the grip, so the gun hung under the hands, apart from them. The offsets of the pack's guns of the same kind instead.
; Skorpions: the height of Boomsticks' other submachine guns (wpn_kiparis_m1)
![wpn_vz61_scorpion]
position = -0.026, 0.0, -0.03
![wpn_vz61_scorpion_m1]
position = -0.026, 0.0, -0.03
![wpn_vz61_scorpion_m2]
position = -0.026, 0.0, -0.03
; the short Kar98k: its hold (animation_slot 3) points the hand down, every other gun of that hold is turned up 30
; degrees to make up for it (wpn_remington700_bas)
![wpn_k98_mod]
position = -0.026, 0, -0.01
orientation = 0, 30, 0

; the window's countdown on the screen (ui_raid_hud.script) on raid levels: show (and the Co-op options page's switch);
; corner top_right, top_left, bottom_right, bottom_left; margins from it and size (the HUD's 1024x768 units); alpha of
; the box (0-255); real minutes (the game's divided by time_factor), or the game's with game_time = true; amber in the
; last warn_minutes
[raid_timer]
show            = true
corner          = top_right
margin_x        = 16
margin_y        = 40
width           = 170
height          = 40
alpha           = 210
game_time       = false
warn_minutes    = 10


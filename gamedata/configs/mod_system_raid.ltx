; the Monolith on a raid level (raid_monolith.script): a garrison on every smart terrain (but no_garrison ones), its
; men drawn by rank weights ("rank:weight, ...", ranks in [raid_monolith_ranks]) by the smart's depth from where one
; comes onto the level (a third each: near, mid, far); big garrisons deeper, a rare thing on their commander; snipers
; on the sniper smarts; posts (a squad of their own; tools\raid\raid_posts.py places them); patrols on routes, rolled
; anew each time one comes onto the level. Every key below can be set per level in [<level>_monolith]; there it wins.
[raid_monolith]
refresh_hours   = 168   ; all the smarts and posts held anew with fresh squads
retake_hours    = 12    ; while one is away, a step each: the free smart nearest to a held one is taken back...
retake_chance   = 0.6   ; ...with this chance (none held: through the level's entry smart)
ladder          = novice, regular, experienced, veteran, master, alpha   ; weakest first, for rank_up
rank_up         = 0.1   ; each man's chance to be one rank higher than drawn
squad           = raid_monolith_squad   ; the squad the drawn men are put in...
post_squad      = raid_monolith_post_squad   ; ...a post's: made at its place, always arrived at its smart
men             = 3, 5  ; a garrison squad's men, min, max
near            = novice:3, regular:1
mid             = regular:2, experienced:1
far             = experienced:2, veteran:1
big             = veteran:3, master:1   ; a big garrison's first squad (the rare thing on its commander)...
big_squads      = 2     ; ...and its other squads, of far's weights
big_count       = 2     ; big garrisons, on the deeper half's smarts
sniper          = sniper:1
sniper_men      = 2, 3
post            = experienced:1, veteran:1   ; a post's squad, if its section has no ranks
post_men        = 2, 3
rare_loot       = af_glass, af_fire, af_ice, af_compass, af_gold_fish, af_soul, af_night_star, af_eye
patrol          = experienced:1, veteran:1
patrol_men      = 3, 3
patrol_chance   = 0.4   ; each route's
patrol_max      = 2
patrol_stay     = 60, 180   ; seconds at a smart on the way (chain routes)
; the Monolith's scientists (a post with "scientists"): each carries scientist_loot_count things of scientist_loot,
; and a rare thing with scientist_rare_chance
scientist_loot  = medkit_scientic, stimpack_scientic, drug_psy_blockade, drug_radioprotector, drug_antidot, detector_scientific, itm_repairkit_tier_3
scientist_loot_count = 1, 2
scientist_rare_chance = 0.5
underground     = raid_sarcofag, raid_control_monolith   ; the Monolith's torches always on there
; ...and with scientist_doc_chance one of the Monolith's documents (sold to traders; what they give in the shelter is
; the user's to say)
scientist_docs  = raid_doc_psi_screens, raid_doc_gauss, raid_doc_synthesis
scientist_doc_chance = 0.35
; reinforcements (raid_monolith.script): while one is on a raid level, every reinforce_every real seconds (drawn anew
; each time) a squad of reinforce_men men of reinforce's ranks leaves the held smart nearest to one that is
; reinforce_distance metres away at least, and hunts one; reinforce_max a raid at most (drawn as it starts). None held
; that far: tried again in reinforce_retry seconds. reinforce_msg: a line on the screen as one sets out
reinforce_every = 180, 300
reinforce_max   = 2, 3
reinforce_distance = 100
reinforce_retry = 15
reinforce       = experienced:1, veteran:1
reinforce_men   = 3, 4
reinforce_msg   = true
; the dead's loot by their squad's kind (raid_loot.script): on the body's first search, after the game's own,
; body_<kind>_count things (min, max) drawn by body_<kind>'s weights ("section:weight"). Kinds: near, mid, far, big,
; sniper, post, patrol, reinforce, guard (the scientists' guards); a kind with none here takes far's. Per level too.
body_near       = bandage:4, medkit:2, antirad:2, ammo_5.45x39_fmj:3, ammo_9x18_fmj:2, grenade_rgd5:1
body_near_count = 0, 1
body_mid        = medkit:3, bandage:2, stimpack:1, antirad:2, ammo_5.45x39_ap:2, ammo_9x19_fmj:1, grenade_rgd5:1, prt_i_fasteners:1
body_mid_count  = 0, 1
body_far        = medkit_army:3, stimpack:2, drug_coagulant:1, antirad:1, ammo_5.45x39_ap:2, ammo_5.56x45_ap:2, grenade_f1:2, prt_i_capacitors:1, gun_oil:1
body_far_count  = 0, 2
body_big        = medkit_army:3, stimpack_army:2, drug_radioprotector:1, ammo_9x39_ap:2, ammo_5.56x45_ap:2, grenade_f1:2, itm_repairkit_tier_2:1, cleaning_kit_r7:1
body_big_count  = 1, 2
body_sniper     = ammo_7.62x54_7h14:4, medkit:2, stimpack:1, cleaning_kit_r7:1
body_sniper_count = 1, 1
body_guard      = medkit_scientic:2, stimpack_army:2, drug_psy_blockade:2, ammo_9x39_ap:2, ammo_5.56x45_ap:2, grenade_f1:1, itm_repairkit_tier_3:1
body_guard_count = 1, 2


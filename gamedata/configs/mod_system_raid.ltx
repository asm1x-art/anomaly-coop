; death in a raid (raid.script): one wakes in the shelter with what is in the slots and on the belt; everything found
; in the raid is lost, each other thing in the backpack with lose_chance
[raid_death]
lose_chance     = 0.5
wake_health     = 0.5

; the window for raids (raid_window.script): world hours. Once every every_hours while the Scorcher works, window_hours
; long, one sets out in its first entry_hours, a warning warn_hours before it closes; after that a psi hit each 3 s,
; late_hit + late_hit_grow per second late, at most late_hit_max, and phantoms.
; reinforce: "smart:squad", once the Scorcher is off: the Pripyat transition, the Scorcher's complex
[raid_window]
every_hours     = 168
every_spread    = 24    ; give or take, drawn each cycle
window_hours    = 6
entry_hours     = 2
warn_hours      = 1
late_hit        = 0.01
late_hit_grow   = 0.0008
late_hit_max    = 0.15
late_health     = 0.005   ; lost each hit, whatever one wears: this + late_health_grow per second late, at most late_health_max
late_health_grow = 0.0003
late_health_max = 0.05
late_hit_seconds = 3
late_msg_seconds = 15
phantom_seconds = 20
phantoms_max    = 5
phantom_distance = 12
senders         = st_raid_cooling_sender_1, st_raid_cooling_sender_2, st_raid_cooling_sender_3, st_raid_cooling_sender_4
reinforce       = rad_freedom_vs_duty:raid_monolith_far, rad_freedom_vs_duty:raid_monolith_mid, rad_antenna_monolith:raid_monolith_alpha, rad_antenna_camper:raid_monolith_far, rad_antenna_patrol:raid_monolith_far

; the raid's rescue events (raid_rescue.script): chance at each cycle, never two cycles running; reveal: metres from the
; place at which the people appear once the siege is dead. position: as of the level's AI map, node: its vertex

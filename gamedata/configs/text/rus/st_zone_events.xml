	</string>
	<string id="st_zev_r_no_levels">
		<text>«%s»: список локаций пуст.</text>
	</string>
	<string id="st_zev_r_started">
		<text>«%s» начался: %s, около %s ч реального времени.</text>
	</string>
	<string id="st_zev_r_not_running">
		<text>«%s» сейчас не идёт.</text>
	</string>
	<string id="st_zev_r_stopped">
		<text>«%s» (%s) остановлен, без итога.</text>
	</string>
	<string id="st_zev_r_outcome">

; the work with the capsules and the chambers (shelter_synthesis.script): the suits it allows, how long a capsule
; takes to fill (s), how near an anomaly takes the actor's capsule (m); the alchemy: a load's game hours from hours_min
; (junk) to hours_max, by its worth (the things' cost) to worth_max, raised to worth_power; the artefacts' tier from
; which they're rare (made of a common one)
[shelter_synthesis]
suits           = shelter_chemist_outfit, ecolog_outfit_yello, ecolog_outfit_blue, ecolog_outfit_green, ecolog_outfit_red
fill_seconds    = 60
reach           = 4
hours_min       = 1
hours_max       = 12
worth_max       = 120000
worth_power     = 0.7
rare_tier       = 4


; The group's shelter (docs/coop/shelter.md, scripts/shelter.script).

; the questline's dialogs with Sidorovich, Sakharov, Kardan (put on them by modxml_shelter.script)
![dialogs]
>files = dialogs_shelter

; the first visit's zombies, the group that found the shelter: zombified, in their own suits (character_desc_shelter.xml)
![profiles]
>files = npc_profile_shelter
>specific_characters_files = character_desc_shelter

[shelter_zombie_nosorog]:stalker_zombied
character_profile = shelter_zombie_nosorog
spec_rank         = novice
community         = zombied

[shelter_zombie_seva]:stalker_zombied
character_profile = shelter_zombie_seva
spec_rank         = novice
community         = zombied

; The generator: says what it needs till Kardan's tools are used on it, then opens its box (below) to take an electric
; artefact that powers the shelter's lamps. The root bone is fixed, as in vanilla [disel_generator]; motions "idle"
; (stopped) and "work" (running).
[shelter_generator]:physic_object
visual            = dynamics\el_tehnika\disel_generator.ogf
startup_animation = idle
fixed_bones       = link
script_binding    = shelter.init_generator

; what the generator holds: a box hidden in its body, opened from the generator's use (inventory boxes have no
; physics, so the generator itself can't be one: the player would walk through it)
[shelter_generator_box]:inventory_box

; the shelter's stash: a crate under the desk in the cabin next to the laptop's (an inventory box has no physics:
; nobody walks under a desk)
[shelter_stash]:inventory_box
visual          = dynamics\box\box_wood_02.ogf

; the laptop on the desk in the room by the passage; works while the generator runs
[shelter_laptop]:physic_object
visual          = dynamics\efp_props\prop_laptop.ogf
script_binding  = shelter.init_laptop

; the questline's things: none can be sold or dropped

; on the zombie in the Nosorog suit: read, it gives the questline (the task shelter_restore)
[shelter_note]:tch_quest
visual              = dynamics\equipments\quest\notes_writing_book_2.ogf
inv_name            = st_shelter_note_name
inv_name_short      = st_shelter_note_name
description         = st_shelter_note_descr
inv_grid_x          = 6
inv_grid_y          = 14
inv_weight          = 0.02
quest_item          = true
shelter_keep        = true ; off a body the cleaning takes, into the stash (shelter.script)
use1_functor        = shelter.note_menu
use1_action_functor = shelter.note_read

; also on that zombie: the map of the rooms and the wiring, for the laptop (it works only with it)
[shelter_flash]:tch_quest
visual          = dynamics\devices\dev_flash_2\dev_flash_2.ogf

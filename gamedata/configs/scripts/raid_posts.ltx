; The Monolith's places on the raid levels, generated by tools\raid\raid_posts.py (edit there).
; scripts\raid_monolith.script adds them to the smarts' jobs: [raid_posts] per smart its jobs, [raid_post_hosts]
; the smart each post or route is made at. A job is taken only by a man of its post's squads (role: scientist
; or guard: only such; lair: any Monolith man of the smart). Positions and poses: mod_patrol_paths_raid.ltx.

[raid_posts]
raid_katacomb_smart_terrain = raid_hos_p1_1, raid_hos_p1_2, raid_hos_p1_3, raid_hos_p1_4, raid_hos_p2_1, raid_hos_p2_2, raid_hos_p2_3, raid_hos_p2_4, raid_hos_p3_1, raid_hos_p3_2, raid_hos_p3_3, raid_hos_p3_4, raid_hos_p4_1, raid_hos_p4_2, raid_hos_p4_3, raid_hos_p4_4, raid_hos_route_1, raid_hos_route_2, raid_hos_route_3

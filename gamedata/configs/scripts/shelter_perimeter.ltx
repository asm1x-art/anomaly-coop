; The perimeter's posts, generated by tools\shelter\perimeter_posts.py (edit there). scripts\shelter_base.script
; adds them to the smarts' jobs (docs/coop/shelter.md). [shelter_perimeter]: per smart its jobs; a job is taken only
; by an NPC of a squad in its "squad"; when = calm (the posts) or surge (an emission or a psi storm: the covers).
; Positions and poses (the watch point's a=): mod_patrol_paths_shelter.ltx. prior over every vanilla job; the covers
; over the posts.

[shelter_perimeter]
rad_after_valley = shelter_post_1, shelter_post_2, shelter_post_3, shelter_post_4, shelter_post_5, shelter_post_6, shelter_post_7, shelter_post_8, shelter_post_9, shelter_post_sniper, shelter_cover_1, shelter_cover_2, shelter_cover_3, shelter_cover_4, shelter_cover_5, shelter_cover_6, shelter_cover_7, shelter_cover_8, shelter_cover_9, shelter_cover_10, shelter_cover_11, shelter_cover_12, shelter_cover_13
rad_entrance = shelter_gate_1, shelter_gate_2, shelter_gate_3, shelter_gate_4, shelter_gate_cover_1, shelter_gate_cover_2, shelter_gate_cover_3, shelter_gate_cover_4

; west road: crouched
[logic@shelter_post_1]
active          = walker@shelter_post_1
squad           = shelter_perim_post
when            = calm
prior           = 200

[walker@shelter_post_1]
path_walk       = shelter_post_1_walk
path_look       = shelter_post_1_look


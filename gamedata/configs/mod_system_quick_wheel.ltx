; The quick item wheel (scripts/ui_quick_wheel.script): a key opens one wheel of the player's own things. The player
; fills it from the backpack (an item's menu: «В быстрое колесо» adds it, «Убрать из быстрого колеса» or a right click
; on the wheel takes it off). Each player's wheel is his (an actor variable, personal in co-op). The key and press/hold
; are per player in MCM («Быстрое колесо»); these are their defaults.

[quick_wheel]
key            = DIK_C    ; opens the wheel (V is the game's weapon function: grenade launcher, second sight, BaS laser)
hold           = false    ; false: a press opens it and the next closes it; true: open while held, letting go uses the thing under the cursor
max_items      = 12       ; things on the wheel at most
refresh_ms     = 300      ; how often the open wheel looks at the backpack again (counts, what is worn, what is loaded)

; the layout, in square units of a 1024x768 screen (narrowed for a wider one, so circles stay round)
center_y       = 384      ; the wheel's middle, from the screen's top
back_size      = 460      ; the game's ammo wheel under it, across
back_alpha     = 242      ; its see-through (of 255)
ring           = 152      ; the ring the things sit on: its radius
disc           = 78       ; a thing's disc (smaller when many)
icon           = 58       ; a thing's icon in its disc
dead_zone      = 48       ; the cursor nearer the middle than this picks nothing

; colours: r, g, b
color_name     = 240, 217, 182  ; the name in the middle
color_text     = 200, 200, 200  ; the count, the condition
color_hint     = 140, 140, 140  ; what a click does
color_bad      = 240, 86, 74    ; can't be used now (ammo for another gun, an addon that doesn't fit)
missing_alpha  = 70             ; a thing that is not in the backpack: its icon this see-through (of 255)

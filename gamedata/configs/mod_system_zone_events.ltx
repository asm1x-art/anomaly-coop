; The Zone's events (coop_zone_events.script; Notion "События Зоны"). A world-state event lies on one level for some
; hours: started by the director after a surge, or by an admin (the admin window's "События", the admin page, the
; bot: event <id> start [level] | stop | outcome). At most one world-state event and one scene at a time.
; Times are real hours (UTC on the master's clock): a player's sleep or the world's speed don't change them.

[zone_events]
enabled             = true      ; the director's own starts (an admin's start works either way)
check_s             = 2         ; real seconds between looks at the events (every game)
after_surge_s       = 45        ; real seconds after a surge's end before the director rolls (its news first)
quiet_s             = 20        ; a game that has just loaded the world settles a surge it missed: no roll then
end_news_real_hours = 2         ; a player who heard an event begin hears its end only this many real hours after it
min_gap_real_hours  = 1         ; the director starts no world-state event sooner after the last one ended

; The events' news as stalkers write them (coop_event_news.script): who may write an event's news,
; <string id of the caption>:<community, for the icon>. One of them for an event, the same for every player. The
; texts' variants are in the text files: <key>_1, <key>_2, ... (st_zone_events.xml, st_coop_news.xml, st_raid.xml):
; a variant more is a string more, no number here. No senders: the event's title and the radio icon, as before.
[coop_event_news]
calm_senders        = st_evnews_who_1:stalker, st_evnews_who_2:stalker, st_evnews_who_3:stalker, st_evnews_who_4:csky, st_evnews_who_5:freedom, st_evnews_who_6:dolg
ash_senders         = st_evnews_who_1:stalker, st_evnews_who_2:stalker, st_evnews_who_3:stalker, st_evnews_who_5:freedom, st_evnews_who_6:dolg, st_evnews_who_7:stalker

; prices while an event runs, by category: what an item's "kind" is (ammo also by its own kind of price)
[zone_events_price_kinds]
ammo                = ammo
mutant              = i_mutant_raw, i_mutant_cooked, i_mutant_belt
artefact            = i_arty, i_arty_cont
medical             = i_medical

; ---------------------------------------------------------------------------------------------------------------
; Мёртвый штиль: every anomaly on one level goes out, fields and single ones alike; the artefacts lying there go with
; them and none is born there meanwhile; at the end the anomalies come back and bear artefacts as after a surge.
; Southern surface levels with anomalies (not the Bar).
[zone_event_calm]
enabled             = true
slot                = world     ; world (a world state) or scene
chance              = 0.25      ; the director's chance after a surge
cooldown_real_hours = 8         ; real hours since the last calm ended before the director starts another
real_hours_min      = 1         ; how long it lasts, real hours
real_hours_max      = 2
levels              = l01_escape, l02_garbage, l03_agroprom, l04_darkvalley, l06_rostok, l07_military, l08_yantar, l09_deadcity, k00_marsh, k01_darkscape, k02_trucks_cemetery, y04_pole
; prices while it runs: buy_<category> what the player pays traders, sell_<category> what traders pay the player
; (categories: [zone_events_price_kinds]; none given: 1)
sell_artefact       = 1.1
; smarts of its level closed to squads whose section has one of these in it (none for the calm)
closed_to_squads    =
; it puts out every anomaly of the level (anything Anomaly binds as an anomaly field), radiation spots too, but these:
; sections starting so (campfires, teleports, the Monolith's wish-granter zone, the Generators' generators)
keep_sections       = campfire, zone_teleport, zone_monolith, generator_
keep_fields         =           ; object names never put out (story anomalies), comma separated
sweep_ids           = 2048      ; ids the sweep of the Zone's artefacts looks at a frame (all 65534 at once froze the game)

; ---------------------------------------------------------------------------------------------------------------
; Пепельный фронт: fire hotspots in the Red Forest, the wind carries the ash to Yantar, Jupiter or Zaton; or the surge
; has shaken up the old machinery of the Truck Cemetery. The level's weather turns to ash, the background radiation
; there is deadly but in a sealed scientific suit, its people sit it out in a shelter, the other stalkers leave the
; level. Players may always go there. Only squads all in sealed suits (sealed_suits, by what they wear: never by their
; faction or their squad's name) take the level's smarts as targets or stay out in the ash.
[zone_event_ash]
enabled             = true
slot                = world
chance              = 0.2       ; the director's chance after a surge
cooldown_real_hours = 12        ; real hours since the last front ended before the director starts another
real_hours_min      = 3         ; how long it lasts, real hours
real_hours_max      = 4
levels              = l10_red_forest, l08_yantar, jupiter, zaton, k02_trucks_cemetery
weather             = w_zev_ash ; environment\weathers\w_zev_ash.ltx
buy_medical         = 1.2       ; anti-rad in demand
; the suits that keep the ash out: parts of the outfit's section (all SEVAs, SSP, the Base chemist's; not an exoskeleton)
sealed_suits        = scientific, ecolog_outfit, shelter_chemist_outfit
; a player out of cover without one: radiation rad_rate a second up to rad_max (0.15-0.3 within 5-10 s, the max in
; 20 s); past rad_harm_from the health goes by at least rad_health * radiation a second, what the engine's own radiation
; harm (per game second: radiation_health_v 0.0018 x the world's speed, x6) or anything else takes counting towards it.
; Death in about 90 s without anti-rad (health lost by t s: rad_health * (5.8 + rad_max * (t - 20)))
rad_rate            = 0.03
rad_max             = 0.6
rad_harm_from       = 0.1
rad_health          = 0.02
cover_rad_decay     = 0.02      ; radiation a second off in cover (the shelter's air): 0.6 gone in 30 s (~0.1 health on the way)
; anti-rad on the front's level: the ash's radiation and its health floor stop for antirad_pause_s real seconds (another
; one in the pause starts it over, no stacking; the engine's radiation and the drug's own boosts as usual). The items:
; Anomaly's dedicated anti-radiation drugs (radiation restore or protection is what they are for); not vodka, food,
; medkits (scientific/survival kits, Rebirth) or water tablets
antirad_items       = antirad, antirad_kalium, antirad_cystamine, drug_radioprotector
antirad_pause_s     = 60
; NPCs (the level's stalkers, not in a sealed suit: the outfit of their visual) out of cover lose health
; evenly from npc_harm_after_s and die npc_death_s real seconds after they were first out of it (each game the NPCs it
; runs; the shelter's people npc_walk_in_s later). Offline squads of the level out of the shelter are taken away after
; offline_death_min real minutes. Story NPCs, companions, players' stand-ins and immune_communities (e.g. zombied:
; Yantar's zombies would die out) never
npc_harm_after_s    = 5
npc_death_s         = 90
offline_death_min   = 8
immune_communities  = zombied
offline_shelter_radius = 40     ; metres: an offline squad of the shelter's smart this near it is in (online: only the covers)
npc_walk_in_s       = 60        ; real s more for the shelter's people (its smart's, or on their way in) to get into a cover
; going in: for the front the shelter's people who must hide (not sealed, not story) take only jobs of its smart that are
; in its covers (its surge jobs among them), as in an emission; those left over take hide_jobs walker jobs on the paths
; hide_paths_<level> (in the covers: checked against all.spawn). The front over: their own jobs again
hide_jobs           = 12
hide_paths_l10_red_forest      = red_smart_terrain_3_2_walker_1_walk, red_smart_terrain_3_2_collector_2_walk, red_smart_terrain_3_2_sleep_1
hide_paths_l08_yantar          = yan_smart_terrain_6_4_surge_1_walk, yan_smart_terrain_6_4_surge_2_walk, yan_smart_terrain_6_4_surge_3_walk, yan_smart_terrain_6_4_1_1_walk, yan_smart_terrain_6_4_2_2_walk, yan_smart_terrain_6_4_3_3_walk, yan_smart_terrain_6_4_4_4_walk, yan_smart_terrain_6_4_povarhide_1_walk
hide_paths_jupiter             = jup_a6_duty_guard_walk, jup_a6_duty_leader_walk, jup_a6_freedom_leader_walk
hide_paths_zaton               = zat_stalker_base_smart_garmata_4_walk, zat_stalker_base_smart_gonta_4_walk, zat_stalker_base_smart_zat_b33_stalker_snag_walk, zat_stalker_base_smart_b29_rival_leader_walk
hide_paths_k02_trucks_cemetery = trc_sim_20_surge_1_walk, trc_sim_20_surge_2_walk, trc_sim_20_surge_3_walk, trc_sim_20_surge_4_walk, trc_sim_20_guard_2_walk
; the service and story NPCs (traders, technicians, medics...) sit the front out in the shelter: a section per level,
; [zone_event_ash_service_<level>] below, a line per NPC. One with a place inside (home, cond) still out of the covers
; service_teleport_s real s after he was first seen out is put on his job's place in them, when no player is within
; service_unseen_m metres of him or of it
service_teleport_s  = 120
service_unseen_m    = 40
rescan_s            = 60        ; real s: the master sends squads that came onto the level since into cover or away
no_respawn          = true      ; the level's smarts respawn nobody for the front
; the shelters: a smart per level; its people (communities; none: all) go in for the front, back after
shelter_l10_red_forest      = red_smart_terrain_3_2     ; the cave (Sin)
shelter_communities_l10_red_forest = greh
shelter_l08_yantar          = yan_smart_terrain_6_4     ; the scientists' bunker
shelter_communities_l08_yantar = ecolog, stalker
shelter_jupiter             = jup_a6                    ; Yanov station
shelter_communities_jupiter = stalker, ecolog, freedom, dolg, csky
shelter_zaton               = zat_stalker_base_smart    ; Skadovsk and the barges
shelter_communities_zaton   = stalker, ecolog, freedom, dolg, csky
shelter_k02_trucks_cemetery = trc_sim_20                ; the bandits' building
shelter_communities_k02_trucks_cemetery = bandit
; the cover itself: Anomaly's surge covers of the shelter (space restrictors; misc\surge_manager.ltx). Inside one: no
; dose. None of them on the level: within cover_fallback_radius metres of the shelter's smart
shelter_covers_l10_red_forest      = red_smart_terrain_3_2_surge_hide_a1
shelter_covers_l08_yantar          = yan_smart_terrain_6_4_surge_hide_a1, yan_space_restrictor_no_weapon_actor_base_cut2
shelter_covers_jupiter             = jup_surge_hide_a6
shelter_covers_zaton               = zat_surge_hide_a2
shelter_covers_k02_trucks_cemetery = trc_sim_20_surge_hide_1, trc_sim_20_surge_hide_2, trc_sim_20_surge_hide_3, trc_sim_20_surge_hide_4
cover_fallback_radius = 10
sealed              = jupiter, zaton  ; shelters that let nobody in for the front, players neither
shelter_radius      = 60        ; metres from a sealed shelter's smart nobody walks into
; the other stalker squads on the level (not its shelter's people, not all in sealed suits) go to smarts (no bases) of the
; neighbouring levels for the front, back to their own after; a level with none listed: they stay
leave_l10_red_forest        = l07_military, l10_limansk, jupiter
leave_l08_yantar            = l06_rostok, l09_deadcity, l03_agroprom
leave_jupiter               = l10_red_forest, zaton
leave_zaton                 = jupiter
leave_k02_trucks_cemetery   = l04_darkvalley, l05_bar, l07_military
return_real_hours   = 2         ; real hours after the end the squads may take to get back to their smarts
albino_squads       =           ; albino mutant squads put on the level for the front (none yet: assets later)
; the ash settling on the ground (each game its own picture: the engine's ash pass, shaders/r3/ash_ground.h; DX11, not
; with MSAA). Its cover grows from 0 to 1 over ground_ramp_up_min real minutes of the front; after the front what has
; settled lies on for ground_linger_game_h game hours, fading as (1 - t) ^ ground_linger_curve. Under a roof it stays
; clean: near the camera (r3_dynamic_wet_surfaces_far) by the rain's view from above, farther by the surface's open
; sky (hemi)
ground_levels        = l10_red_forest, l08_yantar, jupiter, zaton ; not the Truck Cemetery (its front is machinery, no fire)
ground_ramp_up_min   = 20          ; real minutes from no ash to full
ground_linger_game_h = 60          ; game hours the ash lies on after the front (2.5 game days)
ground_linger_curve  = 1.5         ; how it fades: 1 evenly, above 1 quicker at first and a thin layer longer
ground_rain_wash     = 4           ; rain washes it off: a game second of rain (density 1) counts as this many of lying
ground_rain_sample_s = 30          ; real seconds between the master's looks at the rain (it adds it to the shared fact)
ground_opacity       = 0.85        ; the most the ash hides of a surface, 0..1
ground_gloss_keep    = 0.15        ; the surface's gloss left under full ash, 0..1
ground_patchiness    = 1           ; 0: everywhere at once; 1: in patches first (ground_patch_m), the rest later
ground_patch_m       = 6           ; the patches' size, metres
ground_color         = 0.42, 0.41, 0.40 ; the ash's albedo, r, g, b
ground_up            = 0.35, 0.8   ; how much a surface faces up (world normal.y): no ash at the first, full at the second
ground_sky           = 0.03, 0.2   ; open sky over a surface (its hemi): no ash at the first, full at the second
ground_flatten       = 0.6         ; how far full ash smooths a surface (turns its normal up), 0..1
ground_grain         = 0.36        ; how much the ash's albedo varies (fine grain), 0..1
; foliage (leaves, bushes, grass) and far tree LODs: their normals point every way and a crown shades itself from above
ground_flora_up       = -0.6, 0.5  ; world normal.y of a leaf: no ash at the first, full at the second
ground_flora_strength = 0.9        ; the most ash on foliage (x ground_opacity), 0..1
ground_flora_open     = 0.8        ; how much of the crown's own shade from above and its low hemi is ignored, 0..1
; tree trunks and branches (the trees' solid parts): their upper sides
ground_bark_up        = 0.0, 0.7   ; world normal.y of the bark: no ash at the first, full at the second
ground_bark_strength  = 0.8        ; the most ash on bark (x ground_opacity), 0..1
ground_grass_strength = 0.5        ; the most ash on grass (x the ground's), 0..1
ground_aref_strength  = 0.8        ; the most on alpha tested surfaces: willows' hanging foliage, nets, fences, 0..1

; ---------------------------------------------------------------------------------------------------------------
; The ash front's service and story NPCs, a section per level: <story id> = <how>
;   home                     his place is in the shelter's covers as it is (nothing is done; watched, see service_teleport_s)
;   cond, <conditions>       his own logic has a place inside (night, surge): the xr_conditions listed are forced for him
;                            while the front is on his level (name: true, !name: false), so it takes him there and back after
;   shelter                  his squad goes into the level's shelter with its people, he takes one of its hide jobs
;                            (hide_paths_<level>), invulnerable on it; back to his smart and his own job after
;   stay                     the fallback: stays where he is, the ash never hurts him (so does any story NPC not listed)
[zone_event_ash_service_l08_yantar]
yan_stalker_sakharov               = home                            ; the trader: never leaves the bunker
mechanic_army_yan_mlr              = cond, is_night, surge_started   ; the technician: his night place in the bunker
yan_povar_army_mlr                 = cond, is_night, surge_started   ; the barman: his night place in the bunker
yan_merc_01                        = stay                            ; the bunker's guards, in the scientists' suits
yan_merc_02                        = stay

; Co-op: the world's clock, weather and surges (src/xrGame/coop/coop_time.h, coop_time.script). Every game runs
; the server's game time; the sim master's game picks the weather and when surges and psi storms come.
[coop_time]
jumps                = alone ; sleep, the medic, a guide...: alone - the whole world's time jumps, but only while
                             ; nobody else is in the world (with others it doesn't jump); all - always; never
drift_tolerance_ms   = 250   ; real ms: how far our count may stray from the server's before we take its time
max_hold_s           = 120   ; game s: ahead of the world by less, our clock waits for it; by more, it goes back
reselect_weather_s   = 600   ; game s: a step of the clock this big (coming into the world, a jump) picks the weather again
hold_ms              = 3000  ; real ms: after our own jump, how long older news from the server are ignored
schedule_check_s     = 2     ; real s: how often weather and the surge/psi storm timetable are compared with the master's
debug_log_s          = 10    ; real s: how often the clock goes to the log with coop_debug 1

; Co-op: what a player leaves behind (coop_cleanup.script). As a player leaves the world or saves, bodies and boxes
; near them with good things are kept from the game's cleanup for a while; the host releases bodies with nothing
; worth taking. Times are the world's game hours; prices are the items' "cost".
[coop_cleanup]
protect_radius        = 50    ; m around where the player stood
protect_hours         = 24    ; game hours a body or box with good things is kept
valuable_price        = 3000  ; worth of its non-junk things (summed) from which a body or box is kept
max_kept              = 400   ; at most this many kept at once (the newest stay)
junk_price            = 300   ; a thing cheaper than this is junk
junk_condition        = 0.25  ; a thing worn below this is junk (seen only when it is online on the host)
junk_sections         =       ; comma-separated parts of section names that are always junk (empty mags...)
cleaner               = 1     ; 1: the host releases bodies with nothing worth taking; 0: it doesn't
clean_interval_s      = 300   ; real s between the host's cleaner passes
keep_bodies_per_level = 5     ; a level keeps this many bodies even with nothing on them
max_per_pass          = 10    ; at most this many released per level each pass
min_player_distance   = 200   ; m: no body this close to a player goes (on a player's level none go at all)

; Co-op: a player of these factions isn't hurt by the Brain Scorcher and the Miracle Machine (coop_psi.script). In
; story mode Anomaly turns both off for the whole game when one starts as one of them (ui_mm_faction_select,
; faction_psi_off); a shared world keeps them working and spares such a player in their own game instead: the psi
; zones and the killing restrictors whose logic checks one of the infos (those vanilla's switch gives), and the
; shelter's white zone at the Radar. Psi storms, controllers and other psi zones still work on them.
[coop_psi_immunity]
enabled  = true                    ; false: no one is immune
factions = monolith, greh, zombied ; the player's true faction (a faction change carries it)
infos    = bar_deactivate_radar_done, yan_labx16_switcher_primary_off, yan_labx16_switcher_1_off, yan_labx16_switcher_2_off, yan_labx16_switcher_3_off

; Co-op: coming back from a death (coop_death.script): with no own save the player stays as he is, with one a
; save loads that may have been made while something was killing him. What Anomaly's scripts keep of the actor
; themselves is put right: psi health (arszi_psy) full and its death scene off, no bleeding, no radiation, the HUD
; and controls back; needs worse than these are brought down to them.
[coop_rollback]
thirst_max  = 1440 ; actor_status_thirst's last_drink: above 2880 it takes health, from 7200 it can kill in forced sleep
sleep_max   = 5000 ; actor_status_sleep's last_sleep: above 6250 it takes stamina, from 9000 it forces sleep
satiety_min = 0.2  ; below satiety_critical (actor.ltx, 0.2) hunger takes health
settle_s    = 3    ; real s: back at the save point on the same level, all this once more then (a psi field still hits
            ; for a moment after one is gone from it)

; Co-op: a player's own autosave «авто» (coop_autosave.script): one per character, each new one in the old one's
; place, never touching manual saves or the exit save; in a group too it is the player's own. A lone death goes back
; to the newest of the player's own saves, this one counted. Made only when the player is safe: alive and up, health
; at least health_min, no menu, dialog or trade open, nobody fighting them and no hit for hit_quiet_s, not in a psi
; field or the shelter's white zone, no surge or psi storm; until then it waits.
[coop_autosave_personal]
enabled         = true  ; false: no autosaves at all
on_level_entry  = true  ; autosave on coming onto a level (a level change, joining, the world loading again)
entry_delay_s   = 10    ; real s after the level is in before the first try
entry_timeout_s = 300   ; real s: never safe in this long, no autosave for this level entry (0: wait as long as it takes)
interval_min    = 10    ; real minutes between autosaves while playing (0: none but on coming onto a level)
hit_quiet_s     = 15    ; real s since the last hit that hurt the player
health_min      = 0.3   ; at least this much health (0..1)
in_raid         = false ; true: autosaves on the raid's levels too
news            = true  ; a news line «Автосохранение» when it is made
news_ms         = 4000  ; how long the news line shows (real ms)

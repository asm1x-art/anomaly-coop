; Co-op: small things of the world that were each game's own, now the level's authority's or the server's

; the crows of a level (coop_crows.script): spawned by its authority only, shared; the others' crows fly as its
[coop_crows]
min_distance = 100 ; m: a crow appears no nearer than this to any player on the level (Anomaly's 100, to its actor)
send_ms      = 200 ; real ms: how often the authority tells the others where its crows fly

; pulse anomalies, the lightning out of the sky (coop_pulse_anomaly.script): one roll for the level as Anomaly makes for
; its one actor (bind_anomaly_field: by level and weather) in each 2 min slot of the server's clock, by whoever is the
; level's authority then (fact pulse_slot:<level>), around the level's players in turn; every game strikes the same
; ones at the same points and seconds
[coop_pulse_anomaly]
keep_s       = 30  ; real s: how long a pulse stays in the server's fact (its blow comes at 11.5 s)
late_s       = 5   ; real s: a pulse older than this when it reaches us (a join, a level change) isn't struck
peer_stale_s = 10  ; real s: a player not heard from for this long has no turn
look_ms      = 250 ; real ms: how often the fact is looked at

; when traders restock (coop_trader_restock.script): the world's game time is cut into periods, every trader restocks
; once in each (fact trader_restock:<id>: the last period), when the game that has it online first looks at it then;
; a join, a reconnect, a reload restocks nothing. Anomaly's own timer (the economy's "restock" hours) is not used in co-op
[coop_trader_restock]
interval_h = 72 ; game hours: a period (72 = every 3 game days; at x6 about 12 real hours)

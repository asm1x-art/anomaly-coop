// Artefact heat haze (models_artefact_fx_haze.s l_special, distortion buffer: xy offset round 127/255, z blur, a mix).
// The shell round the artefact (models_artefact_fx_haze.vs) wavers most at its middle and fades out at its edge.
#include "common.h"

uniform float4 bus_obj_artefact_fx4;	// x: how far out (m), y: strength, z: speed, 0 = off
uniform float4 bus_artefact_fx_clock;	// x: seconds, the same in every game of a co-op world

Texture2D s_distort;

struct v2p_afx
{
	float2 tc0	: TEXCOORD0;
	float3 nv	: TEXCOORD1;
	float3 pv	: TEXCOORD2;
};

float4 main(v2p_afx I) : SV_Target
{
	float4 H = bus_obj_artefact_fx4;
	if (H.y <= 0.f)
		return float4(127.f / 255.f, 127.f / 255.f, 0.f, 0.f);
	float3 N = normalize(I.nv);
	float3 V = normalize(-I.pv);
	float edge = saturate(abs(dot(N, V)));
	float t = bus_artefact_fx_clock.x * H.z;
	float2 uv = I.pv.xy * 1.7f + float2(0.f, -t);
	float2 d = s_distort.Sample(smp_linear, uv).xy - 0.5f;
	d += s_distort.Sample(smp_linear, uv * 0.6f + float2(t * 0.37f, 0.f)).xy - 0.5f;
	float a = saturate(H.y * edge * edge);
	return float4(127.f / 255.f + d * 0.5f, 0.f, a);
}

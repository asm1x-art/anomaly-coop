; Co-op: an artefact's ground particles, family electro, density 3 (generated by tools/artifact_fx/make_pe.py,
; change the numbers there and run it again). Electric: short arcs flicking round it. Additive sprites, artefact_fx.script keeps the
; emitter on the artefact while it lies near the player.
[_effect]
version = 1
max_particles = 9
flags = 5121
action_count = 5

[sprite]
shader = particles\add
texture = pfx\pfx_electrostatic

[frame]
tex_size = 0.25, 0.25
reserved = 0, 0
dim_x = 4
frame_count = 16
speed = 40

; KillOld
[action_0000]
action_type = 10
version = 1
action_name = killold
flags = 1
flt_0000 = 0.22 ; Age Limit
bool_0000 = off ; Kill Less Than

; Source
[action_0001]
action_type = 21
version = 1
action_name = source
flags = 1
flt_0000 = 0.044 ; Age Sigma
flt_0001 = 0 ; Color\Alpha
flt_0002 = 1 ; Parent Motion
flt_0003 = 25.2 ; Rate
flt_0004 = 0 ; Starting Age
bool_0000 = off ; Allow Rotate
bool_0001 = on ; Single Size

[domain_action_0001_0000] ; Color Point
type = 0
v0 = 0, 0, 0
v1 = 0, 0, 0
v2 = 0, 0, 0

[domain_action_0001_0001] ; Domain
type = 5
v0 = 0, 0.08, 0
v1 = 0.12, 0.3, 0
v2 = 0, 0, 0

[domain_action_0001_0002] ; Rotation Point
type = 0
v0 = 0, 0, 0
v1 = 0, 0, 0
v2 = 0, 0, 0

[domain_action_0001_0003] ; Size Line
type = 1
v0 = 0.07, 0.07, 0.07
v1 = 0.14, 0.14, 0.14
v2 = 0, 0, 0

[domain_action_0001_0004] ; Velocity
type = 0
v0 = 0, 0, 0
v1 = 0, 0, 0
v2 = 0, 0, 0

; TargetColor: glows up
[action_0002]
action_type = 23
version = 1
action_name = targetcolor
flags = 1
flt_0000 = 1 ; Alpha
flt_0001 = 4 ; Scale
flt_0002 = 0 ; TimeFrom
flt_0003 = 0.3 ; TimeTo
vec_0000 = 0.55, 0.75, 1 ; Color

; TargetColor: goes out
[action_0003]
action_type = 23
version = 1
action_name = targetcolor
flags = 1
flt_0000 = 0 ; Alpha
flt_0001 = 1.5 ; Scale
flt_0002 = 0.6 ; TimeFrom
flt_0003 = 1 ; TimeTo
vec_0000 = 0, 0, 0 ; Color

; Move
[action_0004]
action_type = 12
version = 1
action_name = move
flags = 1

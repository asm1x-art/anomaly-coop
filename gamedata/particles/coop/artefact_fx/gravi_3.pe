; Co-op: an artefact's ground particles, family gravi, density 3 (generated by tools/artifact_fx/make_pe.py,
; change the numbers there and run it again). Gravitational: dust motes pulled in and circling. Additive sprites, artefact_fx.script keeps the
; emitter on the artefact while it lies near the player.
[_effect]
version = 1
max_particles = 44
flags = 5121
action_count = 7

[sprite]
shader = particles\add
texture = pfx\snowo

[frame]
tex_size = 0.5, 0.5
reserved = 0, 0
dim_x = 2
frame_count = 4
speed = 6

; KillOld
[action_0000]
action_type = 10
version = 1
action_name = killold
flags = 1
flt_0000 = 2 ; Age Limit
bool_0000 = off ; Kill Less Than

; Source
[action_0001]
action_type = 21
version = 1
action_name = source
flags = 1
flt_0000 = 0.4 ; Age Sigma
flt_0001 = 0 ; Color\Alpha
flt_0002 = 1 ; Parent Motion
flt_0003 = 16.2 ; Rate
flt_0004 = 0 ; Starting Age
bool_0000 = off ; Allow Rotate
bool_0001 = on ; Single Size

[domain_action_0001_0000] ; Color Point
type = 0
v0 = 0, 0, 0
v1 = 0, 0, 0
v2 = 0, 0, 0

[domain_action_0001_0001] ; Domain
type = 5
v0 = 0, 0.1, 0
v1 = 0.3, 0.6, 0
v2 = 0, 0, 0

[domain_action_0001_0002] ; Rotation Point
type = 0
v0 = 0, 0, 0
v1 = 0, 0, 0
v2 = 0, 0, 0

[domain_action_0001_0003] ; Size Line
type = 1
v0 = 0.018, 0.018, 0.018
v1 = 0.035, 0.035, 0.035
v2 = 0, 0, 0

[domain_action_0001_0004] ; Velocity
type = 4
v0 = -0.05, -0.02, -0.05
v1 = 0.05, 0.08, 0.05
v2 = 0, 0, 0

; TargetColor: glows up
[action_0002]
action_type = 23
version = 1
action_name = targetcolor
flags = 1
flt_0000 = 1 ; Alpha
flt_0001 = 2.5 ; Scale
flt_0002 = 0 ; TimeFrom
flt_0003 = 0.3 ; TimeTo
vec_0000 = 0.85, 0.7, 1 ; Color

; TargetColor: goes out
[action_0003]
action_type = 23
version = 1
action_name = targetcolor
flags = 1
flt_0000 = 0 ; Alpha
flt_0001 = 1.5 ; Scale
flt_0002 = 0.6 ; TimeFrom
flt_0003 = 1 ; TimeTo
vec_0000 = 0, 0, 0 ; Color

; OrbitPoint: round the artefact
[action_0004]
action_type = 14
version = 1
action_name = orbitpoint
flags = 1
flt_0000 = 0.05 ; Epsilon
flt_0001 = 0.25 ; Magnitude
flt_0002 = 0.6 ; Max Radius
vec_0000 = 0, 0.15, 0 ; Center
bool_0000 = on ; Allow Rotate

; Damping: it doesn't fly off
[action_0005]
action_type = 4
version = 1
action_name = damping
flags = 1
flt_0000 = 1e+10 ; V High
flt_0001 = 0 ; V Low
vec_0000 = 0.97, 0.97, 0.97 ; Damping

; Move
[action_0006]
action_type = 12
version = 1
action_name = move
flags = 1

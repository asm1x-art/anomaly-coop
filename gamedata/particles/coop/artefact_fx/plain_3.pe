; Co-op: an artefact's ground particles, family plain, density 3 (generated by tools/artifact_fx/make_pe.py,
; change the numbers there and run it again). No nature: a few faint pale motes. Additive sprites, artefact_fx.script keeps the
; emitter on the artefact while it lies near the player.
[_effect]
version = 1
max_particles = 17
flags = 5121
action_count = 6

[sprite]
shader = particles\add
texture = pfx\coop\afx_dot

[frame]
tex_size = 1, 1
reserved = 0, 0
dim_x = 1
frame_count = 1
speed = 0

; KillOld
[action_0000]
action_type = 10
version = 1
action_name = killold
flags = 1
flt_0000 = 2.2 ; Age Limit
bool_0000 = off ; Kill Less Than

; Source
[action_0001]
action_type = 21
version = 1
action_name = source
flags = 1
flt_0000 = 0.44 ; Age Sigma
flt_0001 = 0 ; Color\Alpha
flt_0002 = 1 ; Parent Motion
flt_0003 = 5.4 ; Rate
flt_0004 = 0 ; Starting Age
bool_0000 = off ; Allow Rotate
bool_0001 = on ; Single Size

[domain_action_0001_0000] ; Color Point
type = 0
v0 = 0, 0, 0
v1 = 0, 0, 0
v2 = 0, 0, 0

[domain_action_0001_0001] ; Domain
type = 5
v0 = 0, 0.05, 0
v1 = 0.08, 0.3, 0
v2 = 0, 0, 0

[domain_action_0001_0002] ; Rotation Point
type = 0
v0 = 0, 0, 0
v1 = 0, 0, 0
v2 = 0, 0, 0

[domain_action_0001_0003] ; Size Line
type = 1
v0 = 0.02, 0.02, 0.02
v1 = 0.04, 0.04, 0.04
v2 = 0, 0, 0

[domain_action_0001_0004] ; Velocity
type = 4
v0 = -0.02, 0.04, -0.02
v1 = 0.02, 0.12, 0.02
v2 = 0, 0, 0

; TargetColor: glows up
[action_0002]
action_type = 23
version = 1
action_name = targetcolor
flags = 1
flt_0000 = 0.8 ; Alpha
flt_0001 = 2 ; Scale
flt_0002 = 0 ; TimeFrom
flt_0003 = 0.3 ; TimeTo
vec_0000 = 0.8, 0.9, 1 ; Color

; TargetColor: goes out
[action_0003]
action_type = 23
version = 1
action_name = targetcolor
flags = 1
flt_0000 = 0 ; Alpha
flt_0001 = 1.5 ; Scale
flt_0002 = 0.6 ; TimeFrom
flt_0003 = 1 ; TimeTo
vec_0000 = 0, 0, 0 ; Color

; Turbulence
[action_0004]
action_type = 30
version = 1
action_name = turbulence
flags = 1
flt_0000 = 0.01 ; Delta
flt_0001 = 0.6 ; Frequency
flt_0002 = 0.2 ; Magnitude
vec_0000 = 1, 1, 1 ; Movement
int_0000 = 1 ; Octaves

; Move
[action_0005]
action_type = 12
version = 1
action_name = move
flags = 1

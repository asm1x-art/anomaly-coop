; Co-op: the ash front's falling ash (coop_zone_ash_fx.script moves it with the camera and the wind): Anomaly's snow
; rezy\environment\effects\snow copied, dusk tone, ring 3 of five (radius 15..22 m round the emitter). Changed
; from the snow: colour (Source Color), alpha (Source Color\Alpha), how many (Source Rate a second; max_particles = rate
; x Age Limit), slower (Source Velocity), size (Source Size), born 8 m up (Source Domain Disc: centre, normal, radii),
; Age Limit (without collisions they fall on under the ground), no collisions (flags), Parent Motion 1: the script hands
; the weather's wind as the emitter's motion, so each flake drifts with it. A plain text file: change these numbers
; here; the game reads it at start.
[_effect]
version = 1
max_particles = 770
flags = 37889
action_count = 5

[sprite]
shader = particles\blend
texture = pfx\snowo

[frame]
tex_size = 0.5, 0.5
reserved = 0, 0
dim_x = 2
frame_count = 4
speed = 24

[align_to_path]
default_rotation = -1.570796, 0, 0

; KillOld
[action_0000]
action_type = 10
version = 1
action_name = killold
flags = 1
flt_0000 = 7 ; Age Limit
bool_0000 = off ; Kill Less Than

; Gravity
[action_0001]
action_type = 8
version = 1
action_name = gravity
flags = 0
vec_0000 = 0, -9.8, 0 ; Direction
bool_0000 = on ; Allow Rotate

; Move
[action_0002]
action_type = 12
version = 1
action_name = move
flags = 1

; Source
[action_0003]
action_type = 21
version = 1
action_name = source
flags = 1
flt_0000 = 0 ; Age Sigma
flt_0001 = 0.9 ; Color\Alpha
flt_0002 = 1 ; Parent Motion
flt_0003 = 110 ; Rate
flt_0004 = 0 ; Starting Age
bool_0000 = off ; Allow Rotate
bool_0001 = off ; Single Size

[domain_action_0003_0000] ; Color Point
type = 0
v0 = 0.15, 0.145, 0.135
v1 = 1, 1, 1
v2 = 1, 1, 1

[domain_action_0003_0001] ; Domain Disc
type = 9
v0 = 0, 8, 0
v1 = 0, 0.5, 0
v2 = 15, 22, 0

[domain_action_0003_0002] ; Rotation Point
type = 0
v0 = 3.141593, 0, 0
v1 = 0, 0, 0
v2 = 0, 0, 0

[domain_action_0003_0003] ; Size Point
type = 0
v0 = 0.25, 0.25, 0.25
v1 = 0, 0, 0
v2 = 0, 0, 0

[domain_action_0003_0004] ; Velocity Point
type = 0
v0 = 0, -1.6, 0
v1 = 0, 0, 0
v2 = 0, 0, 0

; Turbulence
[action_0004]
action_type = 30
version = 1
action_name = turbulence
flags = 1
flt_0000 = 0.01 ; Delta
flt_0001 = 0.6 ; Frequency
flt_0002 = 2 ; Magnitude
vec_0000 = 1, 1, 1 ; Movement
int_0000 = 1 ; Octaves

; Co-op: the ash front's embers (coop_zone_ash_fx.script moves it with the camera and the wind, as the falling ash):
; rare glowing sparks drifting round the player. Additive (particles\add: they glow, at any hour), the ash's own flake
; texture made tiny; each fades in, drifts with the wind (Parent Motion 1) and the turbulence and fades out. A plain
; text file: how many (Source Rate a second; max_particles = rate x Age Limit), where (Source Domain Box: the corners,
; metres round the emitter), colour (TargetColor of the first one), size (Source Size) can be changed here; the game
; reads it at start.
[_effect]
version = 1
max_particles = 40
flags = 5121
action_count = 6

[sprite]
shader = particles\add
texture = pfx\snowo

[frame]
tex_size = 0.5, 0.5
reserved = 0, 0
dim_x = 2
frame_count = 4
speed = 24

; KillOld
[action_0000]
action_type = 10
version = 1
action_name = killold
flags = 1
flt_0000 = 6 ; Age Limit
bool_0000 = off ; Kill Less Than

; Source
[action_0001]
action_type = 21
version = 1
action_name = source
flags = 1
flt_0000 = 0.3 ; Age Sigma
flt_0001 = 0 ; Color\Alpha
flt_0002 = 1 ; Parent Motion
flt_0003 = 6 ; Rate
flt_0004 = 0 ; Starting Age
bool_0000 = off ; Allow Rotate
bool_0001 = on ; Single Size

[domain_action_0001_0000] ; Color Point
type = 0
v0 = 0, 0, 0
v1 = 0, 0, 0
v2 = 0, 0, 0

[domain_action_0001_0001] ; Domain Box
type = 4
v0 = -10, 0, -10
v1 = 10, 6, 10
v2 = 0, 0, 0

[domain_action_0001_0002] ; Rotation Point
type = 0
v0 = 0, 0, 0
v1 = 0, 0, 0
v2 = 0, 0, 0

[domain_action_0001_0003] ; Size Line
type = 1
v0 = 0.08, 0.08, 0.08
v1 = 0.14, 0.14, 0.14
v2 = 0, 0, 0

[domain_action_0001_0004] ; Velocity Box
type = 4
v0 = -0.3, -0.5, -0.3
v1 = 0.3, 0.4, 0.3
v2 = 0, 0, 0

; TargetColor: glows up
[action_0002]
action_type = 23
version = 1
action_name = targetcolor
flags = 1
flt_0000 = 1 ; Alpha
flt_0001 = 4 ; Scale
flt_0002 = 0 ; TimeFrom
flt_0003 = 0.35 ; TimeTo
vec_0000 = 1, 0.42, 0.1 ; Color

; TargetColor: goes out
[action_0003]
action_type = 23
version = 1
action_name = targetcolor
flags = 1
flt_0000 = 0 ; Alpha
flt_0001 = 1.5 ; Scale
flt_0002 = 0.6 ; TimeFrom
flt_0003 = 1 ; TimeTo
vec_0000 = 0, 0, 0 ; Color

; Turbulence
[action_0004]
action_type = 30
version = 1
action_name = turbulence
flags = 1
flt_0000 = 0.01 ; Delta
flt_0001 = 0.8 ; Frequency
flt_0002 = 1.5 ; Magnitude
vec_0000 = 1, 1, 1 ; Movement
int_0000 = 1 ; Octaves

; Move
[action_0005]
action_type = 12
version = 1
action_name = move
flags = 1

-- The shelter's bar (docs/coop/shelter.md, "План развития", phase 2): it sells from the store, the room given that role
-- on the laptop's plan: whatever lies in the boxes there and is drink, food or smokes ([shelter_bar] kinds). One thing
-- every sell_hours game hours, picked at random, at its price times the markup set on the laptop; the money goes into
-- the till, a safe under the laptop's desk, as the game's money items (a wallet takes them as money). It sells while
-- nobody is in the shelter too: the boxes and the till are seen as the server keeps them. In co-op the world's
-- simulation master runs it; the time of the last sale, the till, the log and the takings are the world's.

local SETTINGS = "shelter_bar"
local LEVEL = "bunker_a1"
local DENOMINATIONS = { 5000, 1000, 500, 100, 50, 10 } -- money_<n>: a wallet takes each for exactly that much
local LOG_SIZE = 12
local CHECK_MS = 5000
local MOST_AT_ONCE = 48 -- sales caught up at most, after a long sleep or a time away

local cfg

local function settings()
	if not cfg then
		local kinds = {}
		for _, k in ipairs(str_explode(ini_sys:r_string_ex(SETTINGS, "kinds") or "i_food, i_drink", ",")) do
			kinds[k] = true
		end
		local till = str_explode(ini_sys:r_string_ex(SETTINGS, "till_pos"), ",")
		cfg = { kinds = kinds, sell_hours = ini_sys:r_float_ex(SETTINGS, "sell_hours") or 1,
			markup = ini_sys:r_float_ex(SETTINGS, "markup") or 1.1, markup_min = ini_sys:r_float_ex(SETTINGS, "markup_min") or 1,
			markup_max = ini_sys:r_float_ex(SETTINGS, "markup_max") or 3, markup_step = ini_sys:r_float_ex(SETTINGS, "markup_step") or 0.05,
			till = ini_sys:r_string_ex(SETTINGS, "till"), till_yaw = ini_sys:r_float_ex(SETTINGS, "till_yaw") or 0,
			till_pos = vector():set(tonumber(till[1]), tonumber(till[2]), tonumber(till[3])) }
	end
	return cfg
end

-- the game's time in seconds from the game's start (counted from year 0, a float can't tell one hour from the next);
-- in co-op each game has its own time
function now()
	return game.get_game_time():diffSec(level.get_start_time())
end

local function in_coop()
	return coop and coop.connected and coop.connected()
end

local function master()
	return not in_coop() or coop.is_sim_master()
end

-------------------------------------------------------------------------------
-- the store and the till

-- the store room's box (x0, x1, z0, z1), nil while no room is given the role
local function store_box()
	local room = shelter.state("room_store", nil)
	if not room then
		return nil
	end
	local box = str_explode(ini_file("scripts\\shelter\\rooms.ltx"):r_string_ex(room, "box") or "", ",")
	return #box == 4 and { tonumber(box[1]), tonumber(box[2]), tonumber(box[3]), tonumber(box[4]) } or nil, room
end

local function on_level(se)
	local sim, gg = alife(), game_graph()
	return sim:level_name(gg:vertex(se.m_game_vertex_id):level_id()) == LEVEL
end

-- the store's goods: { se, section, kind } of each, as the server has them (one pass over the objects, ~30 ms: the
-- boxes, and everything held by something, as an item can come before its box)
function stock()
	local box = store_box()
	local goods = {}
	if not box then
		return goods
	end
	local kinds, sim = settings().kinds, alife()
	local boxes, held = {}, {}
	for id = 1, 65534 do
		local se = sim:object(id)
		if se then
			if se.parent_id ~= 65535 then
				held[#held + 1] = se
			elseif IsInvbox(nil, se:clsid()) then
				local p = se.position
				if p.x >= box[1] and p.x <= box[2] and p.z >= box[3] and p.z <= box[4] and on_level(se) then
					boxes[id] = true
				end
			end
		end
	end
	for _, se in ipairs(held) do
		if boxes[se.parent_id] then
			local kind = SYS_GetParam(0, se:section_name(), "kind")
			if kinds[kind] then
				goods[#goods + 1] = { se = se, section = se:section_name(), kind = kind }
			end
		end
	end
	return goods
end

function markup()
	return shelter.state("bar_markup", nil) or settings().markup
end

function set_markup(v)
	local c = settings()
	v = math.floor(math.min(c.markup_max, math.max(c.markup_min, v)) * 100 + 0.5) / 100
	shelter.set_state("bar_markup", v)
	return v
end

function price(section)
	return math.floor((SYS_GetParam(2, section, "cost") or 0) * markup() + 0.5)
end

local function till()
	return alife_object(shelter.state("till_id", 65535))
end

-- the money in the till
function till_money()
	local t, sum = till(), 0
	if not t then
		return 0
	end
	local sim = alife()
	for id = 1, 65534 do
		local se = sim:object(id)
		if se and se.parent_id == t.id then
			sum = sum + (tonumber(string.match(se:section_name(), "^money_(%d+)$")) or 0)
		end
	end
	return sum
end

local function spawn_till()
	local c = settings()
	local lv = level.vertex_id(c.till_pos)
	local se = alife_create(c.till, c.till_pos, lv < 4294967295 and lv or db.actor:level_vertex_id(), db.actor:game_vertex_id())
	if se then
		se.angle = vector():set(0, c.till_yaw, 0)
		shelter.set_state("till_id", se.id)
	end
end

-------------------------------------------------------------------------------
-- the sales

-- the log: the newest first, { t = game second, section, price }
function sales()
	local list = {}
	for t, sec, p in string.gmatch(shelter.state("bar_log", "") or "", "([%d%.]+)|([^|;]+)|(%d+);?") do
		list[#list + 1] = { t = tonumber(t), section = sec, price = tonumber(p) }
	end
	return list
end

local function log_sale(t, section, p)
	local parts = { string.format("%d|%s|%d", t, section, p) }
	for i, s in ipairs(sales()) do
		if i >= LOG_SIZE then
			break
		end
		parts[#parts + 1] = string.format("%d|%s|%d", s.t, s.section, s.price)
	end
	shelter.set_state("bar_log", table.concat(parts, ";"))
end

-- the money into the till: as much as the money items make, the rest kept for the next sale
local function deposit(amount)
	local t = till()
	local pending = (shelter.state("till_pending", 0) or 0) + amount
	if t then
		for _, d in ipairs(DENOMINATIONS) do
			while pending >= d do
				alife_create_item("money_" .. d, t)
				pending = pending - d
			end
		end
	end
	shelter.set_state("till_pending", pending)
end

-- n sales, the n-th at game second t_last (the earlier ones an interval apart before it)
local function sell(n, t_last)
	local goods = stock()
	local hours = settings().sell_hours
	local takings = 0
	shelter.everyones(function()
		for i = 1, math.min(n, #goods) do
			local g = table.remove(goods, math.random(#goods))
			local p = price(g.section)
			alife_release(g.se)
			takings = takings + p
			log_sale(t_last - (n - i) * hours * 3600, g.section, p)
		end
		if takings > 0 then
			deposit(takings)
		end
	end)
	if takings > 0 then
		shelter.set_state("bar_total", (shelter.state("bar_total", 0) or 0) + takings)
	end
end

-- game seconds till the next sale, nil before the first
function next_sale_in()
	local last = shelter.state("bar_last", nil)
	return last and math.max(0, last + settings().sell_hours * 3600 - now()) or nil
end

local check_at = 0

local function actor_on_update()
	local ms = time_global()
	if ms < check_at then
		return
	end
	check_at = ms + CHECK_MS
	if not master() then
		return
	end
	local t, last = now(), shelter.state("bar_last", nil)
	local step = settings().sell_hours * 3600
	if not last or last > t then -- the first time; or (in co-op) this game's clock behind the one of the last sale
		shelter.set_state("bar_last", t)
		return
	end
	local n = math.floor((t - last) / step)
	if n < 1 then
		return
	end
	shelter.set_state("bar_last", last + n * step)
	if store_box() and till() then
		sell(math.min(n, MOST_AT_ONCE), last + n * step)
	end
end

local function actor_on_first_update()
	if level.name() == LEVEL and not shelter.state("till_id", nil) then
		shelter.once("till", spawn_till)
	end
end

function on_game_start()
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
	RegisterScriptCallback("actor_on_update", actor_on_update)
end

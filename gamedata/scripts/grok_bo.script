ini_bones		 = ini_file("creatures\\grok_bo_bone_profiles.ltx")
ini_damage		= ini_file("creatures\\damages.ltx")

local EXPLOSIVES = {
	explosive_barrel = true, explosive_barrel_low = true, explosive_tank = true, explosive_grenade = true,
	explosive_hide = true, explosive_particle = true, explosive_fuelcan = true, explosive_mobiltank = true,
	explosive_dinamit = true,
}

-- co-op: another player's shot hits here through their stand-in, which holds no gun; the engine keeps the weapon and
-- cartridge of the bullets that player's game sent just before the hit (coop.last_shot)
local COOP_SHOT_MAX_AGE = 3000

-- the shot behind a hit: weapon section, ammo section and the weapon object (nil for another player's shot); nil when
-- the hit is not a bullet of a player
local function shot_of(shit)
	local who = shit.draftsman
	if not who then
		return
	end
	if who:id() == db.actor:id() then
		local wpn = level.object_by_id(shit.weapon_id)
		if not wpn or EXPLOSIVES[wpn:section()] or IsGrenade(wpn) or not IsWeapon(wpn) or IsMelee(wpn) then
			return
		end
		local sec = wpn:section()
		local ammo_list = utils_item.get_ammo(sec, wpn:id())
		return sec, ammo_list[wpn:get_ammo_type() + 1], wpn
	end
	if coop and coop.connected and coop.connected() and coop.last_shot and who:section() == "coop_proxy"
		and shit.type == hit.fire_wound then
		local s = coop.last_shot(who:id())
		if s and s.age < COOP_SHOT_MAX_AGE and ini_sys:section_exist(s.weapon) and ini_sys:section_exist(s.ammo) then
			return s.weapon, s.ammo, nil
		end
	end
end

-- the barrel's state from the weapon's parts (1 for another player's gun, which isn't here)
local function barrel_of(wpn)
	if not wpn then
		return 1
	end
	local parts = se_load_var(wpn:id(), wpn:name(), "parts")
	if parts ~= nil then
		for k, v in pairs(parts) do
			if string.find(k, "barrel") then
				return v / 100
			end
		end
	end
	return 1
end


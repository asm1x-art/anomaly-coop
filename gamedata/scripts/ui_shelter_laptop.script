-- The laptop's desktop (docs/coop/shelter.md, "План развития", phase 1): a modern dark system on the Chemist's laptop,
-- its look ui_shelter_style.script's. Its shortcuts open programs in a window over the desktop; the taskbar has the
-- start button (its menu shuts the laptop down), the open program and the game's time and date. Clicks and the hover
-- are found by the cursor. Laid out in square units: the screen is that many wide (1024 on 4:3, more on a wide one)
-- and 768 high, squeezed into the interface's 1024 across, so the plan, the icons and the marks keep their shape.
-- Programs: the shelter's plan (the rooms by state, what is where, who is in; a room picked shows its card, where it
-- can be given a role, the world's), the trade (ui_shelter_trade.script: the trade, its store, the supply, the contracts), the synthesis
-- chambers and their journal (shelter_synthesis.script), the cleaning and, once the Brain Scorcher is off, the raid
-- (raid.script: the raid's maps, the landing, the start).

local XML = "ui_shelter_laptop.xml"
local SCREEN = { h = 768 } -- w: the screen's width in square units, set as the laptop opens
local TASKBAR = 48
local C = ui_shelter_style.C
local TOP = ui_shelter_style.TITLE_H + 12 -- a window's content from here down
local LEFT = 128 -- the windows keep right of the shortcuts
local APPS = { { "plan", "st_shelter_app_plan" }, { "trade", "st_shelter_app_trade" }, { "synth", "st_shelter_app_synth" },
	{ "clean", "st_shelter_app_clean" }, { "raid", "st_shelter_app_raid", when = function() return raid.available() end } }
local ROOM_TINT = { blocked = { 150, 0, 0, 0 }, dirty = { 46, 240, 180, 70 } } -- alpha, r, g, b; a clean one: none
local MARKS = { -- the shelter's things on the plan: the state keeping its object's id, its mark
	{ state = "generator_id", mark = "generator" },
	{ state = "laptop_id", mark = "laptop" },
	{ state = "stash_id", mark = "stash" },
	{ state = "chamber_panel_gravi", mark = "chamber" },
	{ state = "chamber_panel_thermo", mark = "chamber" },
	{ state = "chamber_panel_chem", mark = "chamber" },
	{ state = "chamber_panel_electro", mark = "chamber" },
}
local LEGEND = { "generator", "laptop", "stash", "chamber", "lift", "gate", "me", "friend" }
-- the plan's floors, top down: each with its plan's section; what stands on a floor for good, where
local FLOORS = { { id = "top", plan = "plan_top" }, { id = "mid", plan = "plan_main" }, { id = "low", plan = "plan_low" } }
local FIXED_MARKS = {
	{ floor = "top", x = 2.09, z = 30.7, mark = "lift" },
	{ floor = "mid", x = 2.33, z = 31.4, mark = "lift" },
	{ floor = "mid", x = -2.91, z = -16.3, mark = "lift" },
	{ floor = "low", x = -20.67, z = -4.4, mark = "lift" },
	{ floor = "low", x = -41.82, z = -7.52, mark = "gate" },
}
local ROLES = { "store" } -- what a room can be made, in its card's order
local BUNKER = "bunker_a1"

GUI = nil -- the laptop open (the game's hide_hud_all closes it by this name)

local function tr(id, ...)
	return select("#", ...) > 0 and string.format(game.translate_string(id), ...) or game.translate_string(id)
end

local function inside(p, r)
	return p.x >= r[1] and p.x < r[1] + r[3] and p.y >= r[2] and p.y < r[2] + r[4]
end

-------------------------------------------------------------------------------
-- the plan's data: the texture and the world's box on it (tools\shelter\plan.py), the rooms

local plans, rooms

-- the floor a height in the bunker is on
local function floor_of(y)
	return y > 11 and "top" or y < -12 and "low" or "mid"
end

local function load_plan()
	if plans then
		return
	end
	local ini = ini_file("scripts\\shelter\\plan.ltx")
	plans = {}
	for _, f in ipairs(FLOORS) do
		local s = f.plan
		plans[f.id] = { texture = ini:r_string_ex(s, "texture"), w = ini:r_float_ex(s, "width"), h = ini:r_float_ex(s, "height"),
			x0 = ini:r_float_ex(s, "x0"), x1 = ini:r_float_ex(s, "x1"), z0 = ini:r_float_ex(s, "z0"), z1 = ini:r_float_ex(s, "z1") }
	end
	rooms = {}
	ini = ini_file("scripts\\shelter\\rooms.ltx")
	for i = 0, ini:line_count("rooms") - 1 do
		local _, id = ini:r_line_ex("rooms", i, "", "")
		local box = str_explode(ini:r_string_ex(id, "box"), ",")
		local roles = {}
		for _, role in ipairs(str_explode(ini:r_string_ex(id, "roles") or "", ",")) do
			roles[role] = true
		end
		rooms[#rooms + 1] = { id = id, name = ini:r_string_ex(id, "name"), zone = ini:r_string_ex(id, "zone"), roles = roles,
			floor = ini:r_string_ex(id, "floor") or "mid",
			box = { tonumber(box[1]), tonumber(box[2]), tonumber(box[3]), tonumber(box[4]) } }
	end
	-- the small rooms before the halls they sit in (the ini's lines don't come in the file's order)
	local function area(r)
		return (r.box[2] - r.box[1]) * (r.box[4] - r.box[3])
	end
	table.sort(rooms, function(a, b) return area(a) < area(b) end)
end

-- a room's name: the one the group gave it, else its own
local function room_title(room)
	local own = shelter.state("room_title_" .. room.id, nil)
	return own and tostring(own) or tr(room.name)
end

-- a room's state: as its cleaning zone; one with no zone is just open
local function room_state(room)
	return room.zone and shelter.zone_state(room.zone) or "open"
end

-- a room's role, the world's: the room each role is given to
local function role_of(room)
	for _, role in ipairs(ROLES) do
		if shelter.state("room_" .. role, nil) == room.id then
			return role
		end
	end
end

-------------------------------------------------------------------------------
-- the desktop

class "UIShelterOS" (CUIScriptWnd)
ui_shelter_style.apply(UIShelterOS)

function UIShelterOS:__init() super()
	self.k = utils_xml.screen_ratio() -- a square unit across, in the interface's units
	SCREEN.w = math.floor(1024 / self.k + 0.5)
	self:SetWndRect(Frect():set(0, 0, 1024, SCREEN.h))
	self:SetAutoDelete(true)
	self.xml = CScriptXmlInit()
	self.xml:ParseFile(XML)
	self.clicks = {} -- the desktop's and the taskbar's: { x, y, w, h, f, hover = its light }
	self.app_clicks = {}
	self.menu_clicks = nil
	self:image(0, 0, SCREEN.w, SCREEN.h, "ui\\shelter\\laptop_wallpaper", self)
	self:image(math.floor(SCREEN.w / 2 - 200), math.floor((SCREEN.h - TASKBAR) / 2 - 160), 400, 300,
		"ui\\shelter\\laptop_logo", self)
	self:shortcuts()
	self:taskbar()
end

-- the cursor in square units
function UIShelterOS:cursor()
	local p = GetCursorPosition()
	return vector2():set(p.x / self.k, p.y)
end

-- a click's list entry for a part drawn in a window at the window's x, y (the clicks are in the screen's frame)
function UIShelterOS:click_at(list, x, y, w, h, f, hover, tag)
	local c = { self.wx + x, self.wy + y, w, h, f, hover = hover }
	if tag then
		c[tag] = true
	end
	list[#list + 1] = c
	return c
end

function UIShelterOS:shortcuts()
	local i = 0
	for _, app in ipairs(APPS) do
		if not app.when or app.when() then
			i = i + 1
			local y = 16 + (i - 1) * 104
			local hb = self:hover_of(12, y, 104, 98, self, 8)
			self:image(36, y + 8, 56, 56, "ui\\shelter\\laptop_icon_" .. app[1], self)
			self:text(13, y + 67, 104, 26, tr(app[2]), C.black, self, CGameFont.alCenter, "s") -- a shadow under the name
			self:text(12, y + 66, 104, 26, tr(app[2]), C.text, self, CGameFont.alCenter, "s")
			self.clicks[#self.clicks + 1] = { 12, y, 104, 98, function() self:open(app[1]) end, hover = hb }
		end
	end
end

function UIShelterOS:taskbar()
	local y = SCREEN.h - TASKBAR
	self:rect(0, y, SCREEN.w, TASKBAR, C.bar, self, 235)
	self:rect(0, y, SCREEN.w, 1, C.line, self)
	local hb = self:hover_of(6, y + 4, 44, 40, self, 6)
	self:image(16, y + 12, 24, 24, "ui\\shelter\\os_start", self, C.accent)
	self.clicks[#self.clicks + 1] = { 6, y + 4, 44, 40, function() self:toggle_menu() end, hover = hb,
		start = true }
	self.clock = self:text(SCREEN.w - 150, y + 3, 136, 22, "", C.text, self, CGameFont.alRight, "s")
	self.date = self:text(SCREEN.w - 150, y + 23, 136, 22, "", C.dim, self, CGameFont.alRight, "s")
	self.task = nil
	self:tick()
end

function UIShelterOS:tick()
	self.clock:SetText(string.format("%02d:%02d", level.get_time_hours(), level.get_time_minutes()))
	local y, m, d = game.get_game_time():get()
	self.date:SetText(string.format("%02d.%02d.%d", d, m, y))
end

function UIShelterOS:toggle_menu()
	if self.menu then
		self:DetachChild(self.menu)
		self.menu, self.menu_clicks = nil, nil
		return
	end
	local w, h = 290, 148
	local x, y = 6, SCREEN.h - TASKBAR - h - 8
	self.menu = self:box(x, y, w, h, self)
	for i = 3, 1, -1 do
		self:round(-2 * i, 3 - i, w + 4 * i, h + 4 * i, C.black, self.menu, 10 + 2 * i, 18)
	end
	self:framed(0, 0, w, h, C.surface, self.menu, 10)
	self:image(18, 18, 36, 36, "ui\\shelter\\os_start", self.menu, C.accent)
	self:text(68, 14, w - 80, 26, tr("st_shelter_os_user"), C.text, self.menu)
	self:text(68, 38, w - 80, 20, tr("st_shelter_os_name"), C.dim, self.menu, nil, "s")
	self:rect(12, 72, w - 24, 1, C.line, self.menu)
	self.menu_clicks = {}
	local hb = self:hover_of(8, 84, w - 16, 52, self.menu, 6)
	self:image(22, 98, 24, 24, "ui\\shelter\\os_power", self.menu, C.text)
	self:text(60, 84, w - 72, 52, tr("st_shelter_os_shutdown"), C.text, self.menu)
	self.menu_clicks[1] = { x + 8, y + 84, w - 16, 52, function() self:Close() end, hover = hb }
end

-------------------------------------------------------------------------------
-- a program's window; on the taskbar its icon and name, marked as open

function UIShelterOS:open(app)
	self:close_app()
	if self.menu then
		self:toggle_menu()
	end
	self.app = app
	self["open_" .. app](self)
	local y = SCREEN.h - TASKBAR
	self.task = self:box(58, y + 4, 210, 40, self)
	self:round(0, 0, 210, 40, C.white, self.task, 6, 14)
	self:image(10, 9, 22, 22, "ui\\shelter\\laptop_icon_" .. app, self.task)
	self:text(42, 0, 160, 40, tr("st_shelter_app_" .. app), C.text, self.task, nil, "s")
	self:round(85, 36, 40, 3, C.accent, self.task, 1)
end

function UIShelterOS:close_app()
	if self.win then
		self:DetachChild(self.win)
		self:DetachChild(self.task)
	end
	self.win, self.task, self.app, self.app_clicks, self.app_update = nil, nil, nil, {}, nil
	self.raid_dragging, self.raid_press, self.raid_card_box, self.raid_edit = nil, nil, nil, nil
end

-- the window: its frame, title (the program's) and close box; its place kept for the clicks
function UIShelterOS:window(x, y, w, h, app)
	self.wx, self.wy = x, y
	self.win = self:chrome(x, y, w, h, tr("st_shelter_app_" .. app), "ui\\shelter\\laptop_icon_" .. app, self,
		self.app_clicks, x, y, function() self:close_app() end)
	return self.win
end

-- a window's width as asked, less on a narrow screen, and its x: in the middle right of the shortcuts
function UIShelterOS:fit(w)
	w = math.min(w, SCREEN.w - LEFT - 8)
	return w, math.max(LEFT, math.floor((SCREEN.w - w) / 2))
end

-------------------------------------------------------------------------------
-- the shelter's plan

function UIShelterOS:to_plan(x, z)
	local p, plan = self.plan_area, plans[self.plan_floor]
	return p.x + (x - plan.x0) / (plan.x1 - plan.x0) * p.w, p.y + (plan.z1 - z) / (plan.z1 - plan.z0) * p.h
end

function UIShelterOS:room_rect(room)
	local u0, v0 = self:to_plan(room.box[1], room.box[4])
	local u1, v1 = self:to_plan(room.box[2], room.box[3])
	return u0, v0, u1 - u0, v1 - v0
end

function UIShelterOS:mark(x, z, kind, win)
	local u, v = self:to_plan(x, z)
	self:image(u - 9, v - 9, 18, 18, "ui\\shelter\\laptop_mark_" .. kind, win)
end

function UIShelterOS:open_plan()
	load_plan()
	local W, x = self:fit(900)
	local H = 704
	local win = self:window(x, 8, W, H, "plan")
	-- the floor: as asked by its button, else the one one stands on
	local here = level.name() == BUNKER and floor_of(db.actor:position().y) or nil
	self.plan_floor = self.plan_next or here or "mid"
	self.plan_next = nil
	local plan = plans[self.plan_floor]
	for i, f in ipairs(FLOORS) do
		self:button(14 + (i - 1) * 128, TOP, 120, 34, tr("st_shelter_floor_" .. f.id), function()
			self.plan_next = f.id
			self:open("plan")
		end, self.app_clicks, win, x, 8, f.id == self.plan_floor and "primary" or "normal")
	end
	-- the plan fills its place, its shape kept: the tall middle floor by the height, the long lower one by the width
	local py = TOP + 42
	local ph, pw = H - py - 14, W - 14 - 16 - 14 - 250
	local k = math.min(ph / plan.h, pw / plan.w)
	self.plan_area = { x = 14, y = py, w = math.floor(plan.w * k), h = math.floor(plan.h * k) }
	local a = self.plan_area
	self:round(a.x - 1, a.y - 1, a.w + 2, a.h + 2, C.border, win, 4)
	self:image(a.x, a.y, a.w, a.h, plan.texture, win)
	-- the rooms by state
	for _, room in ipairs(rooms) do
		local tint = room.floor == self.plan_floor and ROOM_TINT[room_state(room)]
		if tint then
			local rx, ry, rw, rh = self:room_rect(room)
			self:rect(rx, ry, rw, rh, { tint[2], tint[3], tint[4] }, win, tint[1])
		end
		-- the names the group gave are written on the plan
		local own = room.floor == self.plan_floor and shelter.state("room_title_" .. room.id, nil)
		if own then
			local rx, ry, rw = self:room_rect(room)
			self:text(rx + 3, ry + 2, rw - 6, 20, tostring(own), C.text, win, nil, "s")
		end
	end
	-- what is where, who is in
	for _, m in ipairs(MARKS) do
		local se = alife_object(shelter.state(m.state, 65535))
		if se and floor_of(se.position.y) == self.plan_floor then
			self:mark(se.position.x, se.position.z, m.mark, win)
		end
	end
	for _, m in ipairs(FIXED_MARKS) do
		if m.floor == self.plan_floor then
			self:mark(m.x, m.z, m.mark, win)
		end
	end
	if here == self.plan_floor then
		self:mark(db.actor:position().x, db.actor:position().z, "me", win)
	end
	if coop and coop.connected and coop.connected() then
		local group = {}
		for _, name in ipairs(coop.group()) do
			group[name] = true
		end
		for _, peer in ipairs(coop.peers()) do
			if group[peer.name] and peer.level == BUNKER and floor_of(peer.position.y) == self.plan_floor then
				self:mark(peer.position.x, peer.position.z, "friend", win)
				local u, v = self:to_plan(peer.position.x, peer.position.z)
				self:text(u + 10, v - 10, 120, 20, peer.name, C.text, win, nil, "s")
			end
		end
	end
	-- the hover and the pick, over the rooms
	self.room_hover = self:rect(0, 0, 1, 1, C.accent, win, 40)
	self.room_hover:Show(false)
	self.pick = {}
	for i = 1, 4 do
		self.pick[i] = self:rect(0, 0, 1, 1, C.accent, win)
		self.pick[i]:Show(false)
	end
	self.card_x = a.x + a.w + 16
	self.card_w = W - self.card_x - 14
	self.card_y, self.card_h = py, H - py - 14
	self.card = nil
	self:show_card(nil)
	self.app_update = self.update_plan
	self.app_clicks[#self.app_clicks + 1] = { self.wx + a.x, self.wy + a.y, a.w, a.h, function(p) self:pick_room(p) end }
end

function UIShelterOS:room_at(p)
	local a = self.plan_area
	if not inside(p, { self.wx + a.x, self.wy + a.y, a.w, a.h }) then
		return nil
	end
	for _, room in ipairs(rooms) do
		if room.floor == self.plan_floor then
			local x, y, w, h = self:room_rect(room)
			if inside(p, { self.wx + x, self.wy + y, w, h }) then
				return room
			end
		end
	end
end

function UIShelterOS:update_plan()
	local room = self:room_at(self:cursor())
	if room ~= self.hovered then
		self.hovered = room
		if room then
			self:place(self.room_hover, self:room_rect(room))
		end
		self.room_hover:Show(room and true or false)
	end
end

function UIShelterOS:pick_room(p)
	local room = self:room_at(p)
	if room then
		local x, y, w, h = self:room_rect(room)
		local sides = { { x, y, w, 2 }, { x, y + h - 2, w, 2 }, { x, y, 2, h }, { x + w - 2, y, 2, h } }
		for i, s in ipairs(sides) do
			self:place(self.pick[i], s[1], s[2], s[3], s[4])
			self.pick[i]:Show(true)
		end
	end
	self:show_card(room)
end

-- the card of the room picked: its name, state, role and what it can be made; the legend under it
function UIShelterOS:show_card(room)
	if self.card then
		self.win:DetachChild(self.card)
	end
	-- the card's buttons go: the plan's own click stays first
	for i = #self.app_clicks, 1, -1 do
		if self.app_clicks[i].card then
			table.remove(self.app_clicks, i)
		end
	end
	local x, y, w, h = self.card_x, self.card_y, self.card_w, self.card_h
	local card = self:box(x, y, w, h, self.win)
	self.card = card
	self:framed(0, 0, w, h, C.raised, card, 8)
	local pad = 16
	if not room then
		self:text(pad, pad, w - 2 * pad, 48, tr("st_shelter_plan_hint"), C.dim, card)
	else
		self:text(pad, 12, w - 2 * pad, 34, room_title(room), C.text, card, nil, "l")
		local state = room_state(room)
		local state_color = state == "blocked" and C.bad or state == "dirty" and C.warn or C.good
		self:round(pad, 54, 10, 10, state_color, card, 5)
		self:text(pad + 18, 46, w - 2 * pad - 18, 26,
			tr(state == "blocked" and room.floor ~= "mid" and "st_shelter_room_state_no_lift" or "st_shelter_room_state_" .. state), C.text, card)
		local role = role_of(room)
		self:text(pad, 74, w - 2 * pad, 26, tr("st_shelter_room_role", tr("st_shelter_role_" .. (role or "none"))), C.dim, card)
		local by = 112
		for _, r in ipairs(ROLES) do
			if room.roles[r] then
				if role == r then
					self:button(pad, by, w - 2 * pad, 34, tr("st_shelter_room_unassign"), function()
						shelter.set_state("room_" .. r, nil)
						self:show_card(room)
					end, self.app_clicks, card, self.wx + x, self.wy + y).card = true
				elseif state == "blocked" then
					self:text(pad, by, w - 2 * pad, 34, tr("st_shelter_room_blocked_" .. r), C.faint, card)
				else
					self:button(pad, by, w - 2 * pad, 34, tr("st_shelter_room_make_" .. r), function()
						for _, other in ipairs(ROLES) do -- a room has one role
							if shelter.state("room_" .. other, nil) == room.id then
								shelter.set_state("room_" .. other, nil)
							end
						end
						shelter.set_state("room_" .. r, room.id)
						self:show_card(room)
					end, self.app_clicks, card, self.wx + x, self.wy + y, "primary").card = true
				end
				by = by + 44
			end
		end
		-- its name: empty gives its own back
		self:text(pad, by, w - 2 * pad, 24, tr("st_shelter_room_rename"), C.dim, card, nil, "s")
		by = by + 26
		self:framed(pad, by, w - 2 * pad, 36, C.field, card, 6)
		local edit = self.xml:InitEditBox("edit", card)
		self:place(edit, pad + 8, by + 5, w - 2 * pad - 16, 26)
		local own = shelter.state("room_title_" .. room.id, nil)
		if own then
			edit:SetText(tostring(own))
		end
		self:click_at(self.app_clicks, x + pad, y + by, w - 2 * pad, 36, function() edit:CaptureFocus(true) end, nil, "card").edit = edit
		by = by + 44
		self:button(pad, by, w - 2 * pad, 34, tr("st_shelter_room_rename_save"), function()
			local text = trim(edit:GetText() or "")
			shelter.set_state("room_title_" .. room.id, text ~= "" and text or nil)
			self.plan_next = self.plan_floor
			self:open("plan")
			self:show_card(room)
		end, self.app_clicks, card, self.wx + x, self.wy + y).card = true
	end
	-- the legend
	local ly = h - #LEGEND * 26 - 14
	self:rect(pad, ly - 12, w - 2 * pad, 1, C.line, card)
	for i, kind in ipairs(LEGEND) do
		self:image(pad, ly + (i - 1) * 26 + 4, 18, 18, "ui\\shelter\\laptop_mark_" .. kind, card)
		self:text(pad + 28, ly + (i - 1) * 26, w - 2 * pad - 28, 26, tr("st_shelter_mark_" .. kind), C.dim, card, nil, "s")
	end
end

-------------------------------------------------------------------------------
-- the trade: a full-screen program of its own (ui_shelter_trade.script)

-- a room's name by its id, for the program
function UIShelterOS:room_name(id)
	load_plan()
	for _, r in ipairs(rooms) do
		if r.id == id then
			return room_title(r)
		end
	end
end

-- the name of the room a point is in, nil outside them all
function UIShelterOS:room_name_at(pos)
	load_plan()
	local floor = pos.y > 12 and "top" or pos.y < -10 and "low" or "mid"
	for _, r in ipairs(rooms) do
		if r.floor == floor and pos.x >= r.box[1] and pos.x <= r.box[2] and pos.z >= r.box[3] and pos.z <= r.box[4] then
			return room_title(r)
		end
	end
end

function UIShelterOS:open_trade()
	ui_shelter_trade.open(self, SCREEN.w, SCREEN.h - TASKBAR)
end

-------------------------------------------------------------------------------
-- the synthesis (shelter_synthesis.script): each chamber's state (since when it works and on what, or what lies in its
-- cell; how long it has left, never), and two tabs: the journal of every load made, newest first (all of it, the
-- artefacts made or the stones, each load once), and the recipes (the Chemist's, then each load that made an artefact,
-- as first made); either found by a word of a thing's, a chamber's or a name

local SYNTH = { natures = { "gravi", "thermo", "chem", "electro" }, card_h = 124, row_h = 38, search_y = TOP + 172,
	head_y = TOP + 214, list_y = TOP + 240 }
local FILTERS = { "all", "made", "stone" }
local TABS = { "journal", "recipes" }

-- cp1251's letters to lower case, for the search
local function lower(s)
	return (string.gsub(string.lower(s), "[\192-\223\168]", function(c)
		local b = string.byte(c)
		return string.char(b == 168 and 184 or b + 32)
	end))
end

local function synth_name(sec)
	return sec == shelter_synthesis.STONE and tr("st_shelter_synth_stone_name") or ui_item.get_sec_name(sec)
end

function UIShelterOS:open_synth()
	local W, x = self:fit(960)
	local H = 712
	local win = self:window(x, 6, W, H, "synth")
	self.synth = { w = W, h = H, tab = "journal", filter = "all", page = 1, word = "" }
	-- the search: a field with its glyph, the edit box over it (kept while the body below is drawn again)
	local sy = SYNTH.search_y
	self:framed(18, sy, 330, 34, C.field, win, 6)
	self:image(28, sy + 9, 16, 16, "ui\\shelter\\os_search", win, C.dim)
	local edit = self.xml:InitEditBox("edit", win)
	self:place(edit, 52, sy + 4, 288, 26)
	self.synth.edit = edit
	self:click_at(self.app_clicks, 18, sy, 330, 34, function() edit:CaptureFocus(true) end)
	self:fill_synth()
	self.app_update = self.update_synth
end

function UIShelterOS:update_synth()
	local word = lower(self.synth.edit:GetText() or "")
	if word ~= self.synth.word then
		self.synth.word, self.synth.page = word, 1
		self:fill_synth()
		return
	end
	local now = time_global()
	if now < (self.synth.at or 0) then
		return
	end
	self.synth.at = now + 1000
	self:fill_synth(true)
end

-- the tab as shown, found: the journal filtered, each load once but in "all"; the recipes: the Chemist's, then the
-- loads that made an artefact, each once, oldest first (who made it first)
function UIShelterOS:synth_rows()
	local rows, seen = {}, {}
	local list, f, word = shelter_synthesis.journal(), self.synth.filter, self.synth.word
	if self.synth.tab == "recipes" then
		local journal = list
		list, f = shelter_synthesis.chemist_recipes(), "made"
		for i = #journal, 1, -1 do
			list[#list + 1] = journal[i]
		end
	end
	for _, e in ipairs(list) do
		local stone = e.result == shelter_synthesis.STONE
		local k = e.nature .. ":" .. shelter_synthesis.key(e.parts)
		local ok = f == "all" or (f == "stone") == stone and not seen[k]
		if ok and word ~= "" then
			local names = { tr("st_shelter_synth_short_" .. e.nature), synth_name(e.result), e.who or "" }
			for _, s in ipairs(e.parts) do
				names[#names + 1] = synth_name(s)
			end
			ok = string.find(lower(table.concat(names, "\n")), word, 1, true) ~= nil
		end
		seen[k] = true
		if ok then
			rows[#rows + 1] = e
		end
	end
	return rows
end

-- the window's body: the chambers, the filters and a page of the journal (only_if_changed: drawn again only when the
-- chambers or the journal have changed, the elapsed times put right each second)
function UIShelterOS:fill_synth(only_if_changed)
	local s = self.synth
	local states, sig = {}, {}
	for i, n in ipairs(SYNTH.natures) do
		states[i] = shelter_synthesis.status(n)
		local st = states[i]
		sig[#sig + 1] = tostring(st.installed) .. (st.what or "") .. (st.result or "") .. table.concat(st.parts or {}, ",")
	end
	local journal = shelter_synthesis.journal()
	sig[#sig + 1] = #journal
	sig = table.concat(sig, "|")
	if only_if_changed and sig == s.sig then
		for i, st in ipairs(states) do
			if s.elapsed[i] and st.elapsed then
				s.elapsed[i]:SetText(tr("st_shelter_synth_card_making", shelter_synthesis.duration_text(st.elapsed)))
			end
		end
		return
	end
	s.sig = sig
	if s.body then
		self.win:DetachChild(s.body)
	end
	for i = #self.app_clicks, 1, -1 do -- the old body's buttons
		if self.app_clicks[i].synth then
			table.remove(self.app_clicks, i)
		end
	end
	local W, H, pad = s.w, s.h, 18
	local body = self:box(0, 0, W, H, self.win)
	s.body = body
	-- the chambers
	s.elapsed = {}
	local cw = math.floor((W - 2 * pad - 3 * 12) / 4)
	for i, n in ipairs(SYNTH.natures) do
		local st, cx = states[i], pad + (i - 1) * (cw + 12)
		self:framed(cx, TOP, cw, SYNTH.card_h, C.raised, body, 8)
		local line, color, dot
		if not st.installed then
			line, color, dot = tr("st_shelter_synth_card_empty"), C.faint, C.faint
		elseif st.what == "making" then
			line, color, dot = st.elapsed and tr("st_shelter_synth_card_making", shelter_synthesis.duration_text(st.elapsed)) or "",
				C.text, C.accent
		elseif st.what == "out" then
			line, color, dot = tr("st_shelter_synth_card_out", synth_name(st.result)), C.text, C.warn
		else
			line, color, dot = tr("st_shelter_synth_card_free"), C.good, C.good
		end
		self:round(cx + 14, TOP + 17, 10, 10, dot, body, 5)
		self:text(cx + 32, TOP + 8, cw - 44, 28, tr("st_shelter_synth_short_" .. n), C.text, body)
		local t = self:text(cx + 14, TOP + 36, cw - 28, 30, line, color, body, nil, "s")
		if st.what == "making" then
			s.elapsed[i] = t
			for j, sec in ipairs(st.parts or {}) do
				if sec ~= "" then
					self:round(cx + 14 + (j - 1) * 50, TOP + 70, 44, 44, C.field, body, 6)
					self:icon(sec, cx + 16 + (j - 1) * 50, TOP + 72, 40, body)
				end
			end
		elseif st.what == "out" then
			self:round(cx + 14, TOP + 70, 44, 44, C.field, body, 6)
			self:icon(st.result, cx + 16, TOP + 72, 40, body)
		end
	end
	local recipes = s.tab == "recipes"
	-- the tabs: the journal, the recipes
	for i, t in ipairs(TABS) do
		self:button(pad + (i - 1) * 150, TOP + SYNTH.card_h + 10, 142, 34, tr("st_shelter_synth_tab_" .. t), function()
			s.tab, s.page = t, 1
			self:fill_synth()
		end, self.app_clicks, body, self.wx, self.wy, t == s.tab and "on" or "normal").synth = true
	end
	-- the journal's filters: a row of tabs right of the search
	for i, f in ipairs(recipes and {} or FILTERS) do
		self:button(366 + (i - 1) * 140, SYNTH.search_y, 132, 34, tr("st_shelter_synth_filter_" .. f), function()
			s.filter, s.page = f, 1
			self:fill_synth()
		end, self.app_clicks, body, self.wx, self.wy, f == s.filter and "on" or "normal").synth = true
	end
	-- the columns
	local col = { when = pad + 10, chamber = pad + 128, parts = pad + 262, names = pad + 372, result = W - pad - 330,
		who = W - pad - 104 }
	for k, id in pairs({ when = recipes and "st_shelter_synth_col_found" or "st_shelter_synth_col_when",
		chamber = "st_shelter_synth_col_chamber", parts = "st_shelter_synth_col_load", result = "st_shelter_synth_col_result",
		who = recipes and "st_shelter_synth_col_finder" or "st_shelter_synth_col_who" }) do
		self:text(col[k], SYNTH.head_y, 200, 22, tr(id), C.faint, body, nil, "s")
	end
	self:rect(pad, SYNTH.head_y + 24, W - 2 * pad, 1, C.line, body)
	-- a page of it
	local rows = self:synth_rows()
	local per_page = math.floor((H - SYNTH.list_y - 56) / SYNTH.row_h)
	local pages = math.max(1, math.ceil(#rows / per_page))
	s.page = math.min(s.page, pages)
	-- a load's time of day by the clock, so long before now; its day by the days since
	local clock = level.get_time_hours() * 3600 + level.get_time_minutes() * 60
	local now = game.get_game_time():diffSec(game.CTime())
	if #rows == 0 then
		self:text(pad + 10, SYNTH.list_y + 6, W - 2 * pad, 30, tr(recipes and (s.word == "" and "st_shelter_synth_recipes_empty"
			or "st_shelter_synth_found_none") or #journal == 0 and "st_shelter_synth_journal_empty" or "st_shelter_synth_found_none"),
			C.faint, body)
	end
	for r = 1, per_page do
		local e = rows[(s.page - 1) * per_page + r]
		if not e then
			break
		end
		local y = SYNTH.list_y + (r - 1) * SYNTH.row_h
		if r % 2 == 0 then
			self:round(pad, y, W - 2 * pad, SYNTH.row_h - 2, C.white, body, 5, 7)
		end
		local when
		if e.chemist then
			when = tr("st_shelter_synth_chemist")
		else
			local back = math.max(0, now - e.t)
			local day = (clock - back) % 86400
			local hm = string.format("%02d:%02d", math.floor(day / 3600), math.floor(day % 3600 / 60))
			local days = back <= clock and 0 or math.ceil((back - clock) / 86400)
			when = days == 0 and hm or days == 1 and tr("st_shelter_synth_yesterday", hm) or tr("st_shelter_synth_days_ago", days, hm)
		end
		local th = SYNTH.row_h - 2
		self:text(col.when, y, 114, th, when, C.dim, body, nil, "s")
		self:text(col.chamber, y, 130, th, tr("st_shelter_synth_short_" .. e.nature), C.text, body, nil, "s")
		local names = {}
		for j, sec in ipairs(e.parts) do
			if sec ~= "" then
				self:icon(sec, col.parts + (j - 1) * 34, y + 2, 32, body)
				names[#names + 1] = synth_name(sec)
			end
		end
		self:text(col.names, y, col.result - col.names - 12, th, table.concat(names, ", "), C.text, body, nil, "s")
		local stone = e.result == shelter_synthesis.STONE
		self:icon(e.result, col.result, y + 2, 32, body)
		self:text(col.result + 40, y, col.who - col.result - 48, th, stone and tr("st_shelter_synth_row_stone", e.resonance,
			shelter_synthesis.SLOTS) or synth_name(e.result), stone and C.bad or C.good, body, nil, "s")
		self:text(col.who, y, W - pad - col.who, th, e.chemist and "" or e.who or "", C.dim, body, nil, "s")
	end
	local fy = H - 46
	if pages > 1 then
		self:button(pad, fy, 36, 30, "<", function() s.page = math.max(1, s.page - 1) self:fill_synth() end,
			self.app_clicks, body, self.wx, self.wy, s.page == 1 and "off" or "normal").synth = true
		self:text(pad + 40, fy, 90, 30, tr("st_shelter_synth_page", s.page, pages), C.dim, body, CGameFont.alCenter, "s")
		self:button(pad + 134, fy, 36, 30, ">", function() s.page = math.min(pages, s.page + 1) self:fill_synth() end,
			self.app_clicks, body, self.wx, self.wy, s.page == pages and "off" or "normal").synth = true
	end
	self:text(W - pad - 300, fy, 300, 30, tr(recipes and "st_shelter_synth_recipes_count" or "st_shelter_synth_count", #rows),
		C.faint, body, CGameFont.alRight, "s")
end

-------------------------------------------------------------------------------
-- the raid (raid.script): the raid's levels in a list and the map of the one picked (the PDA's: dragged to move, + and
-- - to zoom; none for a level without one) with the group's marks and the stashes with a running GPS beacon (and in
-- the debug view the Monolith's smarts, routes and patrols), the landing and the way out, the start (not while another
-- of the group is in the raid). A click on the map (not a drag) opens a card: on a stash what is in it and the
-- beacon's charge, on a mark its text to change or remove, elsewhere a new mark's.

local RAID = { list_w = 230, zoom = 1.5, min_scale = 0.25, pin = 22, pick = 12, label_chars = 48, card_rows = 10 }
-- scale: the texture's pixels a square unit shows; pick: how near a click takes a mark
local map_sizes = {} -- a map texture's size in pixels, once seen: the engine sets a static's texture rect to the whole
-- texture as it first draws it (a new texture: the rect zeroed first, the map unseen till then)

function UIShelterOS:open_raid()
	local levels = raid.get_levels()
	local W, x = self:fit(1000)
	local H = 704
	local win = self:window(x, 8, W, H, "raid")
	local lw = RAID.list_w
	self.raid_area = { x = 14 + lw + 14, y = TOP, w = W - lw - 42, h = H - TOP - 14 }
	local a = self.raid_area
	self:round(a.x - 1, a.y - 1, a.w + 2, a.h + 2, C.border, win, 4)
	self:rect(a.x, a.y, a.w, a.h, C.field, win)
	self.raid_map = self:image(a.x, a.y, a.w, a.h, "ui\\shelter\\laptop_white", win)
	self.raid_map:Show(false)
	self.raid_no_map = self:text(a.x, a.y, a.w, a.h, tr("st_raid_no_map"), C.dim, win, CGameFont.alCenter)
	self.raid_no_map:Show(false)
	-- over the map: the marks, then the hovered one's label (each layer keeps its place, its parts are made anew)
	self.raid_pin_layer = self:box(a.x, a.y, a.w, a.h, win)
	self.raid_label_layer = self:box(a.x, a.y, a.w, a.h, win)
	self.raid_pins_box, self.raid_label = nil, nil
	self.app_clicks[#self.app_clicks + 1] = { self.wx + a.x, self.wy + a.y, a.w, a.h, function(p) self:raid_press_at(p) end }
	self:button(a.x + a.w - 92, a.y + 10, 38, 34, "+", function() self:raid_zoom(1 / RAID.zoom) end, self.app_clicks, win,
		self.wx, self.wy)
	self:button(a.x + a.w - 48, a.y + 10, 38, 34, "-", function() self:raid_zoom(RAID.zoom) end, self.app_clicks, win,
		self.wx, self.wy)
	-- under the list: the landing, the way out, the start
	local by = H - 14 - 44
	local ty = TOP + 44 * #levels.order + 12
	self:text(14, ty, lw, by - 86 - ty, tr("st_raid_landing"), C.dim, win, nil, "s")
	local notice = self:text(14, by - 80, lw, 74, tr("st_raid_map_hint"), C.faint, win, nil, "s") -- room for the refusal
	local busy = raid.raider()
	local denied = raid.entry_denied() -- the button stays and only tells why not
	self:button(14, by, lw, 44, busy and tr("st_raid_busy", busy) or tr("st_raid_go"), function()
		if denied then
			notice:SetText(tr(denied))
			actor_menu.set_msg(1, tr(denied), 6)
			return
		end
		self:Close()
		raid.start()
	end, self.app_clicks, win, self.wx, self.wy, busy and "off" or denied and "normal" or "primary")
	self.raid_stashes = raid.stashes()
	self.raid_marks = raid.marks()
	self.raid_list, self.raid_card_box = nil, nil
	self.raid_dragging, self.raid_press = nil, nil
	self.app_update = self.update_raid
	self:raid_select(self.raid_level or levels.order[1])
end

-- the list, the picked level's row lit; the picked level's map, all of it in view
function UIShelterOS:raid_select(name)
	self.raid_level = name
	self:raid_card_close()
	local levels = raid.get_levels()
	if self.raid_list then
		self.win:DetachChild(self.raid_list)
	end
	for i = #self.app_clicks, 1, -1 do
		if self.app_clicks[i].raid_list then
			table.remove(self.app_clicks, i)
		end
	end
	self.raid_list = self:box(14, TOP, RAID.list_w, 44 * #levels.order, self.win)
	for i, n in ipairs(levels.order) do
		local c = self:button(0, (i - 1) * 44, RAID.list_w, 38, tr(levels[n].original), function() self:raid_select(n) end,
			self.app_clicks, self.raid_list, self.wx + 14, self.wy + TOP, n == name and "on" or "flat")
		c.raid_list = true
	end

	local m = levels[name] and levels[name].map
	self.raid_view, self.raid_measure = nil, nil
	self:raid_pins()
	self.raid_map:Show(m and true or false)
	self.raid_no_map:Show(not m)
	if not m then
		return
	end
	if not map_sizes[m.texture] then
		self.raid_map:SetTextureRect(Frect():set(0, 0, 0, 0))
		self.raid_map:SetTextureColor(GetARGB(0, 255, 255, 255))
		self.raid_measure = m.texture
	end
	self.raid_map:InitTexture(m.texture)
	if map_sizes[m.texture] then
		self:raid_view_of(m.texture)
	end
end

-- the view of a map whose size is known: all of it
function UIShelterOS:raid_view_of(texture)
	local size, a = map_sizes[texture], self.raid_area
	local fit = math.max(size.w / a.w, size.h / a.h)
	self.raid_view = { tw = size.w, th = size.h, u = size.w / 2, v = size.h / 2, scale = fit, fit = fit }
	self.raid_map:SetTextureColor(GetARGB(255, 255, 255, 255))
	self:raid_pins()
end

-- the marks of the picked level (none till its map is seen): the stashes, then the group's marks
function UIShelterOS:raid_pins()
	if self.raid_pins_box then
		self.raid_pin_layer:DetachChild(self.raid_pins_box)
	end
	local a = self.raid_area
	self.raid_pins_box = self:box(0, 0, a.w, a.h, self.raid_pin_layer)
	self.raid_pin_list = {}
	self:raid_hover(nil)
	if not self.raid_view then
		return
	end
	local function pin(kind, x, z, data)
		self.raid_pin_list[#self.raid_pin_list + 1] = { kind = kind, x = x, z = z, data = data,
			img = self:image(0, 0, RAID.pin, RAID.pin, "ui\\shelter\\laptop_mark_" .. (kind == "stash" and "stash" or "raid_note"),
				self.raid_pins_box) }
	end
	for _, s in ipairs(self.raid_stashes) do
		if s.level == self.raid_level then
			pin("stash", s.position.x, s.position.z, s)
		end
	end
	for _, m in ipairs(self.raid_marks) do
		if m.level == self.raid_level then
			pin("note", m.x, m.z, m)
		end
	end
	if raid.debug() then
		self:raid_debug_pins()
	end
	self:raid_draw()
end

-- the debug view (raid.debug()): the Monolith's routes as dots, its smarts (number: men alive), its patrols; they follow
-- the map, take no clicks
function UIShelterOS:raid_debug_pins()
	local view = raid_monolith.debug_view(self.raid_level)
	local function add(x, z, w, h, img)
		self.raid_pin_list[#self.raid_pin_list + 1] = { kind = "debug", x = x, z = z, w = w, h = h, img = img }
	end
	for _, points in ipairs(view.routes) do
		for i = 1, #points - 1 do
			local a, b = points[i], points[i + 1]
			local n = math.max(1, math.floor(math.sqrt((b.x - a.x) ^ 2 + (b.z - a.z) ^ 2) / 6))
			for k = 0, n do
				add(a.x + (b.x - a.x) * k / n, a.z + (b.z - a.z) * k / n, 4, 4, self:rect(0, 0, 4, 4, C.warn, self.raid_pins_box))
			end
		end
	end
	for _, s in ipairs(view.smarts) do
		local box = self:box(0, 0, 52, 22, self.raid_pins_box)
		self:round(0, 0, 52, 22, C.black, box, 6, 200)
		self:text(0, 0, 52, 22, s.label, C.warn, box, CGameFont.alCenter, "s")
		add(s.x, s.z, 52, 22, box)
	end
	for _, p in ipairs(view.patrols) do
		local box = self:box(0, 0, 14, 14, self.raid_pins_box)
		self:round(0, 0, 14, 14, C.bad, box, 7)
		add(p.x, p.z, 14, 14, box)
	end
end

-- a world point (x, z) on the map's texture, by the level map's bounds (the PDA's: the texture spans them, north up)
function UIShelterOS:raid_tex_of(x, z)
	local m, v = raid.get_levels()[self.raid_level].map, self.raid_view
	return (x - m.x1) / (m.x2 - m.x1) * v.tw, (m.z2 - z) / (m.z2 - m.z1) * v.th
end

function UIShelterOS:raid_world_of(u, w)
	local m, v = raid.get_levels()[self.raid_level].map, self.raid_view
	return m.x1 + u / v.tw * (m.x2 - m.x1), m.z2 - w / v.th * (m.z2 - m.z1)
end

-- a texture point in the map's area (its top left: 0, 0) and back
function UIShelterOS:raid_area_of(u, w)
	local v = self.raid_view
	return v.ox + (u - v.u + v.vw / 2) / v.scale, v.oy + (w - v.v + v.vh / 2) / v.scale
end

function UIShelterOS:raid_tex_at(sx, sy)
	local v = self.raid_view
	return (sx - v.ox) * v.scale + v.u - v.vw / 2, (sy - v.oy) * v.scale + v.v - v.vh / 2
end

-- the map's part in view: as much of the texture as the area holds at the scale, around u, v (kept inside the
-- texture); a texture smaller than the area at that scale is shown whole in its middle. The marks follow; one out of
-- the map's part is hidden.
function UIShelterOS:raid_draw()
	local v, a = self.raid_view, self.raid_area
	v.vw, v.vh = math.min(a.w * v.scale, v.tw), math.min(a.h * v.scale, v.th)
	v.u = math.max(v.vw / 2, math.min(v.tw - v.vw / 2, v.u))
	v.v = math.max(v.vh / 2, math.min(v.th - v.vh / 2, v.v))
	local sw, sh = v.vw / v.scale, v.vh / v.scale
	v.ox, v.oy = (a.w - sw) / 2, (a.h - sh) / 2
	self:place(self.raid_map, a.x + v.ox, a.y + v.oy, sw, sh)
	self.raid_map:SetTextureRect(Frect():set(v.u - v.vw / 2, v.v - v.vh / 2, v.u + v.vw / 2, v.v + v.vh / 2))
	for _, p in ipairs(self.raid_pin_list or {}) do
		local w, h = p.w or RAID.pin, p.h or RAID.pin
		p.sx, p.sy = self:raid_area_of(self:raid_tex_of(p.x, p.z))
		p.seen = p.sx >= v.ox and p.sx <= v.ox + sw and p.sy >= v.oy and p.sy <= v.oy + sh
		if p.seen then
			self:place(p.img, p.sx - w / 2, p.sy - h / 2, w, h)
		end
		p.img:Show(p.seen)
	end
end

function UIShelterOS:raid_zoom(k)
	local v = self.raid_view
	if v then
		v.scale = math.max(RAID.min_scale, math.min(v.fit, v.scale * k))
		self:raid_draw()
		self:raid_hover(nil)
	end
end

-- the mark nearest to a point of the map's area, if near enough
function UIShelterOS:raid_pin_at(sx, sy)
	local best, best_d
	for _, p in ipairs(self.raid_pin_list or {}) do
		local d = p.seen and p.kind ~= "debug" and math.max(math.abs(p.sx - sx), math.abs(p.sy - sy))
		if d and d <= RAID.pick and (not best_d or d < best_d) then
			best, best_d = p, d
		end
	end
	return best
end

-- the press on the map: a drag starts; let go where it was pressed, it is a click
function UIShelterOS:raid_press_at(p)
	self.raid_press = p
	local v = self.raid_view
	if v then
		self.raid_dragging = { p = p, u = v.u, v = v.v }
	end
end

function UIShelterOS:raid_release(p)
	local press = self.raid_press
	self.raid_dragging, self.raid_press = nil, nil
	if not (press and self.raid_view) or math.abs(p.x - press.x) + math.abs(p.y - press.y) > 4 then
		return
	end
	local a = self.raid_area
	local sx, sy = p.x - self.wx - a.x, p.y - self.wy - a.y
	local pin, v = self:raid_pin_at(sx, sy), self.raid_view
	if pin then
		self:raid_card(pin)
	elseif sx >= v.ox and sx <= v.ox + v.vw / v.scale and sy >= v.oy and sy <= v.oy + v.vh / v.scale then
		local x, z = self:raid_world_of(self:raid_tex_at(sx, sy))
		self:raid_card({ kind = "note", x = x, z = z })
	end
end

-- the label of the mark under the cursor: a stash's charge, a mark's text (its start)
function UIShelterOS:raid_hover(pin)
	if pin == self.raid_hovered and (pin or not self.raid_label) then
		return
	end
	self.raid_hovered = pin
	if self.raid_label then
		self.raid_label_layer:DetachChild(self.raid_label)
		self.raid_label = nil
	end
	if not pin then
		return
	end
	local text = pin.kind == "stash" and tr("st_raid_stash_label", math.floor(pin.data.charge * 100)) or pin.data.text
	if string.len(text) > RAID.label_chars then
		text = string.sub(text, 1, RAID.label_chars - 3) .. "..."
	end
	local a = self.raid_area
	local w = math.min(a.w - 8, 24 + 8 * string.len(text))
	local x = math.max(4, math.min(a.w - w - 4, pin.sx + RAID.pin / 2 + 6))
	local y = math.max(4, math.min(a.h - 32, pin.sy - 14))
	self.raid_label = self:box(x, y, w, 28, self.raid_label_layer)
	self:framed(0, 0, w, 28, C.raised, self.raid_label, 6)
	self:text(10, 0, w - 20, 28, text, C.text, self.raid_label, nil, "s")
end

function UIShelterOS:update_raid()
	if self.raid_measure then
		local r = self.raid_map:GetTextureRect()
		if r.x2 > 0 and r.y2 > 0 then
			map_sizes[self.raid_measure] = { w = r.x2, h = r.y2 }
			local texture = self.raid_measure
			self.raid_measure = nil
			self:raid_view_of(texture)
		end
		return
	end
	local d, v = self.raid_dragging, self.raid_view
	if d and v then
		local p = self:cursor()
		v.u = d.u - (p.x - d.p.x) * v.scale
		v.v = d.v - (p.y - d.p.y) * v.scale
		self:raid_draw()
		self:raid_hover(nil)
	elseif v and not self.raid_card_box then
		local p, a = self:cursor(), self.raid_area
		self:raid_hover(self:raid_pin_at(p.x - self.wx - a.x, p.y - self.wy - a.y))
	end
end

-------------------------------------------------------------------------------
-- the card over the map's bottom: a stash's (its beacon's charge, what is in it) or a mark's (its text in a field;
-- saved, removed); it takes the clicks off the map under it

function UIShelterOS:raid_card_close()
	if self.raid_card_box then
		self.win:DetachChild(self.raid_card_box)
	end
	self.raid_card_box, self.raid_edit = nil, nil
	for i = #self.app_clicks, 1, -1 do
		if self.app_clicks[i].raid_card then
			table.remove(self.app_clicks, i)
		end
	end
end

function UIShelterOS:raid_card(pin)
	self:raid_card_close()
	self:raid_hover(nil)
	local a = self.raid_area
	local stash = pin.kind == "stash" and pin.data
	local rows = stash and math.min(#stash.items, RAID.card_rows) or 0
	local w = math.min(520, a.w - 24)
	local h = stash and 116 + math.max(1, rows) * 24 + (#stash.items > rows and 24 or 0) or 196
	local x, y = a.x + 12, a.y + a.h - h - 12
	local card = self:box(x, y, w, h, self.win)
	self.raid_card_box = card
	for i = 3, 1, -1 do -- a soft shadow
		self:round(-2 * i, 3 - i, w + 4 * i, h + 4 * i, C.black, card, 10 + 2 * i, 18)
	end
	self:framed(0, 0, w, h, C.surface, card, 10)
	self:click_at(self.app_clicks, x, y, w, h, function() end, nil, "raid_card")
	local function button(bx, label, f, kind)
		local c = self:button(bx, h - 52, 150, 38, label, f, self.app_clicks, card, self.wx + x, self.wy + y, kind)
		c.raid_card = true
	end
	button(w - 166, tr("st_raid_close"), function() self:raid_card_close() end)

	if stash then
		self:text(18, 10, w - 36, 30, tr("st_raid_stash"), C.text, card, nil, "l")
		self:text(18, 42, w - 36, 24, tr("st_raid_beacon_charge", math.floor(stash.charge * 100), math.floor(stash.hours)),
			stash.charge < 0.2 and C.warn or C.dim, card, nil, "s")
		if #stash.items == 0 then
			self:text(18, 76, w - 36, 24, tr("st_raid_stash_empty"), C.faint, card, nil, "s")
		end
		for i = 1, rows do
			local it = stash.items[i]
			local name = ui_item.get_sec_name(it.section)
			self:text(18, 76 + (i - 1) * 24, w - 36, 24, it.count > 1 and string.format("%s  x%d", name, it.count) or name,
				C.text, card, nil, "s")
		end
		if #stash.items > rows then
			self:text(18, 76 + rows * 24, w - 36, 24, tr("st_raid_stash_more", #stash.items - rows), C.faint, card, nil, "s")
		end
		return
	end

	local mark = pin.data
	self:text(18, 10, w - 36, 30, tr(mark and "st_raid_mark" or "st_raid_mark_new"), C.text, card, nil, "l")
	self:text(18, 42, w - 36, 38, tr("st_raid_mark_hint"), C.faint, card, nil, "s")
	self:framed(16, 86, w - 32, 38, C.field, card, 6)
	local edit = self.xml:InitEditBox("edit", card)
	self:place(edit, 26, 92, w - 52, 26)
	if mark then
		edit:SetText(mark.text)
	end
	edit:CaptureFocus(true)
	self.raid_edit = edit
	self:click_at(self.app_clicks, x + 16, y + 86, w - 32, 38, function() edit:CaptureFocus(true) end, nil, "raid_card")
	local function save(text)
		raid.set_mark(mark and mark.n, self.raid_level, pin.x, pin.z, text)
		self.raid_marks = raid.marks()
		self:raid_card_close()
		self:raid_pins()
	end
	button(18, tr("st_raid_save"), function() save(trim(edit:GetText() or "")) end, "primary")
	if mark then
		button(176, tr("st_raid_delete"), function() save(nil) end)
	end
end

-------------------------------------------------------------------------------
-- the cleaning: what it does, and the start

function UIShelterOS:open_clean()
	local W, x = self:fit(520)
	local H = 260
	local win = self:window(x, 220, W, H, "clean")
	self:text(20, TOP, W - 40, 130, tr("st_shelter_clean_hint"), C.text, win)
	self:button(W - 20 - 240, H - 56, 240, 38, tr("st_shelter_clean"), function()
		self:Close()
		shelter.clean()
	end, self.app_clicks, win, self.wx, self.wy, "primary")
end

-------------------------------------------------------------------------------
-- the input, the time

function UIShelterOS:click(p)
	for _, list in ipairs({ self.menu_clicks or {}, self.app_clicks, self.clicks }) do
		for i = #list, 1, -1 do
			local c = list[i]
			if inside(p, c) then
				if self.menu and list ~= self.menu_clicks and not c.start then
					self:toggle_menu()
				end
				c[5](p)
				return
			end
		end
	end
	if self.menu then
		self:toggle_menu()
	end
end

function UIShelterOS:Update()
	CUIScriptWnd.Update(self)
	local now = time_global()
	if not self.ticked or now >= self.ticked then
		self.ticked = now + 1000
		self:tick()
	end
	if self.app_update then
		self.app_update(self)
	end
	self:hovers(self:cursor(), { self.menu_clicks or {}, self.app_clicks, self.clicks })
end

function UIShelterOS:OnKeyboard(dik, keyboard_action)
	local res = CUIScriptWnd.OnKeyboard(self, dik, keyboard_action)
	-- a click on a field takes the keys whatever the engine's own focus did with that click
	if dik == DIK_keys.MOUSE_1 and keyboard_action == ui_events.WINDOW_KEY_PRESSED then
		local p = self:cursor()
		for _, c in ipairs(self.app_clicks) do
			if c.edit and inside(p, c) then
				c.edit:CaptureFocus(true)
				return true
			end
		end
	end
	if res == false and keyboard_action == ui_events.WINDOW_KEY_PRESSED then
		if dik == DIK_keys.MOUSE_1 then
			self:click(self:cursor())
			return true
		elseif self.app == "raid" and (dik == DIK_keys.DIK_EQUALS or dik == DIK_keys.DIK_ADD) then
			self:raid_zoom(1 / RAID.zoom)
			return true
		elseif self.app == "raid" and (dik == DIK_keys.DIK_MINUS or dik == DIK_keys.DIK_SUBTRACT) then
			self:raid_zoom(RAID.zoom)
			return true
		elseif dik_to_bind(dik) == key_bindings.kQUIT then
			if self.menu then
				self:toggle_menu()
			elseif self.app then
				self:close_app()
			else
				self:Close()
			end
			return true
		end
	elseif keyboard_action == ui_events.WINDOW_KEY_RELEASED and dik == DIK_keys.MOUSE_1 and self.app == "raid" then
		self:raid_release(self:cursor())
	end
	return res
end

function UIShelterOS:Close()
	self:HideDialog()
	GUI = nil
	Unregister_UI("UIShelterOS")
end

-- the laptop opened (shelter.script's laptop_binder)
function open()
	if not (GUI and GUI:IsShown()) then
		GUI = UIShelterOS()
		GUI:ShowDialog(true)
		Register_UI("UIShelterOS", "ui_shelter_laptop")
	end
end

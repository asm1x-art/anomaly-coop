-- The laptop's desktop (docs/coop/shelter.md, "План развития", phase 1): a modern dark system on the Chemist's laptop,
-- its look ui_shelter_style.script's. Its shortcuts open programs in a window over the desktop; the taskbar has the
-- start button (its menu shuts the laptop down), the open program and the game's time and date. Clicks and the hover
-- are found by the cursor. Laid out in square units: the screen is that many wide (1024 on 4:3, more on a wide one)
-- and 768 high, squeezed into the interface's 1024 across, so the plan, the icons and the marks keep their shape.
-- Programs: the shelter's plan (the rooms by state, what is where, who is in; a room picked shows its card, where it
-- can be given a role, the world's), the bar (shelter_bar.script: its store, markup, till and sales), the synthesis
-- chambers and their journal (shelter_synthesis.script) and the cleaning.

local XML = "ui_shelter_laptop.xml"
local SCREEN = { h = 768 } -- w: the screen's width in square units, set as the laptop opens
local TASKBAR = 48
local C = ui_shelter_style.C
local TOP = ui_shelter_style.TITLE_H + 12 -- a window's content from here down
local LEFT = 128 -- the windows keep right of the shortcuts
local APPS = { { "plan", "st_shelter_app_plan" }, { "bar", "st_shelter_app_bar" }, { "synth", "st_shelter_app_synth" },
	{ "clean", "st_shelter_app_clean" } }
local ROOM_TINT = { blocked = { 150, 0, 0, 0 }, dirty = { 46, 240, 180, 70 } } -- alpha, r, g, b; a clean one: none
local MARKS = { -- the shelter's things on the plan: the state keeping its object's id, its mark
	{ state = "generator_id", mark = "generator" },
	{ state = "laptop_id", mark = "laptop" },
	{ state = "stash_id", mark = "stash" },
	{ state = "chamber_panel_gravi", mark = "chamber" },
	{ state = "chamber_panel_thermo", mark = "chamber" },
	{ state = "chamber_panel_chem", mark = "chamber" },
	{ state = "chamber_panel_electro", mark = "chamber" },
}
local LEGEND = { "generator", "laptop", "stash", "chamber", "me", "friend" }
local ROLES = { "store" } -- what a room can be made, in its card's order
local BUNKER = "bunker_a1"

local gui -- the laptop open

local function tr(id, ...)
	return select("#", ...) > 0 and string.format(game.translate_string(id), ...) or game.translate_string(id)
end

local function inside(p, r)
	return p.x >= r[1] and p.x < r[1] + r[3] and p.y >= r[2] and p.y < r[2] + r[4]
end

-------------------------------------------------------------------------------
-- the plan's data: the texture and the world's box on it (tools\shelter\plan.py), the rooms

local plan, rooms

local function load_plan()
	if plan then
		return
	end
	local ini = ini_file("scripts\\shelter\\plan.ltx")
	plan = { texture = ini:r_string_ex("plan_main", "texture"), w = ini:r_float_ex("plan_main", "width"),
		h = ini:r_float_ex("plan_main", "height"), x0 = ini:r_float_ex("plan_main", "x0"), x1 = ini:r_float_ex("plan_main", "x1"),
		z0 = ini:r_float_ex("plan_main", "z0"), z1 = ini:r_float_ex("plan_main", "z1") }
	rooms = {}
	ini = ini_file("scripts\\shelter\\rooms.ltx")
	for i = 0, ini:line_count("rooms") - 1 do
		local _, id = ini:r_line_ex("rooms", i, "", "")
		local box = str_explode(ini:r_string_ex(id, "box"), ",")
		local roles = {}
		for _, role in ipairs(str_explode(ini:r_string_ex(id, "roles") or "", ",")) do
			roles[role] = true
		end
		rooms[#rooms + 1] = { id = id, name = ini:r_string_ex(id, "name"), zone = ini:r_string_ex(id, "zone"), roles = roles,
			box = { tonumber(box[1]), tonumber(box[2]), tonumber(box[3]), tonumber(box[4]) } }
	end
end

-- a room's role, the world's: the room each role is given to
local function role_of(room)
	for _, role in ipairs(ROLES) do
		if shelter.state("room_" .. role, nil) == room.id then
			return role
		end
	end
end

-------------------------------------------------------------------------------
-- the desktop

class "UIShelterOS" (CUIScriptWnd)
ui_shelter_style.apply(UIShelterOS)

function UIShelterOS:__init() super()
	self.k = utils_xml.screen_ratio() -- a square unit across, in the interface's units
	SCREEN.w = math.floor(1024 / self.k + 0.5)
	self:SetWndRect(Frect():set(0, 0, 1024, SCREEN.h))
	self:SetAutoDelete(true)
	self.xml = CScriptXmlInit()
	self.xml:ParseFile(XML)
	self.clicks = {} -- the desktop's and the taskbar's: { x, y, w, h, f, hover = its light }
	self.app_clicks = {}
	self.menu_clicks = nil
	self:image(0, 0, SCREEN.w, SCREEN.h, "ui\\shelter\\laptop_wallpaper", self)
	self:image(math.floor(SCREEN.w / 2 - 200), math.floor((SCREEN.h - TASKBAR) / 2 - 160), 400, 300,
		"ui\\shelter\\laptop_logo", self)
	self:shortcuts()
	self:taskbar()
end

-- the cursor in square units
function UIShelterOS:cursor()
	local p = GetCursorPosition()
	return vector2():set(p.x / self.k, p.y)
end

-- a click's list entry for a part drawn in a window at the window's x, y (the clicks are in the screen's frame)
function UIShelterOS:click_at(list, x, y, w, h, f, hover, tag)
	local c = { self.wx + x, self.wy + y, w, h, f, hover = hover }
	if tag then
		c[tag] = true
	end
	list[#list + 1] = c
	return c
end

function UIShelterOS:shortcuts()
	for i, app in ipairs(APPS) do
		local y = 16 + (i - 1) * 104
		local hb = self:hover_of(12, y, 104, 98, self, 8)
		self:image(36, y + 8, 56, 56, "ui\\shelter\\laptop_icon_" .. app[1], self)
		self:text(13, y + 67, 104, 26, tr(app[2]), C.black, self, CGameFont.alCenter, "s") -- a shadow under the name
		self:text(12, y + 66, 104, 26, tr(app[2]), C.text, self, CGameFont.alCenter, "s")
		self.clicks[#self.clicks + 1] = { 12, y, 104, 98, function() self:open(app[1]) end, hover = hb }
	end
end

function UIShelterOS:taskbar()
	local y = SCREEN.h - TASKBAR
	self:rect(0, y, SCREEN.w, TASKBAR, C.bar, self, 235)
	self:rect(0, y, SCREEN.w, 1, C.line, self)
	local hb = self:hover_of(6, y + 4, 44, 40, self, 6)
	self:image(16, y + 12, 24, 24, "ui\\shelter\\os_start", self, C.accent)
	self.clicks[#self.clicks + 1] = { 6, y + 4, 44, 40, function() self:toggle_menu() end, hover = hb,
		start = true }
	self.clock = self:text(SCREEN.w - 150, y + 3, 136, 22, "", C.text, self, CGameFont.alRight, "s")
	self.date = self:text(SCREEN.w - 150, y + 23, 136, 22, "", C.dim, self, CGameFont.alRight, "s")
	self.task = nil
	self:tick()
end

function UIShelterOS:tick()
	self.clock:SetText(string.format("%02d:%02d", level.get_time_hours(), level.get_time_minutes()))
	local y, m, d = game.get_game_time():get()
	self.date:SetText(string.format("%02d.%02d.%d", d, m, y))
end

function UIShelterOS:toggle_menu()
	if self.menu then
		self:DetachChild(self.menu)
		self.menu, self.menu_clicks = nil, nil
		return
	end
	local w, h = 290, 148
	local x, y = 6, SCREEN.h - TASKBAR - h - 8
	self.menu = self:box(x, y, w, h, self)
	for i = 3, 1, -1 do
		self:round(-2 * i, 3 - i, w + 4 * i, h + 4 * i, C.black, self.menu, 10 + 2 * i, 18)
	end
	self:framed(0, 0, w, h, C.surface, self.menu, 10)
	self:image(18, 18, 36, 36, "ui\\shelter\\os_start", self.menu, C.accent)
	self:text(68, 14, w - 80, 26, tr("st_shelter_os_user"), C.text, self.menu)
	self:text(68, 38, w - 80, 20, tr("st_shelter_os_name"), C.dim, self.menu, nil, "s")
	self:rect(12, 72, w - 24, 1, C.line, self.menu)
	self.menu_clicks = {}
	local hb = self:hover_of(8, 84, w - 16, 52, self.menu, 6)
	self:image(22, 98, 24, 24, "ui\\shelter\\os_power", self.menu, C.text)
	self:text(60, 84, w - 72, 52, tr("st_shelter_os_shutdown"), C.text, self.menu)
	self.menu_clicks[1] = { x + 8, y + 84, w - 16, 52, function() self:Close() end, hover = hb }
end

-------------------------------------------------------------------------------
-- a program's window; on the taskbar its icon and name, marked as open

function UIShelterOS:open(app)
	self:close_app()
	if self.menu then
		self:toggle_menu()
	end
	self.app = app
	self["open_" .. app](self)
	local y = SCREEN.h - TASKBAR
	self.task = self:box(58, y + 4, 210, 40, self)
	self:round(0, 0, 210, 40, C.white, self.task, 6, 14)
	self:image(10, 9, 22, 22, "ui\\shelter\\laptop_icon_" .. app, self.task)
	self:text(42, 0, 160, 40, tr("st_shelter_app_" .. app), C.text, self.task, nil, "s")
	self:round(85, 36, 40, 3, C.accent, self.task, 1)
end

function UIShelterOS:close_app()
	if self.win then
		self:DetachChild(self.win)
		self:DetachChild(self.task)
	end
	self.win, self.task, self.app, self.app_clicks, self.app_update = nil, nil, nil, {}, nil
end

-- the window: its frame, title (the program's) and close box; its place kept for the clicks
function UIShelterOS:window(x, y, w, h, app)
	self.wx, self.wy = x, y
	self.win = self:chrome(x, y, w, h, tr("st_shelter_app_" .. app), "ui\\shelter\\laptop_icon_" .. app, self,
		self.app_clicks, x, y, function() self:close_app() end)
	return self.win
end

-- a window's width as asked, less on a narrow screen, and its x: in the middle right of the shortcuts
function UIShelterOS:fit(w)
	w = math.min(w, SCREEN.w - LEFT - 8)
	return w, math.max(LEFT, math.floor((SCREEN.w - w) / 2))
end

-------------------------------------------------------------------------------
-- the shelter's plan

function UIShelterOS:to_plan(x, z)
	local p = self.plan_area
	return p.x + (x - plan.x0) / (plan.x1 - plan.x0) * p.w, p.y + (plan.z1 - z) / (plan.z1 - plan.z0) * p.h
end

function UIShelterOS:room_rect(room)
	local u0, v0 = self:to_plan(room.box[1], room.box[4])
	local u1, v1 = self:to_plan(room.box[2], room.box[3])
	return u0, v0, u1 - u0, v1 - v0
end

function UIShelterOS:mark(x, z, kind, win)
	local u, v = self:to_plan(x, z)
	self:image(u - 9, v - 9, 18, 18, "ui\\shelter\\laptop_mark_" .. kind, win)
end

function UIShelterOS:open_plan()
	load_plan()
	local W, x = self:fit(900)
	local H = 704
	local win = self:window(x, 8, W, H, "plan")
	local ph = H - TOP - 14
	self.plan_area = { x = 14, y = TOP, w = math.floor(ph * plan.w / plan.h), h = ph }
	local a = self.plan_area
	self:round(a.x - 1, a.y - 1, a.w + 2, a.h + 2, C.border, win, 4)
	self:image(a.x, a.y, a.w, a.h, plan.texture, win)
	-- the rooms by state
	for _, room in ipairs(rooms) do
		local tint = ROOM_TINT[shelter.zone_state(room.zone)]
		if tint then
			local rx, ry, rw, rh = self:room_rect(room)
			self:rect(rx, ry, rw, rh, { tint[2], tint[3], tint[4] }, win, tint[1])
		end
	end
	-- what is where, who is in
	for _, m in ipairs(MARKS) do
		local se = alife_object(shelter.state(m.state, 65535))
		if se then
			self:mark(se.position.x, se.position.z, m.mark, win)
		end
	end
	if level.name() == BUNKER then
		self:mark(db.actor:position().x, db.actor:position().z, "me", win)
	end
	if coop and coop.connected and coop.connected() then
		local group = {}
		for _, name in ipairs(coop.group()) do
			group[name] = true
		end
		for _, peer in ipairs(coop.peers()) do
			if group[peer.name] and peer.level == BUNKER then
				self:mark(peer.position.x, peer.position.z, "friend", win)
				local u, v = self:to_plan(peer.position.x, peer.position.z)
				self:text(u + 10, v - 10, 120, 20, peer.name, C.text, win, nil, "s")
			end
		end
	end
	-- the hover and the pick, over the rooms
	self.room_hover = self:rect(0, 0, 1, 1, C.accent, win, 40)
	self.room_hover:Show(false)
	self.pick = {}
	for i = 1, 4 do
		self.pick[i] = self:rect(0, 0, 1, 1, C.accent, win)
		self.pick[i]:Show(false)
	end
	self.card_x = a.x + a.w + 16
	self.card_w = W - self.card_x - 14
	self.card = nil
	self:show_card(nil)
	self.app_update = self.update_plan
	self.app_clicks[#self.app_clicks + 1] = { self.wx + a.x, self.wy + a.y, a.w, a.h, function(p) self:pick_room(p) end }
end

function UIShelterOS:room_at(p)
	local a = self.plan_area
	if not inside(p, { self.wx + a.x, self.wy + a.y, a.w, a.h }) then
		return nil
	end
	for _, room in ipairs(rooms) do
		local x, y, w, h = self:room_rect(room)
		if inside(p, { self.wx + x, self.wy + y, w, h }) then
			return room
		end
	end
end

function UIShelterOS:update_plan()
	local room = self:room_at(self:cursor())
	if room ~= self.hovered then
		self.hovered = room
		if room then
			self:place(self.room_hover, self:room_rect(room))
		end
		self.room_hover:Show(room and true or false)
	end
end

function UIShelterOS:pick_room(p)
	local room = self:room_at(p)
	if room then
		local x, y, w, h = self:room_rect(room)
		local sides = { { x, y, w, 2 }, { x, y + h - 2, w, 2 }, { x, y, 2, h }, { x + w - 2, y, 2, h } }
		for i, s in ipairs(sides) do
			self:place(self.pick[i], s[1], s[2], s[3], s[4])
			self.pick[i]:Show(true)
		end
	end
	self:show_card(room)
end

-- the card of the room picked: its name, state, role and what it can be made; the legend under it
function UIShelterOS:show_card(room)
	if self.card then
		self.win:DetachChild(self.card)
	end
	-- the card's buttons go: the plan's own click stays first
	for i = #self.app_clicks, 1, -1 do
		if self.app_clicks[i].card then
			table.remove(self.app_clicks, i)
		end
	end
	local x, y, w, h = self.card_x, TOP, self.card_w, self.plan_area.h
	local card = self:box(x, y, w, h, self.win)
	self.card = card
	self:framed(0, 0, w, h, C.raised, card, 8)
	local pad = 16
	if not room then
		self:text(pad, pad, w - 2 * pad, 48, tr("st_shelter_plan_hint"), C.dim, card)
	else
		self:text(pad, 12, w - 2 * pad, 34, tr(room.name), C.text, card, nil, "l")
		local state = shelter.zone_state(room.zone)
		local state_color = state == "blocked" and C.bad or state == "dirty" and C.warn or C.good
		self:round(pad, 54, 10, 10, state_color, card, 5)
		self:text(pad + 18, 46, w - 2 * pad - 18, 26, tr("st_shelter_room_state_" .. state), C.text, card)
		local role = role_of(room)
		self:text(pad, 74, w - 2 * pad, 26, tr("st_shelter_room_role", tr("st_shelter_role_" .. (role or "none"))), C.dim, card)
		local by = 112
		for _, r in ipairs(ROLES) do
			if room.roles[r] then
				if role == r then
					self:button(pad, by, w - 2 * pad, 34, tr("st_shelter_room_unassign"), function()
						shelter.set_state("room_" .. r, nil)
						self:show_card(room)
					end, self.app_clicks, card, self.wx + x, self.wy + y).card = true
				elseif state == "blocked" then
					self:text(pad, by, w - 2 * pad, 34, tr("st_shelter_room_blocked_" .. r), C.faint, card)
				else
					self:button(pad, by, w - 2 * pad, 34, tr("st_shelter_room_make_" .. r), function()
						shelter.set_state("room_" .. r, room.id)
						self:show_card(room)
					end, self.app_clicks, card, self.wx + x, self.wy + y, "primary").card = true
				end
				by = by + 44
			end
		end
	end
	-- the legend
	local ly = h - #LEGEND * 26 - 14
	self:rect(pad, ly - 12, w - 2 * pad, 1, C.line, card)
	for i, kind in ipairs(LEGEND) do
		self:image(pad, ly + (i - 1) * 26 + 4, 18, 18, "ui\\shelter\\laptop_mark_" .. kind, card)
		self:text(pad + 28, ly + (i - 1) * 26, w - 2 * pad - 28, 26, tr("st_shelter_mark_" .. kind), C.dim, card, nil, "s")
	end
end

-------------------------------------------------------------------------------
-- the bar: the store and its goods, the markup (set here, the world's), when it sells, the till, the takings, the last
-- sales; drawn again when the bar has sold (counting the store takes a pass over all the objects: too long for every
-- second), the time till the next sale each second

local function next_sale_text()
	return tr("st_shelter_bar_next", tostring(ini_sys:r_float_ex("shelter_bar", "sell_hours") or 1),
		math.ceil((shelter_bar.next_sale_in() or 0) / 60))
end

function UIShelterOS:open_bar()
	load_plan()
	local W, x = self:fit(660)
	self:window(x, 40, W, 620, "bar")
	self.bar_w, self.bar_h = W, 620
	self.bar_body = nil
	self:fill_bar()
	self.app_update = self.update_bar
end

function UIShelterOS:update_bar()
	local now = time_global()
	if now < (self.bar_at or 0) then
		return
	end
	self.bar_at = now + 1000
	if shelter.state("bar_last", nil) ~= self.bar_last then
		self:fill_bar()
	else
		self.bar_next:SetText(next_sale_text())
	end
end

function UIShelterOS:fill_bar()
	self.bar_last = shelter.state("bar_last", nil)
	if self.bar_body then
		self.win:DetachChild(self.bar_body)
	end
	for i = #self.app_clicks, 1, -1 do -- the old body's buttons
		if self.app_clicks[i].bar then
			table.remove(self.app_clicks, i)
		end
	end
	local W, pad = self.bar_w, 18
	local body = self:box(0, 0, W, self.bar_h, self.win)
	self.bar_body = body
	-- the store and the money: two cards side by side
	local cw = math.floor((W - 3 * pad) / 2)
	local room = shelter.state("room_store", nil)
	local name
	for _, r in ipairs(rooms) do
		name = r.id == room and tr(r.name) or name
	end
	local goods = shelter_bar.stock()
	local food, drink = 0, 0
	for _, g in ipairs(goods) do
		food, drink = food + (g.kind == "i_food" and 1 or 0), drink + (g.kind == "i_food" and 0 or 1)
	end
	self:framed(pad, TOP, cw, 150, C.raised, body, 8)
	self:text(pad + 14, TOP + 8, cw - 28, 26, tr("st_shelter_bar_store_title"), C.dim, body, nil, "s")
	self:text(pad + 14, TOP + 32, cw - 28, 50, name and tr("st_shelter_bar_store", name) or tr("st_shelter_bar_no_store"),
		name and C.text or C.warn, body)
	self:text(pad + 14, TOP + 86, cw - 28, 50, tr("st_shelter_bar_stock", #goods, food, drink), C.text, body, nil, "s")
	local mx = pad * 2 + cw
	self:framed(mx, TOP, cw, 150, C.raised, body, 8)
	self:text(mx + 14, TOP + 8, cw - 28, 26, tr("st_shelter_bar_money_title"), C.dim, body, nil, "s")
	self:text(mx + 14, TOP + 32, cw - 28, 34, shelter.state("till_id", nil) and tr("st_shelter_bar_till", shelter_bar.till_money())
		or tr("st_shelter_bar_no_till"), C.text, body)
	self:text(mx + 14, TOP + 70, cw - 28, 30, tr("st_shelter_bar_total", shelter.state("bar_total", 0) or 0), C.good, body, nil, "s")
	-- the markup, its - and + beside it; when it sells
	local my = TOP + 168
	self:text(pad, my, 260, 34, tr("st_shelter_bar_markup", string.format("%.2f", shelter_bar.markup())), C.text, body)
	local step = ini_sys:r_float_ex("shelter_bar", "markup_step") or 0.05
	for i, d in ipairs({ -step, step }) do
		self:button(270 + (i - 1) * 44, my, 38, 34, d < 0 and "-" or "+", function()
			shelter_bar.set_markup(shelter_bar.markup() + d)
			self:fill_bar()
		end, self.app_clicks, body, self.wx, self.wy).bar = true
	end
	self.bar_next = self:text(pad, my + 40, W - 2 * pad, 26, next_sale_text(), C.dim, body, nil, "s")
	-- the last sales
	local ly = my + 84
	self:text(pad, ly, W - 2 * pad, 30, tr("st_shelter_bar_log"), C.text, body, nil, "l")
	ly = ly + 38
	local list = shelter_bar.sales()
	if #list == 0 then
		self:text(pad, ly, W - 2 * pad, 26, tr("st_shelter_bar_log_empty"), C.faint, body)
	end
	-- a sale's time of day by the clock: so long before now
	local clock = level.get_time_hours() * 3600 + level.get_time_minutes() * 60
	local now = shelter_bar.now()
	for i, s in ipairs(list) do
		if ly + 28 > self.bar_h - 12 then
			break
		end
		if i % 2 == 0 then
			self:round(pad, ly, W - 2 * pad, 28, C.white, body, 4, 8)
		end
		local day = (clock - (now - s.t)) % 86400
		self:text(pad + 10, ly, 70, 28, string.format("%02d:%02d", math.floor(day / 3600), math.floor(day % 3600 / 60)), C.dim,
			body, nil, "s")
		self:text(pad + 84, ly, W - 2 * pad - 220, 28, ui_item.get_sec_name(s.section), C.text, body, nil, "s")
		self:text(W - pad - 130, ly, 120, 28, "+" .. s.price, C.good, body, CGameFont.alRight, "s")
		ly = ly + 30
	end
end

-------------------------------------------------------------------------------
-- the synthesis (shelter_synthesis.script): each chamber's state (since when it works and on what, or what lies in its
-- cell; how long it has left, never), and the journal of every load made with the Chemist's recipes, newest first: all
-- of it, the artefacts made or the stones (each load once), found by a word of a thing's, a chamber's or a name

local SYNTH = { natures = { "gravi", "thermo", "chem", "electro" }, card_h = 124, row_h = 38, search_y = TOP + 172,
	head_y = TOP + 214, list_y = TOP + 240 }
local FILTERS = { "all", "made", "stone" }

-- cp1251's letters to lower case, for the search
local function lower(s)
	return (string.gsub(string.lower(s), "[\192-\223\168]", function(c)
		local b = string.byte(c)
		return string.char(b == 168 and 184 or b + 32)
	end))
end

local function synth_name(sec)
	return sec == shelter_synthesis.STONE and tr("st_shelter_synth_stone_name") or ui_item.get_sec_name(sec)
end

function UIShelterOS:open_synth()
	local W, x = self:fit(960)
	local H = 712
	local win = self:window(x, 6, W, H, "synth")
	self.synth = { w = W, h = H, filter = "all", page = 1, word = "" }
	-- the search: a field with its glyph, the edit box over it (kept while the body below is drawn again)
	local sy = SYNTH.search_y
	self:framed(18, sy, 330, 34, C.field, win, 6)
	self:image(28, sy + 9, 16, 16, "ui\\shelter\\os_search", win, C.dim)
	local edit = self.xml:InitEditBox("edit", win)
	self:place(edit, 52, sy + 4, 288, 26)
	self.synth.edit = edit
	self:click_at(self.app_clicks, 18, sy, 330, 34, function() edit:CaptureFocus(true) end)
	self:fill_synth()
	self.app_update = self.update_synth
end

function UIShelterOS:update_synth()
	local word = lower(self.synth.edit:GetText() or "")
	if word ~= self.synth.word then
		self.synth.word, self.synth.page = word, 1
		self:fill_synth()
		return
	end
	local now = time_global()
	if now < (self.synth.at or 0) then
		return
	end
	self.synth.at = now + 1000
	self:fill_synth(true)
end

-- the journal as shown: filtered, found, each load once but in "all"
function UIShelterOS:synth_rows()
	local rows, seen = {}, {}
	local list = shelter_synthesis.journal()
	for _, rc in ipairs(shelter_synthesis.chemist_recipes()) do
		list[#list + 1] = rc
	end
	local f, word = self.synth.filter, self.synth.word
	for _, e in ipairs(list) do
		local stone = e.result == shelter_synthesis.STONE
		local k = e.nature .. ":" .. shelter_synthesis.key(e.parts)
		local ok = f == "all" or (f == "stone") == stone and not seen[k]
		if ok and word ~= "" then
			local names = { tr("st_shelter_synth_short_" .. e.nature), synth_name(e.result), e.who or "" }
			for _, s in ipairs(e.parts) do
				names[#names + 1] = synth_name(s)
			end
			ok = string.find(lower(table.concat(names, "\n")), word, 1, true) ~= nil
		end
		seen[k] = true
		if ok then
			rows[#rows + 1] = e
		end
	end
	return rows
end

-- the window's body: the chambers, the filters and a page of the journal (only_if_changed: drawn again only when the
-- chambers or the journal have changed, the elapsed times put right each second)
function UIShelterOS:fill_synth(only_if_changed)
	local s = self.synth
	local states, sig = {}, {}
	for i, n in ipairs(SYNTH.natures) do
		states[i] = shelter_synthesis.status(n)
		local st = states[i]
		sig[#sig + 1] = tostring(st.installed) .. (st.what or "") .. (st.result or "") .. table.concat(st.parts or {}, ",")
	end
	local journal = shelter_synthesis.journal()
	sig[#sig + 1] = #journal
	sig = table.concat(sig, "|")
	if only_if_changed and sig == s.sig then
		for i, st in ipairs(states) do
			if s.elapsed[i] and st.elapsed then
				s.elapsed[i]:SetText(tr("st_shelter_synth_card_making", shelter_synthesis.duration_text(st.elapsed)))
			end
		end
		return
	end
	s.sig = sig
	if s.body then
		self.win:DetachChild(s.body)
	end
	for i = #self.app_clicks, 1, -1 do -- the old body's buttons
		if self.app_clicks[i].synth then
			table.remove(self.app_clicks, i)
		end
	end
	local W, H, pad = s.w, s.h, 18
	local body = self:box(0, 0, W, H, self.win)
	s.body = body
	-- the chambers
	s.elapsed = {}
	local cw = math.floor((W - 2 * pad - 3 * 12) / 4)
	for i, n in ipairs(SYNTH.natures) do
		local st, cx = states[i], pad + (i - 1) * (cw + 12)
		self:framed(cx, TOP, cw, SYNTH.card_h, C.raised, body, 8)
		local line, color, dot
		if not st.installed then
			line, color, dot = tr("st_shelter_synth_card_empty"), C.faint, C.faint
		elseif st.what == "making" then
			line, color, dot = st.elapsed and tr("st_shelter_synth_card_making", shelter_synthesis.duration_text(st.elapsed)) or "",
				C.text, C.accent
		elseif st.what == "out" then
			line, color, dot = tr("st_shelter_synth_card_out", synth_name(st.result)), C.text, C.warn
		else
			line, color, dot = tr("st_shelter_synth_card_free"), C.good, C.good
		end
		self:round(cx + 14, TOP + 17, 10, 10, dot, body, 5)
		self:text(cx + 32, TOP + 8, cw - 44, 28, tr("st_shelter_synth_short_" .. n), C.text, body)
		local t = self:text(cx + 14, TOP + 36, cw - 28, 30, line, color, body, nil, "s")
		if st.what == "making" then
			s.elapsed[i] = t
			for j, sec in ipairs(st.parts or {}) do
				if sec ~= "" then
					self:round(cx + 14 + (j - 1) * 50, TOP + 70, 44, 44, C.field, body, 6)
					self:icon(sec, cx + 16 + (j - 1) * 50, TOP + 72, 40, body)
				end
			end
		elseif st.what == "out" then
			self:round(cx + 14, TOP + 70, 44, 44, C.field, body, 6)
			self:icon(st.result, cx + 16, TOP + 72, 40, body)
		end
	end
	self:text(pad, TOP + SYNTH.card_h + 10, 400, 36, tr("st_shelter_synth_journal"), C.text, body, nil, "l")
	-- the filters: a row of tabs right of the search
	for i, f in ipairs(FILTERS) do
		self:button(366 + (i - 1) * 140, SYNTH.search_y, 132, 34, tr("st_shelter_synth_filter_" .. f), function()
			s.filter, s.page = f, 1
			self:fill_synth()
		end, self.app_clicks, body, self.wx, self.wy, f == s.filter and "on" or "normal").synth = true
	end
	-- the journal's columns
	local col = { when = pad + 10, chamber = pad + 128, parts = pad + 262, names = pad + 372, result = W - pad - 330,
		who = W - pad - 104 }
	for k, id in pairs({ when = "st_shelter_synth_col_when", chamber = "st_shelter_synth_col_chamber",
		parts = "st_shelter_synth_col_load", result = "st_shelter_synth_col_result", who = "st_shelter_synth_col_who" }) do
		self:text(col[k], SYNTH.head_y, 200, 22, tr(id), C.faint, body, nil, "s")
	end
	self:rect(pad, SYNTH.head_y + 24, W - 2 * pad, 1, C.line, body)
	-- a page of it
	local rows = self:synth_rows()
	local per_page = math.floor((H - SYNTH.list_y - 56) / SYNTH.row_h)
	local pages = math.max(1, math.ceil(#rows / per_page))
	s.page = math.min(s.page, pages)
	-- a load's time of day by the clock, so long before now; its day by the days since
	local clock = level.get_time_hours() * 3600 + level.get_time_minutes() * 60
	local now = game.get_game_time():diffSec(game.CTime())
	if #rows == 0 then
		self:text(pad + 10, SYNTH.list_y + 6, W - 2 * pad, 30, tr(#journal == 0 and "st_shelter_synth_journal_empty"
			or "st_shelter_synth_found_none"), C.faint, body)
	end
	for r = 1, per_page do
		local e = rows[(s.page - 1) * per_page + r]
		if not e then
			break
		end
		local y = SYNTH.list_y + (r - 1) * SYNTH.row_h
		if r % 2 == 0 then
			self:round(pad, y, W - 2 * pad, SYNTH.row_h - 2, C.white, body, 5, 7)
		end
		local when
		if e.chemist then
			when = tr("st_shelter_synth_chemist")
		else
			local back = math.max(0, now - e.t)
			local day = (clock - back) % 86400
			local hm = string.format("%02d:%02d", math.floor(day / 3600), math.floor(day % 3600 / 60))
			local days = back <= clock and 0 or math.ceil((back - clock) / 86400)
			when = days == 0 and hm or days == 1 and tr("st_shelter_synth_yesterday", hm) or tr("st_shelter_synth_days_ago", days, hm)
		end
		local th = SYNTH.row_h - 2
		self:text(col.when, y, 114, th, when, C.dim, body, nil, "s")
		self:text(col.chamber, y, 130, th, tr("st_shelter_synth_short_" .. e.nature), C.text, body, nil, "s")
		local names = {}
		for j, sec in ipairs(e.parts) do
			if sec ~= "" then
				self:icon(sec, col.parts + (j - 1) * 34, y + 2, 32, body)
				names[#names + 1] = synth_name(sec)
			end
		end
		self:text(col.names, y, col.result - col.names - 12, th, table.concat(names, ", "), C.text, body, nil, "s")
		local stone = e.result == shelter_synthesis.STONE
		self:icon(e.result, col.result, y + 2, 32, body)
		self:text(col.result + 40, y, col.who - col.result - 48, th, stone and tr("st_shelter_synth_row_stone", e.resonance,
			shelter_synthesis.SLOTS) or synth_name(e.result), stone and C.bad or C.good, body, nil, "s")
		self:text(col.who, y, W - pad - col.who, th, e.chemist and "" or e.who or "", C.dim, body, nil, "s")
	end
	local fy = H - 46
	if pages > 1 then
		self:button(pad, fy, 36, 30, "<", function() s.page = math.max(1, s.page - 1) self:fill_synth() end,
			self.app_clicks, body, self.wx, self.wy, s.page == 1 and "off" or "normal").synth = true
		self:text(pad + 40, fy, 90, 30, tr("st_shelter_synth_page", s.page, pages), C.dim, body, CGameFont.alCenter, "s")
		self:button(pad + 134, fy, 36, 30, ">", function() s.page = math.min(pages, s.page + 1) self:fill_synth() end,
			self.app_clicks, body, self.wx, self.wy, s.page == pages and "off" or "normal").synth = true
	end
	self:text(W - pad - 300, fy, 300, 30, tr("st_shelter_synth_count", #rows), C.faint, body, CGameFont.alRight, "s")
end

-------------------------------------------------------------------------------
-- the cleaning: what it does, and the start

function UIShelterOS:open_clean()
	local W, x = self:fit(520)
	local H = 260
	local win = self:window(x, 220, W, H, "clean")
	self:text(20, TOP, W - 40, 130, tr("st_shelter_clean_hint"), C.text, win)
	self:button(W - 20 - 240, H - 56, 240, 38, tr("st_shelter_clean"), function()
		self:Close()
		shelter.clean()
	end, self.app_clicks, win, self.wx, self.wy, "primary")
end

-------------------------------------------------------------------------------
-- the input, the time

function UIShelterOS:click(p)
	for _, list in ipairs({ self.menu_clicks or {}, self.app_clicks, self.clicks }) do
		for i = #list, 1, -1 do
			local c = list[i]
			if inside(p, c) then
				if self.menu and list ~= self.menu_clicks and not c.start then
					self:toggle_menu()
				end
				c[5](p)
				return
			end
		end
	end
	if self.menu then
		self:toggle_menu()
	end
end

function UIShelterOS:Update()
	CUIScriptWnd.Update(self)
	local now = time_global()
	if not self.ticked or now >= self.ticked then
		self.ticked = now + 1000
		self:tick()
	end
	if self.app_update then
		self.app_update(self)
	end
	self:hovers(self:cursor(), { self.menu_clicks or {}, self.app_clicks, self.clicks })
end

function UIShelterOS:OnKeyboard(dik, keyboard_action)
	local res = CUIScriptWnd.OnKeyboard(self, dik, keyboard_action)
	if res == false and keyboard_action == ui_events.WINDOW_KEY_PRESSED then
		if dik == DIK_keys.MOUSE_1 then
			self:click(self:cursor())
			return true
		elseif dik_to_bind(dik) == key_bindings.kQUIT then
			if self.menu then
				self:toggle_menu()
			elseif self.app then
				self:close_app()
			else
				self:Close()
			end
			return true
		end
	end
	return res
end

function UIShelterOS:Close()
	self:HideDialog()
	gui = nil
end

-- the laptop opened (shelter.script's laptop_binder)
function open()
	if not (gui and gui:IsShown()) then
		gui = UIShelterOS()
		gui:ShowDialog(true)
	end
end

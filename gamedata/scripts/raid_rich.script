-- The raid's rich stashes (docs/coop/shelter.md, "Raids"; settings: mod_system_raid.ltx [raid_rich], [raid_rich_<n>]). A box
-- on a deep level, made as one first goes there, its loot drawn anew every refill_hours, whether or not it was emptied.
-- No mark: found with the RF receiver, each on a frequency of its own.
-- The world's (shelter.state): raid_rich_box_<n>, raid_rich_freq_<n>, raid_rich_at_<n> (the game second of the last refill).

local S = "raid_rich"

local function list(section, key)
	local out = {}
	for _, v in ipairs(str_explode(ini_sys:r_string_ex(section, key) or "", ",")) do
		if v ~= "" then
			out[#out + 1] = v
		end
	end
	return out
end

local function game_seconds()
	return game.get_game_time():diffSec(level.get_start_time())
end

-- the old loot gone, a new one drawn by the stash's level (raid_loot.fill_rich)
local function refill(box_id, level_name)
	local sim = alife()
	local old = {}
	for id = 1, 65534 do
		local se = sim:object(id)
		if se and se.parent_id == box_id then
			old[#old + 1] = se
		end
	end
	for _, se in ipairs(old) do
		alife_release(se)
	end
	raid_loot.fill_rich(sim:object(box_id), level_name)
end

-- a raid level made ready as one goes onto it (before it loads)
function prepare(level_name)
	for _, name in ipairs(list(S, "list")) do
		local s = "raid_rich_" .. name
		if ini_sys:r_string_ex(s, "level") == level_name then
			local key = "raid_rich_box_" .. name
			local box = tonumber(shelter.state(key, nil))
			if not (box and alife():object(box)) then
				local p = str_explode(ini_sys:r_string_ex(s, "position"), ",")
				local pos = vector():set(tonumber(p[1]), tonumber(p[2]), tonumber(p[3]))
				local se = alife_create(ini_sys:r_string_ex(S, "box"), pos, ini_sys:r_u32(s, "node"), raid.vertex_of(level_name, pos))
				box = se and se.id
				shelter.set_state(key, box)
				shelter.set_state("raid_rich_at_" .. name, nil)
				shelter.set_state("raid_rich_freq_" .. name, math.random(ini_sys:r_float_ex(S, "freq_min") or 31, ini_sys:r_float_ex(S, "freq_max") or 299))
			end
			local at = tonumber(shelter.state("raid_rich_at_" .. name, nil))
			if box and (not at or game_seconds() - at >= (ini_sys:r_float_ex(S, "refill_hours") or 168) * 3600) then
				refill(box, level_name)
				shelter.set_state("raid_rich_at_" .. name, math.floor(game_seconds()))
				printf("raid_rich: %s refilled", name)
			end
		end
	end
end

-- the receiver hears those of the level
local function actor_on_first_update()
	local level_name = level.name()
	if not raid.is_raid_level(level_name) then
		return
	end
	for _, name in ipairs(list(S, "list")) do
		if ini_sys:r_string_ex("raid_rich_" .. name, "level") == level_name then
			local box = tonumber(shelter.state("raid_rich_box_" .. name, nil))
			if box then
				item_radio.add_target(box, tonumber(shelter.state("raid_rich_freq_" .. name, nil)), ini_sys:r_float_ex(S, "rf_distance") or 150)
			end
		end
	end
end

function on_game_start()
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
end

-- Co-op: one offline world (docs/coop/multiplayer.md). The world's host moves the squads no player has online, and
-- every SEND_MS tells the other games where they are and where they go; those games don't move them themselves
-- (the engine's CSE_ALifeOnlineOfflineGroup::update, coop_npc.h) and put them there. A squad a player's game has
-- online is that game's until it goes offline again: the host leaves it be, then goes on with it.

local SEND_MS = 5000
local FULL_MS = 60000 -- every squad, moved or not, this often: a game that came in since has them all
local PER_EVENT = 120 -- squads per event: well within a message
local NO_TARGET = 65535
local next_send = 0
local next_full = 0
local sent = {} -- squad id -> what was sent of it last, "gvid,lvid,target"
local hp_sent = {} -- member id -> its health sent last (thousandths)

-- The squads' health: a member wounded in a player's game stays wounded in the host's world (coop_npc.cpp takes it
-- from that game's stream), but in the other players' games only the stream's level had it: one who came there later
-- found them whole again. The host tells every game its members' health (changes; all the wounded ones each FULL_MS),
-- each game takes it onto its offline copies (coop.set_offline_health). Deaths go as deaths.
local function send_health(full)
	local part = {}
	local function flush()
		if #part > 0 then
			coop_sync.send_event("squad_hp", table.concat(part, ";"))
			part = {}
		end
	end
	local sim = alife()
	for id in pairs(SIMBOARD.squads) do
		local squad = sim:object(id)
		if squad then
			for member in squad:squad_members() do
				local se = sim:object(member.id)
				local hp = se and se:alive() and se:health() or 0
				if hp > 0 then
					local h = math.min(1000, math.floor(hp * 1000 + 0.5))
					local last = hp_sent[member.id]
					if (last and last ~= h) or (h < 1000 and (full or not last)) then
						part[#part + 1] = string.format("%d,%d", member.id, h)
						if #part >= PER_EVENT then
							flush()
						end
					end
					hp_sent[member.id] = h
				end
			end
		end
	end
	flush()
end

local function send_squads()
	local now = time_global()
	if now < next_send or not coop.connected() or not coop.is_host() then
		return
	end
	next_send = now + SEND_MS
	local full = now >= next_full
	if full then
		next_full = now + FULL_MS
	end
	local part = {}
	local function flush()
		if #part > 0 then
			coop_sync.send_event("squads", table.concat(part, ";"))
			part = {}
		end
	end
	local sim = alife()
	for id in pairs(SIMBOARD.squads) do
		local squad = sim:object(id)
		if squad and not squad.online and not coop.squad_online_elsewhere(id) and squad.m_game_vertex_id ~= NO_TARGET then
			local target = squad.assigned_target_id or NO_TARGET
			local key = string.format("%d,%d,%d", squad.m_game_vertex_id, squad.m_level_vertex_id, target)
			if full or sent[id] ~= key then
				sent[id] = key
				local p = squad.position
				part[#part + 1] = string.format("%d,%d,%d,%.2f,%.2f,%.2f,%d", id, squad.m_game_vertex_id,
					squad.m_level_vertex_id, p.x, p.y, p.z, target)
				if #part >= PER_EVENT then
					flush()
				end
			end
		end
	end
	flush()
	send_health(full)
end

local function on_squad_hp(sender, payload)
	if coop.is_host() or not coop.set_offline_health then
		return
	end
	local taken = 0
	for id, h in string.gmatch(payload, "(%d+),(%d+)") do
		if coop.set_offline_health(tonumber(id), tonumber(h) / 1000) then
			taken = taken + 1
		end
	end
	if taken > 0 and get_console():get_integer("coop_debug") == 1 then
		printf("[coop dbg] %s offline NPC(s) as wounded as the host has them", taken)
	end
end

local function on_squads(sender, payload)
	if coop.is_host() then
		return
	end
	local sim = alife()
	local moved = 0
	for id, gvid, lvid, x, y, z, target in string.gmatch(payload,
		"(%d+),(%d+),(%d+),([%-%d%.]+),([%-%d%.]+),([%-%d%.]+),(%d+)") do
		id, gvid, lvid, target = tonumber(id), tonumber(gvid), tonumber(lvid), tonumber(target)
		local squad = SIMBOARD.squads[id] and sim:object(id)
		-- a squad not placed yet on the host (gvid 65535: one just made) is no place: teleport_object would die on it
		if squad and not squad.online and game_graph():valid_vertex_id(gvid) then
			if squad.m_game_vertex_id ~= gvid or squad.m_level_vertex_id ~= lvid then
				TeleportSquad(squad, vector():set(tonumber(x), tonumber(y), tonumber(z)), lvid, gvid)
				moved = moved + 1
			end
			if target ~= NO_TARGET then
				squad.assigned_target_id = target
			end
		end
	end
	if moved > 0 and get_console():get_integer("coop_debug") == 1 then
		printf("[coop dbg] %s squad(s) moved where the host has them", moved)
	end
end

function on_game_start()
	if not coop then
		return -- not the co-op engine
	end
	RegisterScriptCallback("actor_on_update", send_squads)
	coop_sync.on_event("squads", on_squads)
	coop_sync.on_event("squad_hp", on_squad_hp)
end

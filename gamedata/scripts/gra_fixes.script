-- Fixes to the Grim Raid Addon weapon pack at run time (tools\gra\build_pack.py brings the pack in; this file is the
-- repo's own, like configs\mod_system_gra_fixes.ltx)

-- The pack's scopes (Shader 3D Scopes, Pizza's, MAS) draw their lenses and reticles only with the engine's 3D shader
-- scopes on (r__3Dfakescope, off by default): without it an ACOG is an empty tube. GRA turned it on in its graphics
-- preset script, left out of the pack as it forces a dozen other settings; this turns it on once per game, so the
-- option can still be turned off in the settings.
local scopes_on
-- The pack's weapon positions (MRAA, 3D scopes) are made for GRA's HUD field of view, 0.64 (its user.ltx): with the
-- vanilla 0.45 hands and guns sit in the face. Set once per game the same way.
local hud_fov_set
-- A scope with a second sight (an ACOG's, a Razor HD's alternative aim) switches on the engine's wpn_func (V here); GRA
-- had Alt with the aim button for it, so it's that too: Alt while aiming changes the sight; Alt + the aim button from
-- the hip takes the other sight and aims through it.
local function switch_sight()
	local func = bind_to_dik(key_bindings.kWPN_FUNC)
	level.press_action(func)
	level.release_action(func)
end

local function on_before_key_press(key, bind, dis, flags)
	local wpn = db.actor:active_item()
	if not (wpn and IsWeapon(wpn) and actor_menu.is_hud_free()) then
		return
	end
	if key == DIK_keys.DIK_LMENU or key == DIK_keys.DIK_RMENU then
		if axr_main.weapon_is_zoomed then
			switch_sight()
		end
	elseif bind == key_bindings.kWPN_ZOOM and ui_mcm.get_mod_key(3) then
		if axr_main.weapon_is_zoomed then
			flags.ret_value = false -- toggled aiming: Alt has changed the sight already, the aim stays
		else
			switch_sight()
		end
	end
end

function actor_on_first_update()
	if not scopes_on then
		exec_console_cmd("r__3Dfakescope 1")
		scopes_on = true
	end
	if not hud_fov_set then
		exec_console_cmd("hud_fov 0.64")
		hud_fov_set = true
	end
end

function save_state(m_data)
	m_data.gra_3d_scopes_on = scopes_on
	m_data.gra_hud_fov_set = hud_fov_set
end

function load_state(m_data)
	scopes_on = m_data.gra_3d_scopes_on
	hud_fov_set = m_data.gra_hud_fov_set
end

function on_game_start()
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
	RegisterScriptCallback("save_state", save_state)
	RegisterScriptCallback("load_state", load_state)
	RegisterScriptCallback("on_before_key_press", on_before_key_press)
end

-- Co-op: the looks of the Zone's event "Ash front" (coop_zone_ash.script; settings [zone_event_ash_fx] in
-- mod_system_zone_ash_fx.ltx). Particles are each game's own, so every game with a player makes them for its player
-- from the front's strength the master decides (coop_zone_ash.ash_now(): the fact ash_now_<level>); the headless host
-- makes none.
--   falling ash  on fall_levels: Anomaly's snow made grey (fall_sizes: rings of flakes round the emitter; which set:
--                fall_size, or the admin window's test button over it, coop_zone_ash.test_look()) moved
--                with the camera, a little ahead of a moving player and upwind; the flakes drift with the weather's
--                wind (the emitter's motion: Parent Motion in the .pe). How much: the player's option "Ash" (Options >
--                Co-op, ash_level()) - copies of it (fall_copies) - times the front's strength, in the hour's tone
--                (day, dusk, night). Under a roof they stop and their flakes go after fall_fade_s
--   embers       ember_particle, one emitter with the falling ash while the strength is ember_from or more
--   fires        fire_particle at the points fire_<level> for as long as the front is on that level
--   intensity()  the front's strength on this level now, 0..1 (0: none here), the master's (ramp_in_min, ramp_out_min,
--                ramp_stop_s)
-- The weather (fog, the wind) is the event's w_zev_ash (coop_zone_ash.weather()).

local S = "zone_event_ash_fx"
local OPTION = "coop/general/ash_fall"

local function num(key, default)
	return ini_sys:r_float_ex(S, key) or default
end

local function str(key, default)
	return ini_sys:r_string_ex(S, key) or default
end

local function ghost()
	return coop and coop.connected and coop.connected() and coop.is_host() -- the headless host has no player
end

local function listed(key, value)
	for _, v in ipairs(coop_zone_events.ini_list(S, key)) do
		if v == value then
			return true
		end
	end
	return false
end

-------------------------------------------------------------------------------
-- the strength

-- the front's strength on this level now, 0..1 (0: no front here), as the master decided it
function intensity()
	local _, fall = coop_zone_ash.ash_now()
	return fall
end

-- the player's choice of how much ash: 0 off .. #fall_copies (the Co-op options page; fall_default till he sets it)
function ash_level()
	local v = ui_options and ui_options.get(OPTION)
	return math.floor(tonumber(v) or num("fall_default", 2))
end

-- the falling ash's tone by the hour (its shader is unlit): day, dusk or night (fall_tone_hours: dusk from, day from,
-- dusk from, night from)
local function tone()
	local t = coop_zone_events.ini_list(S, "fall_tone_hours")
	local h = level.get_time_hours() + level.get_time_minutes() / 60
	local dawn, day, dusk, night = tonumber(t[1]) or 5, tonumber(t[2]) or 7, tonumber(t[3]) or 19, tonumber(t[4]) or 21
	if h >= day and h < dusk then
		return "day"
	elseif (h >= dawn and h < day) or (h >= dusk and h < night) then
		return "dusk"
	end
	return "night"
end

-------------------------------------------------------------------------------
-- falling ash: copies of the ash snow (Anomaly's snow: rings round the emitter) moved with the camera

local falls = {} -- the emitters making flakes now: { name =, p = }
local fading = {} -- emitters stopped, their flakes in the air still falling: { p =, till = time_global() }
local last_pos, last_move = nil, 0

-- under a roof: a ray straight up hits the level's buildings (trees aren't in it)
local function under_roof(pos)
	local rp = ray_pick(pos, vector():set(0, 1, 0), num("fall_roof_m", 25), rq_target.rqtStatic, nil)
	return rp:query()
end

-- the weather's wind on screen, metres a second (the same in every game on the level: its weather and hour are the
-- world's): it blows towards wind_direction (0 north, +z)
local function wind()
	local v = math.min(weather.get_value_numric("wind_velocity") * num("fall_wind", 0.004), num("fall_wind_max", 6))
	local d = weather.get_value_numric("wind_direction")
	return vector():set(math.sin(d) * v, 0, math.cos(d) * v)
end

-- no more flakes from p; those in the air fall on for ms
local function fade(p, now, ms)
	p:stop_deffered()
	fading[#fading + 1] = { p = p, till = now + ms }
end

local function clear_falls()
	for _, e in ipairs(falls) do
		e.p:stop()
	end
	for _, e in ipairs(fading) do
		e.p:stop()
	end
	falls, fading = {}, {}
end

-- want: the effects to fall now, a list of names (empty: none)
local function update_falls(now, want)
	for i = #fading, 1, -1 do
		if now >= fading[i].till then
			fading[i].p:stop()
			table.remove(fading, i)
		end
	end
	local cam = device().cam_pos
	local vel = vector():set(0, 0, 0)
	if last_pos and now > last_move then
		vel:sub(cam, last_pos):mul(1000 / (now - last_move))
		if vel:magnitude() > 15 then
			vel:set(0, 0, 0) -- a teleport or a level's start: no lead
		end
	end
	last_pos, last_move = vector():set(cam), now
	if #want == 0 or under_roof(cam) then
		for _, e in ipairs(falls) do
			fade(e.p, now, num("fall_fade_s", 1.5) * 1000)
		end
		falls = {}
		return
	end
	-- emitters no longer wanted (another tone, fewer copies): their flakes fall on, for their life
	local keep = 0
	while falls[keep + 1] and falls[keep + 1].name == want[keep + 1] do
		keep = keep + 1
	end
	for i = #falls, keep + 1, -1 do
		fade(falls[i].p, now, num("fall_life_s", 8) * 1000)
		falls[i] = nil
	end
	-- the flakes are born up high and fall a few seconds: the emitters go where a moving player will be by then, and
	-- upwind so the wind brings them onto him
	local w = wind()
	local pos = vector():set(cam):mad(vel, num("fall_lead_s", 3)):mad(w, -num("fall_upwind_s", 4))
	for i, name in ipairs(want) do
		local e = falls[i]
		if not e then
			e = { name = name, p = particles_object(name) }
			e.p:play_at_pos(pos)
			falls[i] = e
		end
		e.p:move_to(pos, w)
	end
end

-------------------------------------------------------------------------------
-- fires

local fires = nil -- the level's fire particles while the front is on it

local function fire_points(lvl)
	local t = {}
	for entry in string.gmatch(ini_sys:r_string_ex(S, "fire_" .. lvl) or "", "[^,]+") do
		local x, y, z = string.match(entry, "([%-%d%.]+)%s*:%s*([%-%d%.]+)%s*:%s*([%-%d%.]+)") -- the ltx drops spaces
		if z then
			t[#t + 1] = vector():set(tonumber(x), tonumber(y), tonumber(z))
		end
	end
	return t
end

local function update_fires(on)
	if on and not fires then
		fires = {}
		for _, pos in ipairs(fire_points(level.name())) do
			local p = particles_object(str("fire_particle", "coop\\ash_fire"))
			p:play_at_pos(pos)
			fires[#fires + 1] = p
		end
		coop_zone_events.dbg("ash fx: %s fire(s) on %s", #fires, level.name())
	elseif not on and fires then
		for _, p in ipairs(fires) do
			p:stop_deffered()
		end
		fires = nil
		coop_zone_events.dbg("ash fx: the fires are out")
	end
end

-------------------------------------------------------------------------------

local next_look = 0
local want, want_text = {}, "" -- the effects to fall now (the embers first, then the ash's copies), as one line

local function actor_on_update()
	local now = time_global()
	if now >= next_look then
		next_look = now + 1000
		local k = ghost() and 0 or intensity()
		update_fires(k > 0)
		local copies = coop_zone_events.ini_list(S, "fall_copies")
		local choice = math.min(ash_level(), #copies)
		local n = (k > 0 and choice > 0 and listed("fall_levels", level.name())) and math.max(1, math.ceil(k * choice)) or 0
		local list = {}
		if n > 0 then
			local ember = str("ember_particle", "")
			if ember ~= "" and k >= num("ember_from", 0.3) then
				list[1] = ember
			end
			local sizes = coop_zone_events.ini_list(S, "fall_sizes")
			local size = coop_zone_ash.test_look() or num("fall_size", 2)
			local effect = (sizes[size] or sizes[1] or "coop\\ash_snow") .. "_" .. tone()
			for i = 1, math.max(1, math.floor(tonumber(copies[n]) or 1)) do
				list[#list + 1] = effect
			end
		end
		local text = table.concat(list, ", ")
		if text ~= want_text then
			coop_zone_events.dbg("%s", string.format("ash fx: falling %s (strength %.2f, the player's choice %s)",
				text ~= "" and text or "nothing", k, choice))
			want, want_text = list, text
		end
	end
	if now >= last_move + num("fall_move_ms", 100) and (#want > 0 or #falls > 0 or #fading > 0) then
		update_falls(now, want)
	end
end

-- the level goes: its particles with it
local function actor_on_net_destroy()
	clear_falls()
	want, want_text = {}, ""
	if fires then
		for _, p in ipairs(fires) do
			p:stop()
		end
		fires = nil
	end
	next_look, last_move, last_pos = 0, 0, nil
end

function on_game_start()
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("actor_on_net_destroy", actor_on_net_destroy)
end

-- Co-op: our character's saves, kept by the server (coop-server/src/storage.js). While this game runs the
-- shared world the pause menu's Save, Load and Last save open this window (modxml_coop_saves.script).
-- A save is a snapshot of our character (where it is, its things, money, tasks, rank); a group's leader saves
-- and loads the whole group. Going back to one, the world loads again with the character put back; the world
-- itself never goes back (coop_save.cpp, docs/coop/multiplayer.md).

local REFRESH_MS = 3000
local wnd = nil     -- the window, made on first use
local saves = {}    -- { id, time, name, reason, who }, newest first, as the server last sent them

local function trim(s)
	return string.match(s or "", "^%s*(.-)%s*$")
end

local function tr(key, ...)
	return strformat(game.translate_string(key), ...)
end

-- what a save is: its name, a quick one, or the group's (and who saved it)
local function label(s)
	if s.reason == "group" then
		local text = tr("st_coop_save_group")
		if s.name ~= "" then
			text = text .. " " .. tr("st_coop_save_named", s.name)
		end
		return text .. " - " .. s.who
	end
	return tr("st_coop_save_" .. s.reason, s.name)
end

-- alone, or the leader of our group (coop.group(): the names, leader first)
function may_save()
	local group = coop.group()
	return #group == 0 or group[1] == coop.my_name()
end

local function ago(time)
	local minutes = math.floor((os.time() - time) / 60)
	if minutes < 1 then
		return tr("st_coop_ago_now")
	elseif minutes < 60 then
		return tr("st_coop_ago_min", minutes)
	elseif minutes < 60 * 24 then
		return tr("st_coop_ago_hours", math.floor(minutes / 60))
	end
	return tr("st_coop_ago_days", math.floor(minutes / 60 / 24))
end

local function line(s)
	return string.format("#%d   %s (%s)   %s", s.id, os.date("%d.%m %H:%M", s.time), ago(s.time), label(s))
end

class "UICoopSaves" (CUIScriptWnd)

function UICoopSaves:__init(owner) super()
	self.owner = owner
	self:InitControls()
	self:InitCallBacks()
end

function UICoopSaves:__finalize()
end

function UICoopSaves:InitControls()
	self:SetWndRect(Frect():set(0, 0, 1024, 768))
	local xml = CScriptXmlInit()
	xml:ParseFile("ui_coop_saves.xml")

	xml:InitStatic("background", self)
	local form = xml:InitStatic("form", self)
	xml:InitTextWnd("form:caption", form)
	xml:InitFrame("form:list_frame", form)
	self.list = xml:InitListBox("form:list", form)
	self.list:ShowSelectedItem(true)
	self:Register(self.list, "list")
	xml:InitTextWnd("form:cap_name", form)
	self.edit_name = xml:InitEditBox("form:edit_name", form)
	self:Register(self.edit_name, "edit_name")
	self.status = xml:InitTextWnd("form:status", form)
	for _, name in ipairs({ "btn_save", "btn_rollback", "btn_close" }) do
		self:Register(xml:Init3tButton("form:" .. name, form), name)
	end
end

function UICoopSaves:InitCallBacks()
	self:AddCallback("btn_save", ui_events.BUTTON_CLICKED, self.OnSave, self)
	self:AddCallback("btn_rollback", ui_events.BUTTON_CLICKED, self.OnRollback, self)
	self:AddCallback("btn_close", ui_events.BUTTON_CLICKED, self.Close, self)
end

function UICoopSaves:SetStatus(key, ...)
	self.status:SetText(tr(key, ...))
end

function UICoopSaves:Fill()
	local selected = self.list:GetSelectedIndex()
	self.list:RemoveAll()
	for _, s in ipairs(saves) do
		self.list:AddTextItem(line(s))
	end
	if selected >= 0 and selected < #saves then
		self.list:SetSelectedIndex(selected)
	end
end

function UICoopSaves:Open()
	self.asked = nil
	self:Fill()
	self:SetStatus(not may_save() and "st_coop_saves_leader" or #saves > 0 and "st_coop_saves_hint" or "st_coop_saves_loading")
	self:ShowDialog(true)
	self.owner:HideDialog()
	self.owner:Show(false)
end

function UICoopSaves:Close()
	self.owner:ShowDialog(true)
	if self:IsShown() then
		self:HideDialog()
	end
	self.owner:Show(true)
end

function UICoopSaves:Update()
	CUIScriptWnd.Update(self)
	local now = device():time_continual()
	if not self.asked or now - self.asked > REFRESH_MS then
		self.asked = now
		coop.request_saves()
	end
end

function UICoopSaves:OnSave()
	if not may_save() then
		return self:SetStatus("st_coop_saves_leader")
	end
	coop.request_save(trim(self.edit_name:GetText()))
	self.edit_name:SetText("")
	self:SetStatus("st_coop_saves_saving")
	self.asked = device():time_continual() - REFRESH_MS + 1500 -- the new one shows up soon
end

function UICoopSaves:OnRollback()
	local i = self.list:GetSelectedIndex()
	local s = saves[i + 1]
	if not s then
		return self:SetStatus("st_coop_saves_pick")
	elseif not may_save() then
		return self:SetStatus("st_coop_saves_leader")
	end
	coop.load_save(s.id)
	self:SetStatus("st_coop_saves_going_back")
end

function UICoopSaves:OnKeyboard(dik, keyboard_action)
	local res = CUIScriptWnd.OnKeyboard(self, dik, keyboard_action)
	if res == false and keyboard_action == ui_events.WINDOW_KEY_PRESSED and dik == DIK_keys.DIK_ESCAPE then
		self:Close()
	end
	return res
end

function is_shown()
	return wnd ~= nil and wnd:IsShown()
end

-- the pause menu (owner) opens it
function open(owner)
	if not (wnd and rawequal(wnd.owner, owner)) then -- engine objects have no == of their own
		wnd = UICoopSaves(owner)
	end
	wnd:Open()
end

local function show_result(text)
	if is_shown() then
		wnd.status:SetText(text)
	end
	if db.actor then
		actor_menu.set_msg(1, text, 6)
	end
end

-- from the engine (coop_save.cpp): "id\ttime\tname\treason\twho\t0" lines, newest first
function on_saves(text)
	saves = {}
	for id, time, name, reason, who in string.gmatch(text, "(%d+)\t(%d+)\t([^\t]*)\t([^\t]*)\t([^\t]*)\t%d+\n") do
		saves[#saves + 1] = { id = tonumber(id), time = tonumber(time), name = name, reason = reason, who = who }
	end
	if is_shown() then
		wnd:Fill()
	end
end

-- result: 0 the world loads again with our character put back, 1 no such save, 2 a group's save: its leader loads it
function on_load_result(result, id)
	show_result(tr("st_coop_load_" .. result, id))
end

-- Co-op: F on another player (on their stand-in, src/xrGame/coop/coop_combat.h) opens this wheel, as F on
-- a companion opens the companions' one: trade, the group, passing notes, routes and the story (coop_story.script).
-- On a player lying wounded F helps them up instead (coop_death.script).

local GUI = nil
local opened_at = 0

-- the wheel's actions: hint text and what it does with the player (peer id, name)
local ACTIONS = {
	trade = {
		hint = function() return "st_coop_wheel_trade" end,
		run = function(id, name) coop_trade.offer(id, name) end,
	},
	group = {
		hint = function(id, name)
			if not coop_group.has(name) then
				return "st_coop_wheel_invite"
			end
			return coop_group.is_leader() and "st_coop_wheel_kick" or "st_coop_wheel_leave"
		end,
		run = function(id, name)
			if not coop_group.has(name) then
				coop.group_invite(id, false) -- face to face: a yes/no box
				actor_menu.set_msg(1, string.format(game.translate_string("st_coop_group_invited"), name), 4)
			elseif coop_group.is_leader() then
				coop.group_kick(name)
			else
				coop.group_leave()
			end
		end,
	},
	notes = {
		hint = function() return "st_coop_wheel_notes" end,
		run = function(id, name) coop_share.notes(name) end,
	},
	routes = {
		hint = function() return "st_coop_wheel_routes" end,
		run = function(id, name) coop_share.routes(name) end,
	},
	story = {
		hint = function() return "st_coop_wheel_story" end,
		run = function(id, name) coop_story.share(name) end,
	},
}

local ICON = GetARGB(255, 200, 200, 200) -- the icons' grey, amber under the cursor
local ICON_LIT = GetARGB(255, 238, 155, 23)

-- how much narrower a square unit is across than down: the layout is made as for a 4:3 screen
local function narrowing()
	return (1024 / 768) / (device().width / device().height)
end

-- a part laid out for 4:3 put right on this screen: a top one stays centred, a part inside its parent keeps its place
local function narrow(wnd, k, top)
	local pos, w = wnd:GetWndPos(), wnd:GetWidth()
	local x = top and 512 + (pos.x - 512) * k or pos.x * k
	wnd:SetWndPos(vector2():set(x, pos.y))
	wnd:SetWndSize(vector2():set(w * k, wnd:GetHeight()))
end

class "UICoopWheel" (CUIScriptWnd)

function UICoopWheel:__init() super()
	self:SetWndRect(Frect():set(0, 0, 1024, 768))
	self:SetAutoDelete(true)

	local xml = CScriptXmlInit()
	xml:ParseFile("ui_coop_wheel.xml")
	self.dialog = xml:InitStatic("wheel", self)
	local parts = { xml:InitStatic("wheel:background", self.dialog) }
	self.buttons, self.icons = {}, {}
	for action in pairs(ACTIONS) do
		self.buttons[action] = xml:Init3tButton("wheel:btn_" .. action, self.dialog)
		self:Register(self.buttons[action], "btn_" .. action)
		self:AddCallback("btn_" .. action, ui_events.BUTTON_CLICKED, function() self:Do(action) end, self)
		self.icons[action] = xml:InitStatic("wheel:icon_" .. action, self.dialog) -- over its button
		self:SetIcon(action, action == "group" and "group_add" or action) -- the group's is set for the player (Reset)
		parts[#parts + 1] = self.buttons[action]
		parts[#parts + 1] = self.icons[action]
	end
	self.hint = xml:InitTextWnd("wheel:hint", self.dialog)
	self.hint_desc = xml:InitTextWnd("wheel:hint_desc", self.dialog)
	local info = xml:InitStatic("info", self)
	parts[#parts + 1] = xml:InitStatic("info:background", info)
	self.name = xml:InitTextWnd("info:name", info)
	self.status = xml:InitTextWnd("info:status", info)
	for _, part in ipairs({ self.hint, self.hint_desc, self.name, self.status }) do
		parts[#parts + 1] = part
	end
	self.k = narrowing()
	narrow(self.dialog, self.k, true)
	narrow(info, self.k, true)
	for _, part in ipairs(parts) do
		narrow(part, self.k)
	end
end

function UICoopWheel:__finalize()
end

-- the icons: tools/coop/wheel_ui.py
function UICoopWheel:SetIcon(action, picture)
	self.icons[action]:InitTexture("ui\\coop\\wheel_" .. picture)
	self.icons[action]:SetStretchTexture(true)
	self.icons[action]:SetTextureColor(ICON)
end

function UICoopWheel:Reset(id, name)
	self.id, self.player = id, name
	self.name:SetText(name)
	local in_group = coop_group.has(name)
	self.status:SetText(game.translate_string(in_group and "st_coop_wheel_in_group" or "st_coop_wheel_not_in_group"))
	-- invite: a plus; put out (the leader): a minus; leave: a door
	self:SetIcon("group", not in_group and "group_add" or coop_group.is_leader() and "group_remove" or "group_leave")
end

function UICoopWheel:Update()
	CUIScriptWnd.Update(self)
	local lit
	for action, button in pairs(self.buttons) do
		local over = not lit and button:IsCursorOverWindow()
		self.icons[action]:SetTextureColor(over and ICON_LIT or ICON)
		lit = lit or over and action
	end
	if lit then
		local hint = ACTIONS[lit].hint(self.id, self.player)
		self.hint:SetText(game.translate_string(hint))
		self.hint_desc:SetText(game.translate_string(hint .. "_d"))
		return
	end
	self.hint:SetText("")
	self.hint_desc:SetText("")
end

function UICoopWheel:Do(action)
	self:HideDialog()
	ACTIONS[action].run(self.id, self.player)
end

function UICoopWheel:OnKeyboard(dik, keyboard_action)
	local res = CUIScriptWnd.OnKeyboard(self, dik, keyboard_action)
	if res == false and keyboard_action == ui_events.WINDOW_KEY_RELEASED then
		local bind = dik_to_bind(dik)
		if time_global() > opened_at + 100 and (bind == key_bindings.kQUIT or bind == key_bindings.kUSE) then
			self:HideDialog()
		end
	end
	return res
end

function open(id, name)
	if not GUI or math.abs(GUI.k - narrowing()) > 0.001 then -- none yet, or made for another screen shape
		GUI = UICoopWheel()
	end
	if GUI:IsShown() then
		return
	end
	hide_hud_inventory()
	GUI:Reset(id, name)
	GUI:ShowDialog(true)
	opened_at = time_global()
end

function on_game_start()
	if not coop then
		return -- not the co-op engine
	end
	_G.coop_on_use_player = function(id, name)
		if coop_death.help(id, name) then
			return -- lying wounded: F helps them up
		end
		open(id, name)
	end
	RegisterScriptCallback("actor_on_net_destroy", function() GUI = nil end)
end

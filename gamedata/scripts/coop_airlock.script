-- Co-op: the Yantar bunker's airlock (configs\scripts\yantar\yan_smart_terrain_6_4_ph_door_outer.ltx, _inner.ltx): its
-- doors' logic asks about the other door. coop_door_in(<door>:<section>:...): that door is in one of those sections, as
-- this game has it - at the level's authority, which runs the doors' logic (coop_physics.script), at once after its own
-- switch, so of two players asking at the two doors at the same moment only one gets his door open. A door that isn't
-- online here: in none.

local ids = {} -- door name -> its object id

local function door(name)
	local id = ids[name]
	local obj = id and level.object_by_id(id)
	if obj and obj:name() == name then
		return obj
	end
	ids[name] = nil
	for did in pairs(db.level_doors or {}) do
		local o = level.object_by_id(did)
		if o and o:name() == name then
			ids[name] = did
			return o
		end
	end
	return nil
end

-- The steam between the doors ([coop_airlock]): a puff of the particle at each point of the paths and the hiss at the
-- first one, again every steam_repeat_s for steam_s. An effect of the inner door's switch: the authority plays it, the
-- others play it again (coop_physics replay_effects)
local S = "coop_airlock"
local steam_until, next_puff = 0, 0
local puffs = {} -- the particles playing: { p = particles_object, till = time_global() }

local function puff()
	local name = ini_sys:r_string_ex(S, "steam_particle") or ("static" .. string.char(92) .. "zharka_static_steam")
	local first
	for path in string.gmatch(ini_sys:r_string_ex(S, "steam_paths") or "", "[^,%s]+") do
		if level.patrol_path_exists(path) then
			local pt = patrol(path)
			for i = 0, pt:count() - 1 do
				local p = particles_object(name)
				p:play_at_pos(pt:point(i))
				puffs[#puffs + 1] = { p = p, till = steam_until }
				first = first or pt:point(i)
			end
		end
	end
	local snd = ini_sys:r_string_ex(S, "steam_sound")
	if snd and first then
		local so = sound_object(snd)
		so:play_at_pos(db.actor, first, 0, sound_object.s3d)
		so.volume = ini_sys:r_float_ex(S, "steam_volume") or 1
	end
end

local function play_steam()
	steam_until = time_global() + (ini_sys:r_float_ex(S, "steam_s") or 5) * 1000
	next_puff = 0
end

local function update_steam()
	local now = time_global()
	if now < steam_until and now >= next_puff and db.actor then
		next_puff = now + math.max(0.3, ini_sys:r_float_ex(S, "steam_repeat_s") or 1.2) * 1000
		puff()
	end
	for i = #puffs, 1, -1 do
		local e = puffs[i]
		if now >= e.till or not e.p:playing() then
			if e.p:playing() then
				e.p:stop()
			end
			table.remove(puffs, i)
		end
	end
end

-- The safety net (the level's authority, which runs the doors' logic): a player between the doors with both of them
-- shut and nothing moving for stuck_s ([coop_airlock]) gets the inner door opened, whatever the doors' logic came to
local next_look, still_since, still_pair = 0, nil, nil
local SHUT_OUTER = { ["ph_door@closed"] = true, ["ph_door@locked"] = true, ["ph_door@entered"] = true }
local SHUT_INNER = { ["ph_door@closed"] = true, ["ph_door@locked"] = true }

local function player_between(zone)
	if db.actor and zone:inside(db.actor:position()) then
		return true
	end
	if coop and coop.stand_in_peer then
		for i = 1, #db.OnlineStalkers do
			local id = db.OnlineStalkers[i]
			local o = db.storage[id] and db.storage[id].object
			if o and coop.stand_in_peer(id) ~= 0 and zone:inside(o:position()) then
				return true
			end
		end
	end
	return false
end

-- NPCs: the engine's doors keep who walks through them, and an NPC's use reaches the door's logic once, when he first
-- comes to it. When the logic left the door shut then (the other door was open: locked), he stood at it for good once
-- it was free again. An airlock door shut (closed, locked, entered) that an NPC wants open for npc_wait_s gets his use again
local wanted = {} -- door id -> time_global() since an NPC wants it open while it is shut
local NPC_SHUT = { ["ph_door@closed"] = true, ["ph_door@locked"] = true, ["ph_door@entered"] = true }

local function wants_open(obj)
	if type(obj.is_door_wanted_open_by_npc) == "function" then
		return obj:is_door_wanted_open_by_npc()
	end
	return obj:is_door_blocked_by_npc() -- an engine before it: someone keeps the door as he wants it
end

local function npcs_through(now, obj, section)
	local id = obj:id()
	if not (NPC_SHUT[section] and wants_open(obj)) then
		wanted[id] = nil
		return
	end
	wanted[id] = wanted[id] or now
	if now - wanted[id] < (ini_sys:r_float_ex(S, "npc_wait_s") or 4) * 1000 then
		return
	end
	wanted[id] = now
	local st = db.storage[id]
	local action = st and st.ph_door and st.ph_door.door_action
	if action then
		printf("[coop] airlock: an NPC waits at %s (%s): his use again", obj:name(), section)
		action:use_callback(obj, nil)
	end
end

local function safety_net()
	local now = time_global()
	if now < next_look then
		return
	end
	next_look = now + 1000
	if coop and coop.connected and coop.connected() and not coop.is_authority(level.name()) then
		still_since = nil
		return
	end
	local outer = door(ini_sys:r_string_ex(S, "outer_door") or "")
	local inner = door(ini_sys:r_string_ex(S, "inner_door") or "")
	local zone = db.zone_by_name[ini_sys:r_string_ex(S, "zone") or ""]
	local so = outer and db.storage[outer:id()] and db.storage[outer:id()].active_section
	local si = inner and db.storage[inner:id()] and db.storage[inner:id()].active_section
	if outer then
		npcs_through(now, outer, so)
	end
	if inner then
		npcs_through(now, inner, si)
	end
	if not (zone and SHUT_OUTER[so] and SHUT_INNER[si] and player_between(zone)) then
		still_since = nil
		return
	end
	local pair = so .. "|" .. si
	if still_pair ~= pair or not still_since then
		still_pair, still_since = pair, now
		return
	end
	if now - still_since >= (ini_sys:r_float_ex(S, "stuck_s") or 10) * 1000 then
		still_since = nil
		printf("[coop] airlock: a player stuck between the doors (%s, %s): the inner door opens", so, si)
		xr_logic.switch_to_section(inner, db.storage[inner:id()].ini, "ph_door@open")
	end
end

function on_game_start()
	xr_effects.coop_airlock_steam = function()
		play_steam()
	end
	RegisterScriptCallback("actor_on_update", update_steam)
	RegisterScriptCallback("actor_on_update", safety_net)
	xr_conditions.coop_door_in = function(actor, npc, p)
		local obj = p and p[1] and door(p[1])
		local st = obj and db.storage[obj:id()]
		local section = st and st.active_section
		if not section then
			return false
		end
		for i = 2, #p do
			if p[i] == section then
				return true
			end
		end
		return false
	end
end

-- Artefact synthesis (docs/coop/shelter.md, "Камеры синтеза"): Herman's capsules filled in anomalies. A capsule of a
-- nature goes into an anomaly of that nature near the actor ("Put into the anomaly"); about a minute later it lies
-- there full, and the anomaly is burnt out till the next emission. All of it only in a suit the work allows
-- ([shelter_synthesis] suits): in any other the capsule's discharge kills, and nothing's done. The capsules being
-- filled and the anomalies burnt out are the world's (shelter.state), the filled ones count for the shelter's tasks.
-- Then a capsule of each nature into its chamber by the shelter's entrance, the same way only in such a suit.

local SETTINGS = "shelter_synthesis"
local FILLING = "shelter_capsule_filling" -- the capsule in the anomaly while it fills
-- an anomaly's nature by the hit it deals; fields, campfires and the odd ones have none
local NATURE_OF_HIT = { burn = "thermo", light_burn = "thermo", chemical_burn = "chem", shock = "electro", strike = "gravi" }
local NO_NATURE_CLASS = { ZS_RADIO = true, Z_CFIRE = true } -- fields, campfires
local NO_NATURE = { "zone_teleport", "zone_sarcofag", "zone_emi", "zone_monolith", "zone_mine_field" } -- by prefix
local NATURE_OF = { zone_no_gravity = "gravi" } -- by prefix: an electric hit, a gravitational anomaly
local HIT_OF_NATURE = { thermo = hit.burn, chem = hit.chemical_burn, electro = hit.shock, gravi = hit.strike }
local UPDATE_MS = 1000
local SAVE_EVERY = 5 -- s: a fill's time left kept in the world's state this often

local suits -- the suits the work allows: section -> true
local burnt_here = {} -- anomaly id -> burnt out in this game already
local update_at = 0

local function msg(id, ...)
	actor_menu.set_msg(1, string.format(game.translate_string(id), ...), 6)
end

local function list(name)
	local t = {}
	for v in string.gmatch(shelter.state(name, "") or "", "[^,]+") do
		t[#t + 1] = tonumber(v) or v
	end
	return t
end

local function set_list(name, t)
	shelter.set_state(name, #t > 0 and table.concat(t, ",") or nil)
end

local function suited()
	if not suits then
		suits = {}
		for _, s in ipairs(str_explode(ini_sys:r_string_ex(SETTINGS, "suits") or "", ",")) do
			suits[s] = true
		end
	end
	local outfit = db.actor:item_in_slot(7)
	return outfit and suits[outfit:section()] or false
end

-- the capsule's discharge through a suit that can't take it
local function kill(nature)
	local h = hit()
	h.type = HIT_OF_NATURE[nature] or hit.strike
	h.power = 1000
	h.impulse = 0
	h.draftsman = db.actor
	h.direction = vector():set(0, -1, 0)
	db.actor:hit(h)
	if db.actor:alive() then
		db.actor:kill(db.actor)
	end
end

local function starts(s, prefixes)
	for _, p in ipairs(prefixes) do
		if string.sub(s, 1, #p) == p then
			return true
		end
	end
	return false
end

-- an anomaly's nature, nil for none
function nature_of(obj)
	local sec = obj:section()
	for prefix, nature in pairs(NATURE_OF) do
		if string.sub(sec, 1, #prefix) == prefix then
			return nature
		end
	end
	if starts(sec, NO_NATURE) or NO_NATURE_CLASS[SYS_GetParam(0, sec, "class") or ""] then
		return nil
	end
	return NATURE_OF_HIT[SYS_GetParam(0, sec, "hit_type") or ""]
end

local function burnt(id)
	for _, b in ipairs(list("burnt")) do
		if b == id then
			return true
		end
	end
	return false
end

-- the nearest anomaly in reach: of the nature, not burnt out; and whether there was one of another nature
local function anomaly_for(nature)
	local reach = ini_sys:r_float_ex(SETTINGS, "reach") or 4
	local best, best_d, other
	level.iterate_nearest(db.actor:position(), reach + 10, function(obj)
		if IsAnomaly(obj) then
			local d = obj:position():distance_to(db.actor:position())
			local n = nature_of(obj)
			if d <= reach and n and not is_chamber_anomaly(obj:id()) then
				if n == nature and not burnt(obj:id()) then
					if not best_d or d < best_d then
						best, best_d = obj, d
					end
				elseif n ~= nature then
					other = true
				end
			end
		end
	end)
	return best, other
end

-------------------------------------------------------------------------------
-- the capsule into an anomaly

function capsule_menu(obj)
	local p = obj:parent()
	if p and p:id() == AC_ID and not SYS_GetParam(1, obj:section(), "shelter_full", false) then
		return game.translate_string("st_shelter_capsule_place")
	end
end

function capsule_place(obj)
	local nature = SYS_GetParam(0, obj:section(), "shelter_nature")
	local anomaly, other = anomaly_for(nature)
	if not anomaly then
		return msg(other and "st_shelter_capsule_wrong_anomaly" or "st_shelter_capsule_no_anomaly")
	elseif not suited() then
		return kill(nature)
	end
	hide_hud_inventory()
	local pos = anomaly:position()
	local lv = level.vertex_id(pos)
	if lv >= 4294967295 then
		lv = db.actor:level_vertex_id()
	end
	shelter.everyones(function()
		alife_release(obj)
		local se = alife_create(FILLING, vector():set(pos.x, pos.y + 0.3, pos.z), lv, db.actor:game_vertex_id())
		if se then
			local fills = list("fills")
			fills[#fills + 1] = se.id
			set_list("fills", fills)
			shelter.set_state("fill_" .. se.id, table.concat({ nature, anomaly:id(), ini_sys:r_float_ex(SETTINGS, "fill_seconds") or 60 }, ":"))
		end
	end)
	msg("st_shelter_capsule_placed")
end

-------------------------------------------------------------------------------
-- the capsules filling, the anomalies burnt out

local function burn(anomaly_id)
	local burnt_list = list("burnt")
	burnt_list[#burnt_list + 1] = anomaly_id
	set_list("burnt", burnt_list)
end

-- a fill's time up: the full capsule where it was, the anomaly burnt out, the capsule counted (once for the world)
local function fill_done(id, nature, anomaly_id)
	shelter.once("fill_done_" .. id, function()
		local obj = level.object_by_id(id)
		local se = alife_object(id)
		if se then
			local pos = obj and obj:position() or se.position
			alife_create(table.concat({ "shelter_capsule", nature, "full" }, "_"), pos, se.m_level_vertex_id, se.m_game_vertex_id)
			alife_release(se)
		end
		burn(anomaly_id)
		shelter.set_state("capsules_filled_" .. nature, shelter.state("capsules_filled_" .. nature, 0) + 1)
		if obj and obj:position():distance_to(db.actor:position()) < 30 then
			msg("st_shelter_capsule_filled")
		end
	end)
end

local remaining_here = {} -- a fill's id -> its seconds left, counted down here (kept in the state now and then)

local function update_fills(seconds)
	local fills, left = list("fills"), {}
	for _, id in ipairs(fills) do
		local nature, anomaly_id, kept = string.match(shelter.state("fill_" .. id, "") or "", "^(%a+):(%d+):([%d%.%-]+)$")
		local remaining = remaining_here[id] or tonumber(kept)
		if not remaining then
			-- unknown: dropped
		elseif remaining - seconds <= 0 then
			remaining_here[id] = nil
			shelter.set_state("fill_" .. id, nil)
			fill_done(id, nature, tonumber(anomaly_id))
		else
			left[#left + 1] = id
			remaining_here[id] = remaining - seconds
			if math.floor(remaining_here[id] / SAVE_EVERY) ~= math.floor(remaining / SAVE_EVERY) then
				shelter.set_state("fill_" .. id, table.concat({ nature, anomaly_id, remaining_here[id] }, ":"))
			end
		end
	end
	if #left ~= #fills then
		set_list("fills", left)
	end
end

-- the burnt-out anomalies, online here: off
local function update_burnt()
	for _, id in ipairs(list("burnt")) do
		if not burnt_here[id] then
			local obj = level.object_by_id(id)
			if obj then
				obj:disable_anomaly()
				burnt_here[id] = true
			end
		end
	end
end

-- an emission brings them back
local function on_interaction(kind, obj, what)
	if kind == "anomalies" and what == "emission_end" then
		for _, id in ipairs(list("burnt")) do
			local a = level.object_by_id(id)
			if a then
				a:enable_anomaly()
			end
		end
		burnt_here = {}
		set_list("burnt", {})
	end
end

-------------------------------------------------------------------------------
-- the chambers: the cells along the entrance corridor's north wall (on the left from the door in), one for each
-- nature from the door. Over each cell's panel by its window a box (shelter_chamber_panel_<nature>) to look at and
-- use: it takes a full capsule of the nature, which is then seen in the cell with a real anomaly of the nature round it
-- (the visor and the detectors see it; the transmutations need it), small enough to stay behind the window, and a
-- glow. The panels come on the first visit.
-- At a ready chamber's panel up to three things go in (ui_shelter_chamber.script), and some game hours later in the
-- cell lies an artefact, if they are one of the chamber's recipes, or a stone; taken at the panel. The chamber is busy
-- meanwhile. Loading it and taking out, as all the work, only in the allowed suits. What is being made and what lies in
-- the cells are the world's. The alchemy below.

local LEVEL = "bunker_a1"
local CHAMBERS = { -- from the door: the x of the cell's panel and of its window, the cell's anomaly
	{ nature = "gravi", panel = -7.44, window = -6.41, anomaly = "zone_mine_gravitational_weak" },
	{ nature = "thermo", panel = -4.47, window = -3.44, anomaly = "zone_mine_thermal_weak" },
	{ nature = "chem", panel = -1.53, window = -0.50, anomaly = "zone_mine_acidic_weak" },
	{ nature = "electro", panel = 1.49, window = 2.51, anomaly = "zone_mine_electric_weak" },
}
-- the wall (the panels' face) and the panels' middle height, the cells' floor and depth, the corridor's floor
local WALL = { z = -25.45, panel_y = 4.59, cell_floor = 3.42, cell_z = -24.2, corridor_y = 3.3, corridor_z = -27.1 }
-- an installed chamber's cell: the anomaly's sphere (m) round the cell's middle, short of the window; the glow (a colour
-- or a light animation)
local CELL_RADIUS = 0.9
local CELL_FX = {
	gravi = { color = { 0.5, 0.4, 0.3 } },
	thermo = { color = { 1.0, 0.45, 0.1 } },
	chem = { lanim = "light_green_02" },
	electro = { lanim = "koster_01_electra" },
}
local CELL_GLOW = { range = 3, height = 1, brightness = 0.006 } -- m, m over the floor; a light animation's 0..255 to 0..1.5
local MADE_HOVER = { height = 1.0, out = 0.4, light = 1.2, color = "0.6,0.6,0.6" } -- what's made held in the window: m
-- over the cell's floor, m from the cell's middle towards the glass (a small one is lost on the floor); a light on it of
-- its own colour (an artefact's trail_light_color, a stone's grey), so a faint one is seen too

local function full(nature)
	return "shelter_capsule_" .. nature .. "_full"
end

local function installed(nature)
	return shelter.state("chamber_" .. nature, nil) ~= nil
end

function chambers_installed()
	local n = 0
	for _, c in ipairs(CHAMBERS) do
		n = n + (installed(c.nature) and 1 or 0)
	end
	return n
end

-- the task's mark: the first chamber still empty
function chamber_target()
	for _, c in ipairs(CHAMBERS) do
		if not installed(c.nature) then
			return shelter.state("chamber_panel_" .. c.nature, nil)
		end
	end
end

local function chamber(nature)
	for _, c in ipairs(CHAMBERS) do
		if c.nature == nature then
			return c
		end
	end
end

local function ai_vertex(x)
	local lv = level.vertex_id(vector():set(x, WALL.corridor_y, WALL.corridor_z))
	return lv < 4294967295 and lv or db.actor:level_vertex_id()
end

-- a chamber's anomaly, each game's own (its id kept on the actor): co-op shares a spawn the moment it's made, before
-- its shape could be set, and an anomaly with no shape crashes the game
local function anomaly_var(nature)
	return "shelter_chamber_anomaly_" .. nature
end

local function cell_anomaly(c)
	local id = load_var(db.actor, anomaly_var(c.nature), nil)
	local se = id and alife_object(id)
	return se and se:section_name() == c.anomaly and id or nil
end

function is_chamber_anomaly(id)
	for _, c in ipairs(CHAMBERS) do
		if load_var(db.actor, anomaly_var(c.nature), nil) == id then
			return true
		end
	end
	return false
end

-- as Anomaly's dynamic anomalies are made (bind_anomaly_field.dyn_anomalies_spawn): the shape set before it's online
local function spawn_cell_anomaly(c)
	local se = alife_create(c.anomaly, vector():set(c.window, WALL.cell_floor, WALL.cell_z), ai_vertex(c.window),
		db.actor:game_vertex_id())
	local data = se and utils_stpk.get_anom_zone_data(se)
	if not data then
		printf("! [shelter] no anomaly for the %s chamber", c.nature)
		if se then
			alife_release(se) -- not left with no shape
		end
		return
	end
	data.shapes[1] = { shtype = 0, offset = vector():set(0, 0, 0), center = vector():set(0, 0, 0), radius = CELL_RADIUS }
	utils_stpk.set_anom_zone_data(data, se)
	save_var(db.actor, anomaly_var(c.nature), se.id)
end

local function spawn_panels()
	for _, c in ipairs(CHAMBERS) do
		local se = alife_create("shelter_chamber_panel_" .. c.nature, vector():set(c.panel, WALL.panel_y, WALL.z),
			ai_vertex(c.panel), db.actor:game_vertex_id())
		if se then -- the model's +z into the wall: here north
			shelter.set_state("chamber_panel_" .. c.nature, se.id)
		end
	end
end

local NATURES = { "gravi", "thermo", "chem", "electro" }
STONE = "shelter_synth_stone" -- what a load that's no recipe makes
SLOTS = 3 -- a load: two or three things
local RECIPES_INFO = "shelter_notes_chemist" -- his PDA unloaded

local function chamber_name(nature)
	return game.translate_string("st_shelter_chamber_" .. nature)
end

-- the game's time in seconds
local function game_sec()
	return game.get_game_time():diffSec(game.CTime())
end

local function name(sec)
	return sec == STONE and game.translate_string("st_shelter_synth_stone_name") or ui_item.get_sec_name(sec)
end

-- so long, as "2 h 05 min"
function duration_text(seconds)
	local m = math.max(0, math.floor(seconds / 60))
	return string.format(game.translate_string("st_shelter_synth_duration"), math.floor(m / 60), m % 60)
end

-------------------------------------------------------------------------------
-- the alchemy (docs/coop/shelter.md, "Алхимия"): two or three things into a chamber make an artefact when they are one
-- of the chamber's recipes, a stone otherwise, with the chamber's resonance: the most of them one of its recipes has,
-- of the recipes of the load's kind (junk alone: those of junk; with an artefact: those it is the seed of).
-- Each world has its own recipes, from its seed: every junk item and mutant part ([shelter_synth_junk],
-- [shelter_synth_parts]) sounds in one nature only, dealt evenly, an artefact in its own (items\settings\artefacts.ltx).
-- A junk artefact is made of three junk items; a common one (tier under [shelter_synthesis] rare_tier) of a junk
-- artefact of its nature and two junk items or mutant parts; a rare one of a common one of its nature and two mutant
-- parts or junk artefacts. The Chemist's recipes ([shelter_recipe_<nature>]) stay as he wrote them, their junk sounding
-- in their chamber. The dearer the load, the longer it takes: hours_min for junk to hours_max. Every load's outcome goes
-- into the world's journal (the laptop's "Синтез"), and every game of the group hears of it in its PDA.

local alchemy -- the world's: its seed, pool (section -> "junk", "part", "artefact"), affinity (section -> nature),
-- recipes (nature -> { { result, parts, key, seed (the artefact it grows on), chemist } })

-- Park-Miller: the same numbers from the same seed in every game
local function rng(seed)
	local s = seed % 2147483647
	if s <= 0 then
		s = s + 2147483646
	end
	return function(n)
		s = s * 16807 % 2147483647
		return s % n + 1
	end
end

local function section_list(ini, sec)
	local t = {}
	if ini:section_exist(sec) then
		for i = 0, ini:line_count(sec) - 1 do
			local _, id = ini:r_line_ex(sec, i, "", "")
			if id and ini_sys:section_exist(id) then
				t[#t + 1] = id
			end
		end
	end
	table.sort(t)
	return t
end

-- count of list's (distinct), nil if it has too few
local function pick(r, list, count)
	local t, out = {}, {}
	for i, s in ipairs(list) do
		t[i] = s
	end
	for i = 1, count do
		if #t == 0 then
			return nil
		end
		out[i] = table.remove(t, r(#t))
	end
	return out
end

local function concat(a, b)
	local t = {}
	for _, s in ipairs(a) do
		t[#t + 1] = s
	end
	for _, s in ipairs(b) do
		t[#t + 1] = s
	end
	return t
end

-- a load's sections in one order: the same load, the same key
function key(parts)
	local t = {}
	for i, s in ipairs(parts) do
		t[i] = s
	end
	table.sort(t)
	return table.concat(t, ",")
end

local function generate(seed)
	local r = rng(seed)
	local rare_tier = ini_sys:r_float_ex(SETTINGS, "rare_tier") or 4
	local arts = ini_file("items\\settings\\artefacts.ltx")
	local a = { seed = seed, pool = {}, affinity = {}, recipes = {} }
	local junk_af, common, rare, things = {}, {}, {}, {}
	for _, n in ipairs(NATURES) do
		junk_af[n], common[n], rare[n], things[n] = section_list(arts, "af_class_" .. n .. "_musor"), {}, {}, { junk = {}, part = {} }
		for _, af in ipairs(section_list(arts, "af_class_" .. n)) do
			local t = (SYS_GetParam(2, af, "tier") or 1) >= rare_tier and rare[n] or common[n]
			t[#t + 1] = af
		end
		for _, list in ipairs({ junk_af[n], common[n], rare[n] }) do
			for _, af in ipairs(list) do
				a.pool[af], a.affinity[af] = "artefact", n
			end
		end
		a.recipes[n] = {}
	end
	local chemist = {}
	for _, n in ipairs(NATURES) do
		local sec = "shelter_recipe_" .. n
		if ini_sys:section_exist(sec) then
			local parts = str_explode(ini_sys:r_string_ex(sec, "junk") or "", ",")
			local result = ini_sys:r_string_ex(sec, "result")
			for _, s in ipairs(parts) do
				a.affinity[s] = n
			end
			chemist[result] = true
			table.insert(a.recipes[n], { result = result, parts = parts, key = key(parts), chemist = true })
		end
	end
	-- the junk and the parts dealt among the natures: each to the one with the fewest of its kind
	for _, kind in ipairs({ "junk", "part" }) do
		local free = {}
		for _, s in ipairs(section_list(ini_sys, kind == "junk" and "shelter_synth_junk" or "shelter_synth_parts")) do
			a.pool[s] = kind
			if a.affinity[s] then
				table.insert(things[a.affinity[s]][kind], s)
			else
				free[#free + 1] = s
			end
		end
		for i = #free, 2, -1 do
			local j = r(i)
			free[i], free[j] = free[j], free[i]
		end
		for _, s in ipairs(free) do
			local best
			for _, n in ipairs(NATURES) do
				if not best or #things[n][kind] < #things[best][kind] then
					best = n
				end
			end
			a.affinity[s] = best
			table.insert(things[best][kind], s)
		end
	end
	local function add(n, result, seeds, from, count)
		for _ = 1, 50 do
			local parts = pick(r, from, count)
			if not parts then
				break
			end
			local seed = seeds and seeds[r(#seeds)]
			if seed then
				table.insert(parts, 1, seed)
			end
			local k, taken = key(parts), false
			for _, rc in ipairs(a.recipes[n]) do
				taken = taken or rc.key == k
			end
			if not taken then
				table.insert(a.recipes[n], { result = result, parts = parts, key = k, seed = seed })
				return
			end
		end
		printf("! [shelter] no recipe for %s", result)
	end
	for _, n in ipairs(NATURES) do
		for _, af in ipairs(junk_af[n]) do
			if not chemist[af] then
				add(n, af, nil, things[n].junk, 3)
			end
		end
		if #junk_af[n] > 0 then
			for _, af in ipairs(common[n]) do
				add(n, af, junk_af[n], concat(things[n].junk, things[n].part), 2)
			end
		end
		if #common[n] > 0 then
			for _, af in ipairs(rare[n]) do
				add(n, af, common[n], concat(things[n].part, junk_af[n]), 2)
			end
		end
	end
	return a
end

-- the world's alchemy, nil till it has a seed (the chambers' panels give it one)
function get_alchemy()
	local seed = shelter.state("synth_seed", nil)
	if not seed then
		return nil
	end
	if not alchemy or alchemy.seed ~= seed then
		alchemy = generate(seed)
	end
	return alchemy
end

-- what of a section can go into a chamber: "junk", "part", "artefact" or nil
function component(sec)
	local a = get_alchemy()
	return a and a.pool[sec]
end

local function overlap(a, b)
	local left, n = {}, 0
	for _, s in ipairs(a) do
		left[s] = (left[s] or 0) + 1
	end
	for _, s in ipairs(b) do
		if (left[s] or 0) > 0 then
			left[s], n = left[s] - 1, n + 1
		end
	end
	return n
end

-- what a load makes in a chamber: the artefact or the stone, and the resonance
function outcome(nature, parts)
	local a = get_alchemy()
	local k, best, has, artefacts = key(parts), 0, {}, false
	for _, s in ipairs(parts) do
		has[s], artefacts = true, artefacts or a.pool[s] == "artefact"
	end
	for _, rc in ipairs(a.recipes[nature]) do
		if rc.key == k then
			return rc.result, #parts
		end
		if rc.seed and has[rc.seed] or not rc.seed and not artefacts then
			best = math.max(best, overlap(parts, rc.parts))
		end
	end
	return STONE, best
end

-- a load's game hours by its worth: the things' cost
local function hours_for(parts)
	local worth = 0
	for _, s in ipairs(parts) do
		worth = worth + (SYS_GetParam(2, s, "cost") or 0)
	end
	local lo, hi = ini_sys:r_float_ex(SETTINGS, "hours_min") or 1, ini_sys:r_float_ex(SETTINGS, "hours_max") or 12
	local k = math.min(1, worth / (ini_sys:r_float_ex(SETTINGS, "worth_max") or 120000))
	return lo + (hi - lo) * k ^ (ini_sys:r_float_ex(SETTINGS, "worth_power") or 0.7)
end

-- the journal, the world's: each chamber's loads made, "synth_log_<nature>_<i>" (i up to "synth_logs_<nature>") =
-- "result|parts|resonance|game second|who"
local function logs(nature)
	return shelter.state("synth_logs_" .. nature, 0) or 0
end

local function log_entry(nature, i)
	local v = shelter.state("synth_log_" .. nature .. "_" .. i, nil)
	local result, parts, resonance, t, who = string.match(tostring(v or ""), "^([^|]*)|([^|]*)|(%d*)|(%d*)|(.*)$")
	if not result then
		return nil
	end
	return { nature = nature, result = result, parts = str_explode(parts, ","), resonance = tonumber(resonance) or 0,
		t = tonumber(t) or 0, who = who }
end

-- every load made, newest first: { nature, result, parts, resonance, t, who }
function journal()
	local t = {}
	for _, n in ipairs(NATURES) do
		for i = 1, logs(n) do
			t[#t + 1] = log_entry(n, i)
		end
	end
	table.sort(t, function(a, b)
		return a.t > b.t
	end)
	return t
end

-- the Chemist's recipes, known once his PDA is unloaded: { nature, result, parts, chemist }
function chemist_recipes()
	local t = {}
	if has_alife_info(RECIPES_INFO) then
		for _, n in ipairs(NATURES) do
			local sec = "shelter_recipe_" .. n
			if ini_sys:section_exist(sec) then
				t[#t + 1] = { nature = n, result = ini_sys:r_string_ex(sec, "result"), chemist = true,
					parts = str_explode(ini_sys:r_string_ex(sec, "junk") or "", ",") }
			end
		end
	end
	return t
end

-- what's known of a load in a chamber: the journal's last word on it, or the Chemist's recipe; nil if never tried
function known(nature, parts)
	local k = key(parts)
	for _, rc in ipairs(chemist_recipes()) do
		if rc.nature == nature and key(rc.parts) == k then
			return rc
		end
	end
	for i = logs(nature), 1, -1 do
		local e = log_entry(nature, i)
		if e and key(e.parts) == k then
			return e
		end
	end
end

local function news(e)
	local text
	if e.result == STONE then
		text = string.format(game.translate_string("st_shelter_synth_news_stone"), e.resonance, SLOTS)
	else
		text = string.format(game.translate_string("st_shelter_synth_news_made"), name(e.result))
	end
	if e.who ~= "" then
		text = text .. " " .. string.format(game.translate_string("st_shelter_synth_news_who"), e.who)
	end
	db.actor:give_game_news(chamber_name(e.nature), text, "ui_inGame2_Poslednie_razrabotki", 0, 8000)
end

-- the journal's new entries, heard in this game (each game counts its own; one coming into the world hears only what's
-- new from then on)
local function update_news()
	for _, n in ipairs(NATURES) do
		local count, heard = logs(n), load_var(db.actor, "shelter_synth_heard_" .. n, nil)
		if not heard or heard > count then
			save_var(db.actor, "shelter_synth_heard_" .. n, count)
		elseif heard < count then
			for i = heard + 1, count do
				local e = log_entry(n, i)
				if e then
					news(e)
				end
			end
			save_var(db.actor, "shelter_synth_heard_" .. n, count)
		end
	end
end

-- a chamber's work: "making" (the game second it began; what went in), "out" (what lies in the cell), or nil
local function work(nature)
	local out = shelter.state("synth_out_" .. nature, nil)
	local se = out and alife_object(out)
	if se then
		return "out", se
	end
	if shelter.state("synth_" .. nature, nil) then
		return "making", shelter.state("synth_start_" .. nature, nil),
			str_explode(tostring(shelter.state("synth_load_" .. nature, "") or ""), ",")
	end
end

-- a chamber for the laptop: installed, and its work ("making": since when, what went in; "out": the section in the cell)
function status(nature)
	local what, a, b = work(nature)
	local s = { installed = installed(nature), what = what }
	if what == "making" then
		s.elapsed = a and game_sec() - a or nil
		s.parts = b
	elseif what == "out" then
		s.result = a:section_name()
	end
	return s
end

local function panel_tip(nature)
	local chamber_text = chamber_name(nature)
	if not installed(nature) then
		local id = db.actor:object(full(nature)) and "st_shelter_chamber_tip_install" or "st_shelter_chamber_tip_empty"
		return string.format(game.translate_string(id), chamber_text)
	end
	local what, a = work(nature)
	if what == "out" then
		return string.format(game.translate_string("st_shelter_chamber_tip_take"), chamber_text, name(a:section_name()))
	elseif what == "making" then
		return string.format(game.translate_string("st_shelter_chamber_tip_making"), chamber_text,
			a and duration_text(game_sec() - a) or "?")
	end
	return string.format(game.translate_string("st_shelter_chamber_tip_load"), chamber_text)
end

-- what was made, out of the cell into the actor's inventory
local function take_out(nature, se)
	local sec = se:section_name()
	shelter.everyones(function()
		alife_release(se)
		alife_create_item(sec, db.actor)
	end)
	shelter.set_state("synth_out_" .. nature, nil)
	news_manager.relocate_item(db.actor, "in", sec, 1)
end

-- a load (two or three sections, as picked) out of the actor's inventory into the chamber, the making begun
-- (ui_shelter_chamber.script)
function load(nature, parts)
	if #parts < 2 or work(nature) or not get_alchemy() then
		return
	end
	local objs, used = {}, {}
	for _, sec in ipairs(parts) do
		local found
		db.actor:iterate_inventory(function(_, obj)
			if not found and obj:section() == sec and not used[obj:id()] then
				found = obj
			end
		end, db.actor)
		if not found then
			return msg("st_shelter_synth_missing", name(sec))
		end
		used[found:id()] = true
		objs[#objs + 1] = found
	end
	if not suited() then
		return kill(nature)
	end
	local result, resonance = outcome(nature, parts)
	local now = game_sec()
	for _, obj in ipairs(objs) do
		news_manager.relocate_item(db.actor, "out", obj:section(), 1)
		alife_release(obj)
	end
	shelter.set_state("synth_result_" .. nature, result)
	shelter.set_state("synth_load_" .. nature, table.concat(parts, ","))
	shelter.set_state("synth_resonance_" .. nature, resonance)
	shelter.set_state("synth_who_" .. nature, (string.gsub(db.actor:character_name() or "", "|", "/")))
	shelter.set_state("synth_start_" .. nature, now)
	shelter.set_state("synth_" .. nature, math.floor(now + hours_for(parts) * 3600))
	msg("st_shelter_synth_started", chamber_name(nature))
end

local WORK_STATES = { "synth_", "synth_result_", "synth_load_", "synth_resonance_", "synth_who_", "synth_start_" }

-- a making's time up: what it made in the cell, the journal's entry (once for the world)
local function made(c, ends)
	shelter.once("synth_made_" .. c.nature .. "_" .. ends, function()
		local n = c.nature
		local result = shelter.state("synth_result_" .. n, nil)
		local entry = table.concat({ result or STONE, tostring(shelter.state("synth_load_" .. n, "") or ""),
			shelter.state("synth_resonance_" .. n, 0) or 0, ends, tostring(shelter.state("synth_who_" .. n, "") or "") }, "|")
		for _, s in ipairs(WORK_STATES) do
			shelter.set_state(s .. n, nil)
		end
		local count = logs(n) + 1
		shelter.set_state("synth_log_" .. n .. "_" .. count, entry)
		shelter.set_state("synth_logs_" .. n, count)
		local panel = alife_object(shelter.state("chamber_panel_" .. n, 65535))
		if not (result and panel and ini_sys:section_exist(result)) then
			return
		end
		local se = alife_create(result, vector():set(c.window, WALL.cell_floor + 0.3, WALL.cell_z), panel.m_level_vertex_id,
			panel.m_game_vertex_id)
		shelter.set_state("synth_out_" .. n, se and se.id or nil)
	end)
end

local function update_making()
	local now
	for _, c in ipairs(CHAMBERS) do
		local ends = shelter.state("synth_" .. c.nature, nil)
		if ends then
			now = now or game_sec()
			if now >= ends then
				made(c, ends)
			end
		end
	end
end

local function panel_use(nature)
	if installed(nature) then
		local what, a = work(nature)
		if what == "out" then
			if not suited() then
				return kill(nature)
			end
			return take_out(nature, a)
		elseif what == "making" then
			return msg("st_shelter_synth_making", chamber_name(nature), a and duration_text(game_sec() - a) or "?")
		elseif not get_alchemy() then
			return msg("st_shelter_synth_tuning")
		end
		return ui_shelter_chamber.open(nature)
	end
	local capsule = db.actor:object(full(nature))
	if not capsule then
		return msg("st_shelter_chamber_need_capsule")
	elseif not suited() then
		return kill(nature)
	end
	local c = chamber(nature)
	shelter.everyones(function()
		alife_release(capsule)
		local se = alife_create("shelter_capsule_installed", vector():set(c.window, WALL.cell_floor + 0.05, WALL.cell_z),
			ai_vertex(c.window), db.actor:game_vertex_id())
		shelter.set_state("chamber_" .. nature, se and se.id or 65535)
	end)
	msg("st_shelter_chamber_installed", chamber_name(nature))
end

-- the cell's glow: on while the chamber has its capsule and its panel's online here
local function cell_fx_start(nature)
	local c, fx = chamber(nature), CELL_FX[nature]
	local t = { light = script_light() }
	t.light.range = CELL_GLOW.range
	if fx.lanim then
		t.light.lanim = fx.lanim
		t.light.lanim_brightness = CELL_GLOW.brightness
	else
		t.light.color = fcolor():set(fx.color[1], fx.color[2], fx.color[3], 1)
	end
	t.light:set_position(vector():set(c.window, WALL.cell_floor + CELL_GLOW.height, WALL.cell_z))
	t.light.enabled = true
	t.light:update()
	return t
end

local function cell_fx_stop(t)
	t.light.enabled = false
end

class "panel_binder" (object_binder)
function panel_binder:__init(obj) super(obj)
	self.nature = SYS_GetParam(0, obj:section(), "shelter_nature")
	self.ready = false
	self.tip = nil
	self.next = 0
	self.fx = nil
end
function panel_binder:update(delta)
	object_binder.update(self, delta)
	if not self.ready then -- frozen on the wall
		local shell = self.object:get_physics_shell()
		if not shell then
			return
		end
		shell:freeze()
		self.ready = true
		self.object:set_callback(callback.use_object, panel_binder.use, self)
	end
	if self.fx then
		self.fx.light:update() -- its animation
	end
	local now = time_global()
	if now < self.next or not db.actor then
		return
	end
	self.next = now + 500
	local on = installed(self.nature)
	if on and not cell_anomaly(chamber(self.nature)) then
		spawn_cell_anomaly(chamber(self.nature))
	end
	if on and not self.fx then
		self.fx = cell_fx_start(self.nature)
	elseif not on and self.fx then
		cell_fx_stop(self.fx)
		self.fx = nil
	end
	if on and not self.seeding and not shelter.state("synth_seed", nil) then -- the world's recipes
		self.seeding = true
		shelter.once("synth_seed", function()
			shelter.set_state("synth_seed", math.random(1, 2147483646))
		end)
	end
	local what, made_se = work(self.nature)
	local af = what == "out" and level.object_by_id(made_se.id)
	if af then -- held in the window, an artefact seen without a detector
		if af:get_artefact() then
			af:get_artefact():SwitchVisibility(true)
		end
		local shell = self.held ~= af:id() and af:get_physics_shell()
		if shell then
			local c = chamber(self.nature)
			local pos = vector():set(c.window, WALL.cell_floor + MADE_HOVER.height, WALL.cell_z - MADE_HOVER.out)
			af:force_set_position(pos, false)
			shell:freeze()
			self.held = af:id()
			local rgb = str_explode(ini_sys:r_string_ex(af:section(), "trail_light_color") or MADE_HOVER.color, ",")
			self.made_light = self.made_light or script_light()
			self.made_light.range = MADE_HOVER.light
			self.made_light.color = fcolor():set(tonumber(rgb[1]) or 1, tonumber(rgb[2]) or 1, tonumber(rgb[3]) or 1, 1)
			self.made_light:set_position(pos)
			self.made_light.enabled = true
			self.made_light:update()
		end
	elseif self.made_light then
		self.made_light.enabled = false
		self.made_light = nil
		self.held = nil
	end
	local tip = panel_tip(self.nature)
	if tip ~= self.tip then
		self.tip = tip
		self.object:set_tip_text(tip)
	end
end
function panel_binder:use()
	panel_use(self.nature)
	self.next = 0
end
function panel_binder:net_destroy()
	self.object:set_callback(callback.use_object, nil)
	if self.fx then
		cell_fx_stop(self.fx)
		self.fx = nil
	end
	if self.made_light then
		self.made_light.enabled = false
		self.made_light = nil
	end
	object_binder.net_destroy(self)
end
function init_panel(obj)
	obj:bind_object(panel_binder(obj))
end

local last_update = nil

local function actor_on_update()
	local now = time_global()
	if now < update_at then
		return
	end
	update_at = now + UPDATE_MS
	local seconds = last_update and (now - last_update) / 1000 or 0
	last_update = now
	update_fills(seconds)
	update_burnt()
	update_making()
	update_news()
end

local takes_from = nil -- time_global() from which the actor's takes are pickups (not the inventory a load puts back)

-- a script putting full capsules into the actor's inventory (a test's shortcut): no discharge for a while
function take_quietly(ms)
	takes_from = math.max(takes_from or 0, time_global() + ms)
end

local function actor_on_first_update()
	takes_from = time_global() + 3000
	if level.name() == LEVEL and not shelter.state("chamber_panel_" .. CHAMBERS[1].nature, nil) then
		shelter.once("chamber_panels", spawn_panels)
	end
end

-- a full capsule picked up in a suit that can't take it: its discharge, and it falls back
local function actor_on_item_take(obj)
	local sec = obj:section()
	if not takes_from or time_global() < takes_from then
		return
	end
	if SYS_GetParam(1, sec, "shelter_full", false) and not suited() then
		db.actor:drop_item(obj)
		kill(SYS_GetParam(0, sec, "shelter_nature"))
	end
end

function on_game_start()
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("actor_on_item_take", actor_on_item_take)
	RegisterScriptCallback("actor_on_interaction", on_interaction)
end

-- Co-op: Russian texts for the server, whatever this game's language. What players see their own games translate:
-- the world's state and the script events carry string ids and their arguments, never a finished text. What goes to
-- the server as finished text is for the server's journal, the admin page, the bot and the launchers, which are
-- Russian: the world's news (coop_news.script) and the answers to the admins' events (coop_world_events.script).
-- The engine's string table holds this game's language only (the headless host's may be English), so the Russian
-- texts are read here from the game's own text\rus\*.xml through the engine's xml parser (packed or loose files,
-- DXML patches too). [coop_lang] in mod_system_coop.ltx: the files looked into first; the others on a miss, once per
-- id (a thing's name: the files with "item" in their names; on a miss there too, all of them).

local S = "coop_lang"
local LANG = "rus"
local DIR = "text\\" .. LANG

local found = {}  -- id -> its Russian text, false: none anywhere
local docs = {}   -- file -> its parsed xml (the [coop_lang] files only), false: no such file
local first = nil -- the [coop_lang] files, in order
local others = nil -- every other text\rus file, by name

local function own_language()
	return ini_sys:r_string_ex("string_table", "language") == LANG
end

local function parse(file)
	if not getFS():exist("$game_config$", DIR .. "\\" .. file) then
		return nil -- the parser would stop the game on a missing file
	end
	local xml = CScriptXmlInit()
	xml:ParseDirFile(DIR, file)
	return xml
end

local function look(xml, id)
	xml:NavigateToRoot()
	if not xml:NavigateToNode_ByAttribute("string", "id", id) then
		return nil
	end
	local text = xml:ReadValue("text", 0)
	xml:NavigateToRoot()
	return text
end

local function first_files()
	if not first then
		first = {}
		for _, f in ipairs(str_explode(ini_sys:r_string_ex(S, "files") or "", ",")) do
			if f ~= "" then
				first[#first + 1] = f
			end
		end
	end
	return first
end

local function other_files()
	if others then
		return others
	end
	local skip = {}
	others = {}
	for _, f in ipairs(first_files()) do
		skip[string.lower(f)] = true
	end
	local list = getFS():file_list_open("$game_config$", DIR .. "\\", bit_or(FS.FS_ListFiles, FS.FS_RootOnly))
	for i = 1, list and list:Size() or 0 do
		local f = string.lower(list:GetAt(i - 1))
		if string.find(f, "%.xml$") and not skip[f] then
			others[#others + 1] = f
		end
	end
	if list then
		list:Free()
	end
	table.sort(others)
	return others
end

-- the other files (those with filter in their names, if given), each parsed for this id only: the last that has it
-- wins, as in the engine's string table (an addon's file after Anomaly's own)
local function scan(id, filter)
	local text
	for _, f in ipairs(other_files()) do
		if not filter or string.find(f, filter, 1, true) then
			local xml = parse(f)
			text = xml and look(xml, id) or text
		end
	end
	return text
end

local function find(id, filter)
	for _, f in ipairs(first_files()) do
		if docs[f] == nil then
			docs[f] = parse(f) or false
		end
		local text = docs[f] and look(docs[f], id)
		if text then
			return text
		end
	end
	if not ini_sys:r_bool_ex(S, "scan_all", true) then
		return nil
	end
	local t0 = os.clock()
	local text = filter and scan(id, filter) or scan(id) -- a filter's miss: all of them
	if get_console():get_integer("coop_debug") == 1 then
		printf("[coop dbg] lang: %s looked up in %s files of %s (%s ms): %s", id, filter or "all", DIR,
			math.floor((os.clock() - t0) * 1000), text and "found" or "none")
	end
	return text
end

local function lookup(id, filter)
	id = tostring(id or "")
	if id == "" or own_language() then
		return game.translate_string(id)
	end
	if found[id] == nil then
		local ok, text = pcall(find, id, filter)
		if not ok then
			printf("! [coop] lang: %s: %s", id, tostring(text))
		end
		found[id] = ok and text or false
	end
	return found[id] or game.translate_string(id)
end

-- the Russian text of a string id; this game's own when Russian has none (or the id itself, as translate_string)
function rus(id)
	return lookup(id)
end

-- strformat of a Russian text
function rus_format(id, ...)
	if select("#", ...) > 0 then
		return strformat(rus(id), ...)
	end
	return rus(id)
end

-- a thing's name in Russian (as ui_item.get_sec_name)
function item_name(section)
	local id = section and ini_sys:r_string_ex(section, "inv_name")
	return id and lookup(id, "item") or tostring(section or "")
end

-- Raids (https://app.notion.com/p/40ed89dbf39d818cb08efde54df35db5, "Raids"): the raid's levels are copies of the north's (tools/raid/raid_copy.py), each a
-- level of its own named raid_*, with no way in from the world. A raid starts from the laptop's "Raid" app (in a
-- window of the event "Cooling", raid_window.script; always, once the Brain Scorcher is off) and lands in Limansk where the Red Forest's level changer brings one. A transition of a copy
-- is a restrictor whose custom data has [raid_transition] (level: another copy or a level outside the raid, position,
-- node, direction; its logic calls raid_transition): the way one came onto a level leads out, straight to the
-- shelter; the others lead on; a level outside the raid is shut. The PDA is jammed in a raid.

local LEVELS_LTX = "scripts\\raid\\levels.ltx"
-- the way back: the shelter's entrance (point 1 of bunker_a1), facing into the corridor
local SHELTER = { level = "bunker_a1", position = vector():set(-6.99, 3.28, -27.09), node = 1600,
	look = vector():set(0.978, 0, -0.124) }
local JAM_MSG_MS = 3000

local TAKE_GRACE_MS = 3000 -- a level's load gives the inventory back as takes: none counts till its first update and a while
local ready, loaded_at, dying = false, 0, false -- takes count (found in a raid) / since / a death being handled

local levels -- the raid's levels: order = { names }, [name] = { original, map = { texture, x1, z1, x2, z2 } }, landing

local function vector_of(s)
	local p = str_explode(s, ",")
	return vector():set(tonumber(p[1]), tonumber(p[2]), tonumber(p[3]))
end

function get_levels()
	if levels then
		return levels
	end
	levels = { order = {} }
	local ini = ini_file(LEVELS_LTX)
	if not ini:section_exist("levels") then
		return levels
	end
	for _, name in ipairs(str_explode(ini:r_string_ex("levels", "order"), ",")) do
		local l = { name = name, original = ini:r_string_ex(name, "original") }
		local texture = ini:r_string_ex(name, "map_texture")
		if texture then
			local b = str_explode(ini:r_string_ex(name, "map_bounds"), ",")
			l.map = { texture = texture, x1 = tonumber(b[1]), z1 = tonumber(b[2]), x2 = tonumber(b[3]), z2 = tonumber(b[4]) }
		end
		levels.order[#levels.order + 1] = name
		levels[name] = l
	end
	levels.landing = { level = ini:r_string_ex("landing", "level"), came_from = ini:r_string_ex("landing", "came_from"),
		position = vector_of(ini:r_string_ex("landing", "position")), node = ini:r_u32("landing", "node"),
		direction = ini:r_float_ex("landing", "direction") or 0 }
	return levels
end

function is_raid_level(name)
	return name and string.find(name, "^raid_") ~= nil
end

-- the one debug switch (the console's coop_debug 1, as for co-op): the raid's debug lines in the log, the Monolith's
-- smarts, routes and patrols on the raid app's maps
function debug()
	return get_console():get_integer("coop_debug") == 1
end

function dbg(fmt, ...)
	if debug() then
		printf("[raid dbg] " .. fmt, ...)
	end
end

-- the raid app is there in a window, or always once the Brain Scorcher is off (raid_window.script)
function available()
	return raid_window.available()
end

-- the text's id if one can't set out now
function entry_denied()
	return raid_window.entry_denied()
end

-- The graph vertex of a level nearest to a position there.
local function graph_vertex(level_name, position)
	local gg, sim = game_graph(), alife()
	local best, best_d
	local gvid = 0
	while gg:valid_vertex_id(gvid) do
		local v = gg:vertex(gvid)
		if sim:level_name(v:level_id()) == level_name then
			local d = v:level_point():distance_to_sqr(position)
			if not best_d or d < best_d then
				best, best_d = gvid, d
			end
		end
		gvid = gvid + 1
	end
	return best
end

function vertex_of(level_name, position)
	return graph_vertex(level_name, position)
end

local function go(level_name, position, node, yaw)
	local gvid = graph_vertex(level_name, position)
	if not gvid then
		printf("! raid: level %s has no graph vertices", level_name)
		return false
	end
	ready = false
	ChangeLevel(position, node, gvid, vector():set(0, yaw, 0))
	return true
end

-------------------------------------------------------------------------------
-- who is in a raid (the world's raid_in: one of the group at a time) and the group's news of it (raid_news_<n> =
-- "who|what|level", n below raid_news_next; each game shows the new ones of the others, not while in a raid itself)

local NEWS_MS = 5000

function my_name()
	return (string.gsub(db.actor:character_name() or "", "|", "/"))
end

-- the one in a raid now, other than oneself (nil: the raid is free to go on)
function raider()
	local who = shelter.state("raid_in", nil)
	return who and who ~= "" and who ~= my_name() and who or nil
end

local function news(what, level_name)
	local n = tonumber(shelter.state("raid_news_next", 1)) or 1
	shelter.set_state("raid_news_" .. n, string.format("%s|%s|%s", my_name(), what, level_name or ""))
	shelter.set_state("raid_news_next", n + 1)
end

function group_news(what, level_name)
	news(what, level_name)
end

local function level_caption(name)
	local l = get_levels()[name]
	return game.translate_string(l and l.original or name)
end

local function update_news()
	if is_raid_level(level.name()) then
		return
	end
	local next_n = tonumber(shelter.state("raid_news_next", 1)) or 1
	local heard = load_var(db.actor, "raid_news_heard", nil)
	if heard and heard <= next_n then
		for n = heard, next_n - 1 do
			local who, what, where = string.match(tostring(shelter.state("raid_news_" .. n, "") or ""), "^([^|]*)|([^|]*)|(.*)$")
			if who and who ~= my_name() then
				db.actor:give_game_news(game.translate_string("st_raid_news_title"),
					string.format(game.translate_string("st_raid_news_" .. what), who, level_caption(where)),
					"ui_inGame2_Radiopomehi", 0, 10000)
			end
		end
	end
	save_var(db.actor, "raid_news_heard", next_n)
end

-------------------------------------------------------------------------------
-- found in a raid: what comes into one's inventory on a raid level (picked up, from boxes and bodies) is marked found
-- (the game's raid_found[id]); out alive, it is one's own. Death in a raid ([raid_death]): one wakes at the shelter's
-- entrance with what is in the slots and on the belt (the outfit, the helmet, the backpack itself among them);
-- everything found is lost, each other thing in the backpack with lose_chance.


local function found()
	local m = alife_storage_manager.get_state()
	m.raid_found = m.raid_found or {}
	return m.raid_found
end

local function actor_on_item_take(item)
	if ready and is_raid_level(level.name()) and time_global() >= loaded_at + TAKE_GRACE_MS then
		found()[item:id()] = true
		dbg("found %s (%s)", item:section(), item:id())
	end
end

local function kept(item)
	if db.actor:is_on_belt(item) or ini_sys:r_bool_ex(item:section(), "quest_item", false) then
		return true
	end
	for slot = 1, 16 do
		local s = db.actor:item_in_slot(slot)
		if s and s:id() == item:id() then
			return true
		end
	end
	return false
end

-- alive again: health to wake_health, every wound closed (bleeding = n takes n off each wound's size: a big hit's
-- wound outlasts 1 and kills one later, where no raid death is caught), no radiation
local function patch_up()
	db.actor:set_health_ex(ini_sys:r_float_ex("raid_death", "wake_health") or 0.5)
	db.actor.bleeding = 1000
	db.actor.radiation = 0
end

local function actor_on_before_death(who, flags)
	if not is_raid_level(level.name()) then
		return
	end
	flags.ret_value = false
	patch_up()
	if dying then
		return
	end
	dying = true
	level.add_pp_effector("sleep_fade.ppe", 1314, false)
	local f, lost = found(), {}
	local chance = ini_sys:r_float_ex("raid_death", "lose_chance") or 0.5
	db.actor:iterate_inventory(function(_, item)
		if not kept(item) and (f[item:id()] or math.random() < chance) then
			lost[#lost + 1] = item
		end
	end)
	for _, item in ipairs(lost) do
		dbg("lost %s (%s)%s", item:section(), item:id(), f[item:id()] and ", found" or "")
		alife_release(item)
	end
	printf("raid: died on %s, %s things lost", level.name(), #lost)
	news("died", level.name())
	save_var(db.actor, "raid_woke", #lost)
	CreateTimeEvent("raid", "wake", 1, function()
		dying = false
		exit_to_shelter(true)
		return true
	end)
end

-------------------------------------------------------------------------------
-- into the raid: the landing; the way out of the landing level is the transition to where the landing comes from
function start()
	if raider() or entry_denied() then
		return
	end
	local l = get_levels().landing
	printf("raid: start, landing on %s", l.level)
	shelter.set_state("raid_in", my_name())
	alife_storage_manager.get_state().raid_found = nil
	news("start", l.level)
	save_var(db.actor, "raid_came_from", l.came_from)
	raid_monolith.prepare(l.level)
	raid_rescue.prepare(l.level)
	raid_rich.prepare(l.level)
	raid_rescue.on_start()
	go(l.level, l.position, l.node, l.direction)
end

-- out of the raid (alive, or dead: died), to the shelter's entrance: what was found is one's own
function exit_to_shelter(died)
	printf("raid: out of %s to the shelter", level.name())
	raid_monolith.left(level.name())
	raid_rescue.on_exit(level.name(), died)
	if not died then
		news("out", level.name())
	end
	alife_storage_manager.get_state().raid_found = nil
	shelter.set_state("raid_in", nil)
	save_var(db.actor, "raid_came_from", nil)
	save_var(db.actor, "raid_face_shelter", true)
	go(SHELTER.level, SHELTER.position, SHELTER.node, 0)
end

function transition(obj)
	local ini = obj and obj:spawn_ini()
	if not (ini and ini:section_exist("raid_transition")) then
		return
	end
	local target = ini:r_string_ex("raid_transition", "level")
	if target == load_var(db.actor, "raid_came_from") then
		exit_to_shelter()
		return
	end
	if not is_raid_level(target) then
		actor_menu.set_msg(1, game.translate_string("st_raid_exit_closed"), 4)
		return
	end
	if raid_rescue.escorting(level.name()) then
		actor_menu.set_msg(1, game.translate_string("st_raid_rescue_no_further"), 4)
		return
	end
	printf("raid: %s -> %s", obj:name(), target)
	save_var(db.actor, "raid_came_from", level.name())
	raid_monolith.left(level.name())
	raid_monolith.prepare(target)
	raid_rescue.prepare(target)
	raid_rich.prepare(target)
	go(target, vector_of(ini:r_string_ex("raid_transition", "position")), ini:r_u32("raid_transition", "node"),
		ini:r_float_ex("raid_transition", "direction") or 0)
end

-------------------------------------------------------------------------------
-- GPS beacons ([raid_gps] in mod_system_raid.ltx): one runs from the first time it is found in a box on a raid level
-- (the world's raid_beacon_<id>: that game time) for life_hours, then it is flat: made a raid_gps_beacon_dead where
-- it lies. A box with a running beacon is a stash the raid app shows, with what is in it.

local BEACON, FLAT = "raid_gps_beacon", "raid_gps_beacon_dead"
local NO_PARENT = 65535

local function game_seconds()
	return game.get_game_time():diffSec(level.get_start_time())
end

local function life_seconds()
	return (ini_sys:r_float_ex("raid_gps", "life_hours") or 168) * 3600
end

local function level_of(se)
	return alife():level_name(game_graph():vertex(se.m_game_vertex_id):level_id())
end

-- a beacon's charge, 0..1 (1 till it runs), and the game hours it has left
function beacon_charge(id)
	local started = shelter.state("raid_beacon_" .. id, nil)
	if not started then
		return 1, life_seconds() / 3600
	end
	local left = math.max(0, life_seconds() - (game_seconds() - started))
	return left / life_seconds(), left / 3600
end

local function start_beacon(id)
	if not shelter.state("raid_beacon_" .. id, nil) then
		shelter.set_state("raid_beacon_" .. id, game_seconds())
	end
end

-- a flat beacon made a flat one's item where it lies: in its owner (an actor, a box) or on the ground
local function make_flat(se)
	local owner = se.parent_id ~= NO_PARENT and alife():object(se.parent_id)
	local at = owner or { se.position, se.m_level_vertex_id, se.m_game_vertex_id }
	shelter.set_state("raid_beacon_" .. se.id, nil)
	alife_release_id(se.id)
	alife_create_item(FLAT, at)
	printf("raid: beacon %s is flat", se.id)
end

-- The stashes: the boxes on raid levels with a running beacon, { id, level, position, charge, hours,
-- items = { { section, count } } }; flat beacons found on the way made flat items. A pass over all the objects.
function stashes()
	local sim = alife()
	local beacons, children = {}, {}
	for id = 1, NO_PARENT - 1 do
		local se = sim:object(id)
		if se then
			if se.parent_id ~= NO_PARENT then
				local list = children[se.parent_id] or {}
				list[#list + 1] = se
				children[se.parent_id] = list
			end
			if se:section_name() == BEACON then
				beacons[#beacons + 1] = se
			end
		end
	end
	local out, flat, seen = {}, {}, {}
	for _, beacon in ipairs(beacons) do
		local box = beacon.parent_id ~= NO_PARENT and beacon.parent_id ~= 0 and sim:object(beacon.parent_id)
		if box and IsInvbox(nil, box:clsid()) and is_raid_level(level_of(box)) then
			start_beacon(beacon.id)
			local charge, hours = beacon_charge(beacon.id)
			if charge <= 0 then
				flat[#flat + 1] = beacon
			elseif not seen[box.id] or seen[box.id].charge < charge then
				local counts, items = {}, {}
				for _, child in ipairs(children[box.id] or {}) do
					local sec = child:section_name()
					if not counts[sec] then
						items[#items + 1] = { section = sec, count = 0 }
						counts[sec] = items[#items]
					end
					counts[sec].count = counts[sec].count + 1
				end
				local s = { id = box.id, level = level_of(box), position = box.position, charge = charge, hours = hours,
					items = items }
				if seen[box.id] then
					for i, o in ipairs(out) do
						if o.id == box.id then
							out[i] = s
						end
					end
				else
					out[#out + 1] = s
				end
				seen[box.id] = s
			end
		end
	end
	for _, se in ipairs(flat) do
		make_flat(se)
	end
	return out
end

-- the carried beacons that ran flat
local function check_carried()
	local flat = {}
	db.actor:iterate_inventory(function(_, item)
		if item:section() == BEACON and shelter.state("raid_beacon_" .. item:id(), nil) and beacon_charge(item:id()) <= 0 then
			flat[#flat + 1] = item:id()
		end
	end)
	for _, id in ipairs(flat) do
		local se = alife():object(id)
		if se then
			make_flat(se)
		end
	end
end

local function actor_on_item_put_in_box(box, item)
	if item:section() == BEACON and is_raid_level(level.name()) then
		start_beacon(item:id())
	end
end

-------------------------------------------------------------------------------
-- the group's marks on the raid maps: raid_mark_<n> = "level|x|z|text" (the world's), n below raid_mark_next

function marks()
	local out = {}
	for n = 1, (tonumber(shelter.state("raid_mark_next", 1)) or 1) - 1 do
		local s = shelter.state("raid_mark_" .. n, nil)
		local level_name, x, z, text
		if type(s) == "string" then
			level_name, x, z, text = string.match(s, "^([^|]*)|([^|]*)|([^|]*)|(.*)$")
		end
		x, z = tonumber(x), tonumber(z)
		if level_name and x and z then
			out[#out + 1] = { n = n, level = level_name, x = x, z = z, text = text }
		end
	end
	return out
end

-- a mark saved: n nil for a new one; no text: the mark removed. Whole metres: a fraction would be written with the
-- locale's decimal comma, which tonumber does not read.
function set_mark(n, level_name, x, z, text)
	if not n then
		n = tonumber(shelter.state("raid_mark_next", 1)) or 1
		shelter.set_state("raid_mark_next", n + 1)
	end
	if text and text ~= "" then
		shelter.set_state("raid_mark_" .. n, string.format("%s|%d|%d|%s", level_name, math.floor(x + 0.5), math.floor(z + 0.5), text))
	else
		shelter.set_state("raid_mark_" .. n, nil)
	end
end

-------------------------------------------------------------------------------
-- the PDA in a raid: jammed. The 2D one asks pda.pda_use before it opens; the 3D one is put away when taken out.

local jam_msg_at = 0

local function jammed()
	local now = time_global()
	if now >= jam_msg_at then
		jam_msg_at = now + JAM_MSG_MS
		actor_menu.set_msg(1, game.translate_string("st_raid_pda_jammed"), 3)
	end
end

local checked_at, news_at = 0, 0

local function actor_on_update()
	if is_raid_level(level.name()) and db.actor:active_slot() == 8 then
		db.actor:activate_slot(0)
		jammed()
	end
	local now = time_global()
	if now >= checked_at then
		checked_at = now + (ini_sys:r_float_ex("raid_gps", "check_seconds") or 10) * 1000
		check_carried()
	end
	if now >= news_at then
		news_at = now + NEWS_MS
		update_news()
	end
end

local function actor_on_first_update()
	ready, loaded_at = true, time_global()
	if level.name() == SHELTER.level and load_var(db.actor, "raid_face_shelter") then
		save_var(db.actor, "raid_face_shelter", nil)
		db.actor:set_actor_direction(-SHELTER.look:getH())
	end
	local lost = load_var(db.actor, "raid_woke", nil)
	if lost and level.name() == SHELTER.level then
		save_var(db.actor, "raid_woke", nil)
		patch_up()
		actor_menu.set_msg(1, string.format(game.translate_string("st_raid_woke"), lost), 10)
	end
end

function on_game_start()
	xr_effects.raid_transition = function(actor, obj)
		transition(obj)
	end
	-- Anomaly's guide looks a way up in its table of levels, which has neither the raid's nor the shelter's: with an NPC
	-- of a fit faction online (the rescued, the staff) it crashes there. Nil: it tries again later.
	local go_poisk = tasks_guide.go_poisk
	tasks_guide.go_poisk = function()
		local name = level.name()
		if is_raid_level(name) or name == SHELTER.level then
			return nil
		end
		return go_poisk()
	end
	local pda_use = pda.pda_use
	pda.pda_use = function()
		if is_raid_level(level.name()) then
			jammed()
			return false
		end
		return pda_use()
	end
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
	RegisterScriptCallback("actor_on_item_put_in_box", actor_on_item_put_in_box)
	RegisterScriptCallback("actor_on_item_take", actor_on_item_take)
	RegisterScriptCallback("actor_on_before_death", actor_on_before_death)
end

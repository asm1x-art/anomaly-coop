-- The world's important news for the server's journal (coop-server news.js; the launchers show them and notify):
-- only what every player has already been told in the game, never a timetable. The game that speaks for the world
-- sends them - the sim master (the headless host when it runs the world); the server takes them from no one else.
-- Each goes as the fact "news" = "<type>\t<the world's clock>\t<text>" (coop.report_fact): not a fact of the world,
-- the server neither keeps it with the facts nor relays it. Which types the server keeps is its business
-- (server.cfg news_types: trade and chatter are not kept).
-- Types: cooling, cooling_end (raid_window), surge, surge_end, psi, psi_end (here, Anomaly's own callbacks),
-- raid (raid.script), shelter, bar, trade (shelter_trade.script).

local function on()
	return coop and coop.connected and coop.connected()
end

-- this game speaks for the world
function speaker()
	return on() and coop.is_sim_master()
end

-- the world's clock as players see it on the PDA: "12.05 14:07"
local function world_clock()
	local Y, M, D, h, m = game.get_game_time():get(0, 0, 0, 0, 0, 0, 0)
	return string.format("%02d.%02d %02d:%02d", D, M, h, m)
end

local function clean(text)
	return (string.gsub(tostring(text or ""), "[\t\r\n]+", " "))
end

function publish(kind, text)
	if not speaker() then
		return
	end
	text = clean(text)
	if text == "" then
		return
	end
	coop.report_fact("news", kind .. "\t" .. world_clock() .. "\t" .. text)
	if get_console():get_integer("coop_debug") == 1 then
		printf("[coop dbg] news: %s %s", kind, text)
	end
end

-- Anomaly's surge and psi storm say when they begin and end (surge_manager, psi_storm_manager): the master's are
-- the world's (coop_time.script shares its timetable)
local ANOMALIES = {
	emission_start = { "surge", "st_coop_news_surge" },
	emission_end = { "surge_end", "st_coop_news_surge_end" },
	psi_storm_start = { "psi", "st_coop_news_psi" },
	psi_storm_end = { "psi_end", "st_coop_news_psi_end" },
}

local QUIET_MS = 20000 -- a game that has just loaded the world settles a surge it missed: that was told long ago
local started_at = nil

-- an end is news only after its beginning: one the clock jumped over (a sleep: Anomaly's skip_surge,
-- skip_psi_storm) ends without having begun
local BEGINNING = { surge_end = "surge", psi_end = "psi" }
local going = {} -- surge, psi: begun and not over

local function actor_on_interaction(typ, obj, name)
	local n = typ == "anomalies" and ANOMALIES[name]
	if not n then
		return
	end
	local kind = n[1]
	local began = BEGINNING[kind]
	if began then
		if not going[began] then
			return
		end
		going[began] = nil
	else
		going[kind] = true
	end
	if started_at and time_global() - started_at >= QUIET_MS then
		publish(kind, game.translate_string(n[2]))
	end
end

function on_game_start()
	if not coop then
		return -- not the co-op engine
	end
	RegisterScriptCallback("actor_on_first_update", function()
		started_at = time_global()
		-- one going on in the save we loaded
		local surge = surge_manager and surge_manager.get_surge_manager()
		local psi = psi_storm_manager and psi_storm_manager.get_psi_storm_manager()
		going.surge = surge and surge.started == true or nil
		going.psi = psi and psi.started == true or nil
	end)
	RegisterScriptCallback("actor_on_interaction", actor_on_interaction)
end

-- Co-op: when a trader restocks is the world's, not each game's.
-- trade_manager.update restocks a trader once restock hours have passed since its resupply_time. In co-op only the
-- level's authority restocks (coop_sync: the others' buy_supplies comes out empty), but every game kept a timer of
-- its own: a game that became the authority restocked by its own, too soon or hours late. And trader_autoinject's
-- restock (WPO parts at mechanics, placeable items...) ran 0.1 s later in every game whose own timer was due, outside
-- the shared spawns: each game spawned its own parts and released the trader's.
-- Now the time of a trader's last restock is a fact of the server, "trader_restock:<trader id>" = "Y,M,D,h,m,s,ms"
-- (game time, as tm.resupply_time):
--   authority  takes it into the trader's profile before the update, publishes it when the update restocked (or
--              there is none yet)
--   the others keep their own timer as before (it only says when to look again): they restock nothing
--   autoinject only the level's authority runs it, shared.
-- Without co-op nothing changes.

local FACT = "trader_restock:"

local function in_coop()
	return coop and coop.connected and coop.connected()
end

local function dbg(fmt, ...)
	if get_console():get_integer("coop_debug") == 1 then
		printf("[coop dbg] trader restock: " .. fmt, ...)
	end
end

local KEYS = { "Y", "M", "D", "h", "m", "s", "ms" }

local function stamp(t)
	if type(t) ~= "table" then
		return ""
	end
	local out = {}
	for i, k in ipairs(KEYS) do
		out[i] = tostring(math.floor(tonumber(t[k]) or 0))
	end
	return table.concat(out, ",")
end

local function parse(text)
	local v = {}
	for n in string.gmatch(text or "", "%d+") do
		v[#v + 1] = tonumber(n)
	end
	if #v ~= #KEYS then
		return nil
	end
	local t = {}
	for i, k in ipairs(KEYS) do
		t[k] = v[i]
	end
	return t
end

local function shared(f, ...)
	coop.begin_shared()
	local res = { pcall(f, ...) }
	coop.end_shared()
	if not res[1] then
		error(res[2], 0)
	end
	return unpack(res, 2)
end

local function wrapped_update(original, npc, force_refresh)
	if not (in_coop() and npc and coop.is_authority(level.name())) then
		return original(npc, force_refresh)
	end
	local id = npc:id()
	local key = FACT .. id
	local world = coop.fact(key)
	local tm = trade_manager.get_trade_profile(id)
	local t = parse(world)
	if tm and t then
		tm.resupply_time = t
	end
	local res = { pcall(original, npc, force_refresh) }
	tm = trade_manager.get_trade_profile(id)
	local now = tm and stamp(tm.resupply_time) or ""
	if now ~= "" and now ~= world then
		coop.report_fact(key, now)
		dbg("%s (%s) restocked at %s", npc:name(), id, now)
	end
	if not res[1] then
		error(res[2], 0)
	end
	return unpack(res, 2)
end

local wrapped = false

-- outermost, once every script has wrapped it (trader_autoinject reads the timer before it calls on)
local function wrap_update()
	if wrapped then
		return
	end
	wrapped = true
	local original = trade_manager.update
	trade_manager.update = function(npc, force_refresh)
		return wrapped_update(original, npc, force_refresh)
	end
end

function on_game_start()
	if not coop then
		return -- not the co-op engine
	end
	local timed = trader_autoinject and trader_autoinject.timed_update
	if type(timed) == "function" then
		trader_autoinject.timed_update = function(npc)
			if not in_coop() then
				return timed(npc)
			end
			if not (npc and coop.is_authority(level.name())) then
				return true -- the authority's restock comes as its spawns and releases
			end
			return shared(timed, npc)
		end
	end
	RegisterScriptCallback("actor_on_first_update", wrap_update)
end

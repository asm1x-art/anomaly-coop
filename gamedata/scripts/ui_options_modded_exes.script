--- Options menu extension

-- NVIDIA DLSS and anti-aliasing in Video > Advanced. DLSS doesn't go with MSAA (the engine's r__dlss_status says msaa)
-- and makes SMAA useless (the engine skips SMAA while DLSS runs): choosing a DLSS mode turns MSAA off, and while a DLSS
-- mode is chosen the MSAA and SMAA rows give way to a line saying why.
local DLSS_ID, MSAA_ID, SMAA_ID = "video/advanced/dlss_mode", "video/advanced/ssample_list", "video/advanced/smaa"
local MSAA_OFF = "st_opt_off"
local ui_self -- the options window drawn last: its pending (not yet applied) values count
local options_hooked = false

-- why DLSS can or can't run, read when the page is drawn (the renderer is made by then)
function dlss_status()
	return get_console():get_string("r__dlss_status") or ""
end

-- the DLSS list: when it can run now, or after a restart without MSAA
function dlss_available()
	local s = dlss_status()
	return s == "ok" or s == "msaa"
end

-- a grey line with the reason DLSS can't run
function dlss_unavailable(reason)
	return dlss_status() == reason
end

-- an option's value in the open window (pending first), else the console's
local function opt_now(id)
	local v = ui_options.get_opt_table(id)
	if not (v and v.cmd) then
		return nil
	end
	if ui_self then
		local path, opt = id:match("^(.*)/([^/]+)$")
		return ui_self:GetCurrentValue(path, opt, v)
	end
	return get_console_cmd(0, v.cmd)
end

-- a DLSS mode is chosen (and DLSS can run): MSAA and SMAA are not used
function dlss_chosen()
	local m = opt_now(DLSS_ID)
	return dlss_available() and m ~= nil and m ~= "off"
end

function dlss_not_chosen()
	return not dlss_chosen()
end

-- Preset by video memory (gfx_presets.script): the entry chosen in the window's list (pending first, else the stored one)
local GFX_ID = "video/advanced/gfx_preset"
local function gfx_preset_chosen(self)
	local v = ui_options.get_opt_table(GFX_ID)
	return v and v.id and self:GetCurrentValue("video/advanced", "gfx_preset", v) or nil
end

-- the "Apply again" button: the chosen preset is put in force even if it is the one already applied, then the window's
-- own Apply runs (the other pending rows go on top, the window closes with the notice to restart the game)
function gfx_preset_again(self)
	local chosen = gfx_preset_chosen(self)
	if not (chosen and gfx_presets.apply(chosen)) then
		return
	end
	self.Change_Done = true
	self.Need_Restart = true
	self:On_Accept()
end

-- the options window's hooks: DLSS wins over MSAA in the pending values; the page is drawn anew after a DLSS change
-- (on the next update, not inside the list's own callback)
local function hook_options_window()
	local cls = ui_options.UIOptions
	if not cls or options_hooked then
		return
	end
	options_hooked = true

	local base_reset_opt = cls.Reset_opt
	function cls:Reset_opt(...)
		ui_self = self
		return base_reset_opt(self, ...)
	end

	local base_cache = cls.CacheValue
	function cls:CacheValue(path, opt, value, v)
		base_cache(self, path, opt, value, v)
		local id = path .. "/" .. opt
		if id ~= DLSS_ID and id ~= MSAA_ID then
			return
		end
		ui_self = self
		if dlss_chosen() and opt_now(MSAA_ID) ~= MSAA_OFF then
			local mv = ui_options.get_opt_table(MSAA_ID)
			if mv then
				base_cache(self, "video/advanced", "ssample_list", MSAA_OFF, mv)
			end
		end
		if id == DLSS_ID then
			-- started with MSAA: DLSS comes only with the game's restart (MSAA is built into the shaders at start)
			-- (the page shows a copy of the option; applying reads the option table's own row)
			local restart = dlss_status() == "msaa" and value ~= "off" or nil
			v.restart = restart
			local own = ui_options.get_opt_table(DLSS_ID)
			if own then
				own.restart = restart
			end
			self.dlss_redraw = true
		end
	end

	-- Apply: a preset by video memory chosen in the list (the pending value is not the stored one) is put in force
	-- before the window sends the other changed rows, so the player's own changes of the same Apply stay on top
	local base_accept = cls.On_Accept
	function cls:On_Accept()
		local chosen = gfx_preset_chosen(self)
		if chosen and chosen ~= ui_options.get(GFX_ID) then
			gfx_presets.apply(chosen)
		end
		return base_accept(self)
	end

	local base_update = cls.Update
	function cls:Update()
		base_update(self)
		if self.dlss_redraw then
			self.dlss_redraw = false
			if self.last_curr_tree and self.last_path then
				self:Reset_opt(self.last_curr_tree, self.last_path)
			end
		end
	end
end

-- UI entrypoint
function on_xml_read()
	ui_options_base = ui_options.init_opt_base
	ui_options.init_opt_base = function()
		ui_options_base()
		table.insert(ui_options.options, options_modded_exes.GROUP)

		function cont_sound_device()
			local cont = {}
			local devices = get_console():get_token_list("snd_device")
			if devices then
				for i=1,#devices do
					cont[#cont + 1] = {devices[i]}
				end
			end
			if #cont == 0 then
				local curr = get_console_cmd(0, "snd_device")
				cont[1] = {curr}
			end
			return cont
		end

		local v = ui_options.get_opt_table("sound/general/sound_device")
		if v then
			v.restart = false
			v.content = {cont_sound_device}
		end

		-- Extra options in vanilla options (not Modded Exes Options)
		local need_init_opt_coder = false

		-- Monitor selection
		function cont_vid_monitor()
			local cont = {}
			local monitors = get_console():get_token_list("vid_monitor")
			if monitors then
				for i=1,#monitors do
					cont[#cont + 1] = {monitors[i]}
				end
			end
			if #cont == 0 then
				local curr = get_console_cmd(0, "vid_monitor")
				cont[1] = {curr ~= "" and curr or "Auto"}
			end
			return cont
		end

		local basic = nil
		for _, top in ipairs(ui_options.options) do
			if top.id == "video" and top.gr then
				for _, sub in ipairs(top.gr) do
					if sub.id == "basic" then basic = sub; break end
				end
				break
			end
		end
		if basic and basic.gr then
			local already_present = false
			local renderer_idx = nil
			for i, row in ipairs(basic.gr) do
				if row.id == "monitor" then
					already_present = true
					break
				end
				if row.id == "renderer" then
					renderer_idx = i
				end
			end
			if not already_present and renderer_idx then
				table.insert(basic.gr, renderer_idx + 1, {
					id      = "monitor",
					type    = "list",
					val     = 0,
					cmd     = "vid_monitor",
					content = {cont_vid_monitor},
					no_str  = true,
					restart = true,
				})
				need_init_opt_coder = true
			end
		end

		-- Persistent weather switch
		local weather = nil
		for _, top in ipairs(ui_options.options) do
			if top.id == "video" and top.gr then
				for _, sub in ipairs(top.gr) do
					if sub.id == "weather" then weather = sub; break end
				end
				break
			end
		end
		if weather and weather.gr then
			local already_present = false
			local clear_slide = nil
			for i, row in ipairs(weather.gr) do
				if row.id == "persistent_weather" then
					already_present = true
					break
				end
				if row.id == "clear_slide" then
					clear_slide = i
				end
			end
			if not already_present and clear_slide then
				table.insert(weather.gr, clear_slide, {
					id      = "persistent_weather",
					type    = "check",
					val     = 1,
					def 	= true,
				})
				need_init_opt_coder = true
			end
		end

		-- NVIDIA DLSS (engine: r__dlss_mode, r__dlss_status), after SMAA in Video > Advanced; when it can't run, the reason.
		-- While a DLSS mode is chosen, MSAA (off then) and SMAA (skipped by the engine) give way to a line saying why.
		local advanced = nil
		for _, top in ipairs(ui_options.options) do
			if top.id == "video" and top.gr then
				for _, sub in ipairs(top.gr) do
					if sub.id == "advanced" then advanced = sub; break end
				end
				break
			end
		end
		local has_dlss = get_console():get_string("r__dlss_status") -- nil with an exe without DLSS
		if advanced and advanced.gr and has_dlss and has_dlss ~= "" then
			local already_present = false
			local msaa_idx, smaa_idx = nil, nil
			for i, row in ipairs(advanced.gr) do
				if row.id == "dlss_mode" then
					already_present = true
					break
				end
				if row.id == "ssample_list" then
					msaa_idx = i
				end
				if row.id == "smaa" then
					smaa_idx = i
				end
			end
			if not already_present and msaa_idx and smaa_idx and msaa_idx < smaa_idx then
				local msaa_row, smaa_row = advanced.gr[msaa_idx], advanced.gr[smaa_idx]
				-- MSAA is built into the shaders when the game starts: a change takes the game's restart
				msaa_row.restart = true
				msaa_row.precondition_1 = {dlss_not_chosen}
				smaa_row.precondition_1 = {dlss_not_chosen}
				local rows = {
					{
						id      = "dlss_mode",
						type    = "list",
						val     = 0,
						cmd     = "r__dlss_mode",
						content = {
							{"off", "st_opt_off"},
							{"dlaa", "ui_mm_dlss_dlaa"},
							{"quality", "ui_mm_dlss_quality"},
							{"balanced", "ui_mm_dlss_balanced"},
							{"performance", "ui_mm_dlss_performance"},
							{"ultra_performance", "ui_mm_dlss_ultra_performance"},
						},
						no_str  = true, -- the names are string ids already (as the SMAA row's)
						vid     = true,
						precondition = {dlss_available},
					},
				}
				for _, reason in ipairs({"not_nvidia", "unsupported", "old_driver", "no_dll", "msaa", "hdr10", "init_failed", "no_sdk"}) do
					rows[#rows + 1] = {
						id           = "dlss_off_" .. reason,
						type         = "desc",
						text         = "ui_mm_dlss_off_" .. reason,
						clr          = {255, 200, 200, 200},
						precondition = {dlss_unavailable, reason},
					}
				end
				for i, row in ipairs(rows) do
					table.insert(advanced.gr, smaa_idx + i, row)
				end
				-- the lines in place of MSAA and SMAA (SMAA's first: inserting it doesn't move MSAA's place)
				table.insert(advanced.gr, smaa_idx + 1, {
					id           = "smaa_dlss",
					type         = "desc",
					text         = "ui_mm_smaa_off_dlss",
					clr          = {255, 200, 200, 200},
					precondition = {dlss_chosen},
				})
				table.insert(advanced.gr, msaa_idx + 1, {
					id           = "msaa_dlss",
					type         = "desc",
					text         = "ui_mm_msaa_off_dlss",
					clr          = {255, 200, 200, 200},
					precondition = {dlss_chosen},
				})
				hook_options_window()
				need_init_opt_coder = true
			end
		end

		-- Preset by video memory (gfx_presets.script), the first row of Video > Advanced: right under the window's own
		-- "Presets" list (the game's quality presets of this page), so the two read as a pair.
		-- The preset is put in force by the window's Apply when another entry was chosen (the On_Accept hook above),
		-- or by the button under the list; a short line under them, the rest is in the list's hint
		if advanced and advanced.gr and gfx_presets and advanced.gr[1] and advanced.gr[1].id ~= "gfx_preset" then
			table.insert(advanced.gr, 1, {
				id      = "gfx_preset",
				type    = "list",
				val     = 0,
				def     = {gfx_presets.current},
				content = {gfx_presets.option_content},
				no_str  = true,
				restart = true, -- shader quality levels are built into the shaders at the game's start
			})
			table.insert(advanced.gr, 2, {
				id         = "gfx_preset_again",
				type       = "button",
				functor_ui = {gfx_preset_again},
			})
			table.insert(advanced.gr, 3, {
				id   = "gfx_preset_note",
				type = "desc",
				text = "ui_mm_video_advanced_gfx_preset_note",
				clr  = {255, 200, 200, 200},
			})
			hook_options_window()
			need_init_opt_coder = true
		end
		if need_init_opt_coder and ui_options.init_opt_coder then
			ui_options.init_opt_coder()
		end
	end
	ui_options.init_opt_base()
end

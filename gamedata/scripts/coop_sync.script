-- Co-op: runs Anomaly's world logic on one client only and shares what it spawns.
--
-- Every client runs its own A-Life and scripts. Logic that would run in every world (squad respawns,
-- trader restock, artefacts, world items, offline combat) runs only on the client that is the
-- authority for that level (coop.is_authority, see src/xrGame/coop/coop_net.h), and what it spawns is
-- sent to the others at once (coop.begin_shared / coop.end_shared). Spawns caused by a player's action
-- (opening a stash, looting a corpse) run where the action happens and are shared the same way; the
-- others are told through coop.send_event so they don't spawn the same thing again.
-- Vanilla files are not edited: their module functions are wrapped from here.

local function coop_on()
	return coop and coop.connected()
end

local function level_of(se_obj)
	return se_obj and alife():level_name(game_graph():vertex(se_obj.m_game_vertex_id):level_id())
end

local function is_authority(level_name)
	return not coop_on() or coop.is_authority(level_name)
end

-- f(...) with everything it spawns shared, errors passed through
local function shared(f, ...)
	coop.begin_shared()
	local res = { pcall(f, ...) }
	coop.end_shared()
	if not res[1] then
		error(res[2], 0)
	end
	return unpack(res, 2)
end

-- tbl[name] = wrapper(original, ...)
local function wrap(tbl, name, where, wrapper)
	local original = tbl and tbl[name]
	if type(original) ~= "function" then
		printf("! [coop] %s.%s not found, not wrapped", where, name)
		return
	end
	tbl[name] = function(...)
		return wrapper(original, ...)
	end
end

------------------------------------------------------------------------------------------------
-- Events from the other players: _G.coop_on_event(name, sender, payload), called by the engine

local handlers = {}

_G.coop_on_event = function(name, sender, payload)
	local handler = handlers[name]
	if get_console():get_integer("coop_debug") == 1 then
		printf("[coop dbg] event %s from %s: %s", name, sender, payload)
	end
	if handler then
		handler(sender, payload)
	else
		printf("! [coop] unknown event %s from %s", name, sender)
	end
end

local function send(name, ...)
	if coop_on() then
		local payload = table.concat({ ... }, "\t")
		if get_console():get_integer("coop_debug") == 1 then
			printf("[coop dbg] event %s sent: %s", name, payload)
		end
		coop.send_event(name, payload)
	end
end

local function fields(payload)
	return str_explode(payload, "\t")
end

-- for the other co-op scripts: handler(sender, payload) for an event; send an event of tab-joined fields
function on_event(name, handler)
	handlers[name] = handler
end

function send_event(name, ...)
	send(name, ...)
end

------------------------------------------------------------------------------------------------
-- World logic: authority only

local function wrap_world_logic()
	-- squad respawn at smart terrains: online and offline smarts alike
	RegisterScriptCallback("on_try_respawn", function(smart, flags)
		if not is_authority(level_of(smart)) then
			flags.disabled = true
		end
	end)
	wrap(smart_terrain.se_smart_terrain, "try_respawn", "smart_terrain.se_smart_terrain", function(original, self)
		if coop_on() then
			return shared(original, self)
		end
		return original(self)
	end)

	-- offline combat: a level's battles are its authority's (the sim master's while nobody is there) and
	-- reach the others as deaths and releases. Not the sim master's on a player's level: there those squads
	-- are online, in front of the player, and would drop dead and vanish
	wrap(sim_offline_combat, "validate_enemy", "sim_offline_combat", function(original, sim, lid, ...)
		if coop_on() and not coop.is_authority(alife():level_name(lid)) then
			return false
		end
		return original(sim, lid, ...)
	end)

	-- a death another game sent, of a creature offline here: its squad would release the body (remove_npc
	-- releases a dead member that is offline), and the release reach the game where it lies online
	wrap(safe_release_manager, "release", "safe_release_manager", function(original, se_obj)
		if coop_on() and se_obj and coop.remote_death(se_obj.id) then
			return
		end
		return original(se_obj)
	end)

	-- trader restock. update() also sets the trade conditions up, so it must run everywhere: off the
	-- authority only the trader's buy_supplies condlist comes out empty, so it returns before restocking
	wrap(trade_manager, "update", "trade_manager", function(original, npc, force_refresh)
		if not coop_on() then
			return original(npc, force_refresh)
		end
		if is_authority(level.name()) then
			return shared(original, npc, force_refresh)
		end
		local parse = xr_logic.parse_condlist
		xr_logic.parse_condlist = function(obj, section, field, src)
			if section == "trader" and field == "buy_supplies" then
				return nil
			end
			return parse(obj, section, field, src)
		end
		local ok, err = pcall(original, npc, force_refresh)
		xr_logic.parse_condlist = parse
		if not ok then
			error(err, 0)
		end
	end)

	-- artefacts in anomaly zones: on level load and after an emission
	wrap(bind_anomaly_zone.anomaly_zone_binder, "spawn_artefact_randomly", "bind_anomaly_zone.anomaly_zone_binder",
		function(original, self)
			if not coop_on() then
				return original(self)
			end
			if is_authority(level.name()) then
				return shared(original, self)
			end
		end)
	wrap(bind_anomaly_zone, "force_spawn_artefacts", "bind_anomaly_zone", function(original, ...)
		if not coop_on() then
			return original(...)
		end
		if is_authority(level.name()) then
			return shared(original, ...)
		end
	end)

	-- world items lying around the level
	wrap(game_setup, "try_spawn_world_item", "game_setup", function(original, ...)
		if not coop_on() then
			return original(...)
		end
		if is_authority(level.name()) then
			return shared(original, ...)
		end
	end)

	-- dynamic anomalies are off in co-op for now: their on/off state isn't synced yet
	for _, name in ipairs({ "dyn_anomalies_refresh", "dyn_anomalies_spawn", "dyn_anomalies_suffle" }) do
		wrap(bind_anomaly_field, name, "bind_anomaly_field", function(original, ...)
			if not coop_on() then
				return original(...)
			end
		end)
	end
end

------------------------------------------------------------------------------------------------
-- Corpse loot: created lazily when a corpse is first searched, by whoever does it first

local function wrap_corpse_loot()
	wrap(death_manager, "create_release_item", "death_manager", function(original, npc)
		if not coop_on() then
			return original(npc)
		end
		local id, name = npc:id(), npc:name()
		local already = se_load_var(id, name, "death_dropped")
		local res = shared(original, npc)
		if not already and se_load_var(id, name, "death_dropped") then
			send("loot_created", id, name)
		end
		return res
	end)

	handlers.loot_created = function(sender, payload)
		local f = fields(payload)
		local id, name = tonumber(f[1]), f[2]
		local se_obj = id and alife_object(id)
		if se_obj and se_obj:name() == name then
			se_save_var(id, name, "death_dropped", true)
		end
	end
end

------------------------------------------------------------------------------------------------
-- Mutant loot (ui_mutant_loot.script): the parts a body gives are rolled the first time someone opens it
-- and kept on the body (save_var "loot"). Everyone gets that roll, and what is left after each take; also
-- as se var "coop_loot", which an offline body or a world loaded again keeps.

local function encode_loot(loot)
	local parts = {}
	for sec, t in pairs(loot or {}) do
		if (t.count or 0) > 0 then
			parts[#parts + 1] = sec .. "=" .. t.count
		end
	end
	table.sort(parts)
	return table.concat(parts, ",")
end

local function decode_loot(text)
	local loot = {}
	for _, part in ipairs(str_explode(text or "", ",")) do
		local sec, count = part:match("^(.-)=(%d+)$")
		if sec and sec ~= "" then
			loot[sec] = { count = tonumber(count) }
		end
	end
	return loot
end

-- the body's loot as it is now, to the others when it changed
local function share_loot(obj, before)
	local loot = load_var(obj, "loot", nil)
	if not loot then
		return
	end
	local text = encode_loot(loot)
	if text ~= before then
		se_save_var(obj:id(), obj:name(), "coop_loot", text)
		send("mutant_loot", obj:id(), obj:name(), text)
	end
end

local function wrap_mutant_loot()
	local ui = ui_mutant_loot.UIMutantLoot
	wrap(ui, "FillList", "ui_mutant_loot.UIMutantLoot", function(original, self)
		if not (coop_on() and self.obj) then
			return original(self)
		end
		local text = se_load_var(self.id, self.obj:name(), "coop_loot")
		if text then
			save_var(self.obj, "loot", decode_loot(text)) -- rolled by someone, maybe taken from
		end
		local rolled = load_var(self.obj, "loot", nil) ~= nil
		local res = original(self)
		if not rolled then
			share_loot(self.obj, nil)
		end
		return res
	end)
	wrap(ui, "Loot", "ui_mutant_loot.UIMutantLoot", function(original, self, loot_all)
		local before = coop_on() and self.obj and encode_loot(self.loot)
		local res = original(self, loot_all)
		if before then
			share_loot(self.obj, before)
		end
		return res
	end)

	handlers.mutant_loot = function(sender, payload)
		local f = fields(payload)
		local id, name, text = tonumber(f[1]), f[2], f[3] or ""
		local se_obj = id and alife_object(id)
		if not (se_obj and se_obj:name() == name) then
			return
		end
		local loot = decode_loot(text)
		se_save_var(id, name, "coop_loot", text)
		if is_empty(loot) then
			se_save_var(id, name, "looted", true)
			xr_corpse_detection.set_valuable_loot(id, false)
		end
		local obj = db.storage[id] and level.object_by_id(id)
		if obj then
			save_var(obj, "loot", loot)
		end
		local gui = ui_mutant_loot.GUI -- open on the same body here: what it shows goes too
		if gui and gui:IsShown() and gui.id == id then
			gui.loot = loot
			if is_empty(loot) then
				gui:Close()
			else
				gui:FillList()
			end
		end
	end
end

------------------------------------------------------------------------------------------------
-- Stashes. treasure_manager.caches[id]: false = empty box, "sec1,sec2" = revealed, not spawned yet,
-- true = spawned. A revealed stash's content is the same everywhere; the green spot ("treasure") is
-- shown to the others at once, the purple one ("treasure_searched", rare) through the PDA menu.

local SHARE_STASH = "Поделиться с отрядом"
local rare_revealed = {} -- box id -> { content, hint }: rare stashes we can share

local function caches()
	return treasure_manager.caches -- reassigned on load, never keep the table
end

local function stash_spot(id)
	for _, spot in ipairs({ "treasure", "treasure_searched", "treasure_unique" }) do
		if level.map_has_object_spot(id, spot) ~= 0 then
			return spot
		end
	end
end

local function announce_stash(id, content, spot, hint)
	send("stash_revealed", id, content, spot or "", hint or "")
end

-- runs f, then reports every box that got revealed by it; create_random_stash calls
-- set_random_stash, both are wrapped: only the outer call reports
local watch_depth = 0
local function watch_reveals(f, hint, ...)
	if watch_depth > 0 then
		return f(...)
	end
	local before = {}
	for id, v in pairs(caches()) do
		before[id] = v
	end
	watch_depth = watch_depth + 1
	local res = { pcall(f, ...) }
	watch_depth = watch_depth - 1
	if not res[1] then
		error(res[2], 0)
	end
	table.remove(res, 1)
	for id, v in pairs(caches()) do
		if type(v) == "string" and before[id] ~= v then
			local spot = stash_spot(id)
			if spot == "treasure_searched" then
				rare_revealed[id] = { content = v, hint = hint }
			elseif spot then
				announce_stash(id, v, spot, hint)
			end
		end
	end
	return unpack(res)
end

local function wrap_stashes()
	wrap(treasure_manager, "create_random_stash", "treasure_manager", function(original, no_spot, hint, ...)
		if not coop_on() then
			return original(no_spot, hint, ...)
		end
		return watch_reveals(original, hint, no_spot, hint, ...)
	end)
	wrap(treasure_manager, "set_random_stash", "treasure_manager", function(original, no_spot, hint, ...)
		if not coop_on() then
			return original(no_spot, hint, ...)
		end
		return watch_reveals(original, hint, no_spot, hint, ...)
	end)

	-- the box is filled on first use, where the player opens it
	wrap(treasure_manager, "try_spawn_treasure", "treasure_manager", function(original, box)
		if not coop_on() then
			return original(box)
		end
		local id = box:id()
		local was = caches()[id]
		local res = shared(original, box)
		if type(was) == "string" and caches()[id] == true then
			rare_revealed[id] = nil
			send("stash_opened", id)
		end
		return res
	end)

	handlers.stash_revealed = function(sender, payload)
		local f = fields(payload)
		local id, content, spot, hint = tonumber(f[1]), f[2], f[3], f[4]
		if not (id and content and caches()[id] ~= nil) then
			return
		end
		if caches()[id] ~= true then
			caches()[id] = content
		end
		if spot ~= "" and level.map_has_object_spot(id, spot) == 0 then
			level.map_add_object_spot_ser(id, spot, hint or "")
			news_manager.send_treasure(0)
		end
		printf("[coop] %s shared a stash: box %s", sender, id)
	end

	handlers.stash_opened = function(sender, payload)
		local id = tonumber(fields(payload)[1])
		-- its content arrives as shared spawns; don't spawn it again here
		if id and caches()[id] ~= nil then
			caches()[id] = true
		end
	end

	RegisterScriptCallback("map_spot_menu_add_property", function(ui, id, level_name)
		if coop_on() and rare_revealed[id] and caches()[id] == rare_revealed[id].content then
			ui:AddItem(SHARE_STASH)
		end
	end)
	RegisterScriptCallback("map_spot_menu_property_clicked", function(property_ui, id, level_name, prop)
		local stash = rare_revealed[id]
		if prop == SHARE_STASH and stash then
			announce_stash(id, stash.content, "treasure_searched", stash.hint)
			rare_revealed[id] = nil
		end
	end)
end

------------------------------------------------------------------------------------------------
-- Saving. The world on the server is the sim master's save: it goes up whenever the master saves
-- (src/xrGame/coop/coop_save.cpp), every coop_autosave_interval minutes from here, and whenever the
-- server asks: a player comes in, leaves or asks for a save (ui_coop_saves.script, the quick save key).

local AUTOSAVE = "coop_autosave"
local last_save -- time_global() of the master's last save, nil: not counting yet
local asked = {} -- { name, reason, who }...: saves the server asked for, made one by one as soon as they can be
local saving = nil -- the one being made, told to the others once it is (world_saved)
local SAVES_APART_MS = 3000 -- a save goes up after the next frames: the next one waits, or it takes its name

local function news(text)
	db.actor:give_game_news("Кооператив", text, "ui_iconsTotal_grouping", 0, 8000)
end

local function autosave()
	if not (coop_on() and coop.is_sim_master()) then
		last_save = nil
		return
	end
	local now = time_global()
	last_save = last_save or now
	local minutes = get_console():get_integer("coop_autosave_interval")
	if #asked == 0 and (minutes <= 0 or now - last_save < minutes * 60000) then
		return
	end
	if #asked > 0 and now - last_save < SAVES_APART_MS then
		return
	end
	-- as a quicksave: not dead, not in a menu, trade or dialog
	if not (db.actor:alive() and actor_menu.is_hud_free()) then
		return
	end
	local meta = table.remove(asked, 1) or { name = "", reason = "auto", who = "" }
	saving = meta
	coop.set_save_meta(meta.name, meta.reason, meta.who)
	actor_menu.set_msg(1, meta.reason == "auto" and "Автосохранение мира" or "Сохранение мира", 3)
	local force_pause = not device():is_paused()
	if force_pause then
		device():pause(true)
	end
	exec_console_cmd("save " .. AUTOSAVE)
	if force_pause then
		device():pause(false)
	end
end

local function wrap_saves()
	RegisterScriptCallback("actor_on_update", autosave)

	RegisterScriptCallback("save_state", function()
		if not coop_on() then
			return
		end
		if coop.is_sim_master() then
			last_save = time_global()
			local meta = saving or { name = "", reason = "quick", who = "" }
			saving = nil
			send("world_saved", meta.reason, meta.name, meta.who)
		end
	end)

	_G.coop_on_save_now = function(name, reason, who)
		table.insert(asked, { name = name, reason = reason, who = who })
	end

	handlers.world_saved = function(sender, payload)
		coop_death.mark_save_point() -- where we go back to after a death
		local f = fields(payload)
		local reason, name, who = f[1], f[2] or "", f[3] ~= "" and f[3] or sender
		if reason == "auto" then
			news("Автосохранение мира.")
		elseif reason == "named" then
			news(string.format("Мир сохранён: «%s» (%s).", name, who))
		elseif reason == "join" then
			news(string.format("Мир сохранён: входит %s.", who))
		elseif reason == "leave" then
			news(string.format("Мир сохранён: вышел %s.", who))
		else
			news(string.format("Мир сохранён (%s).", who))
		end
	end
end

------------------------------------------------------------------------------------------------
-- Other players coming into the world and leaving it: _G.coop_on_peer(name, joined), by the engine.
-- The ones already there when our level starts are not news.

local level_since -- time_global() of our actor's first update

local function watch_peers()
	RegisterScriptCallback("actor_on_first_update", function()
		level_since = time_global()
	end)

	_G.coop_on_peer = function(name, joined)
		if not (db.actor and level_since) or time_global() - level_since < 5000 then
			return
		end
		news(string.format(joined and "%s вошёл в мир." or "%s вышел из мира.", name))
	end
end

------------------------------------------------------------------------------------------------
-- Our faction: the world's save holds its owner's actor, the server keeps ours with our character.

local function keep_faction()
	RegisterScriptCallback("actor_on_first_update", function()
		local community = coop_on() and coop.character_community() or ""
		if community == "" or character_community(db.actor) == community then
			return
		end
		db.actor:set_character_community(community, 0, 0)
		alife_storage_manager.get_state().default_faction = string.gsub(community, "^actor_", "")
		printf("[coop] our faction: %s", community)
	end)
end

------------------------------------------------------------------------------------------------
-- Players' stand-ins (section coop_proxy, src/xrGame/coop/coop_combat.cpp): an NPC judges one as it
-- would the player himself. An enemy by relation (faction), unless the NPC leaves players alone right
-- now (bases, combat_ignore logic): else it shoots an invisible, unkillable stand-in for ever and hits
-- everyone around it.
-- Grudges (coop.grudge): a squad shot by a player, in this game or in the one that ran the level then,
-- answers him even there, as one shot by the actor does (xr_combat_ignore's hit_callback).

local answered = {} -- NPC id: its grudge against our actor taken in, once, as the hit itself would be

-- A non-hostile squad attacked by a player (the engine tells the level's authority, coop_combat.cpp):
-- one of it who is still alive gets on the radio a little later and names the attacker, and the
-- attacker's standing with that faction drops (coop_rules faction_penalty). A squad wiped out before
-- that tells nobody.
local REPORT_DELAY = 4 -- s

local function faction_penalty(community)
	local amount = coop_rules.number("faction_penalty", 100)
	if amount > 0 and db.actor and community and community ~= "" then
		relation_registry.change_community_goodwill(community, AC_ID, -amount)
		printf("[coop] %s like us %s less", community, amount)
	end
end

local function report_attack(npc_id, attacker)
	local se = alife_object(npc_id)
	local squad = se and se.group_id and se.group_id ~= 65535 and alife_object(se.group_id)
	local reporter
	if squad then
		for member in squad:squad_members() do
			local m = alife_object(member.id)
			if m and m:alive() then
				reporter = m
				break
			end
		end
	elseif se and se:alive() then
		reporter = se
	end
	if not reporter then
		return -- nobody of it lives to tell
	end
	local community = reporter:community()
	local header = reporter.character_name and reporter:character_name() or ""
	local msg = string.format(game.translate_string("st_coop_attacked"), attacker, game.translate_string(level.name()))
	dynamic_news_helper.send_tip(msg, header, nil, 10, community, "danger", "gr")
	send("news", msg, header, "", "10", community, "danger", "gr")
	if attacker == coop.my_name() then
		faction_penalty(community)
	else
		send("penalty", attacker, community)
	end
end

local function judge_stand_ins()
	_G.coop_on_squad_attacked = function(npc_id, peer, attacker)
		CreateTimeEvent("coop_report_attack", npc_id .. ":" .. attacker, REPORT_DELAY, function()
			report_attack(npc_id, attacker)
			return true
		end)
	end
	handlers.penalty = function(sender, payload)
		local f = fields(payload)
		if f[1] == coop.my_name() then
			faction_penalty(f[2])
		end
	end
	-- our grudge forgiven (we left that level): what our hit set on the squad goes too
	_G.coop_on_calm = function(key)
		local se = alife_object(key)
		local ids = {}
		if se and se.squad_members then
			for member in se:squad_members() do
				ids[#ids + 1] = member.id
			end
		else
			ids[1] = key
		end
		for _, id in ipairs(ids) do
			answered[id] = nil
			local npc = level.object_by_id(id)
			if npc then
				save_var(npc, "xr_combat_ignore_enabled", nil)
			end
		end
	end

	RegisterScriptCallback("on_enemy_eval", function(obj, enemy, flags)
		-- a player lying wounded is left be (coop_death.script)
		local peer = enemy:id() == AC_ID and coop.my_id() or coop.stand_in_peer(enemy:id())
		if peer ~= 0 and coop.downed(peer) then
			flags.override = true
			flags.result = false
			return
		end
		local grudge = coop.grudge(obj:id(), enemy:id())
		if enemy:id() == AC_ID then
			if grudge and not answered[obj:id()] then
				answered[obj:id()] = true
				local st = db.storage[obj:id()]
				if not (st and st.overrides and st.overrides.combat_ignore_keep_when_attacked) then
					save_var(obj, "xr_combat_ignore_enabled", false)
				end
			end
			return -- the rest of is_enemy as usual
		end
		if enemy:section() ~= "coop_proxy" then
			return
		end
		flags.override = true
		flags.result = grudge or (db.actor ~= nil and obj:relation(enemy) >= game_object.enemy
			and not xr_combat_ignore.ignore_enemy_by_overrides(obj, db.actor))
	end)
end

------------------------------------------------------------------------------------------------
-- The stalker network: world news (chatter, deaths, finds, their reactions) come from the sim master's
-- game and are shown in every game, the others' own world news generators keep quiet. Personal ones
-- (tasks, companions, the network going down in an emission or underground) stay each player's own.

local function share_world_news()
	local DNM = dynamic_news_manager and dynamic_news_manager.DynamicNewsManager
	if not (DNM and dynamic_news_helper) then
		printf("! [coop] dynamic news not found, not shared")
		return
	end
	local world = 0 -- > 0 while a world news generator runs

	local function writes_news()
		return not coop_on() or coop.is_sim_master()
	end

	local function generating(original, ...)
		world = world + 1
		local res = { pcall(original, ...) }
		world = world - 1
		if not res[1] then
			error(res[2], 0)
		end
		return unpack(res, 2)
	end

	-- the instance is made a while after the level loads: from the class patched by then
	for _, name in ipairs({ "TickNews", "TickQuick", "TickSpecial", "TickRandom" }) do
		wrap(DNM, name, "DynamicNewsManager", function(original, self, ...)
			if not writes_news() then
				ResetTimeEvent("DynamicNewsManager", name, 10) -- a quiet tick re-arms itself too
				return false
			end
			return generating(original, self, ...)
		end)
	end
	for _, name in ipairs({ "npc_on_death_callback", "monster_on_death_callback", "npc_on_get_all_from_corpse" }) do
		wrap(DNM, name, "DynamicNewsManager", function(original, self, ...)
			if writes_news() then
				return generating(original, self, ...)
			end
		end)
	end
	wrap(DNM, "NewsToggle", "DynamicNewsManager", function(original, self, ...)
		local outer = world
		world = 0
		local res = { pcall(original, self, ...) }
		world = outer
		if not res[1] then
			error(res[2], 0)
		end
		return unpack(res, 2)
	end)

	wrap(dynamic_news_helper, "send_tip", "dynamic_news_helper", function(original, msg, header, timeout, showtime, sender, sound, icon_by)
		local shown = original(msg, header, timeout, showtime, sender, sound, icon_by)
		if shown and world > 0 then
			send("news", msg or "", header or "", timeout or "", showtime or "", sender or "", sound or "", icon_by or "")
		end
		return shown
	end)

	local function opt(s)
		return s ~= "" and s or nil
	end
	handlers.news = function(sender, payload)
		local f = fields(payload)
		dynamic_news_helper.send_tip(opt(f[1]), opt(f[2]), tonumber(f[3]), tonumber(f[4]), opt(f[5]), opt(f[6]), opt(f[7]))
	end
end

function on_game_start()
	if not coop then
		return -- not the co-op engine
	end
	wrap_world_logic()
	wrap_corpse_loot()
	wrap_mutant_loot()
	wrap_stashes()
	wrap_saves()
	watch_peers()
	keep_faction()
	judge_stand_ins()
	share_world_news()
	printf("[coop] world logic wrapped")
end

-- Co-op: the Zone's event "Ash front" (coop_zone_events.script, [zone_event_ash] in mod_system_zone_events.ltx). Fire
-- hotspots in the Red Forest, the wind carries the ash to Yantar, Jupiter or Zaton; or the surge has shaken up the old
-- machinery of the Truck Cemetery. For 3-4 real hours on one level:
--   ash        the level's weather is w_zev_ash over the world's, in each game on it (coop_time asks weather()),
--              blended in at the front's start and back out at its end
--   cover      the level's shelter itself: Anomaly's surge covers there (shelter_covers_<level>: space restrictors),
--              or within cover_fallback_radius of its smart when none of them is on the level
--   radiation  a player there without a sealed suit (sealed_suits: parts of the outfit's section; an exoskeleton is not
--              one) and out of cover takes rad_rate a second up to rad_max and, past rad_harm_from, loses at least
--              rad_health * radiation of health a second (what the engine's radiation or anything else takes counts
--              towards it): death in about 90 s without anti-rad. In cover the radiation goes down by
--              cover_rad_decay a second. Each game its own player's
--   anti-rad   one of antirad_items used on the front's level stops both (the ash's radiation and its health floor) for
--              antirad_pause_s real seconds: time to reach a cover. Another one in the pause starts it over (no
--              stacking); the engine's own radiation and the drug's boosts work as usual. A load or the front's end
--              ends the pause
--   NPCs       the level's stalkers out of cover and not in sealed gear (the outfit their visual stands for: what they
--              wear, never their faction or their squad's name) die of it, each game the NPCs it runs: the level's
--              authority. Online ones lose health evenly from npc_harm_after_s and die npc_death_s after they were
--              first out of cover; the shelter's people (its smart's, or on their way into it) have npc_walk_in_s more
--              to get in. Offline squads out of the shelter (farther than offline_shelter_radius from its smart) for
--              offline_death_min real minutes are taken away. Story NPCs (the safety net: the story can't break),
--              players' companions and stand-ins, immune_communities never
--              The shelter's people in its covers are kept in them for the front (out restrictions) and take no notice
--              of anyone outside them (on_enemy_eval): no fight through the door; one who comes in is fought as ever. One who is out again later (no walk-in time the second time) is hurt
--              as anyone; the front's story NPCs (home, cond, shelter) too, never below service_min_health
--   mutants    the level's online mutants go to the nearest covered spot (a roof above, a tree trunk beside) and stay
--              there (a monster home) till the front is over (the authority)
--   stop       an admin's stop clears it in seconds in every game: the sky in stop_blend_out_s, the ground in
--              stop_clear_s, the falling ash at once
--   service    the level's story and service NPCs (traders, technicians, medics...: [zone_event_ash_service_<level>],
--              a line per story id) sit the front out in the shelter:
--                home     his place is in the shelter's covers as it is
--                cond     his own logic has a place inside (night, surge): the xr_conditions listed are forced for him
--                         while the front is on his level (is_night, !surge_started...), so his logic takes him there
--                         and back after; the same in every game, from the event's fact alone
--                shelter  his squad goes into the shelter with its people (the rel) and he takes one of the hide jobs
--                         in its covers, invulnerable on it; back to his smart and his own job after
--                stay     the fallback: where he stands, the ash never hurts him (as any story NPC not listed)
--              One on home or cond out of the covers for service_teleport_s is put on his job's place in them when no
--              player is within service_unseen_m of him or it (the authority)
--   going in   the shelter's people who must hide (not in sealed gear, not story) go into its covers as in Anomaly's
--              emission: the authority's smart jobs. For the front, on its level, a job of the shelter's smart out of
--              its covers is not theirs, its surge jobs (in the covers) are; hide_jobs more walker jobs on the
--              shelter's in-cover paths (hide_paths_<level>) take the ones left over. The front over: their jobs as
--              before
--   shelter    the level's stalker squads of the shelter's people (shelter_communities_<level>; none listed: all) go
--              into its shelter (shelter_<level>: a smart) for the front and back to their own smarts after: every game
--              sets the same targets from the fact ash_rel. Story squads and companions stay where they are. A sealed
--              shelter (sealed) lets nobody in, players neither: one who walks in within shelter_radius of it is put
--              back where he was outside; one who comes into the world (or was) inside sits the front out there
--   leaving    the level's other stalker squads (not its shelter's people, not all in sealed suits) go to a smart
--              of a neighbouring level (leave_<level>: levels) for the front and back to their own smarts after.
--              Zombies stay. Squads that come onto the level later are sent too (the master, each rescan_s)
--   squads     only squads all in sealed suits take the level's smarts as targets (open_to); the level's smarts
--              respawn nobody (no_respawn)
--   players    are never kept off the level
--   albinos    albino_squads (squad sections, none yet: their assets come later) are put on the level's smarts by the
--              master at the start and taken away at the end
-- The event's data: alb (the albino squads). The squads sent away are the fact "zone_event:ash_rel" =
-- "<level>|<when it ended, real s; 0 while on>|<rel>", rel: squad:its own smart's id (into the shelter) or
-- squad:own:the smart it went to (off the level); own 0: none. Kept apart from the event's slot: the squads come back
-- (return_real_hours) even when another world-state event takes the slot; the master clears it after.

local ID = "ash"
local S = "zone_event_ash"
local ZE -- coop_zone_events

local function num(key, default)
	return ini_sys:r_float_ex(S, key) or default
end

local function tr(key, ...)
	if select("#", ...) > 0 then
		return strformat(game.translate_string(key), ...)
	end
	return game.translate_string(key)
end

local function in_coop()
	return coop and coop.connected and coop.connected()
end

local function ghost()
	return in_coop() and coop.is_host() -- the headless host has no player
end

-- the game that runs the level's NPCs: its authority (the sim master while no player is there)
local function authority(lvl)
	if in_coop() then
		return coop.is_authority(lvl)
	end
	return true
end

local function ids_of(text)
	local t = {}
	for n in string.gmatch(text or "", "[^,]+") do
		t[#t + 1] = n
	end
	return t
end

local function has_part(text, key)
	for _, part in ipairs(ZE.ini_list(S, key)) do
		if string.find(text or "", part, 1, true) then
			return true
		end
	end
	return false
end

local function listed(value, key)
	for _, v in ipairs(ZE.ini_list(S, key)) do
		if v == value then
			return true
		end
	end
	return false
end

local smart_level = {} -- smart id -> its level

local function level_of(se_obj)
	return alife():level_name(game_graph():vertex(se_obj.m_game_vertex_id):level_id())
end

local function smart_level_of(smart)
	local lvl = smart_level[smart.id]
	if not lvl then
		lvl = level_of(smart)
		smart_level[smart.id] = lvl
	end
	return lvl
end

local function shelter_name(lvl)
	return ini_sys:r_string_ex(S, "shelter_" .. tostring(lvl))
end

local function sealed(lvl)
	return listed(lvl, "sealed")
end

local function here()
	return ZE.on_level(ID, level.name())
end

-- the level's shelter smart
local function shelter_smart(lvl)
	return SIMBOARD.smarts_by_names[shelter_name(lvl) or ""]
end

-- in the level's shelter itself: one of its covers (online restrictors of the level we are on), or near its smart
-- when none of them is here
local function in_cover(pos, lvl)
	local found = false
	-- at the feet and a metre up: the covers' shapes may start above the floor
	local up = vector():set(pos.x, pos.y + 1, pos.z)
	for _, name in ipairs(ZE.ini_list(S, "shelter_covers_" .. lvl)) do
		local zone = db.zone_by_name[name]
		if zone then
			found = true
			if zone:inside(pos) or zone:inside(up) then
				return true
			end
		end
	end
	if found then
		return false
	end
	local smart = shelter_smart(lvl)
	return smart and pos:distance_to(smart.position) <= num("cover_fallback_radius", 10) or false
end

-------------------------------------------------------------------------------
-- the weather (every game on the level)
-- The front's weather comes in over weather_blend_in_s real seconds from the front's start and the world's goes back
-- over weather_blend_out_s from its end, the rain in weather_rain_in_s / weather_rain_out_s of them: the engine
-- blends from the look on screen (level.set_weather_blend), no step at any moment, and the weather's own changes
-- meanwhile only change what it ends into. Each blend ends at the front's start (end) + its length by the world's
-- clock, in every game alike: one that comes later (a load, a join, a level change) takes what is left of it; past
-- that, the weather at once

local shown, shown_lvl -- what this game put on its level's screen for the front: "ash", "world" (back again), nil: none

local function secs(key, default)
	return math.max(0, num(key, default))
end

local function ash_file()
	return ini_sys:r_string_ex(S, "weather") or "w_zev_ash"
end

-- the ash's event of our level, going on or over (nil: none)
local function front_here()
	local ev = ZE and ZE.get(ini_sys:r_string_ex(S, "slot") or "world")
	return ev and ev.id == ID and ev.level == level.name() and ev or nil
end

-- the weather over the world's on this level (coop_time's pick of the weather asks it): the front's, from when this
-- game began its blend in till it began the one back. A game that has not shown the front yet (it has just come
-- onto the level) starts from what the others show past the blends: to_sky() then takes the rest of one
-- the blend out of the ash after the front (ev: over): an admin's stop clears it in stop_blend_out_s
function blend_out(ev)
	if ev and ev.how == "stop" then
		return secs("stop_blend_out_s", 10)
	end
	return secs("weather_blend_out_s", 300)
end

function weather()
	if shown_lvl ~= level.name() then
		shown = nil
	end
	if shown then
		return shown == "ash" and ash_file() or nil
	end
	local ev = front_here()
	if not ev then
		return nil
	end
	if ev.stage == "on" then
		return ZE.now() - ev.from >= secs("weather_blend_in_s", 180) and ash_file() or nil
	end
	return ZE.now() - ev.till < blend_out(ev) and ash_file() or nil
end

-- into the weather file over the blend begun since real s ago (a blend of blend_s, its rain in rain_s)
local function to_sky(file, since, blend_s, rain_s)
	since = math.max(0, since)
	local left = blend_s - since
	if left > 0 and level.set_weather_blend then
		level.set_weather_blend(file, left, secs("weather_turn_s", 20), math.min(left, math.max(0.01, rain_s - since)))
	elseif level.get_weather() ~= file then
		level.set_weather(file, true)
	end
	ZE.dbg("ash weather: into %s, %s s of %s left", file, math.max(0, left), blend_s)
end

local function update_weather(ev)
	local lvl = level.name()
	if shown_lvl ~= lvl then
		shown, shown_lvl = nil, lvl
	end
	local mine = ev and ev.level == lvl
	local now = ZE.now()
	if mine and ev.stage == "on" then
		if shown ~= "ash" then
			shown = "ash"
			to_sky(ash_file(), now - ev.from, secs("weather_blend_in_s", 180), secs("weather_rain_in_s", 30))
		end
		return
	end
	local ended = mine and ev.stage == "end"
	local out = blend_out(ended and ev or nil)
	if not (shown == "ash" or shown == nil and ended and now - ev.till < out) then
		return
	end
	shown = "world"
	local wm = level_weathers.get_weather_manager()
	if not (wm and wm.weather_file) then
		if wm then
			wm:select_weather(true) -- no world's weather known here: the manager's, at once
		end
		return
	end
	to_sky(wm.weather_file, ended and now - ev.till or 0, out, math.min(out, secs("weather_rain_out_s", 120)))
	wm:select_weather(false) -- the manager's own pick again (while the blend runs it only says what it ends into)
end

-------------------------------------------------------------------------------
-- the ash: how hard it falls and how much of it lies on the ground. The master decides both for each of the front's
-- levels and keeps them as the fact "zone_event:ash_now_<level>" = "<cover>|<cover a s>|<fall>|<fall a s>": the values
-- now and how fast each goes (a real second). Every game with a player only shows what the fact says (ash_now()),
-- going on from it at its rates till the next one, so two players on a level see the same, and a join, a level change
-- or a reconnect starts where the others are. The fact outlives saves, rejoins and host restarts.
--   fall    the front's strength 0..1 (the falling ash, coop_zone_ash_fx.script): up over ramp_in_min real minutes
--           from the front's start, down over ramp_out_min before its planned end, over ramp_stop_s when it ended
--           otherwise (an admin's stop) ([zone_event_ash_fx])
--   cover   the ash on the ground 0..1, on ground_levels only: settles at fall / ground_full_min a real minute while
--           the front is on; after it goes at 1 / ground_linger_game_h a GAME hour (a sleep takes its share) and, while
--           rain is on the level's screens, rain density / ground_rain_wash_min a real minute more. No rain while the
--           front is on (its weather w_zev_ash has none); after it the rain washes only once it has been seen:
--           ground_rain_visible or more on screen (the world's weather as every game there shows it, world_rain(),
--           coming back over the blend out of the ash, rain_after()) for ground_rain_delay_s real seconds
-- The master looks each look of the events (check_s), sends a change of course at once and the rest each
-- ground_publish_s real seconds. A game eases what it showed onto a new fact over ground_blend_s (a gap above
-- ground_snap is taken at once) and goes on at the fact's rates for ground_extrapolate_s at most (no master: it stops).
-- The picture of the ground's ash (the engine's ash pass, shaders/r3/ash_ground.h): the shader bus lanes ash_cover
-- (cover 0..1, opacity, gloss kept, patchiness), ash_look (albedo, patch size), ash_mask (normal.y and open sky from
-- no ash to full), ash_shape (how far it smooths the surface, grain), ash_flora (foliage and far tree LODs: their
-- facing, strength, how much a crown's own shade is ignored), ash_bark (tree trunks: facing, strength) and ash_kinds
-- (the most on grass and on alpha tested surfaces). Not in the headless host, nor on an exe without the bus.

local ground_tokens -- { cover, look, mask, shape, flora, bark }, nil: no bus
local ground_last = -1
local next_ground = 0

local function nums(key, default)
	local t = {}
	for item in string.gmatch(ini_sys:r_string_ex(S, key) or "", "[^,]+") do
		t[#t + 1] = tonumber(item)
	end
	for i = 1, #default do
		t[i] = t[i] or default[i]
	end
	return t
end

local function ground_register()
	if not shader_bus or ghost() then
		return
	end
	local owner = "Anomaly co-op"
	local cover = shader_bus.register("ash_cover", owner, "Ash front: ash on the ground, x cover 0..1, y opacity, z gloss kept, w patchiness")
	local look = shader_bus.register("ash_look", owner, "Ash front: ash on the ground, xyz albedo, w patch size in metres")
	local mask = shader_bus.register("ash_mask", owner, "Ash front: ash on the ground, normal.y from..to, open sky from..to")
	local shape = shader_bus.register("ash_shape", owner, "Ash front: ash on the ground, x normal turned up, y grain")
	local flora = shader_bus.register("ash_flora", owner, "Ash front: ash on foliage and tree LODs, normal.y from..to, strength, crown shade ignored")
	local bark = shader_bus.register("ash_bark", owner, "Ash front: ash on tree trunks, normal.y from..to, strength")
	local kinds = shader_bus.register("ash_kinds", owner, "Ash front: the most ash on grass (x) and alpha tested surfaces (y)")
	if not (cover and look and mask and shape and flora and bark and kinds) then
		return
	end
	ground_tokens = { cover = cover, look = look, mask = mask, shape = shape, flora = flora, bark = bark, kinds = kinds }
	shader_bus.set(kinds, num("ground_grass_strength", 0.5), num("ground_aref_strength", 0.8), 0, 0)
	local c = nums("ground_color", { 0.42, 0.41, 0.40 })
	shader_bus.set(look, c[1], c[2], c[3], num("ground_patch_m", 6))
	local up, sky = nums("ground_up", { 0.35, 0.8 }), nums("ground_sky", { 0.03, 0.2 })
	shader_bus.set(mask, up[1], up[2], sky[1], sky[2])
	shader_bus.set(shape, num("ground_flatten", 0.6), num("ground_grain", 0.36), 0, 0)
	local fup = nums("ground_flora_up", { -0.6, 0.5 })
	shader_bus.set(flora, fup[1], fup[2], num("ground_flora_strength", 0.9), num("ground_flora_open", 0.8))
	local bup = nums("ground_bark_up", { 0.0, 0.7 })
	shader_bus.set(bark, bup[1], bup[2], num("ground_bark_strength", 0.8), 0)
	ground_last = -1
end

-- game seconds since the world began: the world's clock is shared, so the same in every game
local function game_seconds()
	return math.floor(game.get_game_time():diffSec(level.get_start_time()))
end

local function clamp01(x)
	return math.max(0, math.min(1, x))
end

local function fx_num(key, default)
	return ini_sys:r_float_ex("zone_event_ash_fx", key) or default
end

local function now_key(lvl)
	return "ash_now_" .. lvl
end

-- the fact ash_now_<level>: cover, its rate, fall, its rate (nil: none)
local function parse_now(text)
	local n = "([%d%.eE%+%-]+)"
	local c, cr, f, fr = string.match(text or "", "^" .. n .. "|" .. n .. "|" .. n .. "|" .. n .. "$")
	c, cr, f, fr = tonumber(c), tonumber(cr), tonumber(f), tonumber(fr)
	if not (c and cr and f and fr) then
		return nil
	end
	return c, cr, f, fr
end

-- a weather file's frames: { { t = the day's second, rain = rain_density }, ... } by time ({}: no such file)
local weather_frames = {}
local function frames_of(file)
	local list = weather_frames[file]
	if list then
		return list
	end
	list = {}
	local ini = ini_file("environment\\weathers\\" .. file .. ".ltx")
	if ini then
		ini:section_for_each(function(section)
			local h, m, s = string.match(section, "^(%d+):(%d+):(%d+)$")
			if h then
				list[#list + 1] = { t = h * 3600 + m * 60 + s, rain = ini:r_float_ex(section, "rain_density") or 0 }
			end
			return false
		end)
	end
	table.sort(list, function(a, b) return a.t < b.t end)
	weather_frames[file] = list
	return list
end

-- the last frame at or before the day's second t (a day back when none) and the first one after it (a day on)
local function frame_at(list, t)
	for i = #list, 1, -1 do
		if list[i].t <= t then
			return list[i].t, list[i].rain
		end
	end
	return list[#list].t - 86400, list[#list].rain
end

local function frame_after(list, t)
	for i = 1, #list do
		if list[i].t > t then
			return list[i].t, list[i].rain
		end
	end
	return list[1].t + 86400, list[1].rain
end

-- the rain on screen now in a game out of the front (master): the world's weather as the engine shows it, from the
-- weather the master publishes (coop_time: "weather" = hour|cycle|preset|mode|file[|before]) - between the frame at or
-- before the game time and the next one, as the engine blends them; up to the hour's weather's first frame after the
-- hour began, from the frame of the weather before (the engine goes on from the frame it showed when the weather
-- changed). Its own weather when there is no file (single player, the master indoors)
local function world_rain()
	local hour, file, before = string.match(in_coop() and coop.fact("weather") or "", "^(%d+)|[^|]*|[^|]*|%a|([^|]+)|?(.*)$")
	local list = file and frames_of(file)
	if not (list and #list > 0) then
		return level.rain_factor()
	end
	local _, _, _, h, m, s = game.get_game_time():get(0, 0, 0, 0, 0, 0, 0)
	local t = h * 3600 + m * 60 + s
	local t0, r0 = frame_at(list, t)
	local start = tonumber(hour) * 3600
	local old = before ~= "" and before ~= file and frames_of(before)
	if t >= start and t0 <= start and old and #old > 0 then
		t0, r0 = frame_at(old, t)
	end
	local t1, r1 = frame_after(list, t)
	return r0 + (r1 - r0) * clamp01((t - t0) / math.max(1, t1 - t0))
end

-- the rain on the screens of the level a front has left (ev: its event, over) while the engine blends out of the
-- ash (to_sky): none at first, the rain of the world weather's frame nearest to the blend's end coming in over
-- weather_rain_out_s, from that frame to the next one as the engine goes on, then the world's rain as usual (world)
local function rain_after(ev, world)
	local out = blend_out(ev)
	local since = ZE.now() - ev.till
	local file = string.match(in_coop() and coop.fact("weather") or "", "^%d+|[^|]*|[^|]*|%a|([^|]+)")
	local list = file and frames_of(file)
	if since < 0 or not (list and #list > 0) then
		return world
	end
	local tf = level.get_time_factor()
	local _, _, _, h, m, s = game.get_game_time():get(0, 0, 0, 0, 0, 0, 0)
	local te = (h * 3600 + m * 60 + s + (out - since) * tf) % 86400 -- the blend's end, the day's second
	local t0, r0 = frame_at(list, te)
	local t1, r1 = frame_after(list, te)
	local to = te - t0 < t1 - te and r0 or r1
	if since < out then
		return to * clamp01(since / math.max(0.01, math.min(out, secs("weather_rain_out_s", 120))))
	end
	local x = (since - out) * tf -- game s since the blend's end
	if x < t1 - te then
		return to + (r1 - to) * clamp01(x / math.max(1, t1 - te))
	end
	return world
end

-- the master: each level's ash, as it last looked (level -> { c, cr, f, fr: cover, fall and their rates a real s;
-- sent: time_global() it last sent them }), from the fact when it begins
local ash_state = {}
local last_look, last_gs = nil, nil

-- the fact of the ash lying after a front as it was before ash_now ("<game s of the end>|<cover then>|<rain>"): taken
-- over once, without the rain
local function old_lying(lvl, gs)
	local key = "ash_ground_" .. lvl
	local at, cover = string.match(ZE.mark_of(key) or "", "^(%d+)|([%d%.]+)")
	if not at then
		return 0
	end
	ZE.mark(key, "")
	return clamp01(tonumber(cover) * (1 - (gs - tonumber(at)) / math.max(1, num("ground_linger_game_h", 60) * 3600)))
end

local function sign(x)
	return x > 0 and 1 or x < 0 and -1 or 0
end

-- the master, each look: how far each level's ash went since the last one, its course from now, the fact
local function ash_master(ev)
	local t = time_global()
	if last_look and t - last_look < 500 then
		return
	end
	local dt = last_look and (t - last_look) / 1000 or 0
	local gs = game_seconds()
	local gdt = last_gs and math.max(0, gs - last_gs) or 0
	last_look, last_gs = t, gs
	local world = world_rain()
	local visible, delay = num("ground_rain_visible", 0.1), num("ground_rain_delay_s", 10) * 1000
	local full = math.max(1, num("ground_full_min", 3) * 60)
	local linger = math.max(1, num("ground_linger_game_h", 60) * 3600)
	local wash = math.max(1, num("ground_rain_wash_min", 5) * 60)
	local ramp_in = math.max(1, fx_num("ramp_in_min", 1) * 60)
	local ramp_out = math.max(1, fx_num("ramp_out_min", 10) * 60)
	local ramp_stop = math.max(1, fx_num("ramp_stop_s", 30))
	local stop_clear = math.max(1, num("stop_clear_s", 10))
	for _, lvl in ipairs(ZE.levels(ID)) do
		local s = ash_state[lvl]
		if not s then
			local c, _, f = parse_now(ZE.mark_of(now_key(lvl)))
			s = { c = c or old_lying(lvl, gs), f = f or 0, cr = 0, fr = 0 }
			ash_state[lvl] = s
		end
		local on = ev and ev.stage == "on" and ev.level == lvl
		-- an admin's stop: the ash off the ground in stop_clear_s real seconds, in every game
		local stopped = ev and ev.stage == "end" and ev.how == "stop" and ev.level == lvl
		local ground = listed(lvl, "ground_levels")
		local rain = ev and ev.stage == "end" and ev.level == lvl and rain_after(ev, world) or world
		-- the rain that washes: none under the front's weather; after it, once on screen for the delay (seen: since
		-- when it is)
		if on or rain < visible then
			s.seen = nil
		elseif not s.seen then
			s.seen = t
		end
		local wet = s.seen and t - s.seen >= delay and rain or 0
		-- since the last look
		s.f = clamp01(s.f + s.fr * dt)
		if not ground then
			s.c = 0
		elseif on then
			s.c = clamp01(s.c + s.cr * dt)
		elseif stopped then
			s.c = clamp01(s.c - dt / stop_clear)
		else
			s.c = clamp01(s.c - gdt / linger - (s.wet or 0) * dt / wash) -- the game's time: a sleep takes its share
		end
		-- from now
		local fr, cr = 0, 0
		if on then
			local left = ev.till - ZE.now()
			if left <= ramp_out then
				fr = -s.f / math.max(1, left)
			elseif s.f < 1 then
				fr = 1 / ramp_in
			end
		elseif s.f > 0 then
			fr = -1 / ramp_stop
		end
		if stopped then
			s.f = 0 -- the falling ash ends with the stop
			fr = 0
		end
		if ground and on then
			cr = s.c < 1 and s.f / full or 0
		elseif ground and s.c > 0 then
			cr = stopped and -1 / stop_clear or -(level.get_time_factor() / linger + wet / wash)
		end
		local turned = sign(fr) ~= sign(s.fr) or sign(cr) ~= sign(s.cr) or sign(wet) ~= sign(s.wet or 0)
		s.fr, s.cr, s.wet = fr, cr, wet
		if turned or not s.sent or t - s.sent >= num("ground_publish_s", 5) * 1000 then
			s.sent = t
			local text = ""
			if s.c > 0 or s.f > 0 or cr ~= 0 or fr ~= 0 then
				text = string.format("%.4f|%.6g|%.4f|%.6g", s.c, cr, s.f, fr)
			end
			if text ~= ZE.mark_of(now_key(lvl)) then
				ZE.mark(now_key(lvl), text)
				ZE.dbg("ash on %s: %s (rain %s, washing %s)", lvl, text, string.format("%.2f", rain), string.format("%.2f", wet))
			end
		end
	end
end

-- each game with a player: the fact of its level as it took it (raw), when (at), and the gap it eases out (dc, df)
local view = {}

local function shown(t)
	if not view.raw then
		return 0, 0
	end
	local age = math.min(math.max(0, (t - view.at) / 1000), num("ground_extrapolate_s", 20))
	local ease = math.max(0, 1 - (t - view.at) / (math.max(0.001, num("ground_blend_s", 2)) * 1000))
	return clamp01(view.c + view.cr * age + view.dc * ease), clamp01(view.f + view.fr * age + view.df * ease)
end

-- the ash on our level now, as the master decided it: the ground's cover and the fall's strength, 0..1 each
function ash_now()
	if not level.present() then
		return 0, 0
	end
	local t, lvl = time_global(), level.name()
	if view.lvl ~= lvl then
		view = { lvl = lvl } -- another level: its fact as it is, nothing to ease from
	end
	local raw = ZE.mark_of(now_key(lvl)) or ""
	if raw ~= view.raw then
		local c, cr, f, fr = parse_now(raw)
		c, cr, f, fr = c or 0, cr or 0, f or 0, fr or 0
		local dc, df = 0, 0
		if view.raw then
			local oc, of = shown(t)
			local snap = num("ground_snap", 0.2)
			dc = math.abs(oc - c) <= snap and oc - c or 0
			df = math.abs(of - f) <= snap and of - f or 0
		end
		view.raw, view.at, view.c, view.cr, view.f, view.fr, view.dc, view.df = raw, t, c, cr, f, fr, dc, df
	end
	return shown(t)
end

-- the comparison of looks (the admin window's test buttons, coop_admin_tests.script): the fact "zone_event:ash_test" =
-- "<fall size>|<patchiness>", each empty: the config's (fall_size of [zone_event_ash_fx], ground_patchiness here). A
-- fact: every game shows the same
function test_look()
	local size, patch = string.match(ZE.mark_of("ash_test") or "", "^(%d*)|([%d%.]*)$")
	return tonumber(size), tonumber(patch)
end

-- size, patch: nil each for the config's (both nil: the fact goes)
function set_test_look(size, patch)
	ZE.mark("ash_test", (size or patch) and (tostring(size or "") .. "|" .. tostring(patch or "")) or "")
end

-- how patchy the ash settles and goes, 0 even .. 1 in patches first
function patchiness()
	local _, patch = test_look()
	return patch or num("ground_patchiness", 0)
end

local ground_patch = -1

local function ground_update()
	if not ground_tokens then
		return
	end
	local cover, patch = ash_now(), patchiness()
	if math.abs(cover - ground_last) < 0.0005 and patch == ground_patch then
		return
	end
	if math.floor(cover * 50) ~= math.floor(ground_last * 50) or patch ~= ground_patch then
		ZE.dbg("%s", string.format("ash on the ground %.3f, patchiness %s", cover, patch))
	end
	ground_last, ground_patch = cover, patch
	shader_bus.set(ground_tokens.cover, cover, num("ground_opacity", 0.85), num("ground_gloss_keep", 0.15), patch)
end

-------------------------------------------------------------------------------
-- the radiation (each game its own player)

local last_dose, last_health, warned, next_dbg = nil, nil, false, 0

local function sealed_suit()
	local outfit = db.actor:item_in_slot(7)
	local section = outfit and outfit:section()
	return section and has_part(section, "sealed_suits") or false
end

local pause_until = nil -- time_global() the anti-rad's pause of the ash's dose ends at

local function pause_ms()
	return num("antirad_pause_s", 60) * 1000
end

-- the anti-rad's pause: on till pause_until; over with the front, or after a load (the clock went back)
local function paused(now, on)
	if not pause_until then
		return false
	end
	local left = pause_until - now
	if on and left > 0 and left <= pause_ms() then
		return true
	end
	pause_until = nil
	if on and left <= 0 then
		actor_menu.set_msg(1, tr("st_zev_ash_antirad_end"), 5)
		ZE.dbg("ash: the anti-rad's pause is over")
	end
	return false
end

local function on_item_use(item, sec)
	sec = sec or (item and item:section())
	if not sec or ghost() or not here() or not listed(sec, "antirad_items") then
		return
	end
	pause_until = time_global() + pause_ms()
	actor_menu.set_msg(1, tr("st_zev_ash_antirad", math.floor(pause_ms() / 1000)), 6)
	ZE.dbg("ash: %s used, the ash's dose stops for %s s", sec, pause_ms() / 1000)
end

local function dose(on)
	local now = time_global()
	local pause = paused(now, on and not ghost())
	local covered = on and not ghost() and in_cover(db.actor:position(), level.name())
	if on and not ghost() and now >= next_dbg then
		local why = sealed_suit() and "a sealed suit" or covered and "in cover" or pause and "the anti-rad's pause" or nil
		if why then
			next_dbg = now + 10000
			local outfit = db.actor:item_in_slot(7)
			ZE.dbg("ash: no dose, %s (outfit %s)", why, outfit and outfit:section() or "none")
		end
	end
	if not on or ghost() or sealed_suit() or covered then
		if covered and db.actor.radiation > 0 and last_dose then
			-- the shelter's air: the radiation goes down
			local dt = math.min(5, (now - last_dose) / 1000)
			db.actor:change_radiation(-math.min(db.actor.radiation, num("cover_rad_decay", 0.004) * dt))
		end
		last_dose, last_health = covered and now or nil, nil
		if not on then
			warned = false
		end
		return
	end
	if not warned then
		warned = true
		actor_menu.set_msg(1, tr("st_zev_ash_exposed"), 8)
	end
	if pause then
		last_dose, last_health = nil, nil -- the next look after the pause only starts the count
		return
	end
	local health = db.actor.health
	-- what took health since our last look (the engine's own radiation harm, wounds...): it counts towards ours
	local lost = last_health and math.max(0, last_health - health) or 0
	local dt = last_dose and (now - last_dose) / 1000 or 0
	last_dose, last_health = now, health
	if dt <= 0 or dt > 5 then
		return -- the first look, or a long pause (a load, a menu)
	end
	local rad = db.actor.radiation
	local max = num("rad_max", 0.5)
	if rad < max then
		db.actor:change_radiation(math.min(num("rad_rate", 0.01) * dt, max - rad))
	end
	local extra = 0
	if rad >= num("rad_harm_from", 0.1) then
		extra = num("rad_health", 0.011) * rad * dt - lost
		if extra > 0 then
			health = health - extra
			if health <= 0.02 then
				last_health = nil
				db.actor:kill(db.actor)
				return
			end
			db.actor:set_health_ex(health)
			last_health = health
		end
	end
	if now >= next_dbg then
		next_dbg = now + 10000
		local outfit = db.actor:item_in_slot(7)
		ZE.dbg("%s", string.format("ash: radiation %.2f, health %.2f (lost %.4f by itself, %.4f more by the ash), outfit %s",
			rad, health, lost, math.max(0, extra), outfit and outfit:section() or "none"))
	end
end

-------------------------------------------------------------------------------
-- the NPCs (the level's authority: the NPCs it runs)

local HIDE = "coop_ash_hide_" -- the hide jobs' section names and dynamic ltx (db.dynamic_ltx) per shelter smart
local npc_since = {} -- npc id -> time_global() it was first out of cover
local must_hide -- below: an NPC of the shelter who must go in
local kept = {} -- npc id -> the covers he is kept in for the front (out restrictions, "a,b"): the shelter's people
                -- don't go out of them, not even to a fight (they shoot from inside); taken off after
local walked_in = {} -- npc id -> the shelter's walk-in time was his already this front (one who goes out again, to a
                     -- fight, has none: he is hurt as anyone outside)
local off_since = {} -- squad id -> real s (ZE.now) the offline squad was first seen out of the shelter
local next_offline = 0

local function story(squad)
	if get_object_story_id(squad.id) then
		return true
	end
	for m in squad:squad_members() do
		if get_object_story_id(m.id) then
			return true
		end
	end
	return false
end

-- a squad the ash never hurts: story, a companion, immune
local function spared(squad)
	return story(squad) or (axr_companions and axr_companions.companion_squads[squad.id])
		or listed(squad.get_squad_community and squad:get_squad_community() or "", "immune_communities")
end

-- a sealed suit by the visual: the outfit it stands for (death_manager's outfit_by_visual)
local function visual_sealed(visual)
	local ini = itms_manager and itms_manager.ini_death
	local name = ini and visual and string.match(visual, "([^\\/]+)$")
	local outfit = name and ini:r_string_ex("outfit_by_visual", name)
	return outfit and has_part(outfit, "sealed_suits") or false
end

-- an NPC in a sealed suit
local function npc_sealed(npc)
	return visual_sealed(npc:get_visual_name())
end

-- a squad all in sealed suits (its members' visuals: offline too; looked at again each 30 s)
local sealed_squads = {} -- squad id -> { until (time_global), sealed }
local function squad_sealed(squad)
	local now = time_global()
	local c = sealed_squads[squad.id]
	if c and c[1] > now then
		return c[2]
	end
	local n, yes = 0, true
	for m in squad:squad_members() do
		local se = alife_object(m.id)
		n = n + 1
		if not (se and se.visual_name and visual_sealed(se:visual_name())) then
			yes = false
			break
		end
	end
	yes = yes and n > 0
	sealed_squads[squad.id] = { now + 30000, yes }
	return yes
end

-------------------------------------------------------------------------------
-- the service and story NPCs of the level ([zone_event_ash_service_<level>]: <story id> = <how>[, conditions])

local service = {}   -- level -> { story id -> { how = home | cond | shelter | stay, cond = { xr_conditions name -> forced value } } }
local service_lvl    -- the level the front is on now (update)
local service_ids = {} -- object id -> its line on service_lvl, false: none
local service_out = {} -- npc id -> time_global() the authority first saw him out of the covers
local next_service = 0

local function read_service()
	local conds = {}
	for _, lvl in ipairs(ZE.ini_list(S, "levels")) do
		local section = S .. "_service_" .. lvl
		local t = {}
		for i = 0, (ini_sys:section_exist(section) and ini_sys:line_count(section) or 0) - 1 do
			local _, sid, value = ini_sys:r_line_ex(section, i, "", "")
			local items = ZE.list(value)
			local e = { how = items[1] or "stay", cond = {} }
			for k = 2, #items do
				local no, name = string.match(items[k], "^(!?)(.+)$")
				e.cond[name] = no == ""
				conds[name] = true
			end
			t[sid] = e
		end
		service[lvl] = t
	end
	return conds
end

-- the line of a service NPC (by its object's id) of the level
local function service_on(lvl, id)
	local sid = get_object_story_id(id)
	return sid and service[lvl] and service[lvl][sid] or nil
end

-- the same on the front's level, remembered per object (a game or a server object, or its id)
local function service_of(obj)
	if not (service_lvl and obj) then
		return nil
	end
	local id = type(obj) == "number" and obj or (type(obj.id) == "function" and obj:id() or obj.id)
	local e = service_ids[id]
	if e == nil then
		e = service_on(service_lvl, id) or false
		service_ids[id] = e
	end
	return e or nil
end

-- an NPC in a sealed suit, by his game object or his server object
local function obj_sealed(obj)
	if type(obj.get_visual_name) == "function" then
		return visual_sealed(obj:get_visual_name())
	end
	return obj.visual_name and visual_sealed(obj:visual_name()) or false
end

-- a squad with a service NPC sent into the shelter (one in a sealed suit keeps his post)
local function shelter_service(squad, lvl)
	for m in squad:squad_members() do
		local e = service_on(lvl, m.id)
		local se = alife_object(m.id)
		if e and e.how == "shelter" and not (se and obj_sealed(se)) then
			return true
		end
	end
	return false
end

-- xr_conditions of the service NPCs' own logic, forced while the front is on their level
local function force_condition(name)
	local original = xr_conditions[name]
	if type(original) ~= "function" then
		printf("! [coop] zone event ash: no xr_conditions.%s to force for the service NPCs", name)
		return
	end
	xr_conditions[name] = function(actor, npc, ...)
		local e = service_lvl and service_of(npc)
		if e and e.how == "cond" and e.cond[name] ~= nil then
			return e.cond[name]
		end
		return original(actor, npc, ...)
	end
end

-- the place of an NPC's job now: its animpoint's cover or its path's first point
local function job_place(id)
	local st = db.storage[id]
	local s = st and st.active_scheme and st[st.active_scheme]
	if not s then
		return nil
	end
	local cover = s.cover_name and bind_smart_cover.registered_smartcovers[s.cover_name]
	if cover then
		return cover:position()
	end
	if s.path_walk and level.patrol_path_exists(s.path_walk) then
		return patrol(s.path_walk):point(0)
	end
end

-- no player (ours, the others' stand-ins) within service_unseen_m of any of the places
local function unseen(...)
	local far = num("service_unseen_m", 40)
	local players = {}
	if not ghost() then
		players[1] = db.actor:position()
	end
	if in_coop() then
		for i = 1, #db.OnlineStalkers do
			local id = db.OnlineStalkers[i]
			local o = coop.stand_in_peer(id) ~= 0 and db.storage[id] and db.storage[id].object
			if o then
				players[#players + 1] = o:position()
			end
		end
	end
	for _, pos in ipairs({ ... }) do
		for _, p in ipairs(players) do
			if p:distance_to(pos) < far then
				return false
			end
		end
	end
	return true
end

-- the authority, each 5 s: the service NPCs with a place inside (home, cond) still out of the covers: said in the debug
-- log, and after service_teleport_s put on their job's place in the covers when no player is near
local function service_look(lvl)
	local now = time_global()
	if now < next_service then
		return
	end
	next_service = now + 5000
	local wait = num("service_teleport_s", 120) * 1000
	local seen = {}
	for i = 1, #db.OnlineStalkers do
		local id = db.OnlineStalkers[i]
		local e = service_of(id)
		local npc = e and (e.how == "home" or e.how == "cond") and db.storage[id] and db.storage[id].object
		if npc and npc:alive() and not in_cover(npc:position(), lvl) then
			seen[id] = true
			service_out[id] = service_out[id] or now
			local place = job_place(id)
			local inside = place and in_cover(place, lvl) or false
			ZE.dbg("ash: service NPC %s out of the covers for %s s (job %s, its place %s)", npc:name(),
				math.floor((now - service_out[id]) / 1000), tostring(db.storage[id].active_section),
				inside and "in them" or "not in them")
			if inside and now - service_out[id] >= wait and unseen(npc:position(), place) then
				npc:set_npc_position(place)
				printf("[coop] zone event ash: service NPC %s put on his place in the shelter", npc:name())
			end
		end
	end
	for id in pairs(service_out) do
		if not seen[id] then
			service_out[id] = nil
		end
	end
end

-- an offline squad of the shelter: at its smart (where its jobs are; offline nobody has a place in a cover)
local function squad_sheltered(squad, smart)
	return smart and squad.smart_id == smart.id
		and squad.position:distance_to(smart.position) <= num("offline_shelter_radius", 40)
end

-- a squad of the shelter's people: its smart's, or on its way into it
local function shelter_bound(squad, smart, lvl)
	return smart and (squad.smart_id == smart.id or squad.assigned_target_id == smart.id
		or squad.scripted_target == shelter_name(lvl)) or false
end

-- the level's shelter covers on line now, "a,b"
local function cover_names(lvl)
	local t = {}
	for _, name in ipairs(ZE.ini_list(S, "shelter_covers_" .. lvl)) do
		if db.zone_by_name[name] then
			t[#t + 1] = name
		end
	end
	return table.concat(t, ",")
end

-- the NPC can't leave the covers (each look: a change of his logic's section puts his restrictions as it has them)
local function keep_in(npc, id, names)
	if names == "" then
		return
	end
	local has = {}
	for name in string.gmatch(npc:out_restrictions() or "", "[^,%s]+") do
		has[name] = true
	end
	for name in string.gmatch(names, "[^,]+") do
		if not has[name] then
			npc:add_restrictions(name, "")
		end
	end
	kept[id] = names
end

local function let_out()
	for id, names in pairs(kept) do
		local npc = db.storage[id] and db.storage[id].object
		if npc then
			for name in string.gmatch(names, "[^,]+") do
				npc:remove_restrictions(name, "")
			end
		end
	end
	kept = {}
	ZE.dbg("ash: the shelter's people may go out again")
end

local function npc_dose(ev, rel_ids)
	local now = time_global()
	local lvl = ev.level
	local smart = shelter_smart(lvl)
	local after = num("npc_harm_after_s", 10)
	local death = math.max(after + 1, num("npc_death_s", 210))
	local walk_in = num("npc_walk_in_s", 180) * 1000
	local seen, hurt, killed, walking = {}, 0, 0, 0
	local floor = num("service_min_health", 0.4)
	local names = cover_names(lvl)
	for i = 1, lvl == level.name() and #db.OnlineStalkers or 0 do
		local id = db.OnlineStalkers[i]
		local npc = db.storage[id] and db.storage[id].object
		local se = npc and alife_object(id)
		local squad = se and se.group_id and se.group_id ~= 65535 and alife_object(se.group_id)
		-- a story NPC the front sends inside (home, cond, shelter) is hurt out of the covers too, never below
		-- service_min_health: the story can't break. On a hide job he is invulnerable (coop_ash_service); out of the
		-- covers (gone out to a fight) not
		local e = get_object_story_id(id) and service_of(id)
		local svc = e and e.how ~= "stay"
		local on_hide = svc and string.find(db.storage[id].active_section or "", "@coop_ash_", 1, true) ~= nil -- a hide job or spot
		if squad and squad.squad_members and IsStalker(npc) and npc:alive()
			and not (in_coop() and coop.stand_in_peer(id) ~= 0)
			and not listed(npc:character_community(), "immune_communities") and not npc_sealed(npc)
			and (svc and not (axr_companions and axr_companions.companion_squads[squad.id])
				and (on_hide or not npc:invulnerable())
				or not get_object_story_id(id) and not npc:invulnerable() and not spared(squad)) then
			if in_cover(npc:position(), lvl) then
				if on_hide and not npc:invulnerable() then
					npc:invulnerable(true)
				end
				if svc or must_hide(se) then
					keep_in(npc, id, names)
				end
			else
				if on_hide and npc:invulnerable() then
					npc:invulnerable(false)
				end
				seen[id] = true
				local since = npc_since[id]
				if not since then
					-- the shelter's people walk in (their jobs are in the covers now): the clock starts after, once
					since = not walked_in[id] and shelter_bound(squad, smart, lvl) and now + walk_in or now
					walked_in[id] = true
					npc_since[id] = since
				end
				local t = (now - since) / 1000
				if t < 0 then
					walking = walking + 1
				elseif t >= death and not svc then
					killed = killed + 1
					npc:kill(npc)
				elseif t > after then
					local cap = 1 - (t - after) / (death - after)
					if svc then
						cap = math.max(cap, floor)
					end
					if npc.health > cap then
						hurt = hurt + 1
						npc:set_health_ex(cap)
					end
				end
			end
		end
	end
	for id in pairs(npc_since) do
		if not seen[id] then
			npc_since[id] = nil -- in cover, gone offline or dead: the count starts over
		end
	end
	if killed > 0 then
		printf("[coop] zone event ash: %s NPC(s) died of the ash on %s", killed, lvl)
	end
	if hurt > 0 or walking > 0 then
		ZE.dbg("ash: %s NPC(s) out of cover lose health, %s of the shelter's still walking in", hurt, walking)
	end

	-- the offline squads of the level out of the shelter: gone after offline_death_min real minutes
	if now < next_offline then
		return
	end
	next_offline = now + 15000
	local real = ZE.now()
	local limit = num("offline_death_min", 8) * 60
	local found = {}
	for sid in pairs(SIMBOARD.squads) do
		local squad = alife_object(sid)
		if squad and squad.squad_members and not is_squad_monster[squad.player_id] and not squad.online
			and not (in_coop() and coop.squad_online_elsewhere(sid)) and level_of(squad) == lvl
			and not (squad.scripted_target and not rel_ids[sid]) -- a squad someone else leads (a task's)
			and not spared(squad) and not squad_sealed(squad) and not squad_sheltered(squad, smart) then
			found[sid] = true
			local since = off_since[sid] or real
			off_since[sid] = since
			if real - since >= limit then
				off_since[sid] = nil
				printf("[coop] zone event ash: offline squad %s (%s) died of the ash on %s", squad:name(),
					squad:section_name(), lvl)
				SIMBOARD:remove_squad(squad)
			end
		end
	end
	for sid in pairs(off_since) do
		if not found[sid] then
			off_since[sid] = nil
		end
	end
end

-------------------------------------------------------------------------------
-- the mutants (the level's authority): each online one goes to a covered spot near it for the front - a roof above it
-- (a building) or a tree's trunk beside it - kept there by a monster home; its own home (mob_home) again after

local mutants = {} -- id -> { lv = the covered spot's level vertex (false: none near), pos = where it was looked for }
local next_mutants = 0

local function under_roof(pos)
	local rp = ray_pick(vector():set(pos.x, pos.y + 0.5, pos.z), vector():set(0, 1, 0), num("mutant_roof_m", 25),
		rq_target.rqtStatic, nil)
	return rp:query()
end

local function by_tree(pos)
	local reach = num("mutant_tree_m", 1.5)
	local from = vector():set(pos.x, pos.y + 1, pos.z)
	for k = 0, 7 do
		local a = k * math.pi / 4
		local rp = ray_pick(from, vector():set(math.sin(a), 0, math.cos(a)), reach, rq_target.rqtStatic, nil)
		if rp:query() then
			local res = rp:get_result()
			if res and has_part(res.material_name or "", "mutant_tree_materials") then
				return true
			end
		end
	end
	return false
end

local function covered_spot(pos)
	return under_roof(pos) or by_tree(pos)
end

-- not a place of people: the front's shelter (its covers, within mutant_avoid_m of its smart), a base (a smart with
-- props base, within mutant_avoid_m), behind a door (within mutant_avoid_door_m of one)
local bases, bases_lvl = {}, nil -- the level's bases' positions
local function people_place(p)
	local lvl = level.name()
	if in_cover(p, lvl) then
		return true
	end
	local far = num("mutant_avoid_m", 30)
	local shelter = shelter_smart(lvl)
	if shelter and p:distance_to(shelter.position) <= far then
		return true
	end
	if bases_lvl ~= lvl then
		bases_lvl, bases = lvl, {}
		for _, s in pairs(SIMBOARD.smarts) do
			local smart = s.smrt
			if smart and smart.props and (smart.props.base or 0) > 0 and smart_level_of(smart) == lvl then
				bases[#bases + 1] = smart.position
			end
		end
	end
	for _, b in ipairs(bases) do
		if p:distance_to(b) <= far then
			return true
		end
	end
	local door_m = num("mutant_avoid_door_m", 8)
	for _, dp in pairs(db.level_doors or {}) do
		if p:distance_to(dp) <= door_m then
			return true
		end
	end
	return false
end

local function mutant_spot(p)
	return not people_place(p) and covered_spot(p) -- the cheap look first: the cover's costs rays
end

-- the nearest covered spot around that is no place of people: rings mutant_cover_step apart up to
-- mutant_cover_radius, mutant_cover_dirs each
local function find_cover(npc)
	local lv = npc:level_vertex_id()
	if not (lv and lv < 4294967295) then
		return false
	end
	local pos = level.vertex_position(lv)
	if mutant_spot(pos) then
		return lv
	end
	local step = math.max(1, num("mutant_cover_step", 5))
	local dirs = math.max(4, num("mutant_cover_dirs", 12))
	for d = step, num("mutant_cover_radius", 40), step do
		for k = 0, dirs - 1 do
			local a = 2 * math.pi * k / dirs
			local v = level.vertex_in_direction(lv, vector():set(math.sin(a), 0, math.cos(a)), d)
			if v and v ~= lv and v < 4294967295 then
				local p = level.vertex_position(v)
				if p:distance_to(pos) > d * 0.5 and mutant_spot(p) then
					return v
				end
			end
		end
	end
	return false
end

-- mutant_ignore_enemies: the front's mutants go for nobody (players and NPCs alike) on their way to cover and in it;
-- one hit from within mutant_defend_m goes for whoever hit it for mutant_defend_s
local calm = {}     -- id -> true: its enemy callback is ours
local provoked = {} -- id -> { who = the hitter's id, till = time_global() }

local function calm_enemy(npc, enemy)
	local p = provoked[npc:id()]
	return p ~= nil and enemy ~= nil and enemy:id() == p.who and time_global() < p.till
end

local function on_mutant_hit(npc, amount, dir, who)
	if npc and calm[npc:id()] and who and who:id() ~= npc:id()
		and who:position():distance_to(npc:position()) <= num("mutant_defend_m", 5) then
		provoked[npc:id()] = { who = who:id(), till = time_global() + num("mutant_defend_s", 20) * 1000 }
	end
end

local function mutants_hide()
	local now = time_global()
	if now < next_mutants then
		return
	end
	next_mutants = now + num("mutant_check_s", 5) * 1000
	local r = num("mutant_home_radius", 4)
	local again = num("mutant_cover_radius", 40)
	local budget = num("mutant_per_look", 4) -- searches a look: they cost rays
	local found, none, there = 0, 0, 0
	for id, st in pairs(db.storage) do
		local npc = st.object
		if npc and IsMonster(npc) and npc:alive() then
			if not calm[id] and ini_sys:r_bool_ex(S, "mutant_ignore_enemies", true) then
				calm[id] = true
				npc:set_enemy_callback(calm_enemy)
			end
			local m = mutants[id]
			-- looked for again when it is far from where none was found
			if budget > 0 and (not m or not m.lv and m.pos:distance_to(npc:position()) > again) then
				budget = budget - 1
				m = { lv = find_cover(npc), pos = vector():set(npc:position()) }
				mutants[id] = m
			end
			if m and m.lv then
				found = found + 1
				if npc:position():distance_to(level.vertex_position(m.lv)) <= r * 2 then
					there = there + 1
				end
				npc:set_home(m.lv, r, r * 3, false, r * 2) -- each look: its logic (mob_home) may have set its own
			elseif m then
				none = none + 1
			end
		end
	end
	if found + none > 0 then
		ZE.dbg("ash: %s mutant(s) sent to a covered spot (%s of them there), %s with none near", found, there, none)
	end
end

local function mutants_free()
	for id, m in pairs(mutants) do
		local st = db.storage[id]
		local npc = st and st.object
		if m.lv and npc and npc:alive() then
			npc:remove_home()
			if st.active_scheme == "mob_home" and st.mob_home then
				xr_logic.issue_event(npc, st.mob_home, "reset_scheme", false)
			end
		end
	end
	for id in pairs(calm) do
		local st = db.storage[id]
		local npc = st and st.object
		if npc and npc:alive() then
			npc:set_enemy_callback()
		end
	end
	mutants, calm, provoked = {}, {}, {}
	ZE.dbg("ash: the mutants go out again")
end

-------------------------------------------------------------------------------
-- going in (the level's authority: its smart jobs, as Anomaly's emission does it)

local hide = nil -- while the front is on our level and we run its NPCs: { smart = the shelter's id, lvl = level }
local hides_of = {} -- npc id -> { until (time_global), must hide }
local job_covered = setmetatable({}, { __mode = "k" }) -- job -> its place is in a cover
local SURGE_JOBS = { [2] = true, [8] = true, [14] = true } -- gulag_general: surge, animpoint_surge, beh_surge

-- a service NPC sent into the shelter (shelter): he takes a hide job there
-- (one in a sealed suit keeps his post: the ash can't hurt him)
local function service_hides(obj)
	local e = service_of(obj)
	return e ~= nil and e.how == "shelter" and not obj_sealed(obj)
end

-- an NPC of the shelter who must go in: not story, not a stand-in, not immune, not in a spared squad or a sealed suit;
-- or a service NPC sent in
function must_hide(se_obj)
	local id = se_obj.id
	local now = time_global()
	local c = hides_of[id]
	if c and c[1] > now then
		return c[2]
	end
	local yes = service_hides(se_obj)
	local squad = se_obj.group_id and se_obj.group_id ~= 65535 and alife_object(se_obj.group_id)
	if not yes and squad and squad.squad_members and not get_object_story_id(id)
		and not (in_coop() and coop.stand_in_peer(id) ~= 0)
		and not listed(se_obj:community(), "immune_communities") and not spared(squad) then
		yes = not (se_obj.visual_name and visual_sealed(se_obj:visual_name()))
	end
	hides_of[id] = { now + 5000, yes }
	return yes
end

-- (looked at again now and then: a cover restrictor not online yet would have it judged by the fallback circle)
local function covered_job(job)
	local now = time_global()
	local c = job_covered[job]
	if not (c and c[1] > now) then
		local pos = job.coop_lvid and level.vertex_position(job.coop_lvid) or job.position
		c = { now + 30000, pos and in_cover(pos, hide.lvl) or false }
		job_covered[job] = c
	end
	return c[2]
end

-- the hide jobs: walkers on the shelter's in-cover paths, for those who must hide and found no other job in a cover
local function hide_job_ok(se_obj, smart)
	return hide ~= nil and smart.id == hide.smart and must_hide(se_obj)
end

-- The shelter's own places for those who must hide (hide_spots_<level>: level vertices, e.g. a side corridor out of
-- everyone's way) and its beds (hide_beds_<level>: job sections of the smart). With spots, the shelter's people take
-- a bed or a spot; only when every spot is taken the rest go to the other surge and hide jobs in its covers
local SPOT = "coop_ash_spot_"

local function hide_spots(lvl)
	local t = {}
	for _, v in ipairs(ZE.ini_list(S, "hide_spots_" .. lvl)) do
		t[#t + 1] = tonumber(v)
	end
	return t
end

local function spot_free(smart, lvl)
	local held = smart.npc_by_job_section or {}
	for i = 1, #hide_spots(lvl) do
		if held["logic@" .. SPOT .. i] == nil then
			return true
		end
	end
	return false
end

-- a job's precondition while hiding: for those who must hide, a job of the shelter out of its covers is not theirs, a
-- surge job in them is; a service NPC sent in takes a hide job only (he is invulnerable on it)
local wrapped = {}
local function hide_precondition(pre)
	local key = pre or wrapped
	local f = wrapped[key]
	if not f then
		f = function(se_obj, smart, job, info, ...)
			if hide and smart.id == hide.smart and (not info or info.stype == 0) and must_hide(se_obj) then
				if job.coop_lvid then
					return true -- a spot
				end
				if pre ~= hide_job_ok and service_hides(se_obj) then
					return false
				end
				if not covered_job(job) then
					return false
				end
				if #hide_spots(hide.lvl) > 0 then
					if listed(job.section, "hide_beds_" .. hide.lvl) then
						return true
					end
					-- the rest of the covers' jobs only once the spots are full
					if spot_free(smart, hide.lvl) then
						return false
					end
				end
				if not job.exclusive and SURGE_JOBS[job.job_type_id] then
					return true
				end
			end
			if pre then
				return pre(se_obj, smart, job, info, ...)
			end
			return true
		end
		wrapped[key] = f
	end
	return f
end

local function hide_paths(lvl)
	return ZE.ini_list(S, "hide_paths_" .. lvl)
end

-- the shelter smart's hide jobs' ltx: made once a game, before any NPC's saved logic asks for it
local function hide_ltx(smart_name, lvl)
	local name = HIDE .. smart_name
	if db.dynamic_ltx[name] then
		return db.dynamic_ltx[name]
	end
	local paths = hide_paths(lvl)
	local text = {}
	for i = 1, #paths > 0 and num("hide_jobs", 12) or 0 do
		text[#text + 1] = strformat([[
[logic@%s%s]
active = walker@%s%s

[walker@%s%s]
sound_idle = state
use_camp = true
path_walk = %s
def_state_standing = guard
def_state_moving = {=dist_to_job_point_ge(25)} sprint, {=dist_to_job_point_ge(5)} run, patrol
invulnerable = {=coop_ash_service} true, false
]], HIDE, i, HIDE, i, HIDE, i, paths[(i - 1) % #paths + 1])
	end
	for i, lvid in ipairs(hide_spots(lvl)) do
		text[#text + 1] = strformat([[
[logic@%s%s]
active = beh@%s%s

[beh@%s%s]
behavior_state = beh_cover
target = lvid:%s
wait_anim = guard
invulnerable = {=coop_ash_service} true, false
]], SPOT, i, SPOT, i, SPOT, i, lvid)
	end
	db.dynamic_ltx[name] = create_ini_file(table.concat(text, "\n"))
	return db.dynamic_ltx[name]
end

local function shelter_levels()
	local t = {}
	for _, lvl in ipairs(ZE.ini_list(S, "levels")) do
		local name = shelter_name(lvl)
		if name then
			t[name] = lvl
		end
	end
	return t
end

local function add_hide_jobs(smart)
	local lvl = smart.stalker_jobs and shelter_levels()[smart:name()]
	if not lvl then
		return
	end
	local ltx = hide_ltx(smart:name(), lvl)
	local paths = hide_paths(lvl)
	local added = 0
	for i = 1, #paths > 0 and num("hide_jobs", 12) or 0 do
		if level.patrol_path_exists(paths[(i - 1) % #paths + 1]) then
			added = added + 1
			rawset(smart.stalker_jobs, #smart.stalker_jobs + 1, {
				section = "logic@" .. HIDE .. i, ini_path = "*" .. HIDE .. smart:name(), ltx = ltx, job_type = "path_job",
				prior = 2, -- under every vanilla job: taken only by those no other job in a cover is left for
				prefix_name = "nil", exclusive = true, precondition_function = hide_job_ok,
			})
		end
	end
	for i, lvid in ipairs(hide_spots(lvl)) do
		added = added + 1
		rawset(smart.stalker_jobs, #smart.stalker_jobs + 1, {
			section = "logic@" .. SPOT .. i, ini_path = "*" .. HIDE .. smart:name(), ltx = ltx, job_type = "point_job",
			prior = 3, -- over the hide paths
			prefix_name = "nil", exclusive = true, precondition_function = hide_job_ok, coop_lvid = lvid,
		})
	end
	if added > 0 then
		table.sort(smart.stalker_jobs, function(a, b) return gulag_general.get_job_prior(a) > gulag_general.get_job_prior(b) end)
	end
end

local function update_hide(ev, on_here)
	local smart = on_here and authority(ev.level) and shelter_smart(ev.level)
	local id = smart and smart.id or nil
	if (hide and hide.smart) == id then
		return
	end
	hide = id and { smart = id, lvl = ev.level } or nil
	hides_of, job_covered = {}, setmetatable({}, { __mode = "k" })
	ZE.dbg("ash: the shelter's people %s", hide and ("go into the covers of " .. smart:name()) or "back to their jobs")
end

-------------------------------------------------------------------------------
-- the sealed shelter (each game its own player)

local outside = nil -- where our player last stood outside it (nil: not seen outside since he came onto the level)

local function keep_out(ev)
	local smart, radius = shelter_smart(ev.level), num("shelter_radius", 60)
	if not (smart and sealed(ev.level)) or ghost() then
		outside = nil
		return
	end
	local pos = db.actor:position()
	local d = pos:distance_to(smart.position)
	if d > radius + 2 then
		outside = vector():set(pos)
		return
	end
	if d > radius or not outside then
		return -- at its edge; or inside since he came into the world (a save there) or the front came: he stays
	end
	db.actor:set_actor_position(outside)
	actor_menu.set_msg(1, tr("st_zev_ash_sealed"), 5)
end

-------------------------------------------------------------------------------
-- the shelter's squads (every game: the same targets from the event's data)

local function smart_name(id)
	local s = id and SIMBOARD.smarts[id]
	return s and s.smrt and s.smrt:name()
end

local function read_rel()
	return string.match(ZE.mark_of("ash_rel"), "^([^|]+)|(%d+)|(.*)$")
end

-- the squad ids of the rel
local function rel_set(rel)
	local t = {}
	for _, entry in ipairs(ids_of(rel)) do
		local id = tonumber(string.match(entry, "^(%d+):"))
		if id then
			t[id] = true
		end
	end
	return t
end

local function relocate()
	local lvl, ended, rel = read_rel()
	if not lvl then
		return
	end
	ended = tonumber(ended)
	local on = ended == 0
	local shelter = shelter_name(lvl)
	local back = num("return_real_hours", 2) * 3600
	local late = not on and ZE.now() - ended > back
	if late and ZE.master() and ZE.now() - ended > back + 600 then
		ZE.mark("ash_rel", "") -- every game has sent them home by now
		return
	end
	for _, entry in ipairs(ids_of(rel)) do
		local id, own, away = string.match(entry, "^(%d+):(%d+):?(%d*)$")
		local squad = id and alife_object(tonumber(id))
		if squad and squad.squad_members then
			own = tonumber(own)
			local own_name = smart_name(own)
			local target = away ~= "" and smart_name(tonumber(away)) or away == "" and shelter
			if on then
				if target and squad.scripted_target ~= target then
					squad.scripted_target = target
				end
			elseif target and squad.scripted_target == target or (own_name and squad.scripted_target == own_name) then
				if late or squad.smart_id == own or not own_name then
					squad.scripted_target = nil -- home: Anomaly's own life again
				elseif squad.scripted_target ~= own_name then
					squad.scripted_target = own_name
				end
			end
		end
	end
end

-------------------------------------------------------------------------------
-- the master: who goes into the shelter, the albinos

-- the level's squads to send into its shelter or off the level, but those in known: rel entries
local function gather(lvl, known)
	local shelter = shelter_name(lvl)
	local target = shelter and SIMBOARD.smarts_by_names[shelter]
	local rel = {}
	local people = {}
	for _, c in ipairs(ZE.ini_list(S, "shelter_communities_" .. lvl)) do
		people[c] = true
	end
	local function theirs(squad)
		return next(people) == nil or people[squad.get_squad_community and squad:get_squad_community() or ""]
	end
	-- the neighbouring levels' smarts a squad may go to (no bases)
	local near = {}
	for _, l in ipairs(ZE.ini_list(S, "leave_" .. lvl)) do
		near[l] = true
	end
	local away = {}
	for _, s in pairs(SIMBOARD.smarts) do
		if s.smrt and s.smrt.props and (s.smrt.props.base or 0) == 0 and near[smart_level_of(s.smrt)] then
			away[#away + 1] = s.smrt
		end
	end
	local function away_for(squad)
		local fit = {}
		for _, smart in ipairs(away) do
			local ok, yes = pcall(smart.target_precondition, smart, squad, true, true)
			if ok and yes then
				fit[#fit + 1] = smart
			end
		end
		return #fit > 0 and fit[math.random(#fit)] or nil
	end
	local gone = 0
	for id in pairs(SIMBOARD.squads) do
		local squad = alife_object(id)
		-- a squad with a story NPC (a trader, a mechanic: jup_cont_trader_bandit...) stays: its people are needed
		-- there; but one with a service NPC sent into the shelter (shelter)
		if squad and squad.squad_members and not known[id] and not is_squad_monster[squad.player_id] and not squad.scripted_target
			and not (target and squad.smart_id == target.id) and not (axr_companions and axr_companions.companion_squads[id])
			and level_of(squad) == lvl then
			local own = squad.smart_id or 0
			if story(squad) then
				if target and shelter_service(squad, lvl) then
					rel[#rel + 1] = id .. ":" .. own
				end
			elseif theirs(squad) then
				-- all in sealed suits: they keep their jobs, guards their posts
				if target and not squad_sealed(squad) then
					rel[#rel + 1] = id .. ":" .. own
				end
			elseif squad.player_id ~= "zombied" and not squad_sealed(squad) then
				local smart = away_for(squad)
				if smart then
					rel[#rel + 1] = id .. ":" .. own .. ":" .. smart.id
					gone = gone + 1
				end
			end
		end
	end
	return rel, gone
end

local next_rescan = 0

-- squads that came onto the level since: sent too
local function rescan(ev)
	local now = time_global()
	if now < next_rescan then
		return
	end
	next_rescan = now + num("rescan_s", 60) * 1000
	local lvl, ended, rel = read_rel()
	if lvl ~= ev.level or tonumber(ended) ~= 0 then
		return
	end
	local more, gone = gather(lvl, rel_set(rel))
	if #more > 0 then
		ZE.mark("ash_rel", lvl .. "|0|" .. (rel ~= "" and rel .. "," or "") .. table.concat(more, ","))
		printf("[coop] zone event ash on %s: %s more squad(s) into the shelter, %s off the level", lvl, #more - gone, gone)
	end
end

local function start(ev)
	local rel, gone = gather(ev.level, {})
	ZE.mark("ash_rel", ev.level .. "|0|" .. table.concat(rel, ","))
	next_rescan = time_global() + num("rescan_s", 60) * 1000
	local alb = {}
	local sections = ZE.ini_list(S, "albino_squads")
	if #sections > 0 then
		local smarts = {}
		for _, s in pairs(SIMBOARD.smarts) do
			if s.smrt and smart_level_of(s.smrt) == ev.level and not (s.smrt.props and (s.smrt.props.base or 0) > 0) then
				smarts[#smarts + 1] = s.smrt
			end
		end
		if #smarts > 0 then
			if in_coop() then
				coop.begin_shared() -- the master's spawn is everyone's
			end
			local ok, err = pcall(function()
				for _, section in ipairs(sections) do
					local squad = ini_sys:section_exist(section) and SIMBOARD:create_squad(smarts[math.random(#smarts)], section)
					if squad then
						alb[#alb + 1] = squad.id
					end
				end
			end)
			if in_coop() then
				coop.end_shared()
				coop_sync.send_squad_members()
			end
			if not ok then
				printf("! [coop] zone event ash: albinos: %s", tostring(err))
			end
		end
	end
	ev.data.alb = table.concat(alb, ",")
	printf("[coop] zone event ash on %s: %s squad(s) into %s, %s off the level, %s albino squad(s)", ev.level,
		#rel - gone, tostring(shelter_name(ev.level)), gone, #alb)
end

local function finish(ev, how)
	-- the squads home from now on (relocate, in every game)
	local lvl, _, rel = read_rel()
	if lvl == ev.level then
		ZE.mark("ash_rel", lvl .. "|" .. math.max(1, ZE.now()) .. "|" .. rel)
	end
	for _, s in ipairs(ids_of(ev.data.alb)) do
		local id = tonumber(s)
		local squad = id and alife_object(id)
		if squad and squad.squad_members and not squad.online and not (in_coop() and coop.squad_online_elsewhere(id)) then
			SIMBOARD:remove_squad(squad)
		end
	end
end

-------------------------------------------------------------------------------
-- each look

local function update(ev)
	if ZE.master() then
		ash_master(ev)
	elseif last_look then
		ash_state, last_look, last_gs = {}, nil, nil -- no longer the master: the next one goes on from the fact
	end
	local on = ev and ev.stage == "on"
	local on_here = on and ev.level == level.name()
	if service_lvl ~= (on and ev.level or nil) then
		service_lvl, service_ids, service_out = on and ev.level or nil, {}, {}
	end
	update_weather(ev)
	update_hide(ev, on_here)
	if on_here then
		keep_out(ev)
	else
		outside = nil
	end
	relocate()
	if on and ZE.master() then
		rescan(ev)
	end
	if on and authority(ev.level) then
		local _, _, rel = read_rel()
		npc_dose(ev, rel_set(rel))
		if on_here then
			service_look(ev.level)
		end
	elseif next(npc_since) or next(off_since) or next(walked_in) then
		npc_since, off_since, walked_in = {}, {}, {}
	end
	if next(kept) and not (on_here and authority(ev.level)) then
		let_out()
	end
	if on_here and authority(ev.level) and ini_sys:r_bool_ex(S, "mutant_hide", true) then
		mutants_hide()
	elseif next(mutants) or next(calm) then
		mutants_free()
	end
end

local function news_start(ev)
	local key = coop_event_news.text_id("st_zev_ash_start_" .. ev.level, ev.from, 0)
	local text = game.translate_string(key)
	if text == key then
		return tr(coop_event_news.text_id("st_zev_ash_start", ev.from, 0), ZE.where(ev.level))
	end
	return text
end

-------------------------------------------------------------------------------

local next_dose = 0

function on_game_start()
	ZE = coop_zone_events
	ZE.register(ID, { start = start, finish = finish, update = update, news_start = news_start, open_to = squad_sealed })
	-- the service NPCs: their lines, the conditions of their logic forced for the front, the hide jobs' own one
	for name in pairs(read_service()) do
		force_condition(name)
	end
	xr_conditions.coop_ash_service = function(actor, npc)
		return service_hides(npc)
	end
	-- going in: the shelter smarts' hide jobs, and the jobs' preconditions while hiding
	for name, lvl in pairs(shelter_levels()) do
		hide_ltx(name, lvl)
	end
	local load_job = gulag_general.load_job
	gulag_general.load_job = function(smart, debug_save, ...)
		local r = load_job(smart, debug_save, ...)
		if not debug_save then
			add_hide_jobs(smart)
		end
		return r
	end
	local get_precondition = gulag_general.get_job_precondition
	gulag_general.get_job_precondition = function(job)
		local pre = get_precondition(job)
		if hide then
			return hide_precondition(pre)
		end
		return pre
	end
	ground_register()
	RegisterScriptCallback("actor_on_update", function()
		local now = time_global()
		if now >= next_ground then
			next_ground = now + 250
			ground_update()
		end
		if now < next_dose then
			return
		end
		next_dose = now + 1000
		dose(here() ~= nil)
	end)
	RegisterScriptCallback("actor_on_item_use", on_item_use)
	RegisterScriptCallback("monster_on_hit_callback", on_mutant_hit)
	-- the shelter's people kept in its covers take no notice of anyone outside them (no fight through the door, no
	-- shots from inside): they sit the front out. One who has come into the covers is fought as ever
	-- and nobody goes for a mutant of the front that goes for nobody (npc_ignore_mutants): a guard chasing a snork across
	-- the level in the ash. One the mutant goes for (it was hit by him) fights back
	RegisterScriptCallback("on_enemy_eval", function(npc, enemy, flags)
		if kept[npc:id()] and service_lvl and not in_cover(enemy:position(), service_lvl) then
			flags.override = true
			flags.result = false
		elseif calm[enemy:id()] and not calm_enemy(enemy, npc) and ini_sys:r_bool_ex(S, "npc_ignore_mutants", true) then
			flags.override = true
			flags.result = false
		end
	end)
	-- the level's smarts respawn nobody for the front
	RegisterScriptCallback("on_try_respawn", function(smart, flags)
		if ini_sys:r_bool_ex(S, "no_respawn", true) then
			local ev = ZE.running(ID)
			if ev and smart_level_of(smart) == ev.level then
				flags.disabled = true
			end
		end
	end)
end

-- The Monolith on the raid levels (https://app.notion.com/p/40ed89dbf39d818cb08efde54df35db5, "Raids"; settings: mod_system_raid.ltx [raid_monolith], [<level>_monolith], the posts'
-- sections; places: configs\scripts\raid_posts.ltx from tools\raid\raid_posts.py). A garrison on every smart terrain of
-- a level (but its no_garrison ones), its men drawn by rank weights by the smart's depth from the level's "from" point
-- (thirds: near, mid, far), each one rank up with rank_up; big ones, a rare thing on the commander, on big_count smarts
-- of the deeper half; snipers on the level's sniper smarts. Posts: places a squad of its own holds (levels with too few
-- smarts), the Monolith's scientists with their guards; their jobs are their host smart's, for their own squads only.
-- A garrison stays at its smart (the squad's scripted target). Killed is killed: a cleared smart stays free, but every
-- retake_hours one is away the Monolith takes back, with retake_chance, the free smart nearest to one it holds (holding
-- none: the level's entry smart); every refresh_hours all is held anew, posts too. Patrols walk routes, rolled anew
-- each time one comes onto the level: a chain of smarts (to and fro, resting a while at each) or a loop of points.
-- All is decided as one goes onto a level (prepare), before it loads. The world's (shelter.state): raid_g_<smart or
-- post or route> = its squad ids, raid_p_<level>_<i> = a patrol ("squad|route|index|step"), raid_refresh_<level>,
-- raid_seen_<level> (the game second the level was last seen: the retakes count from it).

local S, RANKS = "raid_monolith", "raid_monolith_ranks"
local POSTS_INI = "scripts\\raid_posts.ltx"
local STEER_MS, SEEN_MS = 3000, 60000

local function list(section, key)
	local s = ini_sys:r_string_ex(section, key)
	return s and str_explode(s, ",") or {}
end

local function number(key, default)
	return ini_sys:r_float_ex(S, key) or default
end

-- a level's setting, else [raid_monolith]'s
local function setting(level_name, key)
	return ini_sys:r_string_ex(level_name .. "_monolith", key) or ini_sys:r_string_ex(S, key)
end

local function level_list(level_name, key)
	local s = setting(level_name, key)
	return s and str_explode(s, ",") or {}
end

local function level_number(level_name, key, default)
	return tonumber(setting(level_name, key)) or default
end

-- "a, b" as {a, b}
local function range_of(s, a, b)
	local t = str_explode(s or "", ",")
	local lo = tonumber(t[1]) or a
	return { lo, tonumber(t[2]) or (t[1] and lo) or b }
end

local function game_seconds()
	return game.get_game_time():diffSec(level.get_start_time())
end

local function pick(t)
	return t[math.random(#t)]
end

local function ids_of(key)
	local out = {}
	for _, s in ipairs(str_explode(tostring(shelter.state(key, "") or ""), ",")) do
		out[#out + 1] = tonumber(s)
	end
	return out
end

function squad_alive(id)
	local se = id and id < 65535 and alife():object(id)
	return se and se:clsid() == clsid.online_offline_group_s and se:npc_count() > 0 and se or nil
end

local function remove_squads(ids)
	for _, id in ipairs(ids) do
		local se = id < 65535 and alife():object(id)
		if se and se:clsid() == clsid.online_offline_group_s then
			SIMBOARD:remove_squad(se)
		end
	end
end

local posts_ini
local function posts()
	posts_ini = posts_ini or ini_file(POSTS_INI)
	return posts_ini
end

-- the level's smarts { name, se, depth, i } by depth from its "from" point
local function smarts_of(level_name)
	local from = list(level_name .. "_monolith", "from")
	local fx, fz = tonumber(from[1]) or 0, tonumber(from[2]) or 0
	local out = {}
	for name, se in pairs(SIMBOARD.smarts_by_names) do
		if alife():level_name(game_graph():vertex(se.m_game_vertex_id):level_id()) == level_name then
			local dx, dz = se.position.x - fx, se.position.z - fz
			out[#out + 1] = { name = name, se = se, depth = math.sqrt(dx * dx + dz * dz) }
		end
	end
	table.sort(out, function(a, b) return a.depth < b.depth end)
	return out
end

-- the smarts that get garrisons (all but the level's no_garrison), numbered by depth
local function garrison_smarts(level_name, smarts)
	local skip, out = {}, {}
	for _, name in ipairs(level_list(level_name, "no_garrison")) do
		skip[name] = true
	end
	for _, smart in ipairs(smarts) do
		if not skip[smart.name] then
			out[#out + 1] = smart
			smart.i = #out
		end
	end
	return out
end

local function tier_of(smart, count)
	return smart.i <= count / 3 and "near" or smart.i <= 2 * count / 3 and "mid" or "far"
end

local function held(smart)
	for _, id in ipairs(ids_of("raid_g_" .. smart.name)) do
		if squad_alive(id) then
			return true
		end
	end
	return false
end

-- a squad at a smart, kept there (sent on when its scripted target is changed)
function spawn_squad(smart_se, section)
	local squad = SIMBOARD:create_squad(smart_se, section)
	if not squad then
		printf("! raid: no squad %s at %s", section, smart_se:name())
		return
	end
	for k in squad:squad_members() do
		local se = k.object or alife():object(k.id)
		if se then
			SIMBOARD:setup_squad_and_group(se)
		end
	end
	squad.scripted_target = smart_se:name()
	return squad
end

-- "rank:weight, ..." drawn: a rank, then one up the level's ladder with rank_up ([raid_monolith_ranks]: rank = NPC
-- section)
local function draw_section(weights, level_name)
	local t, total = {}, 0
	for _, entry in ipairs(str_explode(weights or "", ",")) do
		local rank, w = string.match(entry, "^%s*([%w_]+)%s*:%s*([%d%.]+)")
		if rank then
			t[#t + 1] = { rank, tonumber(w) }
			total = total + tonumber(w)
		end
	end
	if #t == 0 then
		return
	end
	local r, rank = math.random() * total, t[#t][1]
	for _, e in ipairs(t) do
		r = r - e[2]
		if r <= 0 then
			rank = e[1]
			break
		end
	end
	if math.random() < level_number(level_name, "rank_up", 0) then
		local ladder = level_list(level_name, "ladder")
		for i = 1, #ladder - 1 do
			if ladder[i] == rank then
				rank = ladder[i + 1]
				break
			end
		end
	end
	return ini_sys:r_string_ex(RANKS, rank)
end

-- a squad of the smart's of men by rank weights, men = {min, max}; kept there as spawn_squad's. Made at the smart, or
-- "at" { position, level vertex, game vertex } (a post's place: the post squad, always arrived at its smart). kind: the
-- squad's kind for its dead's loot (raid_loot.script: near, far, big, post...)
function spawn_ranked(smart_se, weights, men, at, kind)
	local pos, lv, gv = smart_se.position, smart_se.m_level_vertex_id, smart_se.m_game_vertex_id
	if at then
		pos, lv, gv = at[1], at[2], at[3]
	end
	local squad = alife_create(ini_sys:r_string_ex(S, at and "post_squad" or "squad") or "raid_monolith_squad", pos, lv, gv)
	if not squad then
		return
	end
	squad:create_npc(smart_se)
	local level_name = alife():level_name(game_graph():vertex(gv):level_id())
	for _ = 1, math.random(men[1], math.max(men[1], men[2])) do
		local section = draw_section(weights, level_name)
		local id = section and squad:add_squad_member(section, pos, lv, gv)
		local se = id and alife():object(id)
		if se then
			SIMBOARD:setup_squad_and_group(se)
			SendScriptCallback("squad_on_npc_creation", squad, se, smart_se)
			if kind then
				se_save_var(se.id, se:name(), "raid_kind", kind)
			end
		end
	end
	if squad:npc_count() == 0 then
		printf("! raid: empty squad (%s) at %s", tostring(weights), smart_se:name())
		SIMBOARD:remove_squad(squad)
		return
	end
	SIMBOARD:assign_squad_to_smart(squad, smart_se.id)
	squad:set_squad_relation()
	squad:refresh()
	squad.scripted_target = smart_se:name()
	return squad
end

local function rare_on_commander(squad)
	local commander = squad and alife():object(squad:commander_id())
	if commander then
		alife_create_item(pick(list(S, "rare_loot")), commander)
	end
end

local function is_sniper_smart(level_name, name)
	for _, s in ipairs(level_list(level_name, "snipers")) do
		if s == name then
			return true
		end
	end
	return false
end

-- a smart's garrison: tier's men; a big one big_squads squads (the first of big weights, the rare thing on its
-- commander, the rest of far's); a sniper smart's sniper weights
local function garrison(level_name, smart, tier, big)
	local men, ids, what = range_of(setting(level_name, "men"), 3, 5), {}, tier
	local squads = { { setting(level_name, tier), men } }
	if big then
		what, squads = "big", { { setting(level_name, "big"), men } }
		for _ = 2, level_number(level_name, "big_squads", 2) do
			squads[#squads + 1] = { setting(level_name, "far"), men }
		end
	elseif is_sniper_smart(level_name, smart.name) then
		what, squads = "sniper", { { setting(level_name, "sniper"), range_of(setting(level_name, "sniper_men"), 2, 3) } }
	end
	for i, s in ipairs(squads) do
		local squad = spawn_ranked(smart.se, s[1], s[2], nil, what)
		if squad then
			ids[#ids + 1] = squad.id
			if big and i == 1 then
				rare_on_commander(squad)
			end
		end
	end
	shelter.set_state("raid_g_" .. smart.name, table.concat(ids, ","))
	printf("raid: %s garrison at %s: %s squads", what, smart.name, #ids)
end

-- a post's squads, made at its place, of its host smart: a squad of men by its ranks, or scientists (each with good loot) and their guards
local function man_post(level_name, post)
	local host = posts():r_string_ex("raid_post_hosts", post)
	local smart = host and SIMBOARD.smarts_by_names[host]
	if not smart then
		printf("! raid: post %s has no host smart", post)
		return
	end
	local p = str_explode(posts():r_string_ex("raid_post_spawns", post) or "", ",")
	local pos = #p == 4 and vector():set(tonumber(p[1]), tonumber(p[2]), tonumber(p[3]))
	local at = pos and { pos, tonumber(p[4]), raid.vertex_of(level_name, pos) }
	local ids = {}
	if ini_sys:line_exist(post, "scientists") then
		local squad = spawn_ranked(smart, "scientist:1", range_of(ini_sys:r_string_ex(post, "scientists"), 2, 3), at, "scientist")
		if squad then
			ids[#ids + 1] = squad.id
			local count = range_of(ini_sys:r_string_ex(S, "scientist_loot_count"), 1, 2)
			for k in squad:squad_members() do
				for _ = 1, math.random(count[1], math.max(count[1], count[2])) do
					alife_create_item(pick(list(S, "scientist_loot")), alife():object(k.id))
				end
				if math.random() < number("scientist_rare_chance", 0) then
					alife_create_item(pick(list(S, "rare_loot")), alife():object(k.id))
				end
				if math.random() < number("scientist_doc_chance", 0) then
					alife_create_item(pick(list(S, "scientist_docs")), alife():object(k.id))
				end
			end
		end
		squad = spawn_ranked(smart, ini_sys:r_string_ex(post, "guard_ranks") or setting(level_name, "far"),
			range_of(ini_sys:r_string_ex(post, "guards"), 2, 3), at, "guard")
		ids[#ids + 1] = squad and squad.id
	else
		local squad = spawn_ranked(smart, ini_sys:r_string_ex(post, "ranks") or setting(level_name, "post"),
			range_of(ini_sys:r_string_ex(post, "men") or setting(level_name, "post_men"), 2, 3), at, "post")
		ids[#ids + 1] = squad and squad.id
	end
	shelter.set_state("raid_g_" .. post, table.concat(ids, ","))
	printf("raid: post %s at %s: %s squads", post, host, #ids)
end

-- all held anew: the old garrisons gone, big ones on big_count smarts of the deeper half, the posts manned
local function refresh(level_name, smarts)
	for _, smart in ipairs(smarts_of(level_name)) do
		remove_squads(ids_of("raid_g_" .. smart.name))
		shelter.set_state("raid_g_" .. smart.name, nil)
	end
	for _, post in ipairs(level_list(level_name, "posts")) do
		remove_squads(ids_of("raid_g_" .. post))
	end
	local deeper, big = {}, {}
	for i = math.floor(#smarts / 2) + 1, #smarts do
		deeper[#deeper + 1] = i
	end
	for _ = 1, math.min(level_number(level_name, "big_count", 2), #deeper) do
		big[table.remove(deeper, math.random(#deeper))] = true
	end
	for _, smart in ipairs(smarts) do
		garrison(level_name, smart, tier_of(smart, #smarts), big[smart.i])
	end
	for _, post in ipairs(level_list(level_name, "posts")) do
		man_post(level_name, post)
	end
end

-- steps of the Monolith's taking back: the free smart nearest to a held one (none held: the entry smart)
local function retake(level_name, smarts, steps)
	local entry = ini_sys:r_string_ex(level_name .. "_monolith", "entry")
	for _ = 1, steps do
		local free, holding = {}, {}
		for _, smart in ipairs(smarts) do
			local into = held(smart) and holding or free
			into[#into + 1] = smart
		end
		if #free == 0 then
			return
		end
		local target, best = nil, nil
		for _, f in ipairs(free) do
			if #holding == 0 then
				target = (f.name == entry or not target) and f or target
			end
			for _, h in ipairs(holding) do
				local d = f.se.position:distance_to_sqr(h.se.position)
				if not best or d < best then
					target, best = f, d
				end
			end
		end
		if math.random() < number("retake_chance", 0.6) then
			garrison(level_name, target, tier_of(target, #smarts), false)
		end
	end
end

-- the patrols rolled anew: the old ones gone; each route (shuffled) has one with patrol_chance, patrol_max at most.
-- A chain route ("smarts") starts at a random smart of it; a loop route walks its points from its host smart
local function patrols(level_name)
	local max = level_number(level_name, "patrol_max", 2)
	for i = 1, math.max(max, number("patrol_max", 2), 4) do
		local key = "raid_p_" .. level_name .. "_" .. i
		local p = str_explode(tostring(shelter.state(key, "") or ""), "|")
		remove_squads({ tonumber(p[1]) })
		if p[2] then
			shelter.set_state("raid_g_" .. p[2], nil)
		end
		shelter.set_state(key, nil)
	end
	local routes = list(level_name .. "_monolith", "routes")
	for i = #routes, 2, -1 do
		local j = math.random(i)
		routes[i], routes[j] = routes[j], routes[i]
	end
	local n, chance = 0, level_number(level_name, "patrol_chance", 0.4)
	local weights, men = setting(level_name, "patrol"), range_of(setting(level_name, "patrol_men"), 3, 3)
	for _, route in ipairs(routes) do
		if n < max and math.random() < chance then
			local chain = list(route, "smarts")
			local index = #chain > 0 and math.random(#chain) or 0
			local host = #chain > 0 and chain[index] or posts():r_string_ex("raid_post_hosts", route)
			local smart = host and SIMBOARD.smarts_by_names[host]
			local squad = smart and spawn_ranked(smart, weights, men, nil, "patrol")
			if squad then
				n = n + 1
				shelter.set_state("raid_p_" .. level_name .. "_" .. n,
					string.format("%d|%s|%d|%d", squad.id, route, index, index < #chain and 1 or -1))
				if #chain == 0 then
					shelter.set_state("raid_g_" .. route, tostring(squad.id))
				end
				printf("raid: patrol on %s from %s", route, host)
			end
		end
	end
end

-------------------------------------------------------------------------------
-- reinforcements (the user's: a squad every 3-5 minutes, 2-3 a raid at most, only from held smarts, 100 m away at
-- least): while one is on a raid level, every reinforce_every real seconds (drawn anew each time) a squad of reinforce's
-- ranks leaves the held smart nearest to one that is reinforce_distance metres away at least and hunts one; at most
-- reinforce_max (drawn as the raid starts) a raid (raid.run()). The world's raid_r_<level> = "squad id:smart, ...":
-- they go back to their smarts as one leaves the level, and are gone as one next comes.

local reinforce_at -- time_global() of the next one on this level

local function reinforcements(level_name)
	local out = {}
	for _, entry in ipairs(str_explode(tostring(shelter.state("raid_r_" .. level_name, "") or ""), ",")) do
		local id, smart = string.match(entry, "^(%d+):(.+)$")
		if id then
			out[#out + 1] = { id = tonumber(id), smart = smart }
		end
	end
	return out
end

local function reinforce_next()
	local r = range_of(ini_sys:r_string_ex(S, "reinforce_every"), 180, 300)
	reinforce_at = time_global() + math.random(r[1], math.max(r[1], r[2])) * 1000
end

-- a squad sent now; false: none could be (no held smart far enough)
local function reinforce(level_name)
	local run = raid.run()
	if not run then
		return true
	end
	run.reinf = run.reinf or 0
	if not run.reinf_max then
		local r = range_of(setting(level_name, "reinforce_max"), 2, 3)
		run.reinf_max = math.random(r[1], math.max(r[1], r[2]))
	end
	if run.reinf >= run.reinf_max then
		return true
	end
	local min_d, pos = level_number(level_name, "reinforce_distance", 100), db.actor:position()
	local best, best_d
	for _, smart in ipairs(garrison_smarts(level_name, smarts_of(level_name))) do
		local d = smart.se.position:distance_to(pos)
		if d >= min_d and (not best_d or d < best_d) and held(smart) then
			best, best_d = smart, d
		end
	end
	if not best then
		raid.dbg("reinforce: no held smart %s m away", min_d)
		return false
	end
	local squad = spawn_ranked(best.se, setting(level_name, "reinforce"), range_of(setting(level_name, "reinforce_men"), 3, 4),
		nil, "reinforce")
	if not squad then
		return false
	end
	squad.scripted_target = "actor"
	run.reinf = run.reinf + 1
	local list = tostring(shelter.state("raid_r_" .. level_name, "") or "")
	shelter.set_state("raid_r_" .. level_name, (list == "" and "" or list .. ",") .. squad.id .. ":" .. best.name)
	printf("raid: reinforcement %s of %s from %s, %s m away", run.reinf, run.reinf_max, best.name, math.floor(best_d))
	if ini_sys:r_bool_ex(S, "reinforce_msg", true) then
		actor_menu.set_msg(1, game.translate_string("st_raid_reinforce"), 5)
	end
	return true
end

-- a raid level made ready as one goes onto it (before it loads): refreshed if due, else the retakes since it was
-- last seen; the patrols rolled; the reinforcements of an earlier visit gone
function prepare(level_name)
	if not ini_sys:section_exist(level_name .. "_monolith") then
		return
	end
	for _, r in ipairs(reinforcements(level_name)) do
		remove_squads({ r.id })
	end
	shelter.set_state("raid_r_" .. level_name, nil)
	local smarts = garrison_smarts(level_name, smarts_of(level_name))
	if #smarts == 0 and #level_list(level_name, "posts") == 0 then
		return
	end
	local now = game_seconds()
	local refreshed = shelter.state("raid_refresh_" .. level_name, nil)
	if not refreshed or now - refreshed >= number("refresh_hours", 168) * 3600 then
		refresh(level_name, smarts)
		shelter.set_state("raid_refresh_" .. level_name, now)
		shelter.set_state("raid_seen_" .. level_name, now)
	else
		local step = number("retake_hours", 12) * 3600
		local seen = shelter.state("raid_seen_" .. level_name, now)
		local steps = math.floor((now - seen) / step)
		if steps > 0 then
			retake(level_name, smarts, steps)
			shelter.set_state("raid_seen_" .. level_name, seen + steps * step)
		end
	end
	patrols(level_name)
end

-- the level left now: the time away counts from here; the reinforcements go back to their smarts (a hunt of one
-- elsewhere would look for a way off the level)
function left(level_name)
	if ini_sys:section_exist(level_name .. "_monolith") then
		shelter.set_state("raid_seen_" .. level_name, game_seconds())
		for _, r in ipairs(reinforcements(level_name)) do
			local squad = squad_alive(r.id)
			if squad then
				squad.scripted_target = r.smart
			end
		end
	end
end

-- the patrols on the level: one on a chain at its smart rests patrol_stay seconds, then goes on to the next of its
-- chain (and back at the chain's end); one on a loop walks it by its jobs
local resting = {} -- a patrol's squad id: time_global() to go on

local function steer(level_name)
	for i = 1, level_number(level_name, "patrol_max", 2) do
		local key = "raid_p_" .. level_name .. "_" .. i
		local p = str_explode(tostring(shelter.state(key, "") or ""), "|")
		local squad = squad_alive(tonumber(p[1]))
		local chain, index, step = squad and p[2] and list(p[2], "smarts"), tonumber(p[3]), tonumber(p[4])
		local target = chain and #chain > 0 and SIMBOARD.smarts_by_names[chain[index]]
		raid.dbg("patrol %s: squad %s route %s target %s action %s current %s resting %s", i, tostring(squad and squad.id),
			tostring(p[2]), tostring(target and target:name()), tostring(squad and squad.current_action),
			tostring(squad and squad.current_target_id), tostring(squad and resting[squad.id] and resting[squad.id] - time_global()))
		if target and squad.current_action == 1 and squad.current_target_id == target.id then
			local now = time_global()
			if not resting[squad.id] then
				local r = list(S, "patrol_stay")
				resting[squad.id] = now + math.random(tonumber(r[1]) or 60, tonumber(r[2]) or 180) * 1000
			elseif now >= resting[squad.id] then
				resting[squad.id] = nil
				if index + step < 1 or index + step > #chain then
					step = -step
				end
				index = index + step
				squad.scripted_target = chain[index]
				shelter.set_state(key, string.format("%d|%s|%d|%d", squad.id, p[2], index, step))
				printf("raid: patrol %s on to %s", squad.id, chain[index])
			end
		end
	end
end

local function men_of(key)
	local men = 0
	for _, id in ipairs(ids_of(key)) do
		local squad = squad_alive(id)
		men = men + (squad and squad:npc_count() or 0)
	end
	return men
end

-- for the debug view of the raid app's map: the smarts and posts (their name and the men alive), the routes, where
-- the patrols' commanders are
function debug_view(level_name)
	local view = { smarts = {}, routes = {}, patrols = {} }
	for _, smart in ipairs(smarts_of(level_name)) do
		view.smarts[#view.smarts + 1] = { x = smart.se.position.x, z = smart.se.position.z,
			label = string.format("%s:%d", string.match(smart.name, "(%d+)$") or string.match(smart.name, "_(%a+)$") or "?",
			men_of("raid_g_" .. smart.name)) }
	end
	for _, post in ipairs(level_list(level_name, "posts")) do
		local path = post .. "_1_walk"
		if level.patrol_path_exists(path) then
			local p = patrol(path):point(0)
			view.smarts[#view.smarts + 1] = { x = p.x, z = p.z,
				label = string.format("%s:%d", string.match(post, "_(%w+)$") or post, men_of("raid_g_" .. post)) }
		end
	end
	for _, route in ipairs(list(level_name .. "_monolith", "routes")) do
		local points = {}
		for _, name in ipairs(list(route, "smarts")) do
			local se = SIMBOARD.smarts_by_names[name]
			if se then
				points[#points + 1] = { x = se.position.x, z = se.position.z }
			end
		end
		local path = #points == 0 and route .. "_walk"
		if path and level.patrol_path_exists(path) then
			local ptr = patrol(path)
			for k = 0, ptr:count() - 1 do
				local p = ptr:point(k)
				points[#points + 1] = { x = p.x, z = p.z }
			end
		end
		view.routes[#view.routes + 1] = points
	end
	for i = 1, level_number(level_name, "patrol_max", 2) do
		local squad = squad_alive(tonumber(str_explode(tostring(shelter.state("raid_p_" .. level_name .. "_" .. i, "") or ""), "|")[1]))
		local commander = squad and alife():object(squad:commander_id())
		if commander then
			view.patrols[#view.patrols + 1] = { x = commander.position.x, z = commander.position.z }
		end
	end
	return view
end

-- the posts' jobs (configs\scripts\raid_posts.ltx) join their host smarts' jobs: for the men of the post's own squads
-- (role scientist / guard: only such of them), a lair's for any Monolith man of the smart
local function own_post(se_obj, smart, job)
	if job.raid_role == "lair" then
		return se_obj:community() == "monolith"
	end
	local squad = se_obj.group_id
	if not (squad and squad ~= 65535) then
		return false
	end
	for _, id in ipairs(ids_of("raid_g_" .. job.raid_post)) do
		if id == squad then
			if job.raid_role then
				local scientist = se_obj:section_name() == ini_sys:r_string_ex(RANKS, "scientist")
				return (job.raid_role == "scientist") == scientist
			end
			return true
		end
	end
	return false
end

local function add_post_jobs(smart)
	local names = posts():r_string_ex("raid_posts", smart:name())
	if not (names and smart.stalker_jobs) then
		return
	end
	local ini = posts()
	for _, name in ipairs(str_explode(names, ",")) do
		local section = "logic@" .. name
		local scheme = utils_data.get_scheme_by_section(ini:r_string_ex(section, "active") or "")
		rawset(smart.stalker_jobs, #smart.stalker_jobs + 1, {
			section = section, ini_path = POSTS_INI, ltx = ini, prefix_name = "nil", exclusive = true,
			job_type = (scheme == "walker" or scheme == "patrol") and "path_job" or "point_job",
			prior = ini:r_float_ex(section, "prior") or 200, precondition_function = own_post,
			raid_post = ini:r_string_ex(section, "post"), raid_role = ini:r_string_ex(section, "role"),
		})
	end
	table.sort(smart.stalker_jobs, function(a, b) return gulag_general.get_job_prior(a) > gulag_general.get_job_prior(b) end)
end

local steer_at, seen_at = 0, 0

local function actor_on_update()
	local name = level.name()
	if not raid.is_raid_level(name) then
		return
	end
	local now = time_global()
	if now >= steer_at then
		steer_at = now + STEER_MS
		steer(name)
	end
	if now >= seen_at then
		seen_at = now + SEEN_MS
		shelter.set_state("raid_seen_" .. name, game_seconds())
	end
	if not reinforce_at then
		reinforce_next()
	elseif now >= reinforce_at then
		if shelter.everyones(reinforce, name) then
			reinforce_next()
		else
			reinforce_at = now + (number("reinforce_retry", 15)) * 1000
		end
	end
end

local function actor_on_first_update()
	reinforce_at = nil -- a level loaded: its own count from now
end

function on_game_start()
	local load_job = gulag_general.load_job
	gulag_general.load_job = function(smart, debug_save, ...)
		local r = load_job(smart, debug_save, ...)
		if not debug_save then
			add_post_jobs(smart)
		end
		return r
	end
	local underground = {}
	for _, name in ipairs(list(S, "underground")) do
		underground[name] = true
	end
	-- the Monolith's torches on the raid's underground levels: sr_light keeps them on round the clock on the levels it
	-- knows by name (l12u_sarcofag...), not on the copies; so it is told it is night there
	local check_light, night = sr_light.check_light, function() return 0 end
	sr_light.check_light = function(stalker, ...)
		if not underground[level.name()] then
			return check_light(stalker, ...)
		end
		local hours = level.get_time_hours
		level.get_time_hours = night
		local ok, err = pcall(check_light, stalker, ...)
		level.get_time_hours = hours
		if not ok then
			error(err)
		end
	end
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
end
